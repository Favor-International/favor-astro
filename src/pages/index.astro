---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/global/SiteHeader.astro';
import SiteFooter from '../components/global/SiteFooter.astro';
import PatternDivider from '../components/global/PatternDivider.astro';
import AfricaMap from '../components/global/AfricaMap.astro';
import { SITE, PILLARS, FIELD_STATS } from '../lib/site';
import storiesData from '../data/stories.json';
import { isPublicFieldStory } from '../lib/publicContent';

// The four pillars come verbatim from site.ts (locked to favorintl.org's own
// names and program lists). Icons are simple outlines, one per pillar.
const PILLAR_ICONS: Record<string, string> = {
  'evangelism-discipleship': '<path d="M3 11v2a1 1 0 0 0 1 1h2l4 4V6L6 10H4a1 1 0 0 0-1 1Z"/><path d="M14 8a4 4 0 0 1 0 8M16 5a7 7 0 0 1 0 14"/>',
  'education': '<path d="M12 4 2 9l10 5 10-5-10-5Z"/><path d="M6 11v4c0 1.1 2.7 3 6 3s6-1.9 6-3v-4"/>',
  'community-development': '<path d="M12 20s-7-4.3-7-9a3.6 3.6 0 0 1 7-1.2A3.6 3.6 0 0 1 19 11c0 4.7-7 9-7 9Z"/>',
  'economic-empowerment': '<path d="M12 21v-8"/><path d="M12 13c0-3.2-2.6-5.4-5.6-5.4 0 3.2 2.6 5.4 5.6 5.4Z"/><path d="M12 13c0-3.2 2.6-5.4 5.6-5.4 0 3.2-2.6 5.4-5.6 5.4Z"/>',
};

// Why indigenous leadership: the intro line is verbatim from Favor's own
// mission-vision material; the pull quote is Carole's, verbatim from Lord
// Send Us Where No One Wants to Go (2025), p.17.
const INDIGENOUS_POINTS = [
  { title: 'No learning curve', body: 'Native leaders already speak the languages and live the culture. There is no barrier to cross before the work begins.' },
  { title: 'Support goes further', body: 'Partnership sustains leaders who already live on the field, instead of funding relocation from the West.' },
  { title: 'They stay', body: 'When crisis comes, indigenous leaders do not evacuate. They live there, and the work keeps going.' },
];

// Live from the field: the three most recent real stories from the field
// (real titles, dates, and photos from stories.json).
const latestStories = storiesData.filter(isPublicFieldStory)
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime())
  .slice(0, 3);

// =====================================================================
// NOTE: the old "demo mode" (inert links for the executive-director
// preview) is OVER. Its link-neutering script was removed for real on
// 2026-07-08 (it had survived at the bottom of this file and made every
// homepage link dead - see that day's fix commit). This page is the live,
// fully functional homepage. Do NOT "restore" from /real
// (src/pages/real.astro); that file is a stale leftover copy from the
// demo era and is pending deletion once Daniel confirms.
//
// HOMEPAGE v15: Compassion-style structural cut.
// Five sections only: Hero, Proof + Trust, Map, One Missionary Story,
// Give. Every other band has been removed and lives on a deeper page.
// The through-line is the indigenous missionary. The partner sends them.
// Everything else (4 pillars, vision/mission, vision trips, prayer
// guide, stories index, scripture pause) moves to dedicated routes.
// =====================================================================

// The featured missionary anchors the entire story. Real name,
// real place, real before/after. The partner gift literally
// keeps this person on the trail. One name beats six.
// Stephanie's note (2026-07-31): "cattle warrior" alone did not read as
// something anyone needed saving from, so the band now carries the actual turn
// in Daniel's story (a fighter who lost all purpose at nineteen) and his own
// testimony instead of a founder quote. Both are verbatim from his story record
// in stories.json. Whether Daniel stays the featured missionary at all is
// Carole and Terry's call.
const missionary = {
  name: 'Daniel Kidia',
  country: 'South Sudan',
  image: '/images/stories/daniel-kidia-portrait.png',
  href: '/stories/daniel-kidia/',
};

// The giving tiers come straight from the Website Language Strategy
// doc (Section 9). Numbers are placeholders pending Carole's final
// review of dollar-to-impact math, but the structure is set.
const tiers = [
  { amount: '$25',    label: 'Equip',     line: 'A Bible and discipleship materials for a new believer.' },
  { amount: '$50',    label: 'Send',      line: 'One month of support for an indigenous missionary.', featured: true },
  { amount: '$100',   label: 'Educate',   line: 'A child’s schooling, meals, and Gospel teaching.' },
  { amount: '$250',   label: 'Heal',      line: 'Trauma counseling for a community recovering from war.' },
  { amount: '$500',   label: 'Transform', line: 'A Portable Bible School session for 20+ church planters.' },
  { amount: '$1,000', label: 'Launch',    line: 'Plants a church so new believers can thrive.' },
];
---
<BaseLayout
  title={SITE.name}
  description="You can send an indigenous missionary where the Gospel has not reached. Favor International equips local church planters in Uganda, South Sudan, and Chad. ECFA-accredited."
  image="/images/field-2026/evangelism-1.webp"
>
  <SiteHeader variant="transparent" />
  <main id="main">

    <!-- ====================================================
         1. HERO
         ==================================================== -->
    <section class="hero" aria-label="You can send the Gospel where no one else will go">
      <video
        class="hero__video"
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        poster="/videos/home-hero-poster.jpg"
        aria-hidden="true"
      >
        <source src="/videos/home-hero.mp4" type="video/mp4" />
      </video>
      <div class="hero__scrim" aria-hidden="true"></div>
      <div class="hero__inner container">
        <div class="hero__copy">
          <p class="hero__eyebrow">Become a partner</p>
          <h1 class="hero__h1">You can send the Gospel where no one else will go.</h1>
          <p class="hero__sub">Favor equips indigenous missionaries to share Jesus in the hardest places on earth, across Uganda, South Sudan, Chad, and nations beyond. Your monthly $50 gift keeps one of them on the trail.</p>
          <div class="hero__cta">
            <a class="btn btn--primary btn--large hero__primary" href="/give/donate/">Send a missionary for $50/month <span aria-hidden="true">&rarr;</span></a>
            <a class="hero__secondary" href="/give/one-time/">Or give a one-time gift</a>
          </div>
        </div>
      </div>
    </section>

    <!-- ====================================================
         2. PROOF + TRUST (numbers and accreditation badges in one breath)
         ==================================================== -->
    <section class="proof" aria-label="What your partnership has done">
      <div class="container proof__inner">
        <div class="proof__stats">
          <div class="proof__stat">
            <span class="proof__num">{FIELD_STATS.annual.salvations}</span>
            <span class="proof__label">Came to Christ in 2025</span>
          </div>
          <span class="proof__divider" aria-hidden="true"></span>
          <div class="proof__stat">
            <span class="proof__num">{FIELD_STATS.annual.discipled}</span>
            <span class="proof__label">Discipled in 2025</span>
          </div>
          <span class="proof__divider" aria-hidden="true"></span>
          <div class="proof__stat">
            <span class="proof__num">{FIELD_STATS.toDate.salvations}</span>
            <span class="proof__label">Have come to Christ since we began</span>
          </div>
          <span class="proof__divider" aria-hidden="true"></span>
          <div class="proof__stat">
            <span class="proof__num">{FIELD_STATS.nationsServed}</span>
            <span class="proof__label">Nations served</span>
          </div>
        </div>
        <p class="proof__line">
          Trusted and accredited by ECFA, Charity Navigator, and Candid.
          <a href="/about/accountability/">See our financials &rarr;</a>
        </p>
        <ul class="proof__badges" aria-label="Accountability">
          <li><a href={SITE.trust.ecfa} target="_blank" rel="noopener"><img src="/images/trust/ecfa.png" alt="ECFA Accredited" loading="lazy" /></a></li>
          <li><a href={SITE.trust.charityNavigator} target="_blank" rel="noopener"><img src="/images/trust/charity-navigator.svg" alt="Charity Navigator Four-Star" loading="lazy" /></a></li>
          <li><a href={SITE.trust.candid} target="_blank" rel="noopener"><img src="/images/trust/candid-platinum.svg" alt="Candid Platinum Transparency" loading="lazy" /></a></li>
        </ul>
      </div>
    </section>

    <!-- ====================================================
         2b. MISSION - "the clear message of what we do," per
         Danny's review (2026-07-08), placed between the stats
         and the map. Tagline and mission statement are Favor's
         own, verbatim (site.ts).
         ==================================================== -->
    <section class="mission" aria-label="The mission of Favor International">
      <div class="container mission__inner">
        <p class="eyebrow eyebrow--gold">Our mission</p>
        <h2 class="mission__h2">{SITE.tagline}</h2>
        <p class="mission__text">{SITE.mission}</p>
        <a class="mission__link" href="/about/mission-vision/">Our mission &amp; vision &rarr;</a>
      </div>
    </section>

    <!-- ====================================================
         3. AFRICA MAP
         ==================================================== -->
    <AfricaMap />

    <PatternDivider variant="cream" height="110px" />

    <!-- ====================================================
         3b. THE FOUR PILLARS: how the movement works. Names,
         blurbs, and program lists verbatim from site.ts/PILLARS
         (locked to favorintl.org). Each tile links to its
         Impact page.
         ==================================================== -->
    <section class="pillars" aria-label="How the movement works: the four pillars">
      <div class="container">
        <header class="pillars__head">
          <p class="eyebrow eyebrow--gold">One movement. Four pillars.</p>
          <h2 class="pillars__h2">Bringing Jesus to people who have never heard His name.</h2>
          <p class="pillars__lede">Every program on the field belongs to one of four pillars, and every pillar prepares hearts for the power and love of Jesus Christ.</p>
        </header>
        <div class="pillars__row">
          {PILLARS.map((p) => (
            <a class="pillars__col" href={`/impact/${p.slug}/`}>
              <span class="pillars__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={PILLAR_ICONS[p.slug]}></svg>
              </span>
              <h3>{p.label}</h3>
              <p>{p.blurb}</p>
              <span class="pillars__more">See the work &rarr;</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- ====================================================
         4. ONE MISSIONARY STORY: Daniel Kidia, anchor of the page.
         Carole's voice lives inside this band as the spiritual anchor.
         ==================================================== -->
    <section class="missionary" aria-label="Meet a missionary sent through your partnership">
      <div class="container missionary__grid">
        <figure class="missionary__photo">
          <img src={missionary.image} alt={`${missionary.name}, a Favor field pastor in ${missionary.country}.`} loading="lazy" />
          <figcaption class="missionary__caption">{missionary.name} &middot; {missionary.country}</figcaption>
        </figure>
        <div class="missionary__copy">
          <p class="eyebrow eyebrow--gold">A missionary sent through your partnership</p>
          <h2 class="missionary__h2">He was a fighter with no reason to live. Now he preaches.</h2>
          <p class="missionary__lede">
            Daniel Kidia raided and fought alongside his nomadic Mundari tribesmen in South Sudan.
            At nineteen he fell into a depression so deep he lost all purpose. Then a Favor
            evangelism team walked into his cattle camp. Today he leads Portable Bible Schools
            across South Sudan and trains other former warriors to plant churches in their own
            villages. Your $50 a month feeds him, fuels his motorbike, and stocks the Bibles he
            hands out.
          </p>
          <blockquote class="missionary__carole">
            <p class="missionary__carole-quote">&ldquo;I was blind but now I can see my future in Jesus!&rdquo;</p>
            <footer class="missionary__carole-attr">
              <span class="missionary__carole-name">Daniel Kidia</span>
              <span class="missionary__carole-role">Field pastor &middot; South Sudan</span>
            </footer>
          </blockquote>
          <a class="btn btn--primary btn--large missionary__cta" href="/give/donate/">Send Daniel and missionaries like him <span aria-hidden="true">&rarr;</span></a>
          <a class="missionary__read" href={missionary.href}>Read Daniel&rsquo;s full story &rarr;</a>
        </div>
      </div>
    </section>

    <!-- ====================================================
         4b. FOUNDER TEASER: the woman behind the prayer quoted
         above. Bio line verbatim from Favor's founder page; the
         full story lives at /about/our-story/founder/.
         ==================================================== -->
    <section class="founder" aria-label="Meet the founder, Carole Ward">
      <div class="container founder__grid">
        <div class="founder__copy">
          <p class="eyebrow eyebrow--gold">The woman behind the prayer</p>
          <h2 class="founder__h2">She prayed one dangerous prayer. God took her at her word.</h2>
          <p class="founder__lede">
            In 2002 Carole Ward stepped off a plane into northern Uganda, into the middle of a
            twenty-year war. She had prayed, &ldquo;Lord, send me where no one wants to go.&rdquo;
            People told her she would come home in a body bag.
          </p>
          <p class="founder__lede">
            She went anyway. What began with one woman praying is now an indigenous missionary
            movement across Uganda, South Sudan, Chad, and nations beyond, carried by the African
            leaders she trained and sent.
          </p>
          <blockquote class="founder__quote">
            <p>&ldquo;It only takes one obedient person to start a movement.&rdquo;</p>
            <footer>Carole Ward &middot; Lord Send Us Where No One Wants to Go</footer>
          </blockquote>
          <a class="btn btn--primary btn--large founder__cta" href="/about/our-story/founder/">Read Carole&rsquo;s story <span aria-hidden="true">&rarr;</span></a>
          <a class="founder__read" href="/about/contact/?topic=book">Or request her books, free &rarr;</a>
        </div>
        <figure class="founder__photo">
          <img src="/images/field-2026/carole-4.webp" alt="Carole Ward, Founder of Favor International, praying with believers in the field" loading="lazy" />
          <figcaption class="founder__caption">Carole Ward &middot; Founder</figcaption>
        </figure>
      </div>
    </section>

    <!-- ====================================================
         4c. WHY INDIGENOUS LEADERSHIP: the model, on a deep
         green breakout. Intro sentence verbatim from Favor's
         mission-vision material; quote verbatim from Carole
         (Lord Send Us Where No One Wants to Go, 2025).
         ==================================================== -->
    <section class="whyind" aria-label="Why indigenous leadership">
      <div class="whyind__photo" aria-hidden="true"></div>
      <div class="container whyind__inner">
        <header class="whyind__head">
          <p class="eyebrow eyebrow--gold-on-dark">Why indigenous missionaries</p>
          <h2 class="whyind__h2">Indigenous missionaries are solving problems others haven&rsquo;t been able to.</h2>
          <p class="whyind__lede">They are willing to work harder, more self-sacrificially, and more effectively for their people and nation than we ever could. Jesus discipled a few, equipped them, and sent them out to their own people. Favor follows His model.</p>
          <p class="whyind__verse">&ldquo;And the things that you have heard from me among many witnesses, commit these to faithful men who will be able to teach others also.&rdquo; <span>2 Timothy 2:2, NKJV</span></p>
        </header>
        <div class="whyind__grid">
          {INDIGENOUS_POINTS.map((pt, i) => (
            <div class="whyind__point">
              <span class="whyind__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <h3>{pt.title}</h3>
              <p>{pt.body}</p>
            </div>
          ))}
        </div>
        <blockquote class="whyind__quote">
          <p>&ldquo;Even as others are moving out, we are moving in!&rdquo;</p>
          <footer>Carole Ward &middot; Lord Send Us Where No One Wants to Go</footer>
        </blockquote>
      </div>
    </section>

    <!-- ====================================================
         4d. PRAY OR GO: the two non-financial on-ramps,
         side by side, right before the give section.
         ==================================================== -->
    <section class="onramps" aria-label="Pray with us or go see the field">
      <a class="onramp" href="/pray/30-day-guide/" style="background-image:url('/images/field-2026/prayer-7.webp')">
        <div class="onramp__scrim" aria-hidden="true"></div>
        <div class="onramp__body">
          <p class="onramp__eyebrow">Pray</p>
          <h2>Join the prayer movement.</h2>
          <p>The Nations Prayer Guide walks you through the nations we serve, one specific request per day.</p>
          <span class="onramp__cta">Open the Prayer Guide <span aria-hidden="true">&rarr;</span></span>
        </div>
      </a>
      <a class="onramp" href="/go/vision-trips/" style="background-image:url('/images/story-vision-trip-team.jpg')">
        <div class="onramp__scrim" aria-hidden="true"></div>
        <div class="onramp__body">
          <p class="onramp__eyebrow">Go</p>
          <h2>See it firsthand.</h2>
          <p>Small-team vision trips, hosted on the ground by Favor&rsquo;s field leadership.</p>
          <span class="onramp__cta">Explore vision trips <span aria-hidden="true">&rarr;</span></span>
        </div>
      </a>
    </section>

    <PatternDivider variant="green" height="140px" />

    <!-- ====================================================
         5. GIVE (tiers + final CTA + Florida disclosure)
         ==================================================== -->
    <section class="give" id="give" aria-label="Pick the partnership that fits your life">
      <!-- Background video. Source is NOT attached on page load; an
           IntersectionObserver attaches it when the section is within
           800px of the viewport, so the give-bg.mp4 (235 KB) never
           counts against initial page-load metrics. The poster JPG
           covers the section until the video boots. -->
      <video
        class="give__bg"
        muted
        loop
        playsinline
        preload="none"
        poster="/videos/give-bg-poster.jpg"
        data-lazy-src="/videos/give-bg.mp4"
        aria-hidden="true"
      ></video>
      <div class="give__scrim" aria-hidden="true"></div>
      <div class="container give__inner">
        <header class="give__head">
          <p class="eyebrow eyebrow--gold-on-dark">Become a Favor Partner</p>
          <h2 class="give__h2">Pick the partnership that fits your life.</h2>
          <p class="give__lede">Monthly partners are the engine of the movement. Every gift is tax-deductible. Cancel anytime.</p>
        </header>
        <ul class="give__tiers">
          {tiers.map((t) => (
            <li class:list={['give__tier', t.featured && 'give__tier--featured']}>
              {t.featured && <span class="give__tier-flag">Most partners start here</span>}
              <span class="give__tier-amount">{t.amount}</span>
              <span class="give__tier-label">{t.label}</span>
              <p class="give__tier-line">{t.line}</p>
            </li>
          ))}
        </ul>
        <div class="give__final">
          <a class="btn btn--primary btn--large give__cta" href="/give/donate/">Become a Favor Partner <span aria-hidden="true">&rarr;</span></a>
          <p class="give__line">Tax-deductible. ECFA-accredited since 2019. <a href="/give/one-time/">Or give a one-time gift &rarr;</a></p>
        </div>
        <p class="give__fdacs">
          A copy of the official registration and financial information for Favor International, Inc. (CH57842) may be obtained from the Florida Division of Consumer Services by visiting fdacs.gov or calling toll-free 1-800-HELP-FLA (1-800-435-7352) within the state. Registration does not imply endorsement, approval, or recommendation by the State. EIN {SITE.ein}.
        </p>
      </div>
    </section>

    <!-- ====================================================
         6. LIVE FROM THE FIELD: the three newest real stories
         (titles, dates, photos straight from stories.json).
         Proof the work is happening right now.
         ==================================================== -->
    <section class="field-feed" aria-label="The latest stories from the field">
      <div class="container">
        <header class="field-feed__head">
          <p class="eyebrow eyebrow--gold">From the field</p>
          <h2 class="field-feed__h2">The latest stories from the ground.</h2>
        </header>
        <div class="field-feed__grid">
          {latestStories.map((s) => (
            <a class="field-feed__tile" href={`/stories/${s.slug}/`}>
              <div class="field-feed__photo" style={`background-image:url('${s.image}')`} role="img" aria-label={s.title}></div>
              <p class="field-feed__date">{s.date}{s.category ? ` · ${s.category}` : ''}</p>
              <h3>{s.title}</h3>
              <span class="field-feed__more">Read the story &rarr;</span>
            </a>
          ))}
        </div>
        <p class="field-feed__all"><a href="/stories/">All stories from the field &rarr;</a></p>
      </div>
    </section>

  </main>
  <SiteFooter />
</BaseLayout>

<script>
  // Lazy-load the Give-section background video. Attach the real source
  // and start playback only when the section is within 800px of the
  // viewport. Until then the poster JPG covers the section.
  const give = document.querySelector('.give__bg') as HTMLVideoElement | null;
  if (give && 'IntersectionObserver' in window) {
    const src = give.dataset.lazySrc;
    if (src) {
      const io = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            if (!give.querySelector('source')) {
              const s = document.createElement('source');
              s.src = src;
              s.type = 'video/mp4';
              give.appendChild(s);
              give.load();
              give.play().catch(() => { /* autoplay may be blocked; poster stays */ });
            }
            io.disconnect();
          }
        }
      }, { rootMargin: '800px 0px' });
      io.observe(give);
    }
  } else if (give) {
    // Fallback for environments without IntersectionObserver: load it
    const src = give.dataset.lazySrc;
    if (src) {
      const s = document.createElement('source');
      s.src = src;
      s.type = 'video/mp4';
      give.appendChild(s);
      give.load();
      give.play().catch(() => {});
    }
  }
</script>


<style>
  /* ========== SHARED ========== */
  .eyebrow {
    margin: 0 0 var(--space-3) 0;
    font-family: var(--font-sans);
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--color-sage);
  }
  .eyebrow--gold       { color: var(--color-gold-deep); }
  .eyebrow--green      { color: var(--color-green-deep); }
  .eyebrow--gold-on-dark { color: var(--color-gold); }

  /* ========== HERO ========== */
  .hero {
    position: relative;
    min-height: clamp(680px, 96vh, 920px);
    display: flex; align-items: center;
    color: var(--color-white);
    overflow: hidden;
  }
  .hero__video {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    object-position: 50% 50%;
    z-index: 0;
    display: block;
  }
  .hero__scrim {
    position: absolute; inset: 0; z-index: 1;
    background: linear-gradient(90deg,
      rgba(11, 64, 36, 0.96) 0%,
      rgba(11, 64, 36, 0.90) 28%,
      rgba(11, 64, 36, 0.55) 52%,
      rgba(11, 64, 36, 0.10) 72%,
      rgba(11, 64, 36, 0) 100%);
  }
  .hero__inner { position: relative; z-index: 2; width: 100%; padding-top: 120px; padding-bottom: var(--space-12); }
  .hero__copy  { max-width: 740px; }
  .hero__eyebrow {
    margin: 0 0 var(--space-5) 0;
    font-family: var(--font-sans);
    font-size: 0.95rem;
    font-weight: 800;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--color-gold);
  }
  .hero__h1 {
    margin: 0 0 var(--space-6) 0;
    font-family: var(--font-display);
    font-size: clamp(2.6rem, 6vw, 5rem);
    font-weight: 700; line-height: 1.02;
    letter-spacing: -0.02em;
    color: var(--color-white);
    text-wrap: balance;
  }
  .hero__sub {
    margin: 0 0 var(--space-8) 0;
    font-size: clamp(1.05rem, 1.4vw, 1.2rem);
    line-height: 1.6;
    color: color-mix(in srgb, var(--color-white) 92%, transparent);
    max-width: 56ch;
  }
  .hero__cta { display: flex; align-items: center; gap: var(--space-6); flex-wrap: wrap; }
  .hero__primary {
    border-radius: 999px; padding: 20px 36px;
    font-size: 1.05rem; gap: var(--space-3);
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.25);
  }
  .hero__primary:hover { transform: translateY(-2px); box-shadow: 0 22px 48px rgba(0, 0, 0, 0.32); }
  .hero__secondary {
    color: color-mix(in srgb, var(--color-white) 92%, transparent);
    font-size: 0.95rem; font-weight: 600;
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--color-gold) 80%, transparent);
    padding-bottom: 3px;
    transition: color 200ms, border-color 200ms;
  }
  .hero__secondary:hover { color: var(--color-gold); border-color: var(--color-gold); }
  @media (max-width: 900px) {
    .hero__inner { padding-top: 110px; }
    .hero__scrim { background: linear-gradient(180deg, rgba(11,64,36,0.65) 0%, rgba(11,64,36,0.82) 40%, rgba(11,64,36,0.94) 100%); }
  }

  /* ========== 2. PROOF + TRUST ========== */
  .proof { background: var(--color-white); padding: clamp(var(--space-12), 8vw, var(--space-16)) 0; }
  .proof__inner {
    display: flex; flex-direction: column; align-items: center;
    gap: clamp(var(--space-6), 4vw, var(--space-8));
  }
  .proof__stats {
    display: flex; align-items: center; justify-content: center;
    gap: clamp(var(--space-6), 5vw, var(--space-12));
    flex-wrap: wrap;
  }
  .proof__stat { display: flex; flex-direction: column; align-items: center; gap: 6px; text-align: center; }
  .proof__num {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2.4rem, 5vw, 3.8rem);
    color: var(--color-green-deep);
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .proof__label {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--color-gold-deep);
  }
  .proof__divider { width: 1px; height: 56px; background: var(--color-gold); opacity: 0.4; }
  @media (max-width: 700px) { .proof__divider { display: none; } }
  .proof__line {
    margin: 0;
    color: var(--color-ink-soft);
    font-size: 0.95rem;
    text-align: center;
  }
  .proof__line a {
    color: var(--color-green-deep);
    font-weight: 700;
    text-decoration: none;
    border-bottom: 1px solid var(--color-gold);
    padding-bottom: 2px;
  }
  .proof__badges {
    list-style: none; margin: var(--space-4) 0 0 0; padding: 0;
    display: flex; align-items: center; justify-content: center;
    gap: clamp(var(--space-16), 10vw, 120px);
    flex-wrap: wrap;
  }
  .proof__badges img {
    height: 112px; width: auto;
    opacity: 0.9;
    transition: opacity 200ms, transform 200ms;
  }
  .proof__badges a:hover img { opacity: 1; transform: translateY(-3px); }

  /* ========== 4. MISSIONARY STORY ========== */
  .missionary {
    background: var(--color-white);
    padding: clamp(var(--space-20), 11vw, var(--space-24)) 0;
  }
  .missionary__grid {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: clamp(var(--space-12), 8vw, var(--space-20));
    align-items: center;
  }
  @media (max-width: 900px) { .missionary__grid { grid-template-columns: 1fr; } }
  .missionary__photo {
    margin: 0;
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 18px 48px rgba(11, 64, 36, 0.20);
    aspect-ratio: 4 / 5;
  }
  .missionary__photo img {
    width: 100%; height: 100%;
    object-fit: cover;
    display: block;
    /* Ambient drift per Stephanie's 2026-07-31 note: the story box needs
       motion like the hero banner. Off for reduced-motion users. */
    animation: missionary-drift 18s ease-in-out infinite alternate;
    transform-origin: 50% 35%;
  }
  @keyframes missionary-drift {
    from { transform: scale(1); }
    to   { transform: scale(1.07) translateX(-1.4%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .missionary__photo img { animation: none; }
  }
  .missionary__caption {
    position: absolute; left: var(--space-5); bottom: var(--space-5);
    background: rgba(11, 64, 36, 0.85);
    color: var(--color-white);
    padding: 8px 14px;
    border-radius: 999px;
    font-family: var(--font-sans);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  .missionary__h2 {
    margin: 0 0 var(--space-5) 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2rem, 4.4vw, 3.2rem);
    line-height: 1.08;
    color: var(--color-green-deep);
    letter-spacing: -0.018em;
  }
  .missionary__lede {
    margin: 0 0 var(--space-8) 0;
    color: var(--color-ink);
    font-size: 1.08rem;
    line-height: 1.7;
    max-width: 54ch;
  }
  /* Founder teaser: mirrors the missionary band (photo on the opposite
     side, cream background) so the two person-stories read as a pair. */
  .founder {
    background: var(--color-cream);
    padding: clamp(var(--space-20), 11vw, var(--space-24)) 0;
  }
  .founder__grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: clamp(var(--space-12), 8vw, var(--space-20));
    align-items: center;
  }
  @media (max-width: 900px) {
    .founder__grid { grid-template-columns: 1fr; }
    .founder__photo { order: -1; }
  }
  .founder__photo {
    margin: 0;
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 18px 48px rgba(11, 64, 36, 0.20);
    aspect-ratio: 4 / 5;
  }
  .founder__photo img { width: 100%; height: 100%; object-fit: cover; object-position: center top; display: block; }
  .founder__caption {
    position: absolute; left: var(--space-5); bottom: var(--space-5);
    background: rgba(11, 64, 36, 0.85);
    color: var(--color-white);
    padding: 8px 14px;
    border-radius: 999px;
    font-family: var(--font-sans);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  .founder__h2 {
    margin: 0 0 var(--space-5) 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2rem, 4.4vw, 3.2rem);
    line-height: 1.08;
    color: var(--color-green-deep);
    letter-spacing: -0.018em;
  }
  .founder__lede {
    margin: 0 0 var(--space-5) 0;
    color: var(--color-ink);
    font-size: 1.08rem;
    line-height: 1.7;
    max-width: 54ch;
  }
  .founder__quote {
    margin: 0 0 var(--space-6) 0;
    padding: var(--space-4) 0 var(--space-4) var(--space-8);
    border-left: 3px solid var(--color-gold);
  }
  .founder__quote p {
    margin: 0 0 var(--space-3) 0;
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 600;
    font-size: clamp(1.15rem, 2.2vw, 1.5rem);
    line-height: 1.35;
    color: var(--color-green-deep);
  }
  .founder__quote footer {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-gold-deep);
  }
  .founder__cta { margin-top: var(--space-3); }
  .founder__read {
    display: inline-block;
    margin-left: var(--space-6);
    color: var(--color-green);
    font-weight: 700;
    text-decoration: none;
    border-bottom: 2px solid var(--color-gold);
    padding-bottom: 2px;
  }
  .founder__read:hover { color: var(--color-gold-deep); }
  @media (max-width: 560px) { .founder__read { margin-left: 0; margin-top: var(--space-4); display: block; width: fit-content; } }

  .missionary__carole {
    margin: 0 0 var(--space-8) 0;
    padding: var(--space-4) 0 var(--space-4) var(--space-8);
    border-left: 3px solid var(--color-gold);
  }
  .missionary__carole-quote {
    margin: 0 0 var(--space-3) 0;
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 600;
    font-size: clamp(1.3rem, 2.6vw, 1.85rem);
    line-height: 1.3;
    color: var(--color-green-deep);
  }
  .missionary__carole-attr {
    display: flex; flex-direction: column; gap: 2px;
  }
  .missionary__carole-name {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--color-gold-deep);
  }
  .missionary__carole-role {
    font-family: var(--font-sans);
    font-size: 0.82rem;
    color: var(--color-sage);
    font-style: italic;
  }
  .missionary__cta {
    border-radius: 999px;
    padding: 18px 32px;
    font-size: 1rem;
    box-shadow: 0 12px 28px rgba(11, 64, 36, 0.18);
  }
  .missionary__cta:hover { transform: translateY(-2px); box-shadow: 0 16px 36px rgba(11, 64, 36, 0.25); }
  .missionary__read {
    display: inline-block;
    margin-top: var(--space-4);
    margin-left: var(--space-5);
    color: var(--color-green-deep);
    text-decoration: none;
    font-weight: 700;
    font-size: 0.92rem;
    border-bottom: 1px solid var(--color-gold);
    padding-bottom: 2px;
  }
  .missionary__read:hover { color: var(--color-gold-deep); }

  /* ========== 5. GIVE ========== */
  .give {
    position: relative;
    background: var(--color-green-deep);
    color: var(--color-white);
    padding: clamp(var(--space-20), 12vw, var(--space-24)) 0;
    overflow: hidden;
    isolation: isolate;
  }
  .give__bg {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    object-position: 50% 50%;
    z-index: 0;
    display: block;
  }
  /* Green tint overlay so the video is visible but the dollar tiers and
     CTA still read clearly. Adjustable: bump opacity if buttons feel weak. */
  .give__scrim {
    position: absolute; inset: 0;
    z-index: 1;
    /* ~20% green over the video as Danny requested. Slightly heavier
       at the top/bottom edges so the section blends into the green
       divider above and the dark footer below. */
    background: linear-gradient(
      180deg,
      rgba(11, 64, 36, 0.45) 0%,
      rgba(11, 64, 36, 0.20) 35%,
      rgba(11, 64, 36, 0.20) 65%,
      rgba(11, 64, 36, 0.55) 100%
    );
    pointer-events: none;
  }
  .give__inner {
    position: relative;
    z-index: 2;
    display: flex; flex-direction: column;
    gap: clamp(var(--space-12), 6vw, var(--space-16));
  }
  .give__head { text-align: center; max-width: 700px; margin: 0 auto; padding-top: var(--space-8); }
  .give__h2 {
    margin: var(--space-3) 0 var(--space-3) 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2rem, 4.4vw, 3.2rem);
    line-height: 1.08;
    color: var(--color-white);
    letter-spacing: -0.018em;
  }
  .give__lede {
    margin: 0;
    color: color-mix(in srgb, var(--color-white) 80%, transparent);
    font-size: 1rem;
    line-height: 1.6;
  }
  .give__tiers {
    list-style: none; padding: 0; margin: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(var(--space-8), 3vw, var(--space-12));
  }
  @media (max-width: 900px) { .give__tiers { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .give__tiers { grid-template-columns: 1fr; } }
  .give__tier {
    position: relative;
    display: flex; flex-direction: column; gap: var(--space-2);
    padding: var(--space-6);
    /* Dark translucent so the cards read as defined boxes against
       the savanna video, instead of barely-visible white overlays. */
    background: rgba(0, 0, 0, 0.32);
    border: 1px solid color-mix(in srgb, var(--color-gold) 25%, transparent);
    border-radius: 14px;
    transition: transform 200ms, border-color 200ms, background 200ms;
    backdrop-filter: blur(2px);
  }
  .give__tier:hover {
    transform: translateY(-3px);
    border-color: var(--color-gold);
    background: rgba(0, 0, 0, 0.50);
  }
  .give__tier--featured {
    background: rgba(0, 0, 0, 0.45);
    border-color: var(--color-gold);
    box-shadow: 0 16px 40px rgba(225, 167, 48, 0.25);
  }
  .give__tier-flag {
    position: absolute;
    top: -10px; right: var(--space-4);
    background: var(--color-gold);
    color: var(--color-green-deep);
    font-family: var(--font-sans);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    padding: 4px 12px;
    border-radius: 999px;
  }
  .give__tier-amount {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.8rem, 3.4vw, 2.4rem);
    color: var(--color-white);
    line-height: 1;
  }
  .give__tier-label {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--color-gold);
  }
  .give__tier-line {
    margin: 4px 0 0 0;
    font-size: 0.92rem;
    line-height: 1.55;
    color: color-mix(in srgb, var(--color-white) 82%, transparent);
  }
  .give__final {
    display: flex; flex-direction: column; align-items: center; gap: var(--space-4);
  }
  .give__cta {
    border-radius: 999px;
    padding: 20px 36px;
    font-size: 1.05rem;
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.32);
  }
  .give__cta:hover { transform: translateY(-2px); box-shadow: 0 22px 48px rgba(0, 0, 0, 0.40); }
  .give__line {
    margin: 0;
    color: color-mix(in srgb, var(--color-white) 78%, transparent);
    font-size: 0.9rem;
    text-align: center;
  }
  .give__line a {
    color: var(--color-gold);
    text-decoration: none;
    font-weight: 700;
    border-bottom: 1px solid color-mix(in srgb, var(--color-gold) 60%, transparent);
    padding-bottom: 1px;
    margin-left: var(--space-3);
  }
  /* ---------- 2b. Mission ---------- */
  .mission { background: var(--color-cream); padding: clamp(var(--space-16), 10vw, var(--space-20)) 0; }
  .mission__inner { max-width: 880px; margin: 0 auto; text-align: center; }
  .mission__h2 {
    margin: var(--space-4) 0 var(--space-6);
    font-family: var(--font-display); font-weight: 700;
    font-size: clamp(2.1rem, 4.8vw, 3.4rem); line-height: 1.08;
    color: var(--color-green-deep); letter-spacing: -0.018em; text-wrap: balance;
  }
  .mission__text { margin: 0 auto var(--space-6); max-width: 72ch; color: var(--color-ink-soft); line-height: 1.8; }
  .mission__link { color: var(--color-green); font-weight: 700; text-decoration: none; border-bottom: 2px solid var(--color-gold); padding-bottom: 2px; }
  .mission__link:hover { color: var(--color-gold-deep); }

  .give__fdacs {
    margin: 0 auto;
    max-width: 920px;
    font-size: 0.74rem;
    line-height: 1.6;
    color: color-mix(in srgb, var(--color-white) 55%, transparent);
    text-align: center;
  }

  /* ---------- 3b. The four pillars: open columns, hairline separators,
       green icon medallions. No boxes. ---------- */
  .pillars { background: var(--color-white); padding: clamp(var(--space-16), 10vw, var(--space-24)) 0; }
  .pillars__head { text-align: center; max-width: 640px; margin: 0 auto clamp(56px, 6vw, 88px); }
  .pillars__h2 {
    margin: var(--space-4) 0 var(--space-4);
    font-family: var(--font-display); font-weight: 700;
    font-size: clamp(2rem, 4.4vw, 3.2rem); line-height: 1.08;
    color: var(--color-green-deep); letter-spacing: -0.018em;
  }
  .pillars__lede { margin: 0; color: var(--color-ink-soft); line-height: 1.7; }
  .pillars__row { display: grid; grid-template-columns: repeat(4, 1fr); }
  .pillars__col {
    display: flex; flex-direction: column; align-items: center; text-align: center;
    padding: var(--space-2) clamp(20px, 2.4vw, 40px);
    text-decoration: none; color: inherit;
  }
  .pillars__col + .pillars__col { border-left: 1px solid rgba(11, 64, 36, 0.12); }
  .pillars__icon {
    display: inline-flex; align-items: center; justify-content: center;
    width: 64px; height: 64px; border-radius: 50%;
    background: color-mix(in srgb, var(--color-green) 9%, var(--color-white));
    color: var(--color-green);
    margin-bottom: var(--space-5);
    transition: background 200ms ease, color 200ms ease;
  }
  .pillars__col:hover .pillars__icon { background: var(--color-green); color: var(--color-white); }
  .pillars__icon svg { width: 28px; height: 28px; }
  .pillars__col h3 { margin: 0 0 var(--space-3); font-size: 1.08rem; color: var(--color-green-deep); line-height: 1.3; }
  .pillars__col p { margin: 0 0 var(--space-4); font-size: 0.92rem; line-height: 1.65; color: var(--color-ink-soft); max-width: 30ch; }
  .pillars__more { margin-top: auto; font-weight: 700; font-size: 0.85rem; color: var(--color-gold-deep); }
  .pillars__col:hover .pillars__more { color: var(--color-green); }
  @media (max-width: 1024px) {
    .pillars__row { grid-template-columns: repeat(2, 1fr); row-gap: 40px; }
    .pillars__col:nth-child(3) { border-left: 0; }
  }
  @media (max-width: 560px) {
    .pillars__row { grid-template-columns: 1fr; row-gap: var(--space-8); }
    .pillars__col + .pillars__col { border-left: 0; border-top: 1px solid rgba(11, 64, 36, 0.12); padding-top: var(--space-8); }
  }

  /* ---------- 4c. Why indigenous leadership: deep green with a night
       crusade photo blended underneath. ---------- */
  .whyind { position: relative; isolation: isolate; background: var(--color-green-deep); padding: clamp(var(--space-16), 11vw, var(--space-24)) 0; overflow: hidden; }
  .whyind__photo {
    position: absolute; inset: 0; z-index: 0;
    background-image: url('/images/story-anaka-crusade.jpg');
    background-size: cover; background-position: center;
    opacity: 0.38; mix-blend-mode: luminosity;
    pointer-events: none;
  }
  .whyind::after {
    content: ''; position: absolute; inset: 0; z-index: 1; pointer-events: none;
    background: linear-gradient(to bottom,
      color-mix(in srgb, var(--color-green-deep) 88%, transparent),
      color-mix(in srgb, var(--color-green-deep) 62%, transparent) 55%,
      color-mix(in srgb, var(--color-green-deep) 88%, transparent));
  }
  .whyind__inner { position: relative; z-index: 2; }
  .whyind__head { max-width: 780px; margin: 0 auto clamp(56px, 6vw, 88px); text-align: center; }
  .whyind__h2 {
    margin: var(--space-4) 0 var(--space-5);
    font-family: var(--font-display); font-weight: 700;
    font-size: clamp(2rem, 4.4vw, 3.2rem); line-height: 1.1;
    color: var(--color-white); letter-spacing: -0.018em; text-wrap: balance;
  }
  .whyind__lede { margin: 0 auto; max-width: 56ch; color: color-mix(in srgb, var(--color-white) 80%, transparent); line-height: 1.7; }
  .whyind__verse { margin: var(--space-5) auto 0; max-width: 62ch; font-family: var(--font-display); font-style: italic; font-size: 1.02rem; line-height: 1.6; color: var(--color-gold); }
  .whyind__verse span { display: block; margin-top: var(--space-2); font-family: var(--font-sans); font-style: normal; font-size: 0.72rem; font-weight: 800; letter-spacing: 0.22em; text-transform: uppercase; color: color-mix(in srgb, var(--color-white) 62%, transparent); }
  .whyind__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(32px, 4.5vw, 56px); max-width: 1060px; margin: 0 auto; }
  @media (max-width: 860px) { .whyind__grid { grid-template-columns: 1fr; gap: var(--space-8); } }
  .whyind__point { border-top: 2px solid color-mix(in srgb, var(--color-gold) 60%, transparent); padding-top: var(--space-5); }
  .whyind__num { font-family: var(--font-display); font-size: 1rem; font-weight: 700; color: var(--color-gold); letter-spacing: 0.08em; }
  .whyind__point h3 { margin: var(--space-3) 0; color: var(--color-white); font-size: 1.15rem; }
  .whyind__point p { margin: 0; color: color-mix(in srgb, var(--color-white) 76%, transparent); line-height: 1.7; font-size: 0.97rem; }
  .whyind__quote { margin: clamp(48px, 8vw, 72px) auto 0; max-width: 680px; text-align: center; }
  .whyind__quote p {
    margin: 0 0 var(--space-5);
    font-family: var(--font-script); font-weight: 600;
    font-size: clamp(1.7rem, 3.6vw, 2.5rem); line-height: 1.25;
    color: var(--color-gold);
  }
  .whyind__quote footer { font-size: 0.78rem; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: color-mix(in srgb, var(--color-white) 62%, transparent); }

  /* ---------- 4d. Pray or Go: full-bleed photo diptych, text over the
       image. No cards. ---------- */
  .onramps { display: grid; grid-template-columns: 1fr 1fr; }
  @media (max-width: 860px) { .onramps { grid-template-columns: 1fr; } }
  .onramp {
    position: relative; isolation: isolate; display: flex; align-items: flex-end;
    min-height: clamp(420px, 46vw, 560px);
    background-size: cover; background-position: center;
    text-decoration: none; color: var(--color-white);
    overflow: hidden;
  }
  .onramp::before {
    content: ''; position: absolute; inset: 0; z-index: 0;
    background: inherit; background-size: cover; background-position: center;
  }
  .onramp__scrim {
    position: absolute; inset: 0; z-index: 1;
    background: linear-gradient(to top,
