---
import RedesignLayout from '../../layouts/RedesignLayout.astro';
import PageHero from '../../components/band/PageHero.astro';
import RdFeature from '../../components/redesign/RdFeature.astro';
import LeafHeading from '../../components/redesign/LeafHeading.astro';
import RdCta from '../../components/redesign/RdCta.astro';
import FundraiseUp from '../../components/give/FundraiseUp.astro';
import DonationForm from '../../components/give/DonationForm.astro';
import StateSolicitationDisclosures from '../../components/give/StateSolicitationDisclosures.astro';
import { SITE } from '../../lib/site';

const TRUSTBRIDGE_PORTAL = 'https://portal.trustbridgeglobal.com/public/donate?id=aa3417c3d39a48f483399acb657e3072';

const routes = [
  { flag: '🇬🇧', country: 'United Kingdom', route: 'Gift Aid eligible via TrustBridge UK', cta: 'Give via TrustBridge', href: TRUSTBRIDGE_PORTAL },
  { flag: '🇨🇦', country: 'Canada', route: 'CRA tax receipt via TrustBridge Canada', cta: 'Give via TrustBridge', href: TRUSTBRIDGE_PORTAL },
  { flag: '🇪🇺', country: 'European Union', route: 'TGE network via TrustBridge', cta: 'Give via TrustBridge', href: TRUSTBRIDGE_PORTAL },
  { flag: '🇦🇺', country: 'Australia', route: 'DGR via partner foundation', cta: 'Email us', href: `mailto:${SITE.emailGeneral}?subject=Australia giving` },
];
const internationalFaqs = [
  { q: 'Will I receive a local tax receipt?', a: 'Fundraise Up cannot issue a tax receipt in your country. TrustBridge may issue a local receipt for the UK, Canada, or the EU, depending on the portal and your circumstances. Confirm eligibility in TrustBridge or with a qualified local adviser before relying on a deduction.' },
  { q: 'Can I give from a country not listed below?', a: 'Yes. Use Fundraise Up, or the U.S. form if you can send dollars. If you need a local tax receipt and your country is not listed, email us and we will check whether a partner can issue one.' },
  { q: 'Can an international gift be monthly?', a: 'Recurring options depend on the processor. Review what Fundraise Up or TrustBridge shows after you open the form.' },
  { q: 'Can I designate an international gift?', a: 'Sometimes, depending on the active project and processing route. Email us before you give and we will confirm the current project name and designation instructions with you.' },
  { q: 'Who handles currency conversion and processing fees?', a: 'The payment platform and the banks in the route set conversion and processing. Read the current transaction information in the form before you submit.' },
  { q: 'Who should I contact if the form information conflicts with this page?', a: `If anything here differs from the giving form, trust the form, and email ${SITE.emailGeneral} so we can fix this page.` },
];
---
<RedesignLayout
  title="International Giving"
  description="Give to Favor International from outside the United States. Use the U.S. form if you can. If you cannot, give through Fundraise Up in your currency. TrustBridge is for larger gifts that need a local tax receipt."
>
  <PageHero
    label="International giving"
    title="Give from anywhere in the world."
    promise="Use the U.S. form when you can send dollars. Otherwise give through Fundraise Up in your currency. Favor receives those gifts as they come in. TrustBridge is for larger gifts that need a UK, Canada, or EU tax receipt."
    image="/images/field-2026/pbs-8.webp"
    imageAlt="PBS graduation"
    ctaLabel="Give now"
    ctaHref="#give-options"
    secondaryLabel="Give in U.S. dollars"
    secondaryHref="#usd"
  />

  <section class="band band--cream band--tight" id="give-options">
    <div class="container">
      <LeafHeading
        label="How to give"
        title="Give in U.S. dollars if you can."
      >
        <p>If you have a U.S. card or a way to send dollars, use the U.S. form. If you need to give in another currency, use Fundraise Up, pick that currency, and give there. Favor receives those gifts as they come in.</p>
        <p>Use TrustBridge only for a larger gift that needs a UK, Canada, or EU tax receipt. TrustBridge holds funds until a payout minimum is met, so smaller gifts sit there instead of reaching the field.</p>
      </LeafHeading>
      <div class="intl-stage" data-route="fru" id="intl-stage">
        <div class="intl-opts" role="tablist" aria-label="Giving options">
          <button type="button" class="intl-opt" role="tab" id="tab-fru" data-route="fru" aria-selected="true" aria-controls="panel-fru">
            <span class="intl-opt__kicker">Arrives now</span>
            <span class="intl-opt__title">Fundraise Up</span>
          </button>
          <button type="button" class="intl-opt" role="tab" id="tab-tb" data-route="tb" aria-selected="false" aria-controls="trustbridge">
            <span class="intl-opt__kicker">Large gifts</span>
            <span class="intl-opt__title">TrustBridge</span>
          </button>
          <button type="button" class="intl-opt" role="tab" id="tab-usd" data-route="usd" aria-selected="false" aria-controls="usd">
            <span class="intl-opt__kicker">If you can</span>
            <span class="intl-opt__title">U.S. dollars</span>
          </button>
        </div>

        <div class="intl-deck">
          <div class="intl-panel intl-panel--fru" id="panel-fru" role="tabpanel" aria-labelledby="tab-fru">
            <FundraiseUp />
            <p class="intl-legal"><strong>Tax receipt.</strong> Fundraise Up cannot issue a tax receipt in your country.</p>
          </div>
          <div class="intl-panel intl-panel--tb" id="trustbridge" role="tabpanel" aria-labelledby="tab-tb">
            <div class="intl-grid">
              {routes.map((r) => (
                <a class="intl-card" href={r.href} target="_blank" rel="noopener">
                  <span class="intl-card__flag" aria-hidden="true">{r.flag}</span>
                  <span class="intl-card__country">{r.country}</span>
                  <span class="intl-card__route">{r.route}</span>
                  <span class="intl-card__cta">{r.cta} &rarr;</span>
                </a>
              ))}
            </div>
            <p class="intl-note">Confirm eligibility in TrustBridge or with a local adviser before relying on a deduction. If your country is not listed, email <a href={`mailto:${SITE.emailGeneral}`}>{SITE.emailGeneral}</a>.</p>
          </div>
          <div class="intl-panel intl-panel--usd" id="usd" role="tabpanel" aria-labelledby="tab-usd">
            <DonationForm />
            <StateSolicitationDisclosures />
          </div>
        </div>
      </div>
    </div>
  </section>

  <RdFeature
    image="/images/field-2026/pbs-9.webp"
    imageAlt="Portable Bible School students"
    eyebrow="Where it goes"
    heading="Same field, same accountability."
    side="left"
    background="white"
  >
    <p>International gifts fund the same work as US gifts: Portable Bible Schools, GIFT homes, schools, medical care, and women&rsquo;s empowerment across the nations Favor serves.</p>
    <p>Favor International is ECFA-accredited and independently audited every year. See the <a href="/about/accountability/">audited financials</a> any time.</p>
  </RdFeature>

  <section class="band band--cream"><div class="container intl-confirm">
    <img class="intl-confirm__image" src="/images/field-2026/missionaries-5.webp" alt="Favor field leaders serving across nations" loading="lazy" />
    <div class="intl-confirm__copy">
      <LeafHeading label="Before you give" title="If you need a tax receipt, check it first." intro="Fundraise Up cannot issue a tax receipt in your country. TrustBridge may, in the UK, Canada, or the EU. On a large gift, ask a local adviser how it will be treated." align="left" leaves={false} />
      <ol class="intl-steps"><li><strong>Processor</strong><span>Fundraise Up cannot issue a local tax receipt. TrustBridge may, for the UK, Canada, or the EU. Confirm Favor International is the selected beneficiary.</span></li><li><strong>Receipt</strong><span>Check which organization will issue the receipt and whether it applies in the country where you file taxes.</span></li><li><strong>Advice</strong><span>On a large gift, ask a qualified local adviser how the contribution is treated where you file taxes.</span></li></ol>
    </div>
  </div></section>

  <section class="band band--white"><div class="container container--narrow">
    <LeafHeading label="Questions" title="Giving across borders." leaves={false} />
    <div class="faq intl-faq">{internationalFaqs.map((item) => <details><summary>{item.q}</summary><p>{item.a}</p></details>)}</div>
  </div></section>

  <RdCta
    heading="Give in dollars if you can."
    body="If you need another currency, use Fundraise Up. Favor receives those gifts as they come in."
    ctaLabel="Give now"
    ctaHref="#give-options"
    secondaryLabel="Give in U.S. dollars"
    secondaryHref="#usd"
    image="/images/field-2026/pbs-8.webp"
    imageAlt="Portable Bible School graduates in the field"
  />
</RedesignLayout>

<script>
  const stage = document.getElementById('intl-stage');
  if (stage) {
    const buttons = Array.from(stage.querySelectorAll<HTMLButtonElement>('button[data-route]'));
    const hashes: Record<string, string> = { tb: '#trustbridge', usd: '#usd', fru: '#give-options' };

    const routeFromHash = (hash: string) => {
      if (hash === '#trustbridge') return 'tb';
      if (hash === '#usd') return 'usd';
      return 'fru';
    };

    const show = (route: string, writeHash = false) => {
      stage.dataset.route = route;
      stage.classList.add('is-ready');
      buttons.forEach((btn) => {
        const on = btn.dataset.route === route;
        btn.setAttribute('aria-selected', on ? 'true' : 'false');
      });
      if (writeHash) {
        const next = hashes[route] || '#give-options';
        if (window.location.hash !== next) history.replaceState(null, '', next);
      }
    };

    stage.addEventListener('click', (event) => {
      const btn = (event.target as HTMLElement | null)?.closest('button[data-route]');
      if (!btn) return;
      show(btn.dataset.route || 'fru', true);
    });

    window.addEventListener('hashchange', () => show(routeFromHash(window.location.hash)));
    show(routeFromHash(window.location.hash));
  }
</script>

<style>
  #give-options :global(.band__header) { margin-bottom: var(--space-6); }

  .intl-stage {
    max-width: 42rem;
    margin: 0 auto;
  }
  .intl-stage[data-route='fru'] { max-width: 25rem; }
  .intl-stage[data-route='tb'],
  .intl-stage[data-route='usd'] {
    background: var(--color-white);
    border: 1px solid rgba(31, 58, 26, 0.12);
    border-radius: var(--radius-card);
    box-shadow: 0 2px 10px rgba(31, 58, 26, 0.05);
    overflow: hidden;
  }

  .intl-opts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 4px;
    margin: 0;
    padding: 4px;
    background: var(--color-white);
    border: 1px solid rgba(31, 58, 26, 0.12);
    border-radius: var(--radius-card);
    box-shadow: 0 2px 10px rgba(31, 58, 26, 0.05);
  }
  .intl-stage[data-route='tb'] .intl-opts,
  .intl-stage[data-route='usd'] .intl-opts {
    border: 0;
    border-bottom: 1px solid var(--color-border);
    border-radius: 0;
    box-shadow: none;
    background: var(--color-cream);
  }
  .intl-opt {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    text-align: center;
    background: transparent;
    border: 0;
    border-radius: 12px;
    padding: 10px 8px;
    box-shadow: none;
    cursor: pointer;
    color: inherit;
    font: inherit;
  }
  .intl-opt:hover { background: var(--color-cream); }
  .intl-opt:focus-visible {
    outline: 2px solid var(--color-gold);
    outline-offset: 1px;
  }
  .intl-opt[aria-selected='true'] {
    background: var(--color-cream);
  }
  .intl-stage[data-route='tb'] .intl-opt[aria-selected='true'],
  .intl-stage[data-route='usd'] .intl-opt[aria-selected='true'] {
    background: var(--color-white);
  }
  .intl-opt__kicker {
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--color-gold-deep);
  }
  .intl-opt__title {
    font-family: var(--font-sans);
    font-weight: 800;
    font-size: 0.95rem;
    line-height: 1.2;
    color: var(--color-green);
  }
  .intl-stage[data-route='fru'] .intl-opt__kicker { display: none; }
  .intl-deck { padding: 8px 0 0; }

  .intl-stage[data-route='tb'] .intl-deck,
  .intl-stage[data-route='usd'] .intl-deck {
    padding: var(--space-4);
    margin: 0;
    background: transparent;
    border: 0;
    box-shadow: none;
    border-radius: 0;
  }

  .intl-panel { display: none; }
  .intl-stage[data-route='fru'] .intl-panel--fru,
  .intl-stage[data-route='tb'] .intl-panel--tb,
  .intl-stage[data-route='usd'] .intl-panel--usd {
    display: block;
  }
  .intl-legal {
    margin: var(--space-3) auto 0;
    max-width: 36rem;
    padding: 0;
    border: 0;
    text-align: center;
    font-size: 0.8rem;
    line-height: 1.5;
    color: var(--color-ink-soft);
  }
  .intl-legal strong {
    display: inline;
    margin: 0;
    font-size: inherit;
    letter-spacing: 0;
    text-transform: none;
    color: var(--color-green);
  }

  .intl-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-3); }
  .intl-panel--usd :global(.dform__progress) { margin-bottom: var(--space-4); }
  .intl-panel--usd :global(.dform__state) { padding: var(--space-3) 0; }
  @media (max-width: 540px) {
    .intl-opt { padding: 10px 4px; }
    .intl-opt__kicker { display: none; }
    .intl-opt__title { font-size: 0.82rem; }
    .intl-grid { grid-template-columns: 1fr; }
  }
  .intl-card {
    display: flex; flex-direction: column; align-items: center; text-align: center; gap: 4px;
    background: var(--color-cream); border: 1px solid var(--color-border); border-radius: var(--radius-card);
    padding: var(--space-5) var(--space-4);
    text-decoration: none; color: inherit;
    transition: border-color 180ms, background 180ms;
  }
  .intl-card:hover { border-color: var(--color-gold); background: var(--color-white); }
  .intl-card__flag { font-size: 1.8rem; line-height: 1; }
  .intl-card__country { font-family: var(--font-sans); font-weight: 800; font-size: 1.05rem; color: var(--color-green); }
  .intl-card__route { color: var(--color-ink-soft); line-height: 1.45; font-size: 0.85rem; }
  .intl-card__cta { margin-top: 4px; color: var(--color-gold-deep); font-weight: 700; font-size: 0.85rem; }
  .intl-card:hover .intl-card__cta { color: var(--color-green); }
  .intl-grid + .intl-note {
    display: block;
    margin: var(--space-4) 0 0;
    padding: 0;
    max-width: none;
    text-align: center;
    font-size: 0.85rem;
    line-height: 1.55;
    color: var(--color-ink-soft);
  }
  .intl-note a { color: var(--color-gold-deep); font-weight: 700; }
  .intl-confirm { display:grid; grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr); gap:clamp(44px,7vw,104px); align-items:center; }
  .intl-confirm__image { display:block; width:100%; min-height:620px; height:100%; object-fit:cover; border-radius:var(--rd-radius); }
  .intl-steps { list-style: none; padding: 0; margin: 0; display: grid; gap: var(--space-4); }
  .intl-steps li { display: grid; grid-template-columns: 100px 1fr; gap: var(--space-5); padding: var(--space-5); border-radius: var(--rd-radius); background: var(--color-white); box-shadow: var(--rd-shadow); }
  .intl-steps strong { color: var(--color-green); }
  .intl-steps span, .intl-faq p { color: var(--color-ink-soft); line-height: 1.65; }
  .intl-faq { display: grid; gap: var(--space-3); }
  .intl-faq details { padding: var(--space-5) var(--space-6); border: 1px solid rgba(31,58,26,.12); border-radius: var(--rd-radius); }
  .intl-faq summary { cursor: pointer; color: var(--color-green); font-weight: 800; }
  .intl-faq p { margin: var(--space-4) 0 0; }
  @media (max-width: 860px) { .intl-confirm { grid-template-columns:1fr; } .intl-confirm__image { min-height:0; aspect-ratio:16/10; } }
  @media (max-width: 560px) { .intl-steps li { grid-template-columns: 1fr; gap: var(--space-2); } }
</style>
