---
import RedesignLayout from '../../layouts/RedesignLayout.astro';
import PageHero from '../../components/band/PageHero.astro';
import PostCard from '../../components/band/PostCard.astro';
import LeafHeading from '../../components/redesign/LeafHeading.astro';
import RdCta from '../../components/redesign/RdCta.astro';

const projects = [
  { category: 'Evangelism', name: 'Portable Bible Schools', image: '/images/hero-pbs-graduation.jpg', summary: 'Help carry discipleship training and Bible teaching into rural villages and unreached tribes.' },
  { category: 'Education', name: 'Schools and learning centers', image: '/images/field-2026/education-5.webp', summary: 'Support Village Learning Centers, primary and secondary schools, and leadership training.' },
  { category: 'Community', name: 'Medical care and trauma healing', image: '/images/field-2026/medical-2.webp', summary: 'Help field teams meet physical and emotional needs through clinics and contextualized counseling.' },
  { category: 'Empowerment', name: 'Women and vocational programs', image: '/images/field-2026/women-4.webp', summary: 'Equip women and young adults with training, practical skills, and tools that can produce lasting income.' },
];
const projectSteps = [
  { n: '1', title: 'Choose an area', body: 'Start with the ministry area you want to support: evangelism, education, community care, or economic empowerment.' },
  { n: '2', title: 'Confirm the current need', body: 'Ask the Favor team which project is active, where it is located, and what remains to be funded.' },
  { n: '3', title: 'Receive the giving route', body: 'The team can provide the correct designation language and secure giving path for that project.' },
  { n: '4', title: 'Follow the work', body: 'Ask what reporting or field updates are available and how gifts are handled if the original need becomes fully funded.' },
];
const projectFaqs = [
  { q: 'Why are live project balances not published here?', a: 'Field needs and received gifts can change quickly. Favor should confirm the current balance before a donor relies on a progress figure or makes a restricted gift.' },
  { q: 'Can I designate a gift to one program?', a: 'Designated giving may be available when Favor has an active approved project. Contact the team for the current project name and the correct way to record the designation.' },
  { q: 'What if the project becomes fully funded?', a: 'Ask Favor how excess designated funds would be handled before giving. The answer may depend on the project and the language used in the gift agreement.' },
  { q: 'Can a foundation or church fund a project?', a: 'Yes, those conversations can begin through the foundation or church-partnership pathways. The team can provide the appropriate documentation and current project information.' },
  { q: 'What if I do not need the gift restricted?', a: 'An unrestricted one-time gift or monthly partnership gives field leadership more flexibility to address changing needs without being limited to one project budget.' },
  { q: 'Will every project provide the same reporting?', a: 'No. Reporting depends on the project, grant agreement, duration, and information available from the field. Confirm expectations before making a material designated gift.' },
];
---
<RedesignLayout
  title="Specific Project"
  description="Fund a specific Favor International project directly. School buildings, dormitories, Bible curriculum, off-grid power."
>
  <PageHero
    label="Specific project"
    title="Fund the exact thing the field needs."
    promise="Tell the team which area of the work you want to support, and confirm the current field need before you give."
    image="/images/field/hero-construction-uganda.webp"
    imageAlt="A Favor church under construction in Uganda"
    variant="split"
  />

  <section class="band band--white">
    <div class="container">
      <LeafHeading label="Areas you can support" title="Start with the work God has put on your heart." intro="Project needs and funding balances change in the field. These established ministry areas are the starting point for a current, verified project conversation." />
      <div class="proj-grid">
        {projects.map((p) => (
          <PostCard
            href="/about/contact/?topic=specific-project"
            image={p.image}
            imageAlt={p.name}
            chip={p.category}
            title={p.name}
            desc={p.summary}
            actionLabel="Ask about current needs"
          />
        ))}
      </div>
    </div>
  </section>

  <section class="band band--cream">
    <div class="container">
      <LeafHeading label="How designation works" title="Four steps keep the project clear." intro="A short conversation before giving protects both the donor’s intent and the field team’s ability to report accurately." />
      <ol class="project-steps">{projectSteps.map((item) => <li class="rd-card reveal"><span>{item.n}</span><h3>{item.title}</h3><p>{item.body}</p></li>)}</ol>
    </div>
  </section>

  <section class="band band--white">
    <div class="container container--narrow">
      <LeafHeading label="Questions" title="Before you designate a gift." leaves={false} />
      <div class="faq project-faq">{projectFaqs.map((item) => <details><summary>{item.q}</summary><p>{item.a}</p></details>)}</div>
    </div>
  </section>

  <RdCta
    heading="Confirm the need before you designate the gift."
    body="The team will share the current project, location, funding status, and appropriate giving route so your designation is clear."
    ctaLabel="Ask about a project"
    ctaHref="/about/contact/?topic=specific-project"
    secondaryLabel="Give where most needed"
    secondaryHref="/give/one-time/"
    image="/images/field-2026/education-5.webp"
    imageAlt="A Favor school under construction"
  />
</RedesignLayout>

<style>
  .proj-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-8); }
  @media (max-width: 800px) { .proj-grid { grid-template-columns: 1fr; } }
  .proj-card {
    display: flex; flex-direction: column;
    background: var(--color-white);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-soft);
    overflow: hidden;
    text-decoration: none; color: inherit;
    transition: transform 180ms, box-shadow 180ms;
  }
  .proj-card:hover { transform: translateY(-3px); box-shadow: var(--shadow-card); }
  .proj-card__photo { position: relative; aspect-ratio: 16 / 9; background-size: cover; background-position: center; background-color: var(--color-sage-light); }
  .proj-card__chip {
    position: absolute; top: var(--space-3); left: var(--space-3);
    background: color-mix(in srgb, var(--color-white) 92%, transparent);
    color: var(--color-green-deep);
    padding: 6px 14px; border-radius: var(--radius-pill);
    font-size: 0.7rem; font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase;
    backdrop-filter: blur(2px);
  }
  .proj-card__body { padding: var(--space-6); display: flex; flex-direction: column; gap: var(--space-3); flex: 1; }
  .proj-card h3 { margin: 0; font-size: 1.4rem; color: var(--color-green); line-height: 1.2; }
  .proj-card p { margin: 0; font-size: 0.95rem; color: var(--color-ink-soft); }
  .proj-card__progress { height: 8px; background: var(--color-sage-light); border-radius: 999px; overflow: hidden; }
  .proj-card__bar { height: 100%; width: var(--pct); background: var(--color-gold); border-radius: 999px; }
  .proj-card__foot { margin-top: auto; padding-top: var(--space-2); display: flex; justify-content: space-between; align-items: center; gap: var(--space-4); }
  .proj-card__meta { display: flex; flex-direction: column; line-height: 1.2; }
  .proj-card__meta-label { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.12em; color: var(--color-sage); font-weight: 700; }
  .proj-card__meta strong { color: var(--color-green); font-size: 1.25rem; }
  .proj-card__goal { font-size: 0.78rem; color: var(--color-sage); }
  .proj-card__btn {
    background: var(--color-green); color: var(--color-white);
    padding: 11px 20px; border-radius: var(--radius-pill);
    font-weight: 700; font-size: 0.85rem; white-space: nowrap;
    transition: background 140ms;
  }
  .proj-card:hover .proj-card__btn { background: var(--color-green-deep); }
  .project-steps { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-5); }
  .project-steps span { color: var(--color-gold-deep); font-weight: 800; }
  .project-steps h3 { color: var(--color-green); margin: var(--space-4) 0 var(--space-3); }
  .project-steps p { color: var(--color-ink-soft); margin: 0; line-height: 1.65; }
  .project-faq { display: grid; gap: var(--space-3); }
  .project-faq details { padding: var(--space-5) var(--space-6); border: 1px solid rgba(31,58,26,.12); border-radius: var(--rd-radius); }
  .project-faq summary { cursor: pointer; color: var(--color-green); font-weight: 800; }
  .project-faq p { color: var(--color-ink-soft); margin: var(--space-4) 0 0; }
  @media (max-width: 900px) { .project-steps { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .project-steps { grid-template-columns: 1fr; } }
</style>
