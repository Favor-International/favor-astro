---
import RedesignLayout from '../../layouts/RedesignLayout.astro';
import PageHero from '../../components/band/PageHero.astro';
import LeafHeading from '../../components/redesign/LeafHeading.astro';
import RdCta from '../../components/redesign/RdCta.astro';

const projects = [
  { category: 'Evangelism', name: 'Portable Bible Schools', image: '/images/hero-pbs-graduation.jpg', summary: 'Help carry discipleship training and Bible teaching into rural villages and unreached tribes.' },
  { category: 'Education', name: 'Schools and learning centers', image: '/images/field-2026/education-5.webp', summary: 'Support Village Learning Centers, primary and secondary schools, and leadership training.' },
  { category: 'Community', name: 'Medical care and trauma healing', image: '/images/field-2026/medical-2.webp', summary: 'Help field teams meet physical and emotional needs through clinics and contextualized counseling.' },
  { category: 'Empowerment', name: 'Women and vocational programs', image: '/images/field-2026/women-4.webp', summary: 'Equip women and young adults with training, practical skills, and tools that can produce lasting income.' },
];
// Four steps, written as four instructions. One action per step, one action
// per sentence, so nobody has to guess what to do next or who does it.
const projectSteps = [
  { n: '1', title: 'Choose an area', body: 'Pick one ministry area. Your options are evangelism, education, community care, and economic empowerment.' },
  { n: '2', title: 'Confirm the current need', body: 'Ask us which project is active. We will tell you where it is and how much it still needs.' },
  { n: '3', title: 'Give to that project', body: 'We send you the exact designation wording and a secure way to give. Use both when you give.' },
  { n: '4', title: 'Follow the work', body: 'You receive field reports and updates on the project. Ask us now what happens to your gift if the project reaches full funding.' },
];
const projectFaqs = [
  { q: 'How do I find out what a project still needs?', a: 'Ask us. Field needs and received gifts change quickly, so we confirm the current balance with you before you designate a gift.' },
  { q: 'Can I designate a gift to one program?', a: 'Yes, when there is an active approved project. Contact us for the current project name and the right way to record the designation.' },
  { q: 'What if the project becomes fully funded?', a: 'Ask us before you give and we will tell you exactly how any extra designated funds would be handled for that project.' },
  { q: 'Can a foundation or church fund a project?', a: 'Yes. Start with our foundation or church partnership pages and we will send current project details and documentation.' },
  { q: 'What if I do not want to designate my gift?', a: 'An undesignated gift, one-time or monthly, gives field leadership the most freedom to respond where the need is greatest.' },
  { q: 'Will every project provide the same reporting?', a: 'No. Reporting depends on the project, its duration, and what the field can send. Before a large designated gift, ask us what updates you can expect.' },
];
---
<RedesignLayout
  title="Specific Project"
  description="Fund a specific Favor International project directly. School buildings, dormitories, Bible curriculum, off-grid power."
>
  <PageHero
    label="Specific project"
    title="Fund the exact thing the field needs."
    promise="Your gift funds a real project with a name and a place, and you will watch it unfold through reports and updates from the field."
    image="/images/field/hero-construction-uganda.webp"
    imageAlt="A Favor church under construction in Uganda"
    variant="split"
  />

  <section class="band band--white">
    <div class="container">
      <LeafHeading label="Areas you can support" title="Start with the work God has put on your heart." intro="&ldquo;The harvest truly is great, but the laborers are few.&rdquo; (Luke 10:2). Tell us where God is pulling your heart, and we will show you what the field needs right now." />
      <div class="proj-grid">
        {projects.map((p) => (
          <a class="project-tile reveal" href="/about/contact/?topic=specific-project">
            <img src={p.image} alt={p.name} loading="lazy" />
            <div class="project-tile__copy">
              <span class="project-tile__category">{p.category}</span>
              <h3>{p.name}</h3>
              <p>{p.summary}</p>
              <span class="project-tile__action">Ask about current needs <span aria-hidden="true">→</span></span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="band band--cream">
    <div class="container">
      <LeafHeading label="How designation works" title="Four steps keep the project clear." intro="A short conversation before you give makes sure your gift lands exactly where you intended, and that we can report back to you honestly." />
      <ol class="project-steps">{projectSteps.map((item) => <li class="rd-card reveal"><span>{item.n}</span><h3>{item.title}</h3><p>{item.body}</p></li>)}</ol>
    </div>
  </section>

  <section class="band band--white">
    <div class="container container--narrow">
      <LeafHeading label="Questions" title="Before you designate a gift." leaves={false} />
      <div class="faq project-faq">{projectFaqs.map((item) => <details><summary>{item.q}</summary><p>{item.a}</p></details>)}</div>
    </div>
  </section>

  <RdCta
    heading="Confirm the need before you designate the gift."
    body="The team will share the current project, location, funding status, and appropriate giving route so your designation is clear."
    ctaLabel="Ask about a project"
    ctaHref="/about/contact/?topic=specific-project"
    secondaryLabel="Give where most needed"
    secondaryHref="/give/one-time/"
    image="/images/field-2026/education-5.webp"
    imageAlt="A Favor school under construction"
  />
</RedesignLayout>

<style>
  .proj-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-8); }
  @media (max-width: 800px) { .proj-grid { grid-template-columns: 1fr; } }
  .project-tile { display: block; color: inherit; text-decoration: none; }
  .project-tile img { display: block; width: 100%; aspect-ratio: 16 / 10; object-fit: cover; border-radius: var(--rd-radius); transition: transform 220ms ease; }
  .project-tile:hover img { transform: translateY(-4px); }
  .project-tile__copy { padding: var(--space-5) var(--space-1) 0; }
  .project-tile__category { display: block; margin-bottom: var(--space-2); color: var(--color-gold-deep); font-size: .72rem; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; }
  .project-tile h3 { margin: 0 0 var(--space-3); color: var(--color-green); font-size: clamp(1.3rem, 2vw, 1.6rem); }
  .project-tile p { margin: 0 0 var(--space-4); color: var(--color-ink-soft); line-height: 1.65; }
  .project-tile__action { color: var(--color-green); font-weight: 800; }
  .project-steps { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-5); }
  .project-steps li { position:relative; min-height:330px; overflow:hidden; border:0; color:white; }
  .project-steps li:nth-child(1){background:var(--color-green-deep)}
  .project-steps li:nth-child(2){background:color-mix(in srgb,var(--color-sage) 78%,var(--color-green-deep))}
  .project-steps li:nth-child(3){background:color-mix(in srgb,var(--color-gold-deep) 88%,var(--color-green-deep))}
  .project-steps li:nth-child(4){background:color-mix(in srgb,var(--color-terracotta) 82%,var(--color-green-deep))}
  .project-steps span { position:absolute; right:18px; top:8px; color:rgba(255,255,255,.2); font-weight:900; font-size:clamp(4rem,7vw,6.5rem); line-height:1; }
  .project-steps h3 { color:white; margin:clamp(90px,9vw,120px) 0 var(--space-4); font-size:1.55rem; }
  .project-steps p { color:rgba(255,255,255,.9); margin:0; line-height:1.65; }
  .project-faq { display: grid; gap: var(--space-3); }
  .project-faq details { padding: var(--space-5) var(--space-6); border: 1px solid rgba(31,58,26,.12); border-radius: var(--rd-radius); }
  .project-faq summary { cursor: pointer; color: var(--color-green); font-weight: 800; }
  .project-faq p { color: var(--color-ink-soft); margin: var(--space-4) 0 0; }
  @media (max-width: 900px) { .project-steps { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .project-steps { grid-template-columns: 1fr; } }
</style>
