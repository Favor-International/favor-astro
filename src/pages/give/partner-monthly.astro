---
import RedesignLayout from '../../layouts/RedesignLayout.astro';
import DonationBlock from '../../components/band/DonationBlock.astro';
import DonationForm from '../../components/give/DonationForm.astro';
import OtherWaysToGive from '../../components/give/OtherWaysToGive.astro';
import RdFeature from '../../components/redesign/RdFeature.astro';
import LeafHeading from '../../components/redesign/LeafHeading.astro';
import RdCta from '../../components/redesign/RdCta.astro';
import VerseBand from '../../components/redesign/VerseBand.astro';
import { PARTNER_TIERS } from '../../lib/site';
import storiesData from '../../data/stories.json';
const partnerReasons = [
  { title: 'A missionary keeps walking.', body: 'Your gift arrives the same week every month, so a pastor in South Sudan does not stop to raise support. He keeps walking to the next village.' },
  { title: 'The team can say yes.', body: 'When a chief opens his village to the Gospel, our leaders go now. Steady giving is what lets them answer that door instead of waiting on the next appeal.' },
  { title: 'You walk with the field.', body: 'You receive the stories, the prayer requests, and the names. Your first gift begins a walk with the people doing the work, and you see what God does with it.' },
];
const partnerStory = storiesData.find((s) => s.slug === 'daniel-kidia');
---
<RedesignLayout
  title="Become a Favor Partner"
  description="Favor Partners are monthly givers who keep indigenous missionaries serving in Uganda, South Sudan, and Chad. Pick a tier from $25 to $1,200. Tax-deductible. ECFA-accredited."
>
  <DonationBlock
    eyebrow="Become a Favor Partner"
    heading="Become a Favor Partner."
    body="One monthly gift keeps indigenous missionaries in the field, Bibles in villages, and pastors in training. Choose an amount, or give a custom amount that fits your family."
    image="/images/hero-women-celebrating.jpg"
    imageAlt="Favor Partners gathered at a field event"
    amounts={PARTNER_TIERS.map((t) => t.amount)}
    defaultAmount={50}
    formBase="/give/donate/"
    frequency="monthly"
    inlineTarget="#give-form"
    donateLabel="Become a Partner"
  />

  <section class="band band--cream" id="give-form">
    <div class="container container--narrow">
      <LeafHeading label="Start today" title="Begin your partnership." intro="Pick your monthly amount, tell us where to send the receipt, and finish in Blackbaud's secure checkout." />
      <div class="give-form-card">
        <DonationForm defaultFrequency="monthly" />
      </div>
    </div>
  </section>

  <OtherWaysToGive />

  <section class="band band--white">
    <div class="container">
      <LeafHeading label="Why monthly" title="The harvest is ready now, and the workers are few." intro="&ldquo;Even as others are moving out, we are moving in! We must accelerate and multiply, for the harvest is plentiful, but the laborers are few.&rdquo; That is what Carole Ward told the team in Juba. Monthly partners are how they keep moving in." />
      <div class="partner-reasons">{partnerReasons.map((item) => <article class="rd-card reveal"><h3>{item.title}</h3><p>{item.body}</p></article>)}</div>
    </div>
  </section>

  <VerseBand
    reference="Luke 10:2 · NKJV"
    verse="&ldquo;The harvest truly is great, but the laborers are few; therefore pray the Lord of the harvest to send out laborers into His harvest.&rdquo;"
    note="Jesus told us to pray for workers. Your partnership helps send them."
  />

  <RdFeature
    image="/images/field-2026/education-2.webp"
    imageAlt="Favor ministry graduates celebrating together"
    eyebrow="What your partnership does"
    heading="Where your monthly gift goes."
    side="right"
    background="cream"
    decor="leaf"
  >
    <p>Every Favor Partner gift is unrestricted, meaning the field directs it where it is most needed that month. In FY2024, 89 cents of every dollar went to program work and 11 cents covered U.S. operations, audit, and donor care.</p>
    <ul class="breakdown">
      <li><strong>89%</strong> Field programs: indigenous workers, PBS, Village Learning Centers, medical, counseling, women’s empowerment</li>
      <li><strong>11%</strong> U.S. operations: audit, accounting, payroll, donor care, governance</li>
    </ul>
    <p>Source: FY2024 audited financials filed with ECFA and IRS Form 990, available at <a href="/about/accountability/">accountability</a>.</p>
  </RdFeature>

  <section class="band band--white"><div class="container">
    <LeafHeading label="Choose the right giving path" title="Three ways to give, and what each one does." intro="Start with what God has put on your heart. Any of these three reaches the field." />
    <div class="giving-paths"><article class="rd-card"><h3>Monthly partnership</h3><p>You keep the whole work moving, month after month. Our leaders can send a missionary, open a school, or answer a crisis without stopping to raise the money first.</p></article><article class="rd-card"><h3>One-time giving</h3><p>Your single gift goes straight to the greatest need our field leaders see that week. No recurring commitment.</p></article><article class="rd-card"><h3>Designated project</h3><p>You want to fund one specific thing. Talk to us first and we will tell you the project name, where it is, what it still needs, and exactly how to designate the gift.</p></article></div>
  </div></section>

  <RdFeature
    image="/images/stories/goats-for-women.jpg"
    imageAlt="Women in Puranga, Uganda participating in an empowerment program"
    eyebrow="The Women of Puranga · Uganda"
    heading="A year of training ended with two goats for every woman."
    side="left"
    background="cream"
    decor="leaf"
  >
    <p>A Women’s Empowerment cohort completed a year of training and received two goats for each member. Growing herds can help households meet school, food, and medical costs.</p>
    <blockquote>“They praised and worshiped God as they waited to receive two goats for each member of their Women’s Empowerment group.”</blockquote>
  </RdFeature>

  {partnerStory && (
    <RdFeature image={partnerStory.image} imageAlt={partnerStory.title} eyebrow={`${partnerStory.category} · ${partnerStory.date}`} heading={partnerStory.title} side="right" background="white" decor="leaf">
      {partnerStory.paragraphs.slice(0, 2).map((paragraph) => <p>{paragraph}</p>)}
      <p><a class="story-link" href={`/stories/${partnerStory.slug}/`}>Read Daniel’s complete story &rarr;</a></p>
    </RdFeature>
  )}

  <section class="band band--cream">
    <div class="container container--narrow">
      <LeafHeading label="After you join" title="What happens after you join." intro="Your first gift processes through the secure giving form. You receive an emailed receipt, and you can reach a real person here whenever you want to change your amount or payment details." />
      <div class="faq">
        <details><summary>Can I choose a custom monthly amount?</summary><p>Yes. The suggested levels are a starting point; choose the amount that fits your household.</p></details>
        <details><summary>Is my monthly gift restricted to one program?</summary><p>Favor Partner gifts are unrestricted, allowing field leadership to direct resources where they are most needed.</p></details>
        <details><summary>Will I receive a receipt?</summary><p>Yes. A tax-deductible receipt is sent by email after your gift is processed.</p></details>
        <details><summary>Where can I review Favor's financials?</summary><p>Audited statements, Form 990s, and independent profiles are available on the <a href="/about/accountability/">accountability page</a>.</p></details>
      </div>
    </div>
  </section>

  <RdCta
    background="cream"
    heading="Start your partnership today."
    body="Pick an amount above, or choose your own. Your first gift processes immediately and you will receive a tax-deductible receipt by email."
    ctaLabel="Start your partnership"
    ctaHref="#give-form"
    secondaryLabel="Review accountability"
    secondaryHref="/about/accountability/"
    image="/images/field-2026/crusade-2.webp"
    imageAlt="A community gathered to hear the Gospel in the field"
  />
</RedesignLayout>

<style>
  .give-form-card {
    background: var(--color-white);
    border-radius: var(--radius-card);
    padding: clamp(var(--space-5), 3.5vw, var(--space-10));
    margin-top: var(--space-8);
    scroll-margin-top: 96px;
  }
  .breakdown { list-style: none; padding: 0; margin: var(--space-5) 0; display: grid; gap: var(--space-3); }
  .breakdown li { padding: var(--space-4) var(--space-6); background: var(--color-white); border-radius: var(--radius-input); color: var(--color-ink-soft); line-height: 1.5; }
  .breakdown strong { color: var(--color-green); display: inline-block; min-width: 52px; font-weight: 800; }
  .partner-reasons { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-6); }
  .partner-reasons h3 { color: var(--color-green); margin: 0 0 var(--space-3); }
  .partner-reasons p { color: var(--color-ink-soft); margin: 0; line-height: 1.65; }
  .giving-paths { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-6); }
  .giving-paths h3 { color: var(--color-green); margin: 0 0 var(--space-3); }
  .giving-paths p { color: var(--color-ink-soft); margin: 0; line-height: 1.65; }
  @media (max-width: 800px) { .partner-reasons, .giving-paths { grid-template-columns: 1fr; } }
</style>
