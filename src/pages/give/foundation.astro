---
import RedesignLayout from '../../layouts/RedesignLayout.astro';
import PageHero from '../../components/band/PageHero.astro';
import RdFeature from '../../components/redesign/RdFeature.astro';
import LeafHeading from '../../components/redesign/LeafHeading.astro';
import RdCta from '../../components/redesign/RdCta.astro';
import { SITE } from '../../lib/site';

// Rebuilt 2026-06-10. The previous "Due diligence on day one" cards carried
// scaffold-INVENTED promises (FY2025 audit timing, site-visit lead times,
// quarterly restricted-gift reporting). Removed. Everything below is real and
// verifiable: the documents live on /about/accountability/ and the public
// profiles, and the figures match ECFA's filed numbers.
const IRS_LETTER = '/documents/irs-determination-letter-updated-address.pdf';

const facts = [
  { icon: '📊', title: 'Audited financials', body: 'Independently audited every year. Five years of audited statements, published in full.', cta: 'See our financials', href: '/about/accountability/' },
  { icon: '🗂️', title: 'IRS Form 990s', body: 'Five years of public 990s, filed and published. EIN ' + '47-5225697' + '.', cta: 'View the 990s', href: '/about/accountability/' },
  { icon: '✓', title: 'ECFA-accredited', body: 'Accredited by the Evangelical Council for Financial Accountability since September 30, 2019.', cta: 'ECFA profile', href: 'https://www.ecfa.org/MemberProfile.aspx?ID=50004' },
  { icon: '★', title: 'Independently rated', body: 'Charity Navigator Four-Star (94, FY2024) and Candid Platinum Transparency.', cta: 'Charity Navigator', href: 'https://www.charitynavigator.org/ein/475225697' },
  { icon: '🏛️', title: '501(c)(3) determination', body: 'IRS determination letter available for your files.', cta: 'Download the letter', href: IRS_LETTER },
  { icon: '↗', title: 'DAF-ready', body: 'Donor-advised fund routing through TrustBridge and DAF Direct.', cta: 'International & DAF routes', href: '/give/international/' },
];
const grantPath = [
  { title: 'Orient', body: 'Review Favor’s mission, four program pillars, geographic work, leadership, and published accountability documents.' },
  { title: 'Discuss fit', body: 'Tell us your foundation’s priorities, geography, grant range, restrictions, and required application format.' },
  { title: 'Confirm scope', body: 'Tell us your focus and we will match it to a current program, with budget, timing, and the reporting we can commit to.' },
  { title: 'Complete diligence', body: 'Use the public financials and request any additional organizational documents your board or adviser requires.' },
];
const foundationFaqs = [
  { q: 'Does Favor accept restricted grants?', a: 'Sometimes. When a current program or approved project matches your foundation’s intent, we can accept a restricted grant. We will agree on scope and reporting with you before the grant is issued.' },
  { q: 'Can a donor-advised fund recommend a grant?', a: 'Yes. Our DAF and international giving pages have the routes, or email us and we will send them. Confirm the current beneficiary and processing details with your sponsoring organization before submitting a recommendation.' },
  { q: 'What financial records are public?', a: 'We publish audited financial statements and IRS Form 990 filings, along with links to ECFA, Charity Navigator, and Candid profiles on the accountability page.' },
  { q: 'What should an initial inquiry include?', a: 'Include the foundation name, program interests, geographic priorities, approximate grant range, timing, restrictions, and the documents required for review.' },
  { q: 'Does Favor publish a standard reporting schedule?', a: 'No. We match reporting to the approved grant scope. Ask us what reporting we can commit to before you write a schedule into an agreement.' },
];
---
<RedesignLayout
  title="Foundation Giving"
  description="Foundation, donor-advised fund, and grant-maker inquiries. Audited financials, public 990s, ECFA accreditation, and direct access to the Favor International team."
>
  <PageHero
    label="For foundations and grant-makers"
    title="Everything your board needs to say yes."
    promise="Audited financials, public 990s, ECFA accreditation, and a team that answers directly."
    image="/images/field-2026/pbs-3.webp"
    imageAlt="PBS graduation in South Sudan"
    ctaLabel="Request the foundation packet"
    ctaHref="/about/contact/?topic=foundation"
  />

  <section class="band band--white">
    <div class="container container--narrow fnd-intro">
      <p class="label">Grant-maker basics</p>
      <h2>Our record is public and we are easy to reach.</h2>
      <p>Favor International is a 501(c)(3) public charity (EIN {SITE.ein}), ECFA-accredited, and independently audited every year. The documents you need for due diligence are already published, and our executive team answers grant-maker questions directly.</p>
    </div>
  </section>

  <section class="band band--cream">
    <div class="container">
      <LeafHeading label="On the record" title="Six things you can verify today." />
      <div class="fnd-grid">
        {facts.map((f) => (
          <a class="fnd-card" href={f.href} target={f.href.startsWith('http') ? '_blank' : undefined} rel={f.href.startsWith('http') ? 'noopener' : undefined}>
            <span class="fnd-card__icon" aria-hidden="true">{f.icon}</span>
            <h3>{f.title}</h3>
            <p>{f.body}</p>
            <span class="fnd-card__cta">{f.cta} &rarr;</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <RdFeature
    image="/images/field-2026/vlc-5.webp"
    imageAlt="Children at a Favor Village Learning Center"
    eyebrow="What grants fund"
    heading="Programs run by the people who live there."
    side="right"
    background="white"
  >
    <p>Every Favor program on the field is run by indigenous leaders: Portable Bible Schools, GIFT children&rsquo;s homes, primary and secondary schools, medical care, trauma counseling, and women&rsquo;s empowerment across the nations Favor serves.</p>
    <p>Foundation officers, family-office staff, and DAF advisors can email the executive team directly at <strong>{SITE.emailGeneral}</strong> or call {SITE.phone}. We will respond with the packet you need.</p>
  </RdFeature>

  <section class="band band--cream">
    <div class="container">
      <LeafHeading label="A practical grant path" title="From first review to a defined scope." intro="There is no standard grant package. We will work through diligence with you, step by step." />
      <ol class="grant-path">{grantPath.map((item, index) => <li class="rd-card reveal"><span>0{index + 1}</span><h3>{item.title}</h3><p>{item.body}</p></li>)}</ol>
    </div>
  </section>

  <section class="band band--white"><div class="container container--narrow">
    <LeafHeading label="Questions" title="Foundation and DAF inquiries." leaves={false} />
    <div class="faq fnd-faq">{foundationFaqs.map((item) => <details><summary>{item.q}</summary><p>{item.a}</p></details>)}</div>
  </div></section>

  <RdCta
    heading="Start the conversation."
    body="Tell us what your board needs to see. We will send the foundation packet and answer directly."
    ctaLabel="Email the executive team"
    ctaHref={`mailto:${SITE.emailGeneral}?subject=Foundation inquiry`}
    image="/images/field-2026/pbs-4.webp"
    imageAlt="A PBS graduation cohort in South Sudan"
  />
</RedesignLayout>

<style>
  .fnd-intro { text-align: center; }
  .fnd-intro p:last-child { margin: var(--space-5) auto 0; color: var(--color-ink-soft); line-height: 1.8; max-width: 66ch; }

  .fnd-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-6); }
  @media (max-width: 980px) { .fnd-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { .fnd-grid { grid-template-columns: 1fr; max-width: 400px; margin: 0 auto; } }
  .fnd-card {
    display: flex; flex-direction: column; align-items: center; text-align: center; gap: var(--space-2);
    background: var(--color-white); border: 1px solid var(--color-border); border-radius: var(--radius-card);
    padding: var(--space-8) var(--space-6);
    text-decoration: none; color: inherit; box-shadow: var(--shadow-soft);
    transition: transform 180ms, box-shadow 180ms, border-color 180ms;
  }
  .fnd-card:hover { transform: translateY(-4px); box-shadow: 0 18px 40px rgba(31, 58, 26, 0.14); border-color: var(--color-gold); }
  .fnd-card__icon {
    display: inline-flex; align-items: center; justify-content: center;
    width: 52px; height: 52px; border-radius: 14px; font-size: 1.4rem;
    background: color-mix(in srgb, var(--color-gold) 14%, var(--color-white));
    color: var(--color-gold-deep);
  }
  .fnd-card h3 { margin: var(--space-2) 0 0; font-size: 1.1rem; color: var(--color-green); }
  .fnd-card p { margin: 0; color: var(--color-ink-soft); line-height: 1.6; font-size: 0.95rem; }
  .fnd-card__cta { margin-top: var(--space-2); color: var(--color-gold-deep); font-weight: 700; font-size: 0.88rem; }
  .fnd-card:hover .fnd-card__cta { color: var(--color-green); }
  .grant-path { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-5); }
  .grant-path li { position:relative; min-height:330px; overflow:hidden; border:0; color:white; }
  .grant-path li:nth-child(1){background:var(--color-green-deep)}
  .grant-path li:nth-child(2){background:color-mix(in srgb,var(--color-sage) 78%,var(--color-green-deep))}
  .grant-path li:nth-child(3){background:color-mix(in srgb,var(--color-gold-deep) 88%,var(--color-green-deep))}
  .grant-path li:nth-child(4){background:color-mix(in srgb,var(--color-terracotta) 82%,var(--color-green-deep))}
  .grant-path span { position:absolute; right:18px; top:8px; color:rgba(255,255,255,.2); font-size:clamp(4rem,7vw,6.5rem); line-height:1; font-weight:900; }
  .grant-path h3 { color:white; margin:clamp(90px,9vw,120px) 0 var(--space-4); font-size:1.55rem; }
  .grant-path p { color:rgba(255,255,255,.9); margin:0; line-height:1.65; }
  .fnd-faq p { color:var(--color-ink-soft); margin:0; line-height:1.65; }
  .fnd-faq { display: grid; gap: var(--space-3); }
  .fnd-faq details { padding: var(--space-5) var(--space-6); border: 1px solid rgba(31,58,26,.12); border-radius: var(--rd-radius); }
  .fnd-faq summary { cursor: pointer; color: var(--color-green); font-weight: 800; }
  .fnd-faq details p { margin-top: var(--space-4); }
  @media (max-width: 960px) { .grant-path { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .grant-path { grid-template-columns: 1fr; } }
</style>
