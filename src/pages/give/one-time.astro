---
import RedesignLayout from '../../layouts/RedesignLayout.astro';
import DonationBlock from '../../components/band/DonationBlock.astro';
import DonationForm from '../../components/give/DonationForm.astro';
import LeafHeading from '../../components/redesign/LeafHeading.astro';
import RdCta from '../../components/redesign/RdCta.astro';
import { SITE } from '../../lib/site';

// Real downloadable forms from favorintl.org/connect-support/donate-now
const STOCK_FORM = '/documents/favor-international-stock-and-non-cash-assets-transfer-form-2022-updated-10.25-.pdf';
---
<RedesignLayout
  title="Give Once"
  description="Make a secure one-time gift to Favor International. Any amount. Tax-deductible. Support indigenous missionaries and field-led programs."
>
  <DonationBlock
    eyebrow="One-time gift"
    heading="Give once. Reach the unreached."
    body="A single gift goes straight to the field, where indigenous missionaries are planting churches in the hardest places on earth. You will receive a tax-deductible receipt by email immediately."
    image="/images/education-vlc-jondoru.jpg"
    imageAlt="Children at a Favor Village Learning Center"
    amounts={[25, 50, 100, 150, 250]}
    defaultAmount={60}
    formBase="/give/donate/"
    frequency="once"
    inlineTarget="#give-form"
    donateLabel="Give now"
  />

  <section class="band band--cream" id="give-form">
    <div class="container container--narrow">
      <LeafHeading label="Give now" title="Make your gift." intro="Choose your amount, tell us where to send the receipt, and finish in Blackbaud's secure checkout." />
      <div class="give-form-card">
        <DonationForm defaultFrequency="once" />
      </div>
    </div>
  </section>

  <section class="band band--cream">
    <div class="container container--narrow">
      <LeafHeading label="Where your gift goes" title="Field-led and independently accountable." />
      <p>One-time gifts route through Blackbaud and are received the same day. You will receive a tax-deductible receipt by email immediately. 89 cents of every dollar went to program in FY2024 (audited).</p>
      <p>Favor International is a 501(c)(3) public charity, EIN {SITE.ein}, and an <a href={SITE.trust.ecfa} target="_blank" rel="noopener">ECFA-accredited member</a>. Prefer to give every month? <a href="/give/partner-monthly/">Become a Favor Partner</a>.</p>
    </div>
  </section>

  <section class="band band--white">
    <div class="container container--narrow">
      <LeafHeading label="More ways to give once" title="Choose the route that works for you." intro="Never email bank, card, or brokerage account numbers. Contact the team first for wire or asset-transfer instructions." leaves={false} />
      <ul class="give-methods">
        <li><span class="method-icon method-icon--check" aria-hidden="true">✉</span><span><strong>By check (no fees).</strong> Please make checks payable to Favor Intl. Mail to: Favor International, 3433 Lithia Pinecrest Rd #356, Valrico, FL 33596.</span></li>
        <li><span class="method-icon method-icon--zelle" aria-hidden="true">Z</span><span><strong>Zelle.</strong> Send to admin@favorintl.org.</span></li>
        <li><span class="method-icon method-icon--cash" aria-hidden="true">$</span><span><strong>Cash App.</strong> Send to the CashTag $FavorInternational.</span></li>
        <li><span class="method-icon method-icon--wire" aria-hidden="true">↔</span><span><strong>Wire transfer.</strong> Available on request. Email {SITE.emailGeneral} for instructions.</span></li>
        <li><span class="method-icon method-icon--stock" aria-hidden="true">↗</span><span><strong>Stock and securities.</strong> Give appreciated stock with our <a href={STOCK_FORM} target="_blank" rel="noopener">Stock and Non-Cash Assets Transfer Form</a>.</span></li>
        <li><span class="method-icon method-icon--paypal" aria-hidden="true">P</span><span><strong>PayPal, ACH, and credit card.</strong> All available through our online giving portal.</span></li>
        <li><span class="method-icon method-icon--dedicate" aria-hidden="true">♥</span><span><strong>Designate or dedicate.</strong> Designate your gift, write a note, or honor someone with a dedicated gift through the online giving portal.</span></li>
      </ul>
    </div>
  </section>

  <section class="band band--cream">
    <div class="container container--narrow">
      <LeafHeading label="Questions" title="Common questions about giving." />
      <div class="faq">
        <details>
          <summary>Is my gift tax-deductible?</summary>
          <p>Yes. Favor International is a registered 501(c)(3) public charity (EIN {SITE.ein}). You will receive a tax-deductible receipt by email immediately after you give.</p>
        </details>
        <details>
          <summary>How much of my gift reaches the field?</summary>
          <p>In FY2024, 89 cents of every dollar went to program work, with the remainder covering U.S. operations, audit, and donor care. The figures are audited and filed with ECFA and on IRS Form 990. See the <a href="/about/accountability/">accountability page</a>.</p>
        </details>
        <details>
          <summary>Can I give monthly instead of once?</summary>
          <p>Yes. Monthly partners are the engine of the work. <a href="/give/partner-monthly/">Become a Favor Partner</a> and choose a tier or a custom amount.</p>
        </details>
        <details>
          <summary>Can I give by check, Zelle, CashApp, or stock?</summary>
          <p>Yes. Make checks payable to Favor Intl. and mail to 3433 Lithia Pinecrest Rd #356, Valrico, FL 33596. We also accept Zelle (admin@favorintl.org), CashApp ($FavorInternational), wire transfer, and appreciated stock. Email {SITE.emailGeneral} for routing details.</p>
        </details>
        <details>
          <summary>Where does my gift go to work?</summary>
          <p>Across the nations of East and Central Africa, where Favor equips indigenous missionaries to plant churches, train pastors, run schools, and care for communities. See <a href="/impact/">the work</a>.</p>
        </details>
      </div>
    </div>
  </section>

  <RdCta
    background="cream"
    heading="Prefer to give every month?"
    body="Favor Partners keep indigenous missionaries on the trail all year. Any tier, cancel anytime."
    ctaLabel="Become a Favor Partner"
    ctaHref="/give/partner-monthly/"
    image="/images/field-2026/crusade-1.webp"
    imageAlt="A Favor field gathering"
  />
</RedesignLayout>

<style>
  .give-methods { list-style: none; padding: 0; margin: var(--space-8) 0 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-6); }
  .give-methods li { display: grid; grid-template-columns: 52px 1fr; gap: var(--space-4); align-items: start; padding: var(--space-2) 0 var(--space-5); border-bottom: 1px solid var(--color-border); color: var(--color-ink-soft); line-height: 1.6; }
  .give-methods strong { color: var(--color-green); }
  .method-icon { display: inline-grid; place-items: center; width: 48px; height: 48px; border-radius: 14px; background: var(--color-sage-light); color: var(--color-green); font-size: 1.2rem; font-weight: 900; }
  .method-icon--zelle { background: #6d1ed4; color: white; }
  .method-icon--cash { background: #00c244; color: white; }
  .method-icon--paypal { background: #073b9a; color: white; font-style: italic; }
  .method-icon--check { background: #e4a62a; color: #173d20; }
  .method-icon--wire { background: #287a68; color: white; }
  .method-icon--stock { background: #c6603d; color: white; }
  .method-icon--dedicate { background: #b74f72; color: white; }
  @media (max-width: 720px) { .give-methods { grid-template-columns: 1fr; } }

  .faq { margin-top: var(--space-6); display: grid; gap: var(--space-3); }
  .faq details {
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    padding: var(--space-4) var(--space-6);
  }
  .faq summary {
    cursor: pointer;
    font-weight: 700;
    color: var(--color-green);
    font-size: 1.05rem;
    list-style: none;
    display: flex; justify-content: space-between; align-items: center; gap: var(--space-4);
  }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after { content: '+'; color: var(--color-gold); font-size: 1.5rem; line-height: 1; font-weight: 400; }
  .faq details[open] summary::after { content: '–'; }
  .faq details p { margin: var(--space-4) 0 0; color: var(--color-ink-soft); line-height: 1.6; }
  .give-form-card {
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
    padding: clamp(var(--space-5), 3.5vw, var(--space-10));
    margin-top: var(--space-8);
    scroll-margin-top: 96px;
  }
</style>
