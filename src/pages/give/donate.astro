---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE } from '../../lib/site';

// The REAL Favor International donation form: the same Blackbaud donor-form
// embed the live site uses on /connect-support/donate-now (captured
// 2026-06-10): BBDonorFormLoader.newBlackbaudDonationFormZoned('renxt',
// 'p-5_k5FlbubEyEQnUJw7C9Rw', mainFormID, 'usa'). Gifts made here go to Favor
// through their production Blackbaud account. (Their PayPal variant form is
// c2cfae15-d047-481b-a548-95e3c3fc60fb; their bbox email-signup form is
// 2446db74-94fe-4197-8a40-03b10341c4e2.)
const BB_FORM_ID = '80ce9859-0be9-48ad-a3cb-cce9c5d4e00b';
---
<PageLayout
  title="Give Online"
  description="Give to Favor International online by credit card, ACH, or PayPal. Designate your gift, write a note, or honor someone with a dedicated gift. Tax-deductible."
>
  <section class="band band--cream donate-head">
    <div class="container container--narrow">
      <header class="band__header">
        <p class="label">Instant giving</p>
        <h1>Give online.</h1>
        <p class="donate-sub">Credit card, ACH, PayPal&hellip; it&rsquo;s all here. Designate your gift, write a note, or honor someone with a dedicated gift.</p>
      </header>
    </div>
  </section>

  <section class="band band--white donate-form-band">
    <div class="container container--narrow">
      <div class="donate-form-card">
        <div id={`blackbaud-donation-form_${BB_FORM_ID}`}></div>
        <noscript><p>The donation form needs JavaScript. You can also give by check (payable to Favor Intl., 3433 Lithia Pinecrest Rd #356, Valrico, FL 33596), Zelle (admin@favorintl.org), or CashApp ($FavorInternational).</p></noscript>
      </div>
      <p class="donate-trust">Favor International is a 501(c)(3) public charity, EIN {SITE.ein} &middot; <a href={SITE.trust.ecfa} target="_blank" rel="noopener">ECFA-accredited</a> &middot; Tax-deductible &middot; <a href="/about/accountability/">See the financials</a></p>
      <p class="donate-alt">Prefer another way? <a href="/give/one-time/">Check, Zelle, CashApp, wire, or stock</a> &middot; <a href="/give/partner-monthly/">Become a monthly Favor Partner</a></p>
    </div>
  </section>
</PageLayout>

<script src="https://sky.blackbaudcdn.net/static/donor-form-loader/2/main.js" is:inline></script>
<script is:inline define:vars={{ BB_FORM_ID }}>
  // Same loader call the live favorintl.org donate page uses.
  BBDonorFormLoader.newBlackbaudDonationFormZoned('renxt', 'p-5_k5FlbubEyEQnUJw7C9Rw', BB_FORM_ID, 'usa');
</script>

<style>
  .donate-head { padding-bottom: var(--space-8); }
  .donate-head h1 { color: var(--color-green); }
  .donate-sub { color: var(--color-ink-soft); max-width: 56ch; margin: 0 auto; line-height: 1.7; }
  .donate-form-band { padding-top: var(--space-8); }
  .donate-form-card {
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
    padding: clamp(var(--space-4), 3vw, var(--space-10));
    min-height: 420px;
  }
  .donate-trust { text-align: center; margin: var(--space-8) 0 0; font-size: 0.9rem; color: var(--color-sage); }
  .donate-trust a { color: var(--color-gold-deep); font-weight: 700; }
  .donate-alt { text-align: center; margin: var(--space-3) 0 0; font-size: 0.9rem; color: var(--color-ink-soft); }
  .donate-alt a { color: var(--color-green); font-weight: 700; }
</style>
