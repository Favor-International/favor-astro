---
import RedesignLayout from '../../layouts/RedesignLayout.astro';
import Leaf from '../../components/redesign/Leaf.astro';
import DonationForm from '../../components/give/DonationForm.astro';
import OtherWaysToGive from '../../components/give/OtherWaysToGive.astro';
import StateSolicitationDisclosures from '../../components/give/StateSolicitationDisclosures.astro';
import { SITE } from '../../lib/site';

// Native Blackbaud SKY API giving (2026-07-21). The old page embedded the
// hosted BBDonorFormLoader form; this one is Favor's own three-step form.
// Card capture stays inside Blackbaud Checkout (PCI with Blackbaud), then
// Pages Functions charge the authorization and write the gift to Raiser's
// Edge NXT. See docs/04-tech/integrations/blackbaud-implementation.md.
---
<RedesignLayout
  title="Give Online"
  description="Give to Favor International online by credit or debit card. One-time or monthly, designated where you choose. Tax-deductible, ECFA-accredited."
>
  <section class="band band--cream donate-head">
    <div class="container container--narrow">
      <header class="band__header">
        <Leaf class="donate-leaf" />
        <p class="label" data-when="online">Instant giving</p>
        <p class="label" data-when="offline">Give today</p>
        <h1>Give online.</h1>
        <p class="donate-sub" data-when="online">Your gift sends indigenous missionaries to people who have never heard the name of Jesus. Give one time or monthly. Choose your amount, designate your gift, and finish in Blackbaud&rsquo;s secure checkout in under a minute.</p>
        <p class="donate-sub" data-when="offline">Your gift sends indigenous missionaries to people who have never heard the name of Jesus. Card giving is briefly offline, so use one of the routes below and your gift still reaches the field today.</p>
        <p class="donate-alt">Giving from outside the United States? <a href="/give/international/">Click here.</a></p>
      </header>
    </div>
  </section>

  <section class="band band--white donate-form-band">
    <div class="container container--narrow">
      <DonationForm />
      <noscript><p>The donation form needs JavaScript. You can also give by check (payable to Favor Intl., {SITE.mailing}), Zelle (admin@favorintl.org), or CashApp ($FavorInternational).</p></noscript>
      <blockquote class="donate-verse">
        <p>&ldquo;The harvest truly is great, but the laborers are few; therefore pray the Lord of the harvest to send out laborers into His harvest.&rdquo;</p>
        <cite>Luke 10:2 &middot; NKJV</cite>
      </blockquote>
      <p class="donate-trust">Favor International is a 501(c)(3) public charity, EIN {SITE.ein} &middot; <a href={SITE.trust.ecfa} target="_blank" rel="noopener">ECFA-accredited</a> &middot; Tax-deductible &middot; <a href="/about/accountability/">See our financials</a></p>
      <StateSolicitationDisclosures />
    </div>
  </section>

  <OtherWaysToGive />
</RedesignLayout>

<style>
  .donate-head { padding-bottom: var(--space-8); }
  .donate-head :global(.donate-leaf) { width: 120px; margin: 0 auto -48px; color: #cfe0c6; opacity: .55; transform: rotate(-12deg); }
  .donate-head h1 { color: var(--color-green); }
  .donate-sub { color: var(--color-ink-soft); max-width: 56ch; margin: 0 auto; line-height: 1.7; }

  /* The offline variants only appear once DonationForm has confirmed the
     Blackbaud connection is down (it sets data-give-offline on <html>). The
     online copy is what renders for everyone by default, including with JS
     disabled, so nothing here depends on the script to look right. */
  [data-when='offline'] { display: none; }
  :global(html[data-give-offline]) [data-when='online'] { display: none; }
  :global(html[data-give-offline]) [data-when='offline'] { display: block; }
  .donate-form-band { padding-top: var(--space-8); }
  /* The verse is a quiet close to the page, not part of the form, so it sits
     well below it behind a hairline rule. It was crowding the buttons. */
  .donate-verse {
    margin: clamp(56px, 9vw, 96px) auto 0;
    padding: clamp(32px, 5vw, 48px) 0 0;
    max-width: 62ch;
    border: 0;
    border-top: 1px solid var(--color-border);
    text-align: center;
  }
  .donate-verse p {
    margin: 0 0 var(--space-4);
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1rem, 2.4vw, 1.15rem);
    line-height: 1.7;
    color: var(--color-green-deep);
    text-wrap: pretty;
  }
  @media (max-width: 640px) {
    .donate-verse { margin-inline: var(--space-2); }
  }
  .donate-verse cite {
    font-style: normal;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-gold-deep);
  }
  .donate-trust { text-align: center; margin: var(--space-8) 0 0; font-size: 0.9rem; color: var(--color-sage); }
  .donate-trust a { color: var(--color-gold-deep); font-weight: 700; }
  .donate-form-band :global(.give-legal) { margin-top: var(--space-5); }
  .donate-alt { text-align: center; margin: var(--space-3) 0 0; font-size: 0.9rem; color: var(--color-ink-soft); }
  .donate-alt a { color: var(--color-green); font-weight: 700; }
</style>
