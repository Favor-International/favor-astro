---
import RedesignLayout from '../../layouts/RedesignLayout.astro';
import PageHero from '../../components/band/PageHero.astro';
import LeafHeading from '../../components/redesign/LeafHeading.astro';
import RdFeature from '../../components/redesign/RdFeature.astro';
import RdCta from '../../components/redesign/RdCta.astro';
import { SITE } from '../../lib/site';

// Real downloadable form from favorintl.org/connect-support/donate-now
const LEGACY_FORM = '/documents/favor-international-legacy-circle-membership-form.docx.pdf';
const legacyFaqs = [
  { q: 'Do I need to tell Favor that it is included in my plans?', a: 'Notification is not required for a revocable gift, but it can help Favor confirm its legal name and organizational information and understand the donor’s intent.' },
  { q: 'Can I change a legacy commitment?', a: 'Many wills and beneficiary designations can be changed during the donor’s lifetime, but the answer depends on the document and gift structure. Review changes with your own attorney or plan administrator.' },
  { q: 'Can a legacy gift support a specific program?', a: 'Restrictions should be discussed before documents are finalized. Programs and field needs may change over time, so flexible language can help preserve the purpose of the gift.' },
  { q: 'What information will my adviser need?', a: `Your adviser may request Favor’s legal name, address, EIN ${SITE.ein}, tax-exempt status, and a contact person. Confirm current organizational details with Favor before signing final documents.` },
  { q: 'Is the Legacy Circle form legally binding?', a: 'The form communicates intent and helps Favor understand planned support; it does not replace a will, beneficiary designation, trust document, or professional legal advice.' },
];
---
<RedesignLayout
  title="Legacy Giving"
  description="Plan your estate to keep the field moving. Wills, beneficiary designations, and charitable trusts."
>
  <PageHero
    label="Legacy giving"
    title="Send a pastor for the next generation."
    promise="Wills, beneficiary designations, and charitable trusts that keep Favor's work moving when you cannot."
    image="/images/field-2026/evangelism-7.webp"
    imageAlt="Training the next generation of leaders"
    variant="split"
  />

  <section class="band band--white">
    <div class="container">
      <LeafHeading label="Common paths" title="A future gift can take several forms." intro="Begin with the option that fits your estate plan, then review the details with your attorney or financial adviser." />
      <div class="acard-grid">
        <article class="acard has-texture">
          <h3>Bequest by will</h3>
          <p>A specific dollar amount or a percentage of your estate, named in your will. Most common, easiest to set up. Talk to your attorney.</p>
        </article>
        <article class="acard has-texture">
          <h3>Beneficiary designation</h3>
          <p>Name Favor International as a beneficiary on an IRA, 401(k), or life-insurance policy. Your adviser can explain the tax treatment for your circumstances.</p>
        </article>
        <article class="acard has-texture">
          <h3>Charitable trust</h3>
          <p>Charitable remainder or lead trusts can provide income to you or family and route the remainder to Favor. Talk to a CFP first.</p>
        </article>
        <article class="acard has-texture">
          <h3>The Legacy Circle</h3>
          <p>Tell us your plans and join the Legacy Circle. Download the <a href={LEGACY_FORM} target="_blank" rel="noopener">Legacy Circle Membership Form</a> to get started.</p>
        </article>
      </div>
    </div>
  </section>

  <RdFeature image="/images/field-2026/evangelism-8.webp" imageAlt="Training the next generation of indigenous leaders" eyebrow="A legacy that keeps moving" heading="Prepare leaders you may never meet." side="right" background="cream" decor="leaf">
    <p>A legacy gift can help future indigenous pastors, teachers, and missionaries carry the Gospel in their own nations.</p>
    <p>Favor International is a 501(c)(3) public charity. Legal name and EIN information can be confirmed with the team before documents are finalized.</p>
    <p class="legacy-note">The information on this page is educational and is not legal, tax, or financial advice. Please consult your own qualified advisers.</p>
  </RdFeature>

  <section class="band band--white"><div class="container container--narrow">
    <LeafHeading label="Prepare the conversation" title="Information to confirm with Favor and your adviser." intro="Before final documents are signed, make sure the organization, purpose, and contact details are current." />
    <ul class="legacy-checklist"><li>Favor International’s current legal name and mailing address.</li><li>Federal tax identification number: {SITE.ein}.</li><li>The type of gift and whether it is a fixed amount, percentage, remainder, or beneficiary designation.</li><li>Whether the gift is unrestricted or carries an agreed purpose.</li><li>Who your executor, trustee, plan administrator, or adviser should contact.</li></ul>
  </div></section>

  <section class="band band--cream"><div class="container container--narrow">
    <LeafHeading label="Questions" title="Planning a legacy gift." leaves={false} />
    <div class="faq legacy-faq">{legacyFaqs.map((item) => <details><summary>{item.q}</summary><p>{item.a}</p></details>)}</div>
  </div></section>

  <RdCta
    background="cream"
    heading="Begin a confidential legacy conversation."
    body="If you have named Favor in your estate—or are considering it—the team can provide organizational details and the Legacy Circle form."
    ctaLabel="Email the legacy team"
    ctaHref={`mailto:${SITE.emailGeneral}?subject=Legacy gift intent`}
    image="/images/field-2026/evangelism-8.webp"
    imageAlt="Training the next generation of leaders"
  />
</RedesignLayout>

<style>
  .lg-head { max-width: 720px; margin: 0 auto var(--space-10); text-align: center; }
  .acard-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-6); }
  @media (max-width: 600px) { .acard-grid { grid-template-columns: 1fr; } }
  .acard { background: var(--color-white); border-radius: var(--radius-card); padding: var(--space-6); border: 2px solid var(--accent, var(--color-gold)); box-shadow: var(--shadow-soft); }
  .acard h3 { margin: 0 0 var(--space-3); color: var(--color-green); font-size: 1.1rem; }
  .acard p { margin: 0; color: var(--color-ink-soft); line-height: 1.6; }
  .acard:nth-child(4n+1) { --accent: var(--color-gold-deep); }
  .acard:nth-child(4n+2) { --accent: var(--color-green-bright); }
  .acard:nth-child(4n+3) { --accent: var(--color-terracotta); }
  .acard:nth-child(4n+4) { --accent: var(--color-sage); }
  .legacy-checklist { list-style: none; padding: 0; margin: 0; display: grid; gap: var(--space-3); }
  .legacy-checklist li { position: relative; padding: var(--space-4) var(--space-5) var(--space-4) 52px; border-radius: var(--rd-radius); background: var(--color-cream); color: var(--color-ink-soft); line-height: 1.6; }
  .legacy-checklist li::before { content: '✓'; position: absolute; left: 20px; color: var(--color-green); font-weight: 900; }
  .legacy-faq { display: grid; gap: var(--space-3); }
  .legacy-faq details { padding: var(--space-5) var(--space-6); border: 1px solid rgba(31,58,26,.12); border-radius: var(--rd-radius); background: var(--color-white); }
  .legacy-faq summary { cursor: pointer; color: var(--color-green); font-weight: 800; }
  .legacy-faq p { color: var(--color-ink-soft); margin: var(--space-4) 0 0; line-height: 1.65; }
</style>
