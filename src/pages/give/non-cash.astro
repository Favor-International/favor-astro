---
import RedesignLayout from '../../layouts/RedesignLayout.astro';
import PageHero from '../../components/band/PageHero.astro';
import LeafHeading from '../../components/redesign/LeafHeading.astro';
import RdCta from '../../components/redesign/RdCta.astro';
import { SITE } from '../../lib/site';

// Real downloadable form from favorintl.org/connect-support/donate-now
const STOCK_FORM = '/documents/favor-international-stock-and-non-cash-assets-transfer-form-2022-updated-10.25-.pdf';
const assetFaqs = [
  { q: 'Should I sell the asset before giving it?', a: 'Do not make that decision from this page alone. Giving an asset and selling it first can have different tax consequences. Ask your qualified adviser which approach fits your circumstances.' },
  { q: 'Who determines the value of a non-cash gift?', a: 'Valuation requirements depend on the asset and applicable law. The donor is responsible for obtaining any required appraisal and tax advice; Favor cannot establish the donor’s deductible value.' },
  { q: 'Can Favor accept every real-estate or vehicle gift?', a: 'No acceptance should be assumed. Complex assets require review for ownership, condition, liabilities, marketability, restrictions, and the cost of receiving or disposing of the asset.' },
  { q: 'How will Favor identify my stock transfer?', a: 'Brokerage transfers may arrive without complete donor information. Notify Favor through a non-sensitive channel when the transfer is initiated, but do not email account numbers or private credentials.' },
  { q: 'Will I receive a receipt?', a: 'Favor can acknowledge an accepted contribution, but the contents and tax treatment of the receipt depend on the asset and transaction. Confirm documentation requirements with the team and your adviser.' },
  { q: 'Can I restrict a non-cash gift to one project?', a: 'A restriction must be accepted by Favor before the transfer. Confirm that the project is active and that the asset can be used or liquidated in a way that fulfills the proposed purpose.' },
  { q: 'What if Favor cannot accept the asset?', a: 'Do not transfer it. The team may be able to identify another giving vehicle, but neither Favor nor the donor should assume that every complex asset can be received.' },
];
---
<RedesignLayout
  title="Stocks, Crypto, and Non-Cash Giving"
  description="Donate appreciated stock, cryptocurrency, real estate, or other non-cash assets to Favor International."
>
  <PageHero
    label="Non-cash giving"
    title="Stocks. Crypto. Real estate. Vehicles."
    promise="A non-cash gift may fit your financial plan. Confirm the asset and current transfer route with the team before you send it."
    image="/images/ministry-medical-clinic.jpg"
    imageAlt="Partners gathering"
    variant="split"
  />

  <section class="band band--white">
    <div class="container">
      <LeafHeading label="Asset types" title="Start with the asset, then confirm the route." intro="Complex gifts are reviewed individually. Contact the team before transferring an asset and never email account numbers, private keys, or other sensitive financial information." />
      <div class="acard-grid">
        <article class="acard has-texture">
          <img src="/images/field-2026/education-5.webp" alt="A long-term investment in Favor's field work" loading="lazy" />
          <div class="acard__body">
          <h3>Appreciated stock</h3>
          <p>Appreciated stock may offer tax advantages depending on your circumstances. Review the gift with your adviser and use our <a href={STOCK_FORM} target="_blank" rel="noopener">Stock and Non-Cash Assets Transfer Form</a> to begin.</p>
          </div>
        </article>
        <article class="acard has-texture">
          <img src="/images/field-2026/radio-3.webp" alt="Technology carrying Favor's work further" loading="lazy" />
          <div class="acard__body">
          <h3>Cryptocurrency</h3>
          <p>Email {SITE.emailGeneral} for current instructions to give cryptocurrency.</p>
          </div>
        </article>
        <article class="acard has-texture">
          <img src="/images/field-2026/church-6.webp" alt="A building supporting ministry in the field" loading="lazy" />
          <div class="acard__body">
          <h3>Real estate, vehicles, equipment</h3>
          <p>Non-cash assets are handled case-by-case. Start with our <a href={STOCK_FORM} target="_blank" rel="noopener">Stock and Non-Cash Assets Transfer Form</a>, or email {SITE.emailGeneral} first.</p>
          </div>
        </article>
        <article class="acard has-texture">
          <img src="/images/field-2026/gift-4.webp" alt="Partners multiplying their impact together" loading="lazy" />
          <div class="acard__body">
          <h3>Matching gifts</h3>
          <p>Most large employers will match charitable gifts. Search your benefits portal for "Favor International" and EIN {SITE.ein}.</p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="band band--cream">
    <div class="container asset-prep">
      <div class="asset-prep__copy">
        <LeafHeading label="Before you transfer" title="Three steps protect you and the ministry." align="left" leaves={false} />
        <ol class="asset-steps">
          <li><strong>Ask.</strong><span>Contact Favor to confirm that the asset can be accepted and receive the current routing instructions.</span></li>
          <li><strong>Review.</strong><span>Consult your own tax, legal, or financial adviser about valuation and treatment.</span></li>
          <li><strong>Identify.</strong><span>Tell Favor when the transfer is initiated so the team can identify and acknowledge the gift.</span></li>
        </ol>
        <p class="asset-disclaimer">Favor does not provide legal, tax, or financial advice. The donor and the donor's advisers are responsible for valuation and personal tax decisions.</p>
      </div>
      <img class="asset-prep__image" src="/images/field-2026/agriculture-5.webp" alt="A Favor sustainability project supported through careful stewardship" loading="lazy" />
    </div>
  </section>

  <section class="band band--white"><div class="container container--narrow">
    <LeafHeading label="Questions" title="Before transferring an asset." leaves={false} />
    <div class="faq asset-faq">{assetFaqs.map((item) => <details><summary>{item.q}</summary><p>{item.a}</p></details>)}</div>
  </div></section>

  <RdCta
    heading="Start the non-cash gift."
    body="Email the executive team to confirm whether the asset can be accepted and request the current routing form."
    ctaLabel="Start the gift"
    ctaHref={`mailto:${SITE.emailGeneral}?subject=Non-cash gift`}
    image="/images/field-2026/bibles-2.webp"
    imageAlt="Bibles staged for distribution"
  />
</RedesignLayout>

<style>
  .nc-head { max-width: 720px; margin: 0 auto var(--space-10); text-align: center; }
  .acard-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-6); }
  @media (max-width: 760px) { .acard-grid { grid-template-columns: 1fr; } }
  .acard { background:transparent; }
  .acard img { display:block; width:100%; aspect-ratio:16/10; object-fit:cover; border-radius:var(--rd-radius); }
  .acard__body { padding:var(--space-5) var(--space-1) 0; }
  .acard h3 { margin: 0 0 var(--space-2); color: var(--color-green); font-size: 1.1rem; }
  .acard p { margin: 0; color: var(--color-ink-soft); line-height: 1.6; }
  .acard:nth-child(4n+1) { --accent: var(--color-gold-deep); }
  .acard:nth-child(4n+2) { --accent: var(--color-green-bright); }
  .acard:nth-child(4n+3) { --accent: var(--color-terracotta); }
  .acard:nth-child(4n+4) { --accent: var(--color-sage); }
  .asset-prep { display:grid; grid-template-columns:minmax(0,1.08fr) minmax(0,.92fr); gap:clamp(44px,7vw,104px); align-items:center; }
  .asset-prep__image { display:block; width:100%; min-height:620px; height:100%; object-fit:cover; border-radius:var(--rd-radius); }
  .asset-steps { list-style: none; padding: 0; margin: var(--space-8) 0; display: grid; gap: var(--space-4); }
  .asset-steps { counter-reset:asset-step; }
  .asset-steps li { counter-increment:asset-step; display:grid; grid-template-columns:44px 90px 1fr; gap:var(--space-4); align-items:start; padding:var(--space-5); background:var(--color-white); border-radius:var(--rd-radius); box-shadow:var(--rd-shadow); }
  .asset-steps li::before { content:'0' counter(asset-step); display:grid; place-items:center; width:38px; height:38px; border-radius:50%; background:var(--color-green); color:var(--color-gold-light); font-size:.75rem; font-weight:900; }
  .asset-steps strong { color: var(--color-green); }
  .asset-steps span, .asset-disclaimer { color: var(--color-ink-soft); line-height: 1.65; }
  .asset-disclaimer { font-size:.9rem; text-align:left; max-width:68ch; }
  .asset-faq { display: grid; gap: var(--space-3); }
  .asset-faq details { padding: var(--space-5) var(--space-6); border: 1px solid rgba(31,58,26,.12); border-radius: var(--rd-radius); }
  .asset-faq summary { cursor: pointer; color: var(--color-green); font-weight: 800; }
  .asset-faq p { color: var(--color-ink-soft); margin: var(--space-4) 0 0; line-height: 1.65; }
  @media (max-width: 900px) { .asset-prep { grid-template-columns:1fr; } .asset-prep__image { min-height:0; aspect-ratio:16/10; order:-1; } }
  @media (max-width: 560px) { .asset-steps li { grid-template-columns:40px 1fr; gap:var(--space-3); } .asset-steps li span { grid-column:2; } }
</style>
