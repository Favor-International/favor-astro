---
import RedesignLayout from '../../layouts/RedesignLayout.astro';
import PageHero from '../../components/band/PageHero.astro';
import RdFeature from '../../components/redesign/RdFeature.astro';
import RdCta from '../../components/redesign/RdCta.astro';
import LeafHeading from '../../components/redesign/LeafHeading.astro';
import { CTA } from '../../lib/cta';

const focuses = [
  { country: 'Uganda', ask: 'Pray for the PBS graduates traveling to plant in Karamoja.' },
  { country: 'South Sudan', ask: 'Pray for the Juba team as they enter cattle-camp regions long closed to the Gospel.' },
  { country: 'Chad', ask: 'Pray for protection and open doors. Pray specifically and frequently.' },
  { country: 'Ethiopia', ask: 'Pray for the Bibles being printed in Amharic. Pray for the hands they will reach.' },
  { country: 'Democratic Republic of Congo', ask: 'Pray for the church planting cohort working through trauma in eastern provinces.' },
  { country: 'Kenya', ask: 'Pray for partners and ambassadors who refer Favor to their networks.' },
];
---
<RedesignLayout
  title="Pray With Us"
  description="Pray where they cannot reach. Specific villages, specific pastors, specific battles. Get the 30-day prayer guide and stand in the gap with Favor International."
  image="/images/field/hero-prayer-ssudan.webp"
>
  <PageHero
    label="Pray"
    title="You can pray where they cannot reach."
    promise="Prayer is the first work of every Favor village. You can be part of it. Specific villages, specific pastors, specific battles."
    image="/images/field-2026/prayer-4.webp"
    imageAlt="Believers gathered in a South Sudan house of prayer"
    video="/videos/pray-hero.mp4"
    ctaLabel={CTA.prayerGuide}
    ctaHref="/pray/30-day-guide/"
    secondaryLabel="Email a prayer request"
    secondaryHref="mailto:prayer@favorintl.org"
  />

  <section class="band band--white">
    <div class="container container--narrow">
      <LeafHeading label="What we ask you to pray for" title="Six specific battles, one Kingdom outcome." intro="Prayer becomes more tangible when the place, people, and need have a name." />
      <ul class="focus-list">
        {focuses.map((f, index) => (
          <li>
            <span class="focus-list__number">0{index + 1}</span>
            <strong>{f.country}.</strong> {f.ask}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="band band--white prayer-quote-wrap"><div class="container prayer-quote">
    <p class="label">Field Leader · Lakes State, South Sudan</p>
    <blockquote>“The prayers from outside Sudan reached our village before the team did. We felt the protection in our bones.”</blockquote>
    <p>Cattle-camp church planted in 2025.</p>
  </div></section>

  <RdFeature
    image="/images/field-2026/prayer-5.webp"
    imageAlt="A Favor House of Prayer gathering"
    eyebrow="Houses of Prayer"
    heading="Where every Favor work begins."
    side="right"
    background="white"
    decor="leaf"
  >
    <p>Our Houses of Prayer in Gulu, Uganda, and in Juba, South Sudan were our first operational centers, before offices, schools, radio, or leadership training facilities. Prayer always comes first and then everything else follows.</p>
    <p>Our House of Prayer ministry teams do so much, from leading morning devotions and noon-hour prayers every weekday to all-night prayer events. They also launch local and rural outreaches and ministries on the streets, in hospitals, and in prisons. They provide a 24/7 prayer covering for new believers, organize pastors&rsquo; fellowships and national prayer gatherings, and coordinate local crusades.</p>
    <p>Through these activities and more, our HOP teams serve to bring unity in the community and amongst church and government leaders. Hundreds of believers from communities near and far come to hear from God. Miracles and answers to prayer are a daily occurrence. Many people discover Jesus&rsquo; love for the first time in these houses of prayer and from the outreaches that they operate.</p>
  </RdFeature>

  <section class="band band--cream">
    <div class="container">
      <LeafHeading label="From the field" title="Prayer in action." intro="Gathered prayer comes before outreach, discipleship, healing, and baptism." />
      <div class="field-gallery">
        <figure class="field-tile" style="background-image:url('/images/field-2026/prayer-9.webp')" role="img" aria-label="Believers in prayer at a Favor House of Prayer">
          <figcaption>A House of Prayer gathering</figcaption>
        </figure>
        <figure class="field-tile" style="background-image:url('/images/field-2026/prayer-10.webp')" role="img" aria-label="Intercession at a Favor prayer meeting">
          <figcaption>Intercession before the work begins</figcaption>
        </figure>
        <figure class="field-tile" style="background-image:url('/images/field-2026/prayer-gathering-3.webp')" role="img" aria-label="A national prayer gathering">
          <figcaption>A national prayer gathering</figcaption>
        </figure>
        <figure class="field-tile" style="background-image:url('/images/field-2026/baptism-8.webp')" role="img" aria-label="A baptism following prayer and evangelism">
          <figcaption>Prayer answered: new believers baptized</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <RdCta
    heading="Stand in the gap for the nations."
    body="One specific prayer focus per day, nation by nation, across the nations Favor serves. No email required."
    ctaLabel={CTA.prayerGuide}
    ctaHref="/pray/30-day-guide/"
    image="/images/field-2026/prayer-gathering-2.webp"
    imageAlt="Believers gathered in prayer"
  />
</RedesignLayout>

<style>
  .focus-list { list-style: none; padding: 0; margin: var(--space-8) 0 0; display:grid; grid-template-columns:repeat(2,1fr); gap:var(--space-6); }
  .focus-list li {
    position:relative; padding:var(--space-8); min-height:180px; overflow:hidden;
    background:var(--color-cream); border-radius:var(--rd-radius); color:var(--color-ink-soft); line-height:1.7;
  }
  .focus-list__number { position:absolute; right:18px; top:6px; color:color-mix(in srgb,var(--color-green) 12%,transparent); font-size:4.8rem; font-weight:900; line-height:1; }
  .focus-list strong { color: var(--color-green); }
  .prayer-quote-wrap { padding-block:clamp(44px,6vw,84px); }
  .prayer-quote { max-width:min(1080px,calc(100% - 32px)); padding:clamp(52px,7vw,92px); border-radius:clamp(24px,3vw,42px); background:var(--color-green); text-align:center; color:white; }
  .prayer-quote blockquote { max-width:800px; margin:var(--space-5) auto; border:0; padding:0; font-family:var(--font-sans); font-size:clamp(1.5rem,3vw,2.3rem); line-height:1.45; font-weight:650; }
  .prayer-quote > p:last-child { color:var(--color-gold-light); font-weight:800; }
  @media(max-width:720px){.focus-list{grid-template-columns:1fr}}
</style>
