---
import RedesignLayout from '../../layouts/RedesignLayout.astro';
import PageHero from '../../components/band/PageHero.astro';
import RdCta from '../../components/redesign/RdCta.astro';
import LeafHeading from '../../components/redesign/LeafHeading.astro';

const countries = [
  {
    name: 'Uganda',
    days: 'Days 1-10',
    image: '/images/field/country-uganda.webp',
    intro: 'Pray for the ministry teams serving from Gulu into cities, villages, schools, and cattle-herding communities.',
    prayers: [
      'Pray for the Gulu House of Prayer and for every gathering to remain rooted in Scripture and intercession.',
      'Pray for Portable Bible School trainers as they equip believers to disciple others.',
      'Pray for open doors, wise translators, and safe travel as teams serve Karamoja communities.',
      'Pray for teachers and students at Favor Primary School to grow in knowledge, character, and faith.',
      'Pray for Village Learning Center teachers bringing dependable learning close to children’s homes.',
      'Pray for trauma-counseling teams and for participants walking toward forgiveness and healing.',
      'Pray for medical staff serving families with practical care, health education, and prayer.',
      'Pray for women building skills, stable income, and strong homes through empowerment programs.',
      'Pray for local pastors and congregations to serve their communities with humility and courage.',
      'Pray for Favor’s Ugandan staff and their families: endurance, unity, provision, and rest.',
    ],
  },
  {
    name: 'South Sudan',
    days: 'Days 11-20',
    image: '/images/field/hero-prayer-ssudan.webp',
    intro: 'Pray for leaders serving from Juba into communities shaped by conflict, displacement, and deep spiritual hunger.',
    prayers: [
      'Pray for the Juba House of Prayer and for prayer to remain the foundation of every ministry response.',
      'Pray for Portable Bible School teachers traveling to communities with limited access to sustained Bible training.',
      'Pray for Taposa communities and former warriors hearing the Gospel through leaders who understand their language and culture.',
      'Pray for young people in GIFT to know safety, belonging, discipleship, and a hopeful path forward.',
      'Pray for Favor’s school leaders, teachers, students, and families in Juba.',
      'Pray for trauma-counseling participants carrying the wounds of conflict and loss.',
      'Pray for medical teams bringing care and health education where services are limited.',
      'Pray for new believers to be discipled and connected to healthy, locally led churches.',
      'Pray for displaced families and for ministry teams serving them with wisdom and compassion.',
      'Pray for Favor’s South Sudanese staff and their families: protection, provision, unity, and strength.',
    ],
  },
  {
    name: 'Chad',
    days: 'Days 21-30',
    image: '/images/field/country-chad.webp',
    intro: 'Pray for the growing work in Chad and for national leaders carrying prayer, discipleship, and the Gospel forward.',
    prayers: [
      'Pray for the House of Prayer in N’Djamena to strengthen believers and serve the city faithfully.',
      'Pray for protection, discernment, and endurance for Favor’s team on the ground.',
      'Pray for trusted relationships with local pastors, churches, and community leaders.',
      'Pray for Portable Bible School teachers as they train believers to understand and share Scripture.',
      'Pray for clear communication across languages and for teaching to be understood and remembered.',
      'Pray for new believers to receive patient follow-up, sound discipleship, and Christian community.',
      'Pray for families and young people to encounter the hope and love of Jesus.',
      'Pray for wisdom as field leaders respond to changing needs and opportunities.',
      'Pray for national leaders to be equipped to train and send others from their own communities.',
      'Pray for lasting fruit in Chad: transformed hearts, healthy churches, and faithful disciples who multiply.',
    ],
  },
];
---
<RedesignLayout
  title="30-Day Nations Prayer Guide"
  description="Thirty focused days of prayer for Favor International’s work in Uganda, South Sudan, and Chad."
>
  <PageHero waveColor="cream"
    label="30-day prayer guide"
    title="Three nations. Thirty days of focused prayer."
    promise="Pray with Favor’s teams in Uganda, South Sudan, and Chad—one clear ministry focus at a time."
    image="/images/field-2026/prayer-1.webp"
    imageAlt="Favor leaders gathered in prayer"
    ctaLabel="Start with Uganda"
    ctaHref="#uganda"
    variant="split"
  />

  <section class="band band--white guide-intro"><div class="container">
    <LeafHeading label="A daily rhythm" title="Name the nation. Name the ministry. Pray specifically." intro="Use one focus each day on your own, around the family table, or with a church prayer group. The guide moves through ten days for each of Favor’s three public country fields." />
    <nav class="country-nav" aria-label="Prayer guide countries">
      {countries.map((country, index) => (
        <a href={`#${country.name.toLowerCase().replaceAll(' ', '-')}`} class="country-card">
          <img src={country.image} alt={`Favor ministry in ${country.name}`} loading="lazy" />
          <span class="country-card__shade"></span>
          <span class="country-card__number">0{index + 1}</span>
          <span class="country-card__copy"><strong>{country.name}</strong><small>{country.days}</small></span>
        </a>
      ))}
    </nav>
  </div></section>

  {countries.map((country, countryIndex) => (
    <section class:list={['band', countryIndex % 2 === 0 ? 'band--cream' : 'band--white', 'country-guide']} id={country.name.toLowerCase().replaceAll(' ', '-') }>
      <div class="container country-guide__layout">
        <header class="country-guide__head">
          <p class="label">{country.days}</p>
          <h2>{country.name}.</h2>
          <p>{country.intro}</p>
          <img src={country.image} alt={`Favor teams serving in ${country.name}`} loading="lazy" />
        </header>
        <ol class="prayer-list" start={countryIndex * 10 + 1}>
          {country.prayers.map((ask, prayerIndex) => {
            const day = countryIndex * 10 + prayerIndex + 1;
            return <li id={`day-${day}`}><span class="prayer-list__day">Day {day}</span><span class="prayer-list__ask">{ask}</span></li>;
          })}
        </ol>
      </div>
    </section>
  ))}

  <section class="band band--cream guide-actions"><div class="container container--narrow">
    <LeafHeading label="Keep it close" title="Print the guide and pray through it again." intro="Prayer is not a campaign that expires. Return to these thirty focuses with your family, small group, or church." leaves={false} />
    <p><button class="btn btn--primary btn--large" type="button" onclick="window.print()">Print this guide</button></p>
  </div></section>

  <RdCta
    heading="Send a prayer request to our team."
    body="Email prayer@favorintl.org. A real person reads it, and Favor’s prayer team will stand with you."
    ctaLabel="Email a prayer request"
    ctaHref="mailto:prayer@favorintl.org"
    image="/images/field/worship-uganda.webp"
    imageAlt="Hands raised in worship at a Favor house of prayer in Uganda"
    background="cream"
  />
</RedesignLayout>

<style>
  .country-nav { display:grid; grid-template-columns:repeat(3,1fr); gap:var(--space-5); margin-top:var(--space-10); }
  .country-card { position:relative; min-height:340px; overflow:hidden; border-radius:var(--rd-radius); color:white; text-decoration:none; isolation:isolate; }
  .country-card img { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; transition:transform .35s ease; }
  .country-card:hover img { transform:scale(1.035); }
  .country-card__shade { position:absolute; inset:0; background:linear-gradient(180deg,rgba(19,55,26,.04) 25%,rgba(19,55,26,.9) 100%); }
  .country-card__number { position:absolute; top:20px; right:22px; font-size:3.5rem; line-height:1; font-weight:900; color:rgba(255,255,255,.48); }
  .country-card__copy { position:absolute; left:28px; right:28px; bottom:26px; display:flex; flex-direction:column; gap:4px; }
  .country-card__copy strong { font-family:var(--font-display); font-size:clamp(1.5rem,2.5vw,2.1rem); }
  .country-card__copy small { color:var(--color-gold-light); font-weight:800; letter-spacing:.12em; text-transform:uppercase; }
  .country-guide { scroll-margin-top:100px; }
  .country-guide__layout { display:grid; grid-template-columns:minmax(280px,.72fr) minmax(0,1.28fr); gap:clamp(42px,7vw,96px); align-items:start; }
  .country-guide__head { position:sticky; top:110px; }
  .country-guide__head h2 { color:var(--color-green-deep); margin:var(--space-2) 0 var(--space-4); font-size:clamp(2.6rem,5vw,4.8rem); }
  .country-guide__head > p:not(.label) { color:var(--color-ink-soft); line-height:1.75; }
  .country-guide__head img { width:100%; aspect-ratio:4/3; object-fit:cover; border-radius:var(--rd-radius); margin-top:var(--space-6); }
  .prayer-list { list-style:none; padding:0; margin:0; display:grid; gap:var(--space-3); counter-reset:none; }
  .prayer-list li { display:grid; grid-template-columns:88px 1fr; gap:var(--space-5); align-items:start; padding:var(--space-5) var(--space-6); background:var(--color-white); border-radius:var(--rd-radius); box-shadow:0 10px 30px rgba(31,58,26,.07); }
  .band--white .prayer-list li { background:var(--color-cream); }
  .prayer-list li:nth-child(4n+1) { --accent:var(--color-green); }
  .prayer-list li:nth-child(4n+2) { --accent:var(--color-gold-deep); }
  .prayer-list li:nth-child(4n+3) { --accent:var(--color-terracotta); }
  .prayer-list li:nth-child(4n+4) { --accent:var(--color-sage); }
  .prayer-list__day { display:grid; place-items:center; min-height:42px; border-radius:var(--radius-pill); background:var(--accent); color:white; font-weight:800; letter-spacing:.05em; font-size:.75rem; text-transform:uppercase; }
  .prayer-list__ask { color:var(--color-ink-soft); line-height:1.7; }
  .guide-actions { text-align:center; }
  .guide-actions p { margin:var(--space-8) 0 0; }
  @media(max-width:820px){
    .country-nav{grid-template-columns:1fr}.country-card{min-height:280px}
    .country-guide__layout{grid-template-columns:1fr}.country-guide__head{position:static}.country-guide__head img{max-height:360px}
  }
  @media(max-width:560px){.prayer-list li{grid-template-columns:1fr;gap:var(--space-2)}}
  @media print {
    :global(.site-header), :global(.site-footer), :global(.rd-cta), .country-nav, .guide-actions, .country-guide__head img { display:none !important; }
    .country-guide { break-before:page; padding:28px 0; }
    .country-guide__layout { display:block; }
    .country-guide__head { position:static; }
    .prayer-list li { break-inside:avoid; box-shadow:none; border:1px solid #ddd; padding:12px 16px; }
  }
</style>
