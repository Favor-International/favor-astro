---
import RedesignLayout from '../../layouts/RedesignLayout.astro';
---
<RedesignLayout
  title="From Intimacy to Intercession: A Prayer Workbook"
  description="Download the 48-page prayer workbook with teachings, testimonies, and guided prayer from the ministry of Carole Ward."
  image="/images/intimacy-to-intercession-cover.webp"
>
  <section class="workbook band band--cream" aria-labelledby="workbook-title">
    <div class="container workbook__layout">
      <img class="workbook__cover" src="/images/intimacy-to-intercession-cover.webp" width="918" height="1188" alt="From Intimacy to Intercession prayer workbook cover, with a cross overlooking a city" fetchpriority="high" />
      <div class="workbook__details">
        <p class="label">A prayer workbook</p>
        <h1 id="workbook-title">From Intimacy to Intercession</h1>
        <p class="workbook__description">Pray through five teachings from the ministry of Carole Ward, with testimonies from the mission field, reflection questions, and guided prayer. The workbook includes space for notes, a fasting and prayer-week schedule, and a small-group leader&rsquo;s guide.</p>
        <a class="btn btn--primary btn--large" href="/downloads/from-intimacy-to-intercession-prayer-workbook.pdf" download>Download the workbook</a>
        <p class="workbook__meta">PDF &middot; 48 pages &middot; 3.9 MB</p>
      </div>
    </div>
  </section>
</RedesignLayout>

<style>
  .workbook__layout { display: grid; grid-template-columns: minmax(0, 0.85fr) minmax(0, 1fr); gap: clamp(36px, 6vw, 88px); align-items: center; max-width: 1120px; }
  .workbook__cover { display: block; width: 100%; height: auto; max-width: 420px; box-shadow: 0 16px 40px rgba(31, 58, 26, 0.16); }
  .workbook__details h1 { margin: 16px 0 24px; text-wrap: balance; }
  .workbook__description { color: var(--color-ink-soft); margin-bottom: 32px; }
  .workbook__meta { margin-top: 16px; font-size: var(--rd-fs-small); color: var(--color-ink-soft); }
  @media (max-width: 700px) {
    .workbook__layout { grid-template-columns: minmax(0, 1fr); }
    .workbook__cover { max-width: 300px; margin-inline: auto; }
    .workbook__details .btn { width: 100%; text-align: center; }
  }
</style>
