---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../lib/site';

// =====================================================================
// PARTNER PORTAL — simulated login experience (demo).
// The Log In button in the site header lands here. Any email/password
// "signs in": a short authenticating spinner plays, then the card swaps
// to a "Partner Portal is coming soon" preview listing what partners
// will find here at launch. Nothing is stored or sent anywhere — the
// form never leaves the browser. Replace the script's fake auth with a
// real auth flow when the portal ships.
// =====================================================================
---
<BaseLayout
  title="Partner Portal"
  description="Log in to the Favor Partner Portal."
  noindex
>
  <main id="main" class="portal">

    <!-- Field photo side panel (decorative) -->
    <aside class="portal__side" aria-hidden="true">
      <img class="portal__side-photo" src="/images/field-2026/prayer-7.webp" alt="" loading="eager" />
      <div class="portal__side-scrim"></div>
      <blockquote class="portal__quote">
        <p class="portal__quote-text">&ldquo;Send me where no one else will go.&rdquo;</p>
        <footer class="portal__quote-attr">
          <span class="portal__quote-name">Carole Ward</span>
          <span class="portal__quote-role">Founder, Favor International</span>
        </footer>
      </blockquote>
    </aside>

    <!-- Auth pane -->
    <section class="portal__pane">
      <a class="portal__brand" href="/" aria-label={`${SITE.name} home`}>
        <img src="/images/favor-logo-color.png" alt={SITE.name} width="1358" height="443" />
      </a>

      <!-- STATE 1: sign-in card -->
      <div class="portal__card" data-portal-login>
        <p class="portal__eyebrow">Partner Portal</p>
        <h1 class="portal__h1">Welcome back, Partner.</h1>
        <p class="portal__sub">Sign in to see the impact of your partnership.</p>

        <form class="portal__form" data-portal-form>
          <label class="portal__field">
            <span class="portal__field-label">Email address</span>
            <input type="email" name="email" autocomplete="email" placeholder="you@example.com" required />
          </label>
          <label class="portal__field">
            <span class="portal__field-label">Password</span>
            <input type="password" name="password" autocomplete="current-password" placeholder="&bull;&bull;&bull;&bull;&bull;&bull;&bull;&bull;" required />
          </label>
          <div class="portal__row">
            <label class="portal__remember">
              <input type="checkbox" name="remember" checked />
              <span>Remember me</span>
            </label>
            <button class="portal__forgot" type="button" data-portal-forgot>Forgot password?</button>
          </div>
          <button class="portal__submit" type="submit" data-portal-submit>
            <span class="portal__submit-spinner" aria-hidden="true"></span>
            <span class="portal__submit-label" data-portal-submit-label>Sign in</span>
          </button>
          <p class="portal__hint" data-portal-hint hidden>Password reset arrives with the portal launch &mdash; stay tuned.</p>
        </form>

        <!-- Points at the homepage giving section (not /give/…) so the
             exec-preview demo stays inside the neutered-home bubble. -->
        <p class="portal__foot">Not a partner yet? <a href="/#give">Become one &rarr;</a></p>
      </div>

      <!-- STATE 2: coming-soon card (revealed after the simulated sign-in) -->
      <div class="portal__card portal__card--soon" data-portal-soon hidden>
        <div class="portal__check" aria-hidden="true">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none">
            <path d="M4 12.5l5.5 5.5L20 7" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </div>
        <p class="portal__eyebrow">You&rsquo;re in early</p>
        <h2 class="portal__h1" data-portal-soon-heading tabindex="-1">The Partner Portal is coming soon.</h2>
        <p class="portal__sub" data-portal-greeting>
          We&rsquo;re building a home for everything your partnership makes possible. Here&rsquo;s what you&rsquo;ll find at launch:
        </p>
        <ul class="portal__features">
          <li>
            <span class="portal__lock" aria-hidden="true">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none"><rect x="5" y="10.5" width="14" height="9.5" rx="2" stroke="currentColor" stroke-width="2"/><path d="M8 10V7.5a4 4 0 0 1 8 0V10" stroke="currentColor" stroke-width="2"/></svg>
            </span>
            <span><strong>Giving history &amp; tax receipts</strong> &mdash; every gift, every year-end statement, in one place.</span>
          </li>
          <li>
            <span class="portal__lock" aria-hidden="true">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none"><rect x="5" y="10.5" width="14" height="9.5" rx="2" stroke="currentColor" stroke-width="2"/><path d="M8 10V7.5a4 4 0 0 1 8 0V10" stroke="currentColor" stroke-width="2"/></svg>
            </span>
            <span><strong>Impact reports from the field</strong> &mdash; see what your partnership did this quarter.</span>
          </li>
          <li>
            <span class="portal__lock" aria-hidden="true">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none"><rect x="5" y="10.5" width="14" height="9.5" rx="2" stroke="currentColor" stroke-width="2"/><path d="M8 10V7.5a4 4 0 0 1 8 0V10" stroke="currentColor" stroke-width="2"/></svg>
            </span>
            <span><strong>Prayer updates from missionaries</strong> &mdash; pray with the people you send, by name.</span>
          </li>
          <li>
            <span class="portal__lock" aria-hidden="true">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none"><rect x="5" y="10.5" width="14" height="9.5" rx="2" stroke="currentColor" stroke-width="2"/><path d="M8 10V7.5a4 4 0 0 1 8 0V10" stroke="currentColor" stroke-width="2"/></svg>
            </span>
            <span><strong>Manage your partnership</strong> &mdash; update your gift, payment method, and preferences anytime.</span>
          </li>
        </ul>
        <a class="portal__back" href="/">&larr; Back to the homepage</a>
      </div>

    </section>
  </main>
</BaseLayout>

<script>
  // Simulated sign-in: accept anything, show an authenticating spinner,
  // then reveal the coming-soon card. Credentials never leave the page.
  const form = document.querySelector<HTMLFormElement>('[data-portal-form]');
  const loginCard = document.querySelector<HTMLElement>('[data-portal-login]');
  const soonCard = document.querySelector<HTMLElement>('[data-portal-soon]');
  const submitBtn = document.querySelector<HTMLButtonElement>('[data-portal-submit]');
  const submitLabel = document.querySelector<HTMLElement>('[data-portal-submit-label]');
  const greeting = document.querySelector<HTMLElement>('[data-portal-greeting]');
  const soonHeading = document.querySelector<HTMLElement>('[data-portal-soon-heading]');

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!form.reportValidity() || !submitBtn) return;

    const email = (form.elements.namedItem('email') as HTMLInputElement | null)?.value?.trim();

    submitBtn.disabled = true;
    submitBtn.classList.add('is-authing');
    if (submitLabel) submitLabel.textContent = 'Signing you in…';

    setTimeout(() => {
      if (greeting && email) {
        greeting.innerHTML = `Signed in as <strong>${email.replace(/[<>&"]/g, '')}</strong>. We’re building a home for everything your partnership makes possible. Here’s what you’ll find at launch:`;
      }
      if (loginCard) loginCard.hidden = true;
      if (soonCard) {
        soonCard.hidden = false;
        soonCard.classList.add('is-revealed');
      }
      soonHeading?.focus();
    }, 1400);
  });

  // "Forgot password?" — friendly inline note instead of a dead end.
  const forgot = document.querySelector<HTMLButtonElement>('[data-portal-forgot]');
  const hint = document.querySelector<HTMLElement>('[data-portal-hint]');
  forgot?.addEventListener('click', () => {
    if (hint) hint.hidden = !hint.hidden;
  });
</script>

<style>
  .portal {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    min-height: 100vh;
    min-height: 100dvh;
    background: var(--color-cream);
  }

  /* ===== Photo side ===== */
  .portal__side {
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
  }
  .portal__side-photo {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    display: block;
  }
  .portal__side-scrim {
    position: absolute; inset: 0;
    background: linear-gradient(200deg,
      rgba(11, 64, 36, 0.18) 0%,
      rgba(11, 64, 36, 0.42) 55%,
      rgba(11, 64, 36, 0.86) 100%);
  }
  .portal__quote {
    position: relative;
    margin: 0;
    padding: clamp(var(--space-8), 5vw, var(--space-16));
    color: var(--color-white);
  }
  .portal__quote-text {
    margin: 0 0 var(--space-4) 0;
    font-family: var(--font-script);
    font-weight: 600;
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    line-height: 1.2;
  }
  .portal__quote-attr { display: flex; flex-direction: column; gap: 2px; }
  .portal__quote-name {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--color-gold);
  }
  .portal__quote-role {
    font-size: 0.82rem;
    color: color-mix(in srgb, var(--color-white) 78%, transparent);
  }

  /* ===== Auth pane ===== */
  .portal__pane {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-8);
    padding: clamp(var(--space-8), 6vw, var(--space-16)) var(--space-6);
  }
  .portal__brand img { height: 64px; width: auto; display: block; }

  .portal__card {
    width: 100%;
    max-width: 460px;
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    box-shadow: 0 18px 48px rgba(31, 58, 26, 0.10);
    padding: clamp(var(--space-8), 4vw, var(--space-12));
  }
  .portal__eyebrow {
    margin: 0 0 var(--space-3) 0;
    font-family: var(--font-sans);
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--color-gold-deep);
  }
  .portal__h1 {
    margin: 0 0 var(--space-3) 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.7rem, 3vw, 2.1rem);
    line-height: 1.12;
    letter-spacing: -0.015em;
    color: var(--color-green-deep);
  }
  .portal__h1:focus { outline: none; }
  .portal__sub {
    margin: 0 0 var(--space-6) 0;
    color: var(--color-ink-soft);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .portal__form { display: grid; gap: var(--space-4); }
  .portal__field { display: grid; gap: 6px; }
  .portal__field-label {
    font-family: var(--font-sans);
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-green);
  }
  .portal__field input {
    font: inherit;
    font-size: 0.95rem;
    color: var(--color-ink);
    background: var(--color-cream);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-input);
    padding: 13px 14px;
    transition: border-color 140ms, box-shadow 140ms, background 140ms;
  }
  .portal__field input:focus {
    outline: none;
    background: var(--color-white);
    border-color: var(--color-gold);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-gold) 25%, transparent);
  }

  .portal__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    flex-wrap: wrap;
  }
  .portal__remember {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.85rem;
    color: var(--color-ink-soft);
    cursor: pointer;
  }
  .portal__remember input { accent-color: var(--color-green); width: 16px; height: 16px; }
  .portal__forgot {
    background: none;
    border: 0;
    padding: 0;
    font: inherit;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-green);
    cursor: pointer;
    border-bottom: 1px solid var(--color-gold);
    padding-bottom: 1px;
    transition: color 140ms;
  }
  .portal__forgot:hover { color: var(--color-gold-deep); }

  .portal__submit {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    margin-top: var(--space-2);
    border: 0;
    border-radius: 999px;
    padding: 16px 24px;
    font-family: var(--font-sans);
    font-size: 0.9rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-green-deep);
    background: var(--color-gold);
    cursor: pointer;
    box-shadow: 0 10px 24px rgba(225, 167, 48, 0.35);
    transition: background 140ms, transform 140ms, box-shadow 140ms, opacity 140ms;
  }
  .portal__submit:hover:not(:disabled) {
    background: color-mix(in srgb, var(--color-gold) 88%, var(--color-ink));
    transform: translateY(-1px);
    box-shadow: 0 14px 30px rgba(225, 167, 48, 0.4);
  }
  .portal__submit:disabled { cursor: default; opacity: 0.85; }
  .portal__submit-spinner {
    display: none;
    width: 16px; height: 16px;
    border: 2px solid color-mix(in srgb, var(--color-green-deep) 30%, transparent);
    border-top-color: var(--color-green-deep);
    border-radius: 50%;
    animation: portal-spin 700ms linear infinite;
  }
  .portal__submit.is-authing .portal__submit-spinner { display: inline-block; }
  @keyframes portal-spin { to { transform: rotate(360deg); } }

  .portal__hint {
    margin: 0;
    font-size: 0.82rem;
    color: var(--color-sage);
    text-align: center;
  }

  .portal__foot {
    margin: var(--space-6) 0 0 0;
    font-size: 0.88rem;
    color: var(--color-ink-soft);
    text-align: center;
  }
  .portal__foot a {
    color: var(--color-green);
    font-weight: 700;
    text-decoration: none;
    border-bottom: 1px solid var(--color-gold);
    padding-bottom: 1px;
  }
  .portal__foot a:hover { color: var(--color-gold-deep); }

  /* ===== Coming-soon card ===== */
  .portal__card--soon.is-revealed { animation: portal-reveal 420ms ease-out; }
  @keyframes portal-reveal {
    from { opacity: 0; transform: translateY(14px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .portal__check {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 52px; height: 52px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--color-green-bright) 14%, var(--color-white));
    color: var(--color-green);
    border: 2px solid color-mix(in srgb, var(--color-green-bright) 45%, transparent);
    margin-bottom: var(--space-5);
  }
  .portal__features {
    list-style: none;
    margin: 0 0 var(--space-8) 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
  }
  .portal__features li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    background: var(--color-cream);
    border: 1px solid var(--color-border);
    border-radius: 10px;
    font-size: 0.88rem;
    line-height: 1.55;
    color: var(--color-ink-soft);
  }
  .portal__features strong { color: var(--color-green-deep); }
  .portal__lock {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 26px; height: 26px;
    margin-top: 2px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--color-gold) 18%, var(--color-white));
    color: var(--color-gold-deep);
    border: 1px solid color-mix(in srgb, var(--color-gold) 45%, transparent);
  }
  .portal__back {
    display: inline-block;
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--color-green);
    text-decoration: none;
    border-bottom: 1px solid var(--color-gold);
    padding-bottom: 2px;
    transition: color 140ms;
  }
  .portal__back:hover { color: var(--color-gold-deep); }

  /* ===== Responsive ===== */
  @media (max-width: 900px) {
    .portal { grid-template-columns: 1fr; }
    .portal__side { display: none; }
  }
</style>
