---
import RedesignLayout from '../../layouts/RedesignLayout.astro';
import LeafHeading from '../../components/redesign/LeafHeading.astro';
import RdCta from '../../components/redesign/RdCta.astro';
import { SITE } from '../../lib/site';
import teachings from '../../data/teachings.json';
import inventory from '../../../docs/06-reference/youtube-inventory-2026-08-07.json';

// The Favor video library, styled as a streaming app: near-black canvas,
// billboard hero, a liquid-glass command bar with search (Cmd+K), tile rows
// that scale on hover, and a Most Watched row ranked by real YouTube views.
// Every card opens a real, verified video in the on-page player. Data lives
// in src/data/teachings.json; edit the library there, not here.
const featured = teachings.featured;
const rows = teachings.rows;

const FAVOUR_FM = 'https://zeno.fm/radio/favour-fm/';
const YOUTUBE_CHANNEL = 'https://www.youtube.com/c/FavorInternational';

// Most Watched: rank every placed video by its actual channel view count.
// Externals have no inventory row, so this is Favor's own channel only.
const viewsById = new Map<string, number>(
  inventory.uploads.map((u: { id: string; views: number | null }) => [u.id, u.views ?? 0])
);
type Item = { id: string; title: string; minutes?: number };
const placed = new Map<string, Item>();
for (const row of rows) for (const item of row.items as Item[]) placed.set(item.id, item);
const mostWatched = [...placed.values()]
  .filter((v) => (viewsById.get(v.id) ?? 0) > 0)
  .sort((a, b) => (viewsById.get(b.id) ?? 0) - (viewsById.get(a.id) ?? 0))
  .slice(0, 10);

type Resource = { title: string; body: string; href: string; cta: string; external?: boolean };
const resources: Resource[] = [
  { title: 'Books', body: 'Send Me Where No One Wants to Go and its 2025 sequel. Both free on request.', href: '/books/', cta: 'See the books' },
  { title: 'Nations Prayer Guide', body: 'One specific request a day, thirty days, across the nations Favor serves.', href: '/pray/30-day-guide/', cta: 'Open the guide' },
  { title: 'Pray with Favor', body: 'How Favor prays, and how your prayers join the field teams.', href: '/pray/', cta: 'Start praying' },
  { title: 'GIFT', body: 'The residential discipleship school for former child soldiers and street kids.', href: '/impact/evangelism-discipleship/gift-institute/', cta: 'About GIFT' },
  { title: 'Portable Bible Schools', body: 'Three months of Bible training carried village to village.', href: '/impact/evangelism-discipleship/portable-bible-schools/', cta: 'About the schools' },
  { title: 'Leadership Training Institute', body: 'Training the leaders who carry the movement forward.', href: '/impact/education/leadership/', cta: 'About the institute' },
  { title: 'Favour FM', body: 'Favor’s own radio station, live from northern Uganda. Teaching, prayer, and music around the clock.', href: FAVOUR_FM, cta: 'Listen live', external: true },
];

const socials = [
  { label: 'YouTube', href: SITE.social.youtube },
  { label: 'Facebook', href: SITE.social.facebook },
  { label: 'Instagram', href: SITE.social.instagram },
  { label: 'X', href: SITE.social.twitter },
];
---
<RedesignLayout
  title="Learn"
  description="The Favor video library: Carole Ward's teachings, field films, and testimonies, free to watch right here. New videos added all the time."
>
  <div class="lib-app">
    <!-- Billboard: the featured video, playable on the spot. -->
    <section class="lib-hero">
      <img
        class="lib-hero__backdrop"
        src="/images/field-2026/carole-4.webp"
        alt=""
        width="1600"
        height="902"
        fetchpriority="high"
        decoding="async"
      />
      <div class="lib-hero__scrim" aria-hidden="true"></div>
      <div class="container lib-hero__inner">
        <p class="label label--inverse">Learn &middot; Featured</p>
        <h1>{featured.title}</h1>
        <p class="lib-hero__meta">Vision Video &middot; Her story on film</p>
        <p class="lib-hero__blurb">{featured.blurb}</p>
        <div class="lib-hero__cta">
          <button
            class="btn btn--primary btn--large lib-play-btn"
            type="button"
            data-video-id={featured.id}
            data-video-title={featured.title}
          >
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M8 5v14l11-7z"/></svg>
            Play
          </button>
          <a class="lib-hero__secondary" href="#library">Browse the library &rarr;</a>
        </div>
      </div>
    </section>

    <!-- The library. -->
    <section class="lib" id="library">
      <!-- Liquid-glass command bar: search plus row jumps, stuck under the header. -->
      <div class="lib-bar" id="lib-bar">
        <div class="container lib-bar__inner">
          <div class="lib-bar__glass">
            <label class="lib-search">
              <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"/><path d="M20 20l-3.8-3.8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
              <input
                id="lib-search-input"
                type="search"
                placeholder="Search the library"
                autocomplete="off"
                spellcheck="false"
                aria-label="Search the video library"
              />
              <kbd class="lib-search__kbd" aria-hidden="true">⌘K</kbd>
            </label>
            <nav class="lib-bar__chips" aria-label="Library rows">
              <a class="lib__chip" href="#most-watched">Most Watched</a>
              {rows.map((row) => (
                <a class="lib__chip" href={`#${row.key}`}>{row.title}</a>
              ))}
            </nav>
          </div>
          <p class="lib-bar__status" id="lib-search-status" role="status" aria-live="polite"></p>
        </div>
      </div>

      <!-- Most Watched: ranked by real view counts on Favor's channel. -->
      <section class="lib-row lib-row--first lib-row--ranked" id="most-watched" aria-label="Most Watched">
        <div class="container lib-row__head">
          <h3>Most Watched</h3>
        </div>
        <div class="lib-row__wrap">
          <button class="lib-row__arrow lib-row__arrow--prev" type="button" aria-label="Scroll Most Watched back" data-dir="-1">
            <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" d="M15 6l-6 6 6 6"/></svg>
          </button>
          <ul class="lib-rail" role="list">
            {mostWatched.map((v, i) => (
              <li class="lib-rail__item lib-rank">
                <span class="lib-rank__num" aria-hidden="true">{i + 1}</span>
                <button
                  class="lib-card"
                  type="button"
                  data-video-id={v.id}
                  data-video-title={v.title}
                  data-search={v.title.toLowerCase()}
                  aria-label={`Most watched number ${i + 1}: play ${v.title}`}
                >
                  <span class="lib-card__thumb">
                    <img src={`https://i.ytimg.com/vi/${v.id}/hqdefault.jpg`} alt="" loading="lazy" decoding="async" width="480" height="360" />
                    {v.minutes && <span class="lib-card__time">{v.minutes} min</span>}
                    <span class="lib-card__overlay" aria-hidden="true"><span class="lib-card__overlay-title">{v.title}</span></span>
                    <span class="lib-card__play" aria-hidden="true">
                      <svg viewBox="0 0 24 24" width="22" height="22"><path fill="currentColor" d="M8 5v14l11-7z"/></svg>
                    </span>
                  </span>
                  <span class="lib-card__title">{v.title}</span>
                </button>
              </li>
            ))}
          </ul>
          <button class="lib-row__arrow lib-row__arrow--next" type="button" aria-label="Scroll Most Watched forward" data-dir="1">
            <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" d="M9 6l6 6-6 6"/></svg>
          </button>
        </div>
      </section>

      {rows.map((row) => (
        <section class="lib-row" id={row.key} aria-label={row.title}>
          <div class="container lib-row__head">
            <h3>{row.title}</h3>
          </div>
          <div class="lib-row__wrap">
            <button class="lib-row__arrow lib-row__arrow--prev" type="button" aria-label={`Scroll ${row.title} back`} data-dir="-1">
              <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" d="M15 6l-6 6 6 6"/></svg>
            </button>
            <ul class="lib-rail" role="list">
              {row.items.map((v) => {
                const minutes = (v as { minutes?: number }).minutes;
                return (
                  <li class="lib-rail__item">
                    <button
                      class="lib-card"
                      type="button"
                      data-video-id={v.id}
                      data-video-title={v.title}
                      data-search={v.title.toLowerCase()}
                      aria-label={minutes ? `Play ${v.title}, ${minutes} minutes` : `Play ${v.title}`}
                    >
                      <span class="lib-card__thumb">
                        <img src={`https://i.ytimg.com/vi/${v.id}/hqdefault.jpg`} alt="" loading="lazy" decoding="async" width="480" height="360" />
                        {minutes && <span class="lib-card__time">{minutes} min</span>}
                        <span class="lib-card__overlay" aria-hidden="true"><span class="lib-card__overlay-title">{v.title}</span></span>
                        <span class="lib-card__play" aria-hidden="true">
                          <svg viewBox="0 0 24 24" width="22" height="22"><path fill="currentColor" d="M8 5v14l11-7z"/></svg>
                        </span>
                      </span>
                      <span class="lib-card__title">{v.title}</span>
                    </button>
                  </li>
                );
              })}
            </ul>
            <button class="lib-row__arrow lib-row__arrow--next" type="button" aria-label={`Scroll ${row.title} forward`} data-dir="1">
              <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" d="M9 6l6 6-6 6"/></svg>
            </button>
          </div>
        </section>
      ))}

      <p class="lib-empty container" id="lib-empty" hidden>
        Nothing matches that search. Try prayer, warfare, school, or a country.
      </p>

      <div class="container lib__footer">
        <a href={YOUTUBE_CHANNEL} target="_blank" rel="noopener">Watch the full channel on YouTube &rarr;</a>
      </div>
    </section>
  </div>

  <!-- Secondary strip: the non-video ways to learn. -->
  <section class="band band--cream" id="resources">
    <div class="container">
      <LeafHeading
        label="Beyond the videos"
        title="More ways to learn."
        intro="Books, prayer guides, and the schools where this teaching runs on the field every day."
      />
      <div class="lib-resources">
        {resources.map((r) => (
          <article class="lib-resource has-texture">
            <h3>{r.title}</h3>
            <p>{r.body}</p>
            {r.external
              ? <a href={r.href} target="_blank" rel="noopener">{r.cta} &rarr;</a>
              : <a href={r.href}>{r.cta} &rarr;</a>}
          </article>
        ))}
        <article class="lib-resource lib-resource--social has-texture">
          <h3>Follow Favor</h3>
          <p>New teachings, testimonies, and field updates as they land.</p>
          <ul class="lib-resource__socials" role="list">
            {socials.map((s) => (
              <li><a href={s.href} target="_blank" rel="noopener">{s.label}</a></li>
            ))}
          </ul>
        </article>
      </div>
    </div>
  </section>

  <RdCta
    heading="Can't find a teaching?"
    body="Tell us what you're looking for and the US team will point you to it, or mail you one of Carole's books free."
    ctaLabel="Contact the team"
    ctaHref="/about/contact/"
    image="/images/field-2026/carole-4.webp"
    imageAlt="Carole Ward in prayer in the field"
  />

  <!-- Shared lightbox player. One dialog for the whole page. -->
  <dialog class="lib-player" id="lib-player" aria-labelledby="lib-player-title">
    <div class="lib-player__inner">
      <button class="lib-player__close" type="button" aria-label="Close player">
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
      <div class="lib-player__frame">
        <iframe
          id="lib-player-iframe"
          title="Video player"
          allow="autoplay; encrypted-media; picture-in-picture"
          allowfullscreen
          referrerpolicy="strict-origin-when-cross-origin"
        ></iframe>
      </div>
      <div class="lib-player__bar">
        <p id="lib-player-title"></p>
        <a id="lib-player-outlink" href="#" target="_blank" rel="noopener">Watch on YouTube &rarr;</a>
      </div>
    </div>
  </dialog>
</RedesignLayout>

<script>
  const initLibrary = () => {
    // Pin the glass bar directly beneath the real header, whatever its height.
    const header = document.querySelector<HTMLElement>(".site-header");
    const setHeaderVar = () => {
      if (header) document.documentElement.style.setProperty("--header-h", header.offsetHeight + "px");
    };
    setHeaderVar();
    window.addEventListener("resize", setHeaderVar, { passive: true });

    const dialog = document.getElementById('lib-player') as HTMLDialogElement | null;
    if (!dialog || dialog.dataset.ready === 'true') return;
    dialog.dataset.ready = 'true';

    const iframe = document.getElementById('lib-player-iframe') as HTMLIFrameElement;
    const titleEl = document.getElementById('lib-player-title') as HTMLElement;
    const outlink = document.getElementById('lib-player-outlink') as HTMLAnchorElement;
    let opener: HTMLElement | null = null;

    const openPlayer = (id: string, title: string, trigger: HTMLElement) => {
      opener = trigger;
      titleEl.textContent = title;
      iframe.title = title;
      outlink.href = `https://www.youtube.com/watch?v=${id}`;
      iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`;
      dialog.showModal();
    };

    document.querySelectorAll<HTMLElement>('[data-video-id]').forEach((btn) => {
      btn.addEventListener('click', () => {
        openPlayer(btn.dataset.videoId || '', btn.dataset.videoTitle || '', btn);
      });
    });

    // Kill playback and hand focus back. Idempotent, and wired to every
    // close path directly rather than trusting the close event alone.
    const cleanup = () => {
      iframe.src = '';
      if (opener) {
        opener.focus();
        opener = null;
      }
    };
    const closePlayer = () => {
      if (dialog.open) dialog.close();
      cleanup();
    };
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) closePlayer();
    });
    dialog.querySelector('.lib-player__close')?.addEventListener('click', closePlayer);
    dialog.addEventListener('cancel', () => setTimeout(cleanup, 0));
    dialog.addEventListener('close', cleanup);

    // Rail arrows: scroll one viewport-ish page, fade out at the edges.
    document.querySelectorAll<HTMLElement>('.lib-row__wrap').forEach((wrap) => {
      const rail = wrap.querySelector<HTMLElement>('.lib-rail');
      if (!rail) return;
      const arrows = wrap.querySelectorAll<HTMLButtonElement>('.lib-row__arrow');
      const updateArrows = () => {
        const maxScroll = rail.scrollWidth - rail.clientWidth - 1;
        arrows.forEach((a) => {
          const dir = Number(a.dataset.dir);
          const atEdge = dir < 0 ? rail.scrollLeft <= 0 : rail.scrollLeft >= maxScroll;
          a.toggleAttribute('data-at-edge', atEdge);
        });
      };
      arrows.forEach((a) => {
        a.addEventListener('click', () => {
          const dir = Number(a.dataset.dir);
          rail.scrollBy({ left: dir * rail.clientWidth * 0.85, behavior: 'smooth' });
        });
      });
      rail.addEventListener('scroll', updateArrows, { passive: true });
      window.addEventListener('resize', updateArrows, { passive: true });
      updateArrows();
    });

    // ---- Search: live filter across every card. Cmd/Ctrl+K jumps in. ----
    const input = document.getElementById('lib-search-input') as HTMLInputElement | null;
    const status = document.getElementById('lib-search-status');
    const empty = document.getElementById('lib-empty');
    if (input && status && empty) {
      const rowsEls = [...document.querySelectorAll<HTMLElement>('.lib-row')];
      const applyFilter = () => {
        const q = input.value.trim().toLowerCase();
        let shown = 0;
        rowsEls.forEach((rowEl) => {
          let rowShown = 0;
          rowEl.querySelectorAll<HTMLElement>('.lib-rail__item').forEach((li) => {
            const card = li.querySelector<HTMLElement>('.lib-card');
            const hit = !q || (card?.dataset.search ?? '').includes(q);
            li.hidden = !hit;
            if (hit) rowShown++;
          });
          rowEl.hidden = rowShown === 0;
          shown += rowShown;
        });
        empty.hidden = !(q && shown === 0);
        status.textContent = q ? `${shown} video${shown === 1 ? '' : 's'} match` : '';
      };
      input.addEventListener('input', applyFilter);
      input.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          input.value = '';
          applyFilter();
          input.blur();
        }
      });
      document.addEventListener('keydown', (e) => {
        if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
          e.preventDefault();
          document.getElementById('lib-bar')?.scrollIntoView({ block: 'start', behavior: 'smooth' });
          input.focus();
        }
      });
    }
  };

  initLibrary();
  document.addEventListener('astro:page-load', initLibrary);
</script>

<style>
  /* ---------- The app canvas: near-black, faintly green, one room. ---------- */
  .lib-app {
    --app-bg: #101410;
    background: var(--app-bg);
  }

  /* ---------- Billboard ---------- */
  .lib-hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: clamp(500px, 74vh, 780px);
    overflow: hidden;
    color: var(--color-white);
  }
  .lib-hero__backdrop {
    position: absolute; inset: 0; z-index: 0;
    width: 100%; height: 100%; object-fit: cover; object-position: 70% 25%;
  }
  .lib-hero__scrim {
    position: absolute; inset: 0; z-index: 1;
    background:
      linear-gradient(180deg, rgba(16, 20, 16, 0.25) 0%, rgba(16, 20, 16, 0.45) 50%, var(--app-bg) 96%),
      linear-gradient(90deg, rgba(16, 20, 16, 0.82) 0%, rgba(16, 20, 16, 0.35) 55%, rgba(16, 20, 16, 0.05) 100%);
  }
  .lib-hero__inner { position: relative; z-index: 2; padding-top: var(--space-24); padding-bottom: clamp(96px, 12vw, 150px); }
  .lib-hero h1 {
    color: var(--color-white);
    font-size: clamp(2.1rem, 4.4vw, 3.4rem);
    margin: var(--space-3) 0 var(--space-2);
    max-width: 18ch;
    text-wrap: balance;
  }
  .lib-hero__meta {
    margin: 0 0 var(--space-3);
    font-size: 0.85rem; font-weight: 700; letter-spacing: 0.05em;
    color: color-mix(in srgb, var(--color-cream) 72%, transparent);
    text-transform: uppercase;
  }
  .lib-hero__blurb {
    max-width: 52ch;
    font-size: clamp(1rem, 1.3vw, 1.15rem);
    line-height: 1.65;
    color: color-mix(in srgb, var(--color-cream) 92%, transparent);
    margin: 0 0 var(--space-6);
  }
  .lib-hero__cta { display: flex; align-items: center; gap: var(--space-6); flex-wrap: wrap; }
  .lib-play-btn { display: inline-flex; align-items: center; gap: var(--space-2); }
  .lib-hero__secondary {
    display: inline-flex; align-items: center; min-height: 44px;
    color: var(--color-white); text-decoration: none; font-weight: 700;
    letter-spacing: 0.06em; text-transform: uppercase; font-size: 0.85rem;
    border-bottom: 2px solid var(--color-gold);
  }
  .lib-hero__secondary:hover { color: var(--color-gold); }

  /* ---------- Library ---------- */
  .lib {
    background: var(--app-bg);
    color: var(--color-cream);
    padding-bottom: clamp(48px, 6vw, 80px);
  }

  /* Liquid-glass command bar. The inset top highlight is the specular edge
     that sells the glass; the blur does the liquid. Sticky so the controls
     travel with you, like app chrome. */
  .lib-bar {
    position: sticky;
    top: calc(var(--header-h, 108px) + 8px);
    z-index: 20;
    padding: var(--space-3) 0;
    margin-top: calc(-1 * clamp(64px, 8vw, 104px));
  }
  .lib-bar__glass {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-2) var(--space-3);
    border-radius: 18px;
    background: linear-gradient(120deg, rgba(255, 255, 255, 0.10), rgba(255, 255, 255, 0.035));
    border: 1px solid rgba(255, 255, 255, 0.14);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.22),
      inset 0 -1px 0 rgba(255, 255, 255, 0.05),
      0 14px 40px rgba(0, 0, 0, 0.45);
    backdrop-filter: blur(18px) saturate(160%);
    -webkit-backdrop-filter: blur(18px) saturate(160%);
  }
  @supports not (backdrop-filter: blur(1px)) {
    .lib-bar__glass { background: rgba(16, 20, 16, 0.94); }
  }
  .lib-search {
    display: flex; align-items: center; gap: var(--space-2);
    flex: 0 0 auto;
    width: min(300px, 44vw);
    padding: 0 var(--space-3);
    min-height: 44px;
    border-radius: 12px;
    background: rgba(0, 0, 0, 0.30);
    border: 1px solid rgba(255, 255, 255, 0.10);
    color: color-mix(in srgb, var(--color-cream) 75%, transparent);
    cursor: text;
  }
  .lib-search:focus-within {
    border-color: var(--color-gold);
    box-shadow: 0 0 0 3px rgba(225, 167, 48, 0.25);
  }
  .lib-search input {
    flex: 1; min-width: 0;
    border: 0; background: none; outline: none;
    color: var(--color-white);
    font: inherit; font-size: 0.95rem;
  }
  .lib-search input::placeholder { color: color-mix(in srgb, var(--color-cream) 55%, transparent); }
  .lib-search input::-webkit-search-cancel-button { -webkit-appearance: none; }
  .lib-search__kbd {
    font-family: var(--font-sans);
    font-size: 0.72rem; font-weight: 700;
    padding: 3px 7px;
    border-radius: 6px;
    border: 1px solid rgba(255, 255, 255, 0.18);
    background: rgba(255, 255, 255, 0.07);
    color: color-mix(in srgb, var(--color-cream) 70%, transparent);
  }
  .lib-bar__chips {
    display: flex; align-items: center; gap: var(--space-2);
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    padding: var(--space-1) 0;
  }
  .lib-bar__chips::-webkit-scrollbar { display: none; }
  .lib__chip {
    flex: 0 0 auto;
    display: inline-flex; align-items: center; min-height: 38px;
    padding: 0 var(--space-4);
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-pill);
    color: var(--color-cream); text-decoration: none;
    font-size: 0.86rem; font-weight: 600;
    white-space: nowrap;
    transition: background 0.15s ease, border-color 0.15s ease;
  }
  .lib__chip:hover { background: rgba(225, 167, 48, 0.14); border-color: var(--color-gold); color: var(--color-gold); }
  .lib-bar__status {
    margin: var(--space-2) 0 0;
    padding-left: var(--space-2);
    font-size: 0.82rem;
    color: color-mix(in srgb, var(--color-cream) 65%, transparent);
    min-height: 1.2em;
  }

  /* ---------- Rows ---------- */
