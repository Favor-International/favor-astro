---
import RedesignLayout from '../../layouts/RedesignLayout.astro';
import PageHero from '../../components/band/PageHero.astro';
import RdFeature from '../../components/redesign/RdFeature.astro';
import LeafHeading from '../../components/redesign/LeafHeading.astro';
import RdCta from '../../components/redesign/RdCta.astro';
import VideoEmbed from '../../components/global/VideoEmbed.astro';
import Figure from '../../components/global/Figure.astro';
import StoryStrip from '../../components/band/StoryStrip.astro';

// Card copy is verbatim sentences from the live program sub-pages (see
// src/data/programs.ts). Each card links to its full program page.
const programs = [
  { name: 'Portable Bible Schools (PBS)', href: '/impact/evangelism-discipleship/portable-bible-schools/', image: '/images/field-2026/pbs-7.webp', desc: 'Favor’s Portable Bible Schools mobilize new disciple-makers into physical and spiritual war zones. Two-month discipleship training that Favor brings to rural villages, always moving further outward into the unreached tribes.' },
  { name: 'God’s Institute for Transformation (GIFT)', href: '/impact/evangelism-discipleship/gift-institute/', image: '/images/field-2026/street-outreach-5.webp', desc: 'A home and family for youth who need Jesus with skin on. A 24/7 family and a holistic solution to a total need: mentoring, food, shelter, medical, clothing, education, vocational skills and opportunities, salvation and discipleship.' },
  { name: 'House of Prayer', href: '#house-of-prayer', image: '/images/ministry-house-of-prayer.jpg', desc: 'Our Houses of Prayer in Gulu, Uganda, and in Juba, South Sudan were our first operational centers. Prayer always comes first and then everything else follows.' },
  { name: 'Favor FM (Christian Radio)', href: '/impact/evangelism-discipleship/radio/', image: '/images/ministry-radio.jpg', desc: 'Favor operates two radio stations that cover Gulu, Uganda, and Juba, South Sudan, reaching people in the right place at the right time. We have become one of the highest preferred radio stations in the regions of both nations.' },
];

const gallery = [
  { src: '/images/story-anaka-crusade.jpg', caption: 'A field crusade in Anaka, northern Uganda', position: 'center 38%' },
  { src: '/images/field-2026/bibles-4.webp', caption: 'A new believer holding the Bible he received', position: 'center 14%' },
  { src: '/images/hero-pastor-preaching.jpg', caption: 'An indigenous pastor preaching in the field', position: 'center 20%' },
  { src: '/images/field-2026/education-3.webp', caption: 'Portable Bible School graduates, DR Congo', position: 'center 25%' },
];
---
<RedesignLayout
  title="Evangelism & Discipleship"
  description="Portable Bible Schools, GIFT Leadership Institute, House of Prayer, and Favor FM: the four programs by which Favor International equips indigenous pastors to evangelize and disciple across East Africa."
>
  <PageHero
    label="What we do"
    title="Evangelism & Discipleship."
    promise="Indigenous pastors and teachers reaching villages and tribes others will not. PBS, GIFT, House of Prayer, Favor FM."
    image="/images/pillar-evangelism-discipleship.jpg"
    imageAlt="Portable Bible School mobilization in the field"
    objectPosition="center 18%"
    ctaLabel="Fund a pastor"
    ctaHref="/give/specific-project/"
  />

  <section class="band band--white">
    <div class="container">
      <div class="ed-video">
        <div class="ed-video__copy">
          <p class="label">From the field</p>
          <h2>See it where it happens.</h2>
          <p>Before you read a word of program description, watch the work. This is evangelism and discipleship in Africa, led by the indigenous pastors who live there.</p>
        </div>
        <div class="ed-video__player">
          <VideoEmbed id="C5VBPhA50Mg" title="Evangelism in Africa: Building Lasting Disciples Through God's Word" />
        </div>
      </div>
    </div>
  </section>

  <section class="band band--white wd-motto-wrap">
    <div class="container wd-motto">
      <p class="wd-motto__tag">Bibles instead of bullets</p>
      <p class="wd-motto__body">In South Sudan, we have the motto "Bibles instead of bullets", and as was the case in Uganda, God's Word helps stop violence, child abductions, cattle raiding, and many times has been our protection.</p>
      <blockquote class="wd-motto__verse">
        "Go therefore and make disciples of all the nations, baptizing them in the name of the Father and of the Son and of the Holy Spirit."
        <cite>Jesus, Matthew 28:19, NKJV</cite>
      </blockquote>
    </div>
  </section>

  <section class="band band--cream">
    <div class="container">
      <LeafHeading label="Mobilization of heaven's agenda" title="Four programs carry one Gospel outward." intro="Prayer forms the foundation; training, discipleship, and radio carry the message into places conventional ministry cannot reach." />
      <div class="ed-programs">
        {programs.map((p) => (
          <a class="ed-prog" href={p.href}>
            <Figure src={p.image} alt={p.name} ratio="16 / 10" />
            <div class="ed-prog__body">
              <h3>{p.name}</h3>
              <p>{p.desc}</p>
              <span class="ed-prog__more">Learn more &rarr;</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <RdFeature
    image="/images/stories/daniel-kidia.jpg"
    imageAlt="Daniel Kidia, a Favor field pastor in South Sudan"
    eyebrow="Daniel Kidia &middot; South Sudan"
    heading="&ldquo;There are so many precious to God in Africa that need to know the truth. They are ready for a change in their villages, towns, and nations.&rdquo;"
    side="left"
  >
    <p>A former Mundari cattle warrior, now a Favor field pastor leading Portable Bible School classes among his own people.</p>
  </RdFeature>

  <section class="band band--white" id="house-of-prayer">
    <div class="container container--narrow">
      <LeafHeading label="The programs in depth" title="How the work happens on the ground." leaves={false} />
      <div class="faq ed-depth">
        <details open>
          <summary>Portable Bible Schools (PBS)</summary>
          <p>Favor&rsquo;s Portable Bible Schools (PBSs) mobilize new disciple-makers into physical and spiritual war zones. Whether a life-time believer or brand-new convert, all come hungry for the Word and for training. These emerging leaders come from hidden corners, of nations restrictive of and hostile to the Gospel, for the two-month discipleship training that Favor brings to rural villages, always moving further outward into the unreached tribes.</p>
        </details>
        <details>
          <summary>Houses of Prayer</summary>
          <p>Our Houses of Prayer in Gulu, Uganda, and in Juba, South Sudan were our first operational centers, before offices, schools, radio, or leadership training facilities. Prayer always comes first and then everything else follows.</p>
          <p>Our House of Prayer ministry teams do so much, from leading morning devotions and noon-hour prayers every weekday to all-night prayer events. They also launch local and rural outreaches and ministries on the streets, in hospitals, and in prisons. They provide a 24/7 prayer covering for new believers, organize pastors&rsquo; fellowships and national prayer gatherings, and coordinate local crusades.</p>
        </details>
        <details>
          <summary>Christian Radio</summary>
          <p>Favor operates two radio stations that cover Gulu, Uganda, and Juba, South Sudan, reaching people in the right place at the right time. Our programming is a mix of teaching, music, news, testimonies, prayer, preaching, education, and more. We have become one of the highest preferred radio stations in the regions of both nations, with a high level of daily community involvement and call-ins.</p>
        </details>
      </div>
    </div>
  </section>

  <section class="band band--cream">
    <div class="container">
      <LeafHeading label="From the field" title="Real people, real places." />
      <div class="ed-gallery">
        {gallery.map((g) => (
          <figure class="ed-tile" style={`background-image:url(${g.src});background-position:${g.position}`} role="img" aria-label={g.caption}>
            <figcaption>{g.caption}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <StoryStrip tags={['New Believers', 'Salvation', 'Discipleship']} heading="Stories of salvation and discipleship." background="white" />

  <RdCta
    heading="Send a pastor into the unreached."
    body="Fund a PBS cohort, sponsor a GIFT student, or become a Favor Partner to keep all four programs going."
    ctaLabel="Become a Favor Partner"
    ctaHref="/give/partner-monthly/"
    image="/images/field-2026/crusade-2.webp"
    imageAlt="A field gathering in northern Uganda"
  />
</RedesignLayout>

<style>
  .ed-video { display: block; text-align: center; }
  .ed-video__copy { max-width: 680px; margin: 0 auto var(--space-8); }
  .ed-video__copy h2 { margin: 0 0 var(--space-4); }
  .ed-video__copy p { color: var(--color-ink-soft); line-height: 1.7; margin: 0; }
  .ed-video__player { max-width: 940px; margin: 0 auto; }

  .ed-programs { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-8); }
  @media (max-width: 760px) { .ed-programs { grid-template-columns: 1fr; } }
  .ed-prog { display: flex; flex-direction: column; text-decoration: none; color: inherit; transition: transform 180ms; }
  .ed-prog:hover { transform: translateY(-4px); }
  .ed-prog :global(.figure__img) { box-shadow: none; }
  .ed-prog__body { padding: var(--space-5) var(--space-1) 0; }
  .ed-prog__body h3 { margin: 0 0 var(--space-3); color: var(--color-green); font-size: 1.25rem; }
  .ed-prog__body p { margin: 0; color: var(--color-ink-soft); line-height: 1.65; }
  .ed-prog__more { display: inline-block; margin-top: var(--space-4); color: var(--color-gold-deep); font-weight: 700; font-size: 0.9rem; }
  .ed-prog:hover .ed-prog__more { color: var(--color-green); }

  .ed-depth { margin-top: var(--space-2); }
  .ed-depth details { border: 2px solid var(--accent, var(--color-gold)); }
  .ed-depth details:nth-of-type(4n+1) { --accent: var(--color-gold-deep); }
  .ed-depth details:nth-of-type(4n+2) { --accent: var(--color-green-bright); }
  .ed-depth details:nth-of-type(4n+3) { --accent: var(--color-terracotta); }
  .ed-depth details:nth-of-type(4n+4) { --accent: var(--color-sage); }

  /* Field gallery: 2x2 of larger photos with the caption baked onto the image. */
  .ed-gallery { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-6); max-width: 1040px; margin: 0 auto; }
  @media (max-width: 560px) { .ed-gallery { grid-template-columns: 1fr; } }
  .ed-tile { position: relative; margin: 0; aspect-ratio: 3 / 2; background-size: cover; background-position: center 30%; border-radius: var(--radius-card); overflow: hidden; box-shadow: var(--shadow-card); }
  .ed-tile::after { content: ''; position: absolute; inset: 38% 0 0; background: linear-gradient(transparent, rgba(13,28,12,.82)); }
  .ed-tile figcaption { position: absolute; z-index: 1; left: var(--space-5); right: var(--space-5); bottom: var(--space-5); color: #fff; font-weight: 700; font-size: 1rem; line-height: 1.35; text-shadow: 0 1px 8px rgba(0,0,0,.4); }

  .wd-motto-wrap { padding-block: clamp(44px, 6vw, 84px); }
  .wd-motto { max-width: min(1120px, calc(100% - 32px)); padding: clamp(56px, 7vw, 96px) clamp(24px, 7vw, 96px); border-radius: clamp(24px, 3vw, 42px); background: var(--color-green); text-align: center; }
  .wd-motto__tag { font-family: var(--font-sans); font-weight: 800; font-size: clamp(1.8rem, 4.5vw, 2.8rem); letter-spacing: -0.01em; color: var(--color-gold-light); margin: 0; }
  .wd-motto__body { margin: var(--space-6) auto 0; max-width: 64ch; line-height: 1.8; color: color-mix(in srgb, var(--color-white) 88%, transparent); }
  .wd-motto__verse { margin: var(--space-8) auto 0; border: 0; padding: 0; font-family: var(--font-serif, Georgia, serif); font-style: italic; font-size: clamp(1.15rem, 2.6vw, 1.5rem); line-height: 1.5; color: var(--color-white); }
  .wd-motto__verse cite { display: block; margin-top: var(--space-4); font-style: normal; font-size: 0.78rem; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-gold-light); }
</style>
