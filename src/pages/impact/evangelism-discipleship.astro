---
import RedesignLayout from '../../layouts/RedesignLayout.astro';
import PageHero from '../../components/band/PageHero.astro';
import LeafHeading from '../../components/redesign/LeafHeading.astro';
import RdQuote from '../../components/redesign/RdQuote.astro';
import RdFeature from '../../components/redesign/RdFeature.astro';
import RdGallery from '../../components/redesign/RdGallery.astro';
import RdStoryStrip from '../../components/redesign/RdStoryStrip.astro';
import RdCta from '../../components/redesign/RdCta.astro';
import VideoEmbed from '../../components/global/VideoEmbed.astro';

// Card copy is verbatim sentences from the live program sub-pages (see
// src/data/programs.ts). Each card links to its full program page.
const programs = [
  { name: 'Portable Bible Schools (PBS)', href: '/impact/evangelism-discipleship/portable-bible-schools/', image: '/images/field-2026/pbs-7.webp', desc: 'Favor’s Portable Bible Schools mobilize new disciple-makers into physical and spiritual war zones. Two-month discipleship training that Favor brings to rural villages, always moving further outward into the unreached tribes.' },
  { name: 'God’s Institute for Transformation (GIFT)', href: '/impact/evangelism-discipleship/gift-institute/', image: '/images/field-2026/street-outreach-5.webp', desc: 'A home and family for youth who need Jesus with skin on. A 24/7 family and a holistic solution to a total need: mentoring, food, shelter, medical, clothing, education, vocational skills and opportunities, salvation and discipleship.' },
  { name: 'House of Prayer', href: '/pray/', image: '/images/ministry-house-of-prayer.jpg', desc: 'Our Houses of Prayer in Gulu, Uganda, and in Juba, South Sudan were our first operational centers. Prayer always comes first and then everything else follows.' },
  { name: 'Favor FM (Christian Radio)', href: '/impact/evangelism-discipleship/radio/', image: '/images/ministry-radio.jpg', desc: 'Favor operates two radio stations that cover Gulu, Uganda, and Juba, South Sudan, reaching people in the right place at the right time. We have become one of the highest preferred radio stations in the regions of both nations.' },
];

const gallery = [
  { src: '/images/story-anaka-crusade.jpg', caption: 'A field crusade in Anaka, northern Uganda' },
  { src: '/images/field-2026/bibles-4.webp', caption: 'Bibles staged for distribution by PBS teams' },
  { src: '/images/hero-pastor-preaching.jpg', caption: 'An indigenous pastor preaching in the field' },
  { src: '/images/field-2026/education-3.webp', caption: 'Portable Bible School graduates, DR Congo' },
];

const depth = [
  { name: 'Portable Bible Schools (PBS)', body: ['Favor’s Portable Bible Schools (PBSs) mobilize new disciple-makers into physical and spiritual war zones. Whether a life-time believer or brand-new convert, all come hungry for the Word and for training. These emerging leaders come from hidden corners, of nations restrictive of and hostile to the Gospel, for the two-month discipleship training that Favor brings to rural villages, always moving further outward into the unreached tribes.'] },
  { name: 'Houses of Prayer', body: ['Our Houses of Prayer in Gulu, Uganda, and in Juba, South Sudan were our first operational centers, before offices, schools, radio, or leadership training facilities. Prayer always comes first and then everything else follows.', 'Our House of Prayer ministry teams do so much, from leading morning devotions and noon-hour prayers every weekday to all-night prayer events. They also launch local and rural outreaches and ministries on the streets, in hospitals, and in prisons. They provide a 24/7 prayer covering for new believers, organize pastors’ fellowships and national prayer gatherings, and coordinate local crusades.'] },
  { name: 'Christian Radio', body: ['Favor operates two radio stations that cover Gulu, Uganda, and Juba, South Sudan, reaching people in the right place at the right time. Our programming is a mix of teaching, music, news, testimonies, prayer, preaching, education, and more. We have become one of the highest preferred radio stations in the regions of both nations, with a high level of daily community involvement and call-ins.'] },
];
---
<RedesignLayout
  title="Evangelism & Discipleship"
  description="Portable Bible Schools, GIFT Leadership Institute, House of Prayer, and Favor FM: the four programs by which Favor International equips indigenous pastors to evangelize and disciple across East Africa."
>
  <PageHero
    label="What we do"
    title="Evangelism & Discipleship."
    promise="Indigenous pastors and teachers reaching villages and tribes others will not. PBS, GIFT, House of Prayer, Favor FM."
    image="/images/pillar-evangelism-discipleship.jpg"
    imageAlt="Portable Bible School mobilization in the field"
    objectPosition="center 18%"
    ctaLabel="Fund a pastor"
    ctaHref="/give/specific-project/gift-dormitory/"
  />

  <section class="band band--white">
    <div class="container">
      <LeafHeading
        label="From the field"
        title="See it where it happens."
        intro="Before you read a word of program description, watch the work. This is evangelism and discipleship in Africa, led by the indigenous pastors who live there."
      />
      <div class="rd-video">
        <VideoEmbed id="C5VBPhA50Mg" title="Evangelism in Africa: Building Lasting Disciples Through God's Word" />
      </div>
    </div>
  </section>

  <RdQuote
    tag="Bibles instead of bullets"
    body={`In South Sudan, we have the motto "Bibles instead of bullets", and as was the case in Uganda, God's Word helps stop violence, child abductions, cattle raiding, and many times has been our protection.`}
    quote={`"Go therefore and make disciples of all the nations, baptizing them in the name of the Father and of the Son and of the Holy Spirit."`}
    cite="Jesus, Matthew 28:19, NKJV"
  />

  <section class="band band--cream">
    <div class="container">
      <LeafHeading label="Mobilization of heaven's agenda" title="The four programs." leaves={false} />
      <div class="rd-grid rd-grid--2">
        {programs.map((p) => (
          <a class="rd-tile" href={p.href}>
            <div class="rd-tile__img" style={`background-image:url('${p.image}')`} role="img" aria-label={p.name}></div>
            <div class="rd-tile__meta">
              <h3>{p.name}</h3>
              <p>{p.desc}</p>
              <span class="rd-more">Learn more &rarr;</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <RdFeature
    image="/images/stories/daniel-kidia.jpg"
    imageAlt="Daniel Kidia, a Favor field pastor in South Sudan"
    eyebrow="Daniel Kidia &middot; South Sudan"
    heading="&ldquo;There are so many precious to God in Africa that need to know the truth. They are ready for a change in their villages, towns, and nations.&rdquo;"
    side="left"
  >
    <p>A former Mundari cattle warrior, now a Favor field pastor leading Portable Bible School classes among his own people.</p>
  </RdFeature>

  <section class="band band--greenlight">
    <div class="container container--narrow">
      <LeafHeading label="The programs in depth" title="How the work happens on the ground." leaves={false} />
      <div class="rd-depth">
        {depth.map((d) => (
          <article class="rd-outline rd-depth__item rd-prose">
            <h3>{d.name}</h3>
            {d.body.map((b) => <p>{b}</p>)}
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="band band--white">
    <div class="container">
      <LeafHeading label="From the field" title="Real people, real places." />
      <RdGallery items={gallery} />
    </div>
  </section>

  <RdStoryStrip tags={['New Believers', 'Salvation', 'Discipleship']} heading="Stories of salvation and discipleship." background="cream" />

  <RdCta
    heading="Send a pastor into the unreached."
    body="Fund a PBS cohort, sponsor a GIFT student, or become a Favor Partner to keep all four programs going."
    ctaLabel="Become a Favor Partner"
    ctaHref="/give/partner-monthly/"
  />
</RedesignLayout>

<style>
  .rd-video { max-width: 940px; margin: 0 auto; }
  .rd-more { display: inline-block; margin-top: var(--space-3); color: var(--color-gold-deep); font-weight: 700; font-size: var(--rd-fs-small); }
  .rd-tile:hover .rd-more { color: var(--color-green); }
  .rd-depth { display: grid; gap: var(--space-6); }
  .rd-depth__item { padding: clamp(28px, 3.5vw, 44px) clamp(28px, 4vw, 52px); }
  .rd-depth__item h3 { color: var(--color-green); margin: 0 0 var(--space-4); }
</style>
