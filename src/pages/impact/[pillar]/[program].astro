---
import RedesignLayout from '../../../layouts/RedesignLayout.astro';
import PageHero from '../../../components/band/PageHero.astro';
import RdFeature from '../../../components/redesign/RdFeature.astro';
import LeafHeading from '../../../components/redesign/LeafHeading.astro';
import RdCta from '../../../components/redesign/RdCta.astro';
import VideoFeature from '../../../components/redesign/VideoFeature.astro';
import { PROGRAMS, PILLAR_TAGLINES, programsByPillar, type Program } from '../../../data/programs';
import { PILLARS } from '../../../lib/site';
import storiesData from '../../../data/stories.json';

// One template for every program sub-page. Content is verbatim from the live
// site (see src/data/programs.ts). Mirrors the live site's What We Do tree that
// Will navigates: /impact/<pillar>/<program>/.
export function getStaticPaths() {
  return PROGRAMS.map((p) => ({ params: { pillar: p.pillar, program: p.slug }, props: { program: p } }));
}

const { program } = Astro.props as { program: Program };
const pillar = PILLARS.find((p) => p.slug === program.pillar)!;
const tagline = PILLAR_TAGLINES[program.pillar];
const siblings = programsByPillar(program.pillar).filter((p) => p.slug !== program.slug);
// Flow: hero > centered text intro > image+text band > remaining text.
// (Never an image band straight after the hero photo.)
const introBlock = program.blocks[0];
const featureBlocks = program.blocks.slice(1, 3);
const restBlocks = program.blocks.slice(3);

const storyByProgram: Record<string, string> = {
  'portable-bible-schools': 'a-generational-shift',
  'gift-institute': 'gift-girl-graduate-turns-trainer',
  radio: 'man-listens-to-favour-fm-receives-sight-from-god',
  centers: 'i-want-the-little-children-to-come-to-me',
  leadership: 'training-for-the-harvest',
  primary: 'student-on-a-mission',
  secondary: 'the-next-generations-leaders',
  counseling: 'trauma-counseling-heals-a-former-warrior',
  medical: 'medical-center-salvations',
  'church-planting': 'rapid-church-transformation',
  construction: 'strong-foundations-in-rural-areas',
  sustainability: 'full-circle-transformation',
  vocation: 'streets-to-school',
  women: 'goats-for-women',
};
const fieldStory = storiesData.find((s) => s.slug === storyByProgram[program.slug]);
const galleryByProgram: Record<string, string[]> = {
  'portable-bible-schools': ['/images/field-2026/pbs-2.webp','/images/field-2026/pbs-4.webp','/images/field-2026/pbs-8.webp','/images/field-2026/bibles-3.webp'],
  'gift-institute': ['/images/field-2026/gift-2.webp','/images/field-2026/gift-4.webp','/images/field-2026/gift-6.webp','/images/field-2026/street-outreach-5.webp'],
  radio: ['/images/field-2026/radio-1.webp','/images/field-2026/radio-2.webp','/images/field-2026/radio-4.webp','/images/field-2026/prayer-5.webp'],
  centers: ['/images/field-2026/vlc-3.webp','/images/field-2026/vlc-4.webp','/images/field-2026/vlc-5.webp','/images/education-vlc-jondoru.jpg'],
  leadership: ['/images/field-2026/terry-1.webp','/images/field-2026/terry-3.webp','/images/field-2026/education-3.webp','/images/field-2026/pbs-10.webp'],
  primary: ['/images/field-2026/education-1.webp','/images/field-2026/education-4.webp','/images/field-2026/education-8.webp','/images/field-2026/vlc-2.webp'],
  secondary: ['/images/field-2026/secondary-1.webp','/images/field-2026/secondary-2.webp','/images/field-2026/secondary-3.webp','/images/field-2026/education-7.webp'],
  counseling: ['/images/field-2026/trauma-1.webp','/images/field-2026/trauma-3.webp','/images/field-2026/prayer-4.webp','/images/field-2026/villages-2.webp'],
  medical: ['/images/field-2026/medical-2.webp','/images/field-2026/villages-3.webp','/images/field-2026/prayer-4.webp','/images/field-2026/prayer-5.webp'],
  'church-planting': ['/images/field-2026/church-6.webp','/images/field-2026/church-1.webp','/images/field-2026/church-3.webp','/images/field-2026/baptism-4.webp'],
  construction: ['/images/field-2026/construction-1.webp','/images/field-2026/construction-2.webp','/images/field-2026/construction-3.webp','/images/field-2026/church-7.webp'],
  sustainability: ['/images/field-2026/agriculture-1.webp','/images/field-2026/agriculture-2.webp','/images/field-2026/agriculture-4.webp','/images/field-2026/villages-1.webp'],
  vocation: ['/images/field-2026/vocation-1.webp','/images/field-2026/vocation-2.webp','/images/field-2026/vocation-3.webp','/images/field-2026/education-9.webp'],
  women: ['/images/field-2026/women-1.webp','/images/field-2026/women-2.webp','/images/field-2026/women-3.webp','/images/field-2026/women-4.webp'],
};
const programGallery = [...new Set(galleryByProgram[program.slug] || [])]
  .filter((image) => image !== program.heroImage && image !== program.bodyImage);
const pathGallery = programGallery.slice(0, 2);
const sectionGallery = programGallery.slice(2);
const videoByProgram: Record<string, { id: string; title: string; heading: string; body: string }> = {
  'gift-institute': { id:'xwSVEViFikA', title:"God's Institute for Transformation", heading:'See GIFT leadership training in the field.', body:'Meet the young people and indigenous leaders at the center of this ministry.' },
  centers: { id:'DEydcLqBQW0', title:"Favor's Primary Schools", heading:'See a Favor classroom in motion.', body:'A field film shows the learning environment, teachers, and children more fully than a single photograph can.' },
  primary: { id:'DEydcLqBQW0', title:"Favor's Primary Schools", heading:'Educated for the Kingdom.', body:'Watch Favor’s Christ-centered primary-school work in the communities it serves.' },
  secondary: { id:'DEydcLqBQW0', title:"Favor's Primary Schools", heading:'A foundation that continues.', body:'See the education pathway students build on as they continue toward secondary school.' },
  counseling: { id:'nSFl3Y7TLYI', title:'The Power of Trauma Counseling', heading:'Healing the whole person.', body:'This field film shows why trauma counseling is a foundational part of community restoration.' },
  medical: { id:'4YpOvDoc6k4', title:'Where Medicine Meets Miracles', heading:'Where medicine meets miracles.', body:'Watch Favor’s medical teams combine practical care, prayer, and community service.' },
  'church-planting': { id:'TZmNp40_lbI', title:'Church Planting', heading:'The church is the body of Christ.', body:'See what a locally rooted church means for a believing community.' },
  construction: { id:'25f290un21o', title:'They Once Met Under Trees', heading:'From gathering under trees to a church home.', body:'A field film follows the difference a permanent community church can make.' },
  women: { id:'JCjHdG0NnLQ', title:'To Reach a Village, Reach a Woman', heading:'To reach a village, reach a woman.', body:'Watch how women’s empowerment can multiply through households and communities.' },
};
const programVideo = videoByProgram[program.slug];
const emphasisByProgram: Record<string, string[][]> = {
  counseling: [
    ['written by Christ-believing psychologists from Australia', 'peer-reviewed through publications at Boston University'],
    ['immense demand and need for trauma counseling', 'brutal oppression and injustice'],
  ],
};
const emphasizeText = (text: string, blockIndex: number) => {
  const explicitPhrases = emphasisByProgram[program.slug]?.[blockIndex] || [];
  if (explicitPhrases.length > 0) {
    return explicitPhrases.reduce((html, phrase) => html.replace(phrase, `<strong>${phrase}</strong>`), text);
  }

  // A short opening statement can carry emphasis. Long sentences should not
  // become one large highlighted wall of text.
  const point = text.indexOf('. ');
  const lead = point > 0 ? text.slice(0, point + 1) : '';
  return lead && lead.split(/\s+/).length <= 12
    ? `<strong>${lead}</strong>${text.slice(point + 1)}`
    : text;
};

const pillarLens: Record<string, { title: string; body: string }[]> = {
  'evangelism-discipleship': [
    { title: 'The need', body: 'Distance, conflict, language, and persecution can keep people from sustained Bible teaching even after they first hear the Gospel.' },
    { title: 'Favor’s approach', body: 'National leaders carry prayer, Scripture, training, and follow-up into the communities they already understand and can continue serving.' },
    { title: 'What comes next', body: 'The aim is multiplication: believers equipped to disciple others, strengthen congregations, and carry the Gospel further outward.' },
  ],
  education: [
    { title: 'The need', body: 'Poverty, distance, limited classrooms, and crowded schools leave many children and emerging leaders without a dependable path to learn.' },
    { title: 'Favor’s approach', body: 'Learning begins close to home, continues through Christ-centered schools, and grows into training for teachers, ministers, and community leaders.' },
    { title: 'What comes next', body: 'Education is designed to form people who can serve their families, lead with character, and teach the generation following them.' },
  ],
  'community-development': [
    { title: 'The need', body: 'War and poverty affect the whole person: physical health, emotional strength, family life, faith, and the places where a community gathers.' },
    { title: 'Favor’s approach', body: 'Field teams pair practical care with prayer, discipleship, trained local leadership, and a healthy church rooted in the community.' },
    { title: 'What comes next', body: 'Immediate care opens a longer path toward reconciliation, stable congregations, local service, and community-led restoration.' },
  ],
  'economic-empowerment': [
    { title: 'The need', body: 'A lack of training, tools, and access to income can keep families dependent and leave young people vulnerable to exploitation.' },
    { title: 'Favor’s approach', body: 'Participants receive practical instruction, discipleship, hands-on experience, and follow-up as they build skills or begin a shared project.' },
    { title: 'What comes next', body: 'Income can support food, health care, education, and locally led ministry while experience and skills continue multiplying.' },
  ],
};
const lens = pillarLens[program.pillar];

const programFaqs = [
  { q: `Who carries ${program.name} on the ground?`, a: 'Favor’s field programs are led and delivered by indigenous staff, teachers, pastors, counselors, and ministry leaders who live in the nations and communities they serve.' },
  { q: `How does ${program.name} connect to the rest of Favor’s work?`, a: `It belongs to the ${pillar.label} pillar, but it does not stand alone. Favor’s programs are designed to reinforce prayer, discipleship, local leadership, and the long-term health of a community.` },
  { q: 'Are the details identical in every location?', a: 'No. Language, facilities, local leadership, and immediate needs vary by nation and community. This page describes Favor’s published model; current field details should be confirmed with the Favor team.' },
  { q: 'How can I support this work?', a: 'Favor Partners provide dependable, unrestricted support that field leadership can direct where it is most needed. You can also contact the team to ask whether a current designated project is available.' },
];
---
<RedesignLayout
  title={`${program.name} | ${pillar.label}`}
  description={program.promise}
>
  <PageHero
    label={pillar.label}
    title={program.name + '.'}
    promise={program.promise}
    image={program.heroImage}
    imageAlt={program.heroAlt}
  />

  {programVideo && (
    <section class="band band--cream"><div class="container">
      <VideoFeature id={programVideo.id} videoTitle={programVideo.title} eyebrow="Watch the work" heading={programVideo.heading} side="right" decor="leaf">
        <p>{programVideo.body}</p>
      </VideoFeature>
    </div></section>
  )}

  <section class="band band--cream prog-path-section">
    <div class="container">
      <div class="prog-path-head">
        <p class="label">{tagline}</p>
        <h2>What this ministry carries into the field.</h2>
        {introBlock.type === 'p'
          ? <p class="prog-intro__lede">{introBlock.text}</p>
          : <ul>{introBlock.items.map((i) => <li>{i}</li>)}</ul>}
      </div>
      <div class="prog-path">
        <div class="prog-path__media">
          <img src={program.bodyImage} alt={program.bodyAlt} loading="lazy" />
          {pathGallery[0] && <img src={pathGallery[0]} alt={`${program.name} in the field`} loading="lazy" />}
          {pathGallery[1] && <img src={pathGallery[1]} alt={`${program.name} community moment`} loading="lazy" />}
          <span>How it works</span>
        </div>
        <ol class="prog-path__steps">
          {featureBlocks.map((b, index) => (
            <li>
              <span class="prog-path__number">0{index + 1}</span>
              <div>
                <h3>{index === 0 ? 'The field-led response' : 'The work continues'}</h3>
                {b.type === 'p'
                  ? <p set:html={emphasizeText(b.text, index)}></p>
                  : <>{b.intro && <p>{b.intro}</p>}<ul>{b.items.map((i) => <li>{i}</li>)}</ul></>}
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <section class:list={['band', restBlocks.length > 0 ? 'band--white' : 'band--cream']}>
    <div class="container">
      <LeafHeading label="The ministry in context" title="A need, a field-led response, and a path forward." intro={`See how ${program.name} fits Favor’s wider approach to transformation.`} />
      <div class="prog-lens">
        {lens.map((item, index) => (
          <article class="rd-card prog-lens__item reveal">
            <span class="prog-lens__number" aria-hidden="true">0{index + 1}</span>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  {restBlocks.length > 0 && (
    <section class="band band--white">
      <div class="container container--narrow prog-body">
        <LeafHeading label="On the ground" title="What the work looks like in practice." leaves={false} />
        {restBlocks.map((b) => b.type === 'p'
          ? <p>{b.text}</p>
          : <>
              {b.intro && <p>{b.intro}</p>}
              <ul>{b.items.map((i) => <li>{i}</li>)}</ul>
            </>
        )}
      </div>
    </section>
  )}

  {sectionGallery.length > 0 && (
    <section class="band band--cream">
      <div class="container">
        <LeafHeading label="In the field" title={`${program.name}, seen up close.`} intro={sectionGallery.length === 1 ? 'A closer look at the people, place, and daily work behind this ministry.' : 'More than one frame is needed to understand the people, places, and daily work behind this ministry.'} />
        <div class:list={['prog-gallery', sectionGallery.length === 1 && 'prog-gallery--one', sectionGallery.length === 2 && 'prog-gallery--two']}>
          {sectionGallery.map((image, index) => <figure class:list={['prog-gallery__item', sectionGallery.length > 2 && index === 0 && 'prog-gallery__item--wide']}><img src={image} alt={`${program.name} field moment ${index + 1}`} loading="lazy" /></figure>)}
        </div>
      </div>
    </section>
  )}

  {(program.scripture || program.pullQuote) && (
    <section class="band band--cream prog-quote-wrap">
      <div class="container prog-quote-band">
        <blockquote class="prog-quote">
          {(program.scripture || program.pullQuote)!.text}
          <cite>{(program.scripture || program.pullQuote)!.attribution}</cite>
        </blockquote>
      </div>
    </section>
  )}

  {fieldStory && (
    <RdFeature
      image={fieldStory.image}
      imageAlt={fieldStory.title}
      eyebrow={`${fieldStory.category} · ${fieldStory.date}`}
      heading={fieldStory.title}
      side="left"
      background="cream"
      decor="leaf"
    >
      {fieldStory.paragraphs.slice(0, 2).map((paragraph) => <p>{paragraph}</p>)}
      <p><a class="story-link" href={`/stories/${fieldStory.slug}/`}>Read the complete field story &rarr;</a></p>
    </RdFeature>
  )}

  <section class="band band--white">
    <div class="container container--narrow">
      <LeafHeading label="Questions" title={`Understanding ${program.name}.`} intro="What to know before you explore, pray, or give." leaves={false} />
      <div class="faq prog-faq">
        {programFaqs.map((item) => (
          <details>
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="band band--white">
    <div class="container container--narrow">
      <LeafHeading label={pillar.label} title="Keep exploring this ministry." intro="Each program is one part of a connected, field-led movement." />
      <nav class="prog-siblings" aria-label={`Other ${pillar.label} programs`}>
        <a class="prog-sib prog-sib--hub" href={`/impact/${pillar.slug}/`}>
          <span class="prog-sib__name">{pillar.label} overview</span>
          <span class="prog-sib__go" aria-hidden="true">&rarr;</span>
        </a>
        {siblings.map((s) => (
          <a class="prog-sib" href={`/impact/${s.pillar}/${s.slug}/`}>
            <span class="prog-sib__name">{s.name}</span>
            <span class="prog-sib__go" aria-hidden="true">&rarr;</span>
          </a>
        ))}
      </nav>
    </div>
  </section>

  <RdCta
    heading={`Stand with ${program.name}.`}
    body="Favor Partners give field leaders the flexibility to keep this work moving month after month."
    ctaLabel="Become a Favor Partner"
    ctaHref="/give/donate/"
    secondaryLabel={`Explore ${pillar.label}`}
    secondaryHref={`/impact/${pillar.slug}/`}
    image={program.bodyImage}
    imageAlt={program.bodyAlt}
  />
</RedesignLayout>

<style>
  .prog-path-head { max-width: 780px; margin: 0 auto clamp(40px, 6vw, 72px); text-align: center; }
  .prog-path-head h2 { margin: 0 auto var(--space-5); max-width: 18ch; }
  .prog-path-head p, .prog-path-head ul { color: var(--color-ink-soft); line-height: 1.75; }
  .prog-path { display: grid; grid-template-columns: minmax(0,.9fr) minmax(0,1.1fr); gap: clamp(36px, 6vw, 88px); align-items: center; }
  .prog-path__media { position: relative; }
  .prog-path__media { display:grid; gap:var(--space-5); }
  .prog-path__media img { display:block; width:88%; aspect-ratio:16/9; object-fit:cover; border-radius:var(--rd-radius); }
  .prog-path__media img:nth-child(2) { width:92%; margin-left:auto; }
  .prog-path__media img:nth-child(3) { width:82%; }
  .prog-path__media span { position: absolute; z-index:1; left: var(--space-5); bottom: var(--space-5); color: white; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; font-size: .75rem; text-shadow: 0 2px 12px rgba(0,0,0,.7); }
  .prog-path__steps { list-style: none; padding: 0; margin: 0; position: relative; }
  .prog-path__steps::before { content:''; position:absolute; left: 27px; top: 28px; bottom: 28px; width:2px; background:color-mix(in srgb,var(--color-gold) 55%,transparent); }
  .prog-path__steps > li { display:grid; grid-template-columns:56px 1fr; gap:var(--space-5); position:relative; padding:0 0 clamp(56px,7vw,88px); }
  .prog-path__steps > li:last-child { padding-bottom:0; }
  .prog-path__number { position:relative; z-index:1; display:grid; place-items:center; width:56px; height:56px; border-radius:50%; background:var(--color-green); color:var(--color-gold-light); font-weight:900; }
  .prog-path__steps h3 { margin:0 0 var(--space-3); color:var(--color-green); }
  .prog-path__steps p, .prog-path__steps ul { margin:0; color:var(--color-ink-soft); line-height:1.7; }
  .prog-path__steps strong { color:var(--color-green-deep); font-weight:800; box-shadow:inset 0 -.38em color-mix(in srgb,var(--color-gold) 30%,transparent); }
  @media (max-width: 820px) { .prog-path { grid-template-columns:1fr; } .prog-path__media{grid-template-columns:repeat(3,1fr)} .prog-path__media img,.prog-path__media img:nth-child(2),.prog-path__media img:nth-child(3){width:100%;height:100%;margin:0;aspect-ratio:3/4} }
  .prog-lens { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-6); }
  .prog-lens__item { position:relative; min-height:330px; overflow:hidden; border:0; display:flex; flex-direction:column; justify-content:flex-end; color:white; }
  .prog-lens__item:nth-child(1){background:var(--color-green-deep)}
  .prog-lens__item:nth-child(2){background:color-mix(in srgb,var(--color-sage) 78%,var(--color-green-deep))}
  .prog-lens__item:nth-child(3){background:color-mix(in srgb,var(--color-gold-deep) 88%,var(--color-green-deep))}
  .prog-lens__number { position:absolute; right:18px; top:8px; color:rgba(255,255,255,.2); font-size:clamp(4rem,7vw,6.5rem); line-height:1; font-weight:900; }
  .prog-lens__item h3 { margin:0 0 var(--space-4); color:white; font-size:1.55rem; }
  .prog-lens__item p { margin:0; color:rgba(255,255,255,.9); line-height:1.65; }
  .prog-gallery { display:grid; grid-template-columns:repeat(3,1fr); grid-auto-rows:240px; gap:var(--space-5); }
  .prog-gallery__item { margin:0; overflow:hidden; border-radius:var(--rd-radius); }
  .prog-gallery__item--wide { grid-column:span 2; grid-row:span 2; }
  .prog-gallery img { width:100%; height:100%; object-fit:cover; display:block; transition:transform 300ms ease; }
  .prog-gallery__item:hover img { transform:scale(1.03); }
  .prog-gallery--one { display:block; }
  .prog-gallery--one .prog-gallery__item { width:min(100%,900px); aspect-ratio:16/10; margin-inline:auto; }
  .prog-gallery--two { grid-template-columns:repeat(2,minmax(0,1fr)); grid-auto-rows:auto; gap:clamp(24px,3vw,48px); align-items:start; }
  .prog-gallery--two .prog-gallery__item { aspect-ratio:16/10; }
  .prog-gallery--two .prog-gallery__item:first-child { grid-column:1; grid-row:1; }
  .prog-gallery--two .prog-gallery__item:last-child { grid-column:2; grid-row:1; margin-top:clamp(36px,4vw,64px); }
  @media(max-width:720px){.prog-gallery{grid-template-columns:1fr;grid-auto-rows:auto}.prog-gallery__item--wide{grid-column:auto;grid-row:auto}.prog-gallery img{aspect-ratio:16/10}.prog-gallery--two{display:grid;gap:var(--space-5)}.prog-gallery--two .prog-gallery__item:first-child,.prog-gallery--two .prog-gallery__item:last-child{grid-column:1;margin-top:0}.prog-gallery--two .prog-gallery__item{aspect-ratio:auto}}
  .prog-faq { display: grid; gap: var(--space-3); }
  .prog-faq details { background: var(--color-white); border: 1px solid rgba(31,58,26,.12); border-radius: var(--rd-radius); padding: var(--space-5) var(--space-6); box-shadow: 0 2px 10px rgba(31,58,26,.05); }
  .prog-faq summary { cursor: pointer; list-style: none; color: var(--color-green); font-weight: 800; display: flex; justify-content: space-between; gap: var(--space-4); }
  .prog-faq summary::-webkit-details-marker { display: none; }
  .prog-faq summary::after { content: '+'; color: var(--color-gold-deep); font-size: 1.35rem; font-weight: 400; }
  .prog-faq details[open] summary::after { content: '–'; }
  .prog-faq p { margin: var(--space-4) 0 0; color: var(--color-ink-soft); line-height: 1.7; }
  @media (max-width: 820px) { .prog-lens { grid-template-columns: 1fr; } }
  .prog-intro__lede { margin: 0 auto; max-width: 68ch; color: var(--color-ink-soft); line-height: 1.85; font-size: 1.08rem; }
  .prog-body p { color: var(--color-ink-soft); line-height: 1.8; margin: 0 0 var(--space-5); }
  .prog-body p:last-child { margin-bottom: 0; }
  .prog-body ul { margin: 0 0 var(--space-5); padding-left: var(--space-6); color: var(--color-ink-soft); line-height: 1.8; }
  .prog-body li { margin-bottom: var(--space-2); }

  .prog-quote-band { text-align: center; }
  .prog-quote-wrap { padding-block: clamp(44px, 6vw, 84px); }
