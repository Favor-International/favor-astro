---
import RedesignLayout from '../../layouts/RedesignLayout.astro';
import PageHero from '../../components/band/PageHero.astro';
import LeafHeading from '../../components/redesign/LeafHeading.astro';
import RdFeature from '../../components/redesign/RdFeature.astro';
import RdStoryStrip from '../../components/redesign/RdStoryStrip.astro';
import RdCta from '../../components/redesign/RdCta.astro';

// Card copy is verbatim sentences from the live program sub-pages
// (src/data/programs.ts holds the full verbatim pages these link to).
const programs = [
  { name: 'Sustainability Projects', href: '/impact/economic-empowerment/sustainability/', image: '/images/field-2026/agriculture-5.webp', alt: 'Water and farm work on a Favor sustainability project', desc: 'God has provided Favor with a 270 acre farm. We have a few sustainability projects that help provide for our ministry teams and support our programs directly.' },
  { name: 'Women Empowerment', href: '/impact/economic-empowerment/women/', image: '/images/field-2026/women-4.webp', alt: 'A Women Empowerment group meeting', desc: 'Favor’s Women Empowerment ministry equips women to generate their own income through training in skills, trauma healing, entrepreneurship, parenting, and financial management.' },
  { name: 'Vocational Program', href: '/impact/economic-empowerment/vocation/', image: '/images/field-2026/vocation-3.webp', alt: 'Vocational Program students at work', desc: 'Favor seeks to equip and empower youth in their late teens and early twenties with the opportunity to choose and study a vocation of their choice.' },
];
---
<RedesignLayout
  title="Economic Empowerment"
  description="Sustainability projects, women's empowerment, and vocational programs: Favor International's economic empowerment ministry."
>
  <PageHero
    label="What we do"
    title="Economic Empowerment."
    promise="Sustainability projects, vocational programs, and women's empowerment that change a whole village."
    image="/images/pillar-economic-empowerment.jpg"
    imageAlt="Women's empowerment program"
    ctaLabel="Fund the work"
    ctaHref="/give/partner-monthly/"
  />

  <section class="band band--white">
    <div class="container container--narrow ee-intro">
      <LeafHeading
        label="Independence built on freedom in Christ"
        title="The Gospel is the foundation of healthy economies."
        intro="And healthy economies help lay new foundations of the Gospel to be shared freely. We strongly believe in self-sustained economic development that can take communities from poverty to productivity. Our model of education, empowerment, and investment enables the most marginalized people to bring themselves and their communities out of poverty."
      />
    </div>
  </section>

  <section class="band band--cream">
    <div class="container">
      <LeafHeading label="The three programs" title="From relief to self-reliance." leaves={false} />
      <div class="rd-grid rd-grid--3">
        {programs.map((p) => (
          <a class="rd-tile" href={p.href}>
            <div class="rd-tile__img" style={`background-image:url('${p.image}')`} role="img" aria-label={p.alt}></div>
            <div class="rd-tile__meta">
              <h3>{p.name}</h3>
              <p>{p.desc}</p>
              <span class="rd-more">Learn more &rarr;</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <RdFeature
    image="/images/field-2026/villages-4.webp"
    imageAlt="The Women of Puranga, Uganda"
    eyebrow="The Women of Puranga &middot; Uganda"
    heading="&ldquo;They praised and worshiped God as they waited to receive two goats for each member of their Women's Empowerment group.&rdquo;"
    side="left"
  >
    <p>A Women's Empowerment cohort received two goats each after a year of training. The herds pay for school fees, food, and medical care across the village.</p>
  </RdFeature>

  <RdStoryStrip tags={['Women', 'Skills Development', 'Stewardship']} heading="Stories of empowerment." background="greenlight" />

  <RdCta
    heading="Fund a cohort that funds itself."
    body="Sustainability tools, vocational training, and women’s programs are built to multiply. Favor Partners get them started."
    ctaLabel="Become a Favor Partner"
    ctaHref="/give/partner-monthly/"
  />
</RedesignLayout>

<style>
  .ee-intro :global(.band__header) { margin-bottom: 0; }
  .rd-more { display: inline-block; margin-top: var(--space-3); color: var(--color-gold-deep); font-weight: 700; font-size: var(--rd-fs-small); }
  .rd-tile:hover .rd-more { color: var(--color-green); }
</style>
