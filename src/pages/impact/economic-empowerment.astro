---
import RedesignLayout from '../../layouts/RedesignLayout.astro';
import PageHero from '../../components/band/PageHero.astro';
import StoryStrip from '../../components/band/StoryStrip.astro';
import LeafHeading from '../../components/redesign/LeafHeading.astro';
import RdFeature from '../../components/redesign/RdFeature.astro';
import RdCta from '../../components/redesign/RdCta.astro';
import storiesData from '../../data/stories.json';

// Card copy is verbatim sentences from the live program sub-pages
// (src/data/programs.ts holds the full verbatim pages these link to).
const programs = [
  { name: 'Sustainability Projects', href: '/impact/economic-empowerment/sustainability/', image: '/images/field-2026/agriculture-5.webp', alt: 'Water and farm work on a Favor sustainability project', desc: 'God has provided Favor with a 270 acre farm. We have a few sustainability projects that help provide for our ministry teams and support our programs directly.' },
  { name: 'Women Empowerment', href: '/impact/economic-empowerment/women/', image: '/images/field-2026/women-4.webp', alt: 'A Women Empowerment group meeting', desc: 'Favor’s Women Empowerment ministry equips women to generate their own income through training in skills, trauma healing, entrepreneurship, parenting, and financial management.' },
  { name: 'Vocational Program', href: '/impact/economic-empowerment/vocation/', image: '/images/field-2026/vocation-3.webp', alt: 'Vocational Program students at work', desc: 'Favor seeks to equip and empower youth in their late teens and early twenties with the opportunity to choose and study a vocation of their choice.' },
];
const pathway = [
  { n: '1', title: 'Train', body: 'Participants build practical knowledge in skills, trauma healing, entrepreneurship, parenting, financial management, or a chosen vocation.' },
  { n: '2', title: 'Practice', body: 'Training moves into hands-on work through shared projects, vocational experience, farming, fisheries, animal husbandry, and other locally relevant activities.' },
  { n: '3', title: 'Begin', body: 'Women and young adults use the structure, skills, certificates, or starter project provided through the program to begin producing income.' },
  { n: '4', title: 'Follow up', body: 'Favor’s published model includes accountability and continuing support as participants implement what they have learned and build confidence.' },
];
const empowermentFaqs = [
  { q: 'Is economic empowerment separate from discipleship?', a: 'No. Favor describes practical work and spiritual formation as connected. Training includes Biblical teaching and is intended to form people who can serve their families, communities, and marketplaces.' },
  { q: 'Does every participant receive the same project?', a: 'No. Favor publishes several approaches, including women’s group projects, vocational disciplines, agriculture, fisheries, poultry, and other hands-on work. Current options depend on the field and should be confirmed with the team.' },
  { q: 'What does sustainability mean here?', a: 'The goal is not permanent relief. Favor’s published programs emphasize skills, income, local accountability, and projects that can continue supporting families or ministry after the initial investment.' },
  { q: 'How can a donor support a current empowerment need?', a: 'Monthly partners support the overall field. For a designated opportunity, contact Favor to confirm which project is active, its location, and its current funding status before giving.' },
];
const empowermentStory = storiesData.find((s) => s.slug === 'goats-for-women');
---
<RedesignLayout
  title="Economic Empowerment"
  description="Sustainability projects, women's empowerment, and vocational programs: Favor International's economic empowerment ministry."
>
  <PageHero
    label="What we do"
    title="Economic Empowerment."
    promise="Sustainability projects, vocational programs, and women's empowerment that change a whole village."
    image="/images/pillar-economic-empowerment.jpg"
    imageAlt="Women's empowerment program"
    ctaLabel="Fund the work"
    ctaHref="/give/partner-monthly/"
  />

  <section class="band band--white">
    <div class="container container--narrow ee-intro">
      <LeafHeading label="Independence built on freedom in Christ" title="The Gospel is the foundation of healthy economies." leaves={false} />
      <p>And healthy economies help lay new foundations of the Gospel to be shared freely. We strongly believe in self-sustained economic development that can take communities from poverty to productivity. Our model of education, empowerment, and investment enables the most marginalized people to bring themselves and their communities out of poverty.</p>
    </div>
  </section>

  <section class="band band--cream">
    <div class="container">
      <LeafHeading label="The three programs" title="From relief to self-reliance." intro="Training, practical tools, and local leadership help families build income that continues long after a project begins." />
      <div class="ee-programs">
        {programs.map((p) => (
          <a class="ee-prog" href={p.href}>
            <span class="ee-prog__photo" style={`background-image:url(${p.image})`} role="img" aria-label={p.alt}></span>
            <span class="ee-prog__body">
              <h3>{p.name}</h3>
              <p>{p.desc}</p>
              <span class="ee-prog__more">Learn more &rarr;</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="band band--white">
    <div class="container">
      <LeafHeading label="The pathway" title="Training becomes practice, then ownership." intro="The details vary by program, but the published model moves participants from instruction toward locally sustained work." />
      <ol class="ee-pathway">{pathway.map((item) => <li class="rd-card reveal"><span>{item.n}</span><h3>{item.title}</h3><p>{item.body}</p></li>)}</ol>
    </div>
  </section>

  <RdFeature image="/images/field-2026/villages-4.webp" imageAlt="Women and families gathered in a village in Uganda" eyebrow="The Women of Puranga · Uganda" heading="A gift designed to keep multiplying." side="left" decor="leaf">
    <p>After a year of training, each member of a Women Empowerment cohort received two goats. The herds can grow into school fees, food, and medical care for families across the village.</p>
    <blockquote>“They praised and worshiped God as they waited to receive two goats for each member of their Women Empowerment group.”</blockquote>
  </RdFeature>

  <StoryStrip tags={['Women', 'Skills Development', 'Stewardship']} heading="Stories of empowerment." background="white" />

  {empowermentStory && (
    <RdFeature image={empowermentStory.image} imageAlt={empowermentStory.title} eyebrow={`${empowermentStory.category} · ${empowermentStory.date}`} heading={empowermentStory.title} side="right" background="cream" decor="leaf">
      {empowermentStory.paragraphs.slice(0, 2).map((paragraph) => <p>{paragraph}</p>)}
      <p><a class="story-link" href={`/stories/${empowermentStory.slug}/`}>Read the complete field story &rarr;</a></p>
    </RdFeature>
  )}

  <section class="band band--white">
    <div class="container container--narrow">
      <LeafHeading label="Questions" title="How economic empowerment works." leaves={false} />
      <div class="faq ee-faq">{empowermentFaqs.map((item) => <details><summary>{item.q}</summary><p>{item.a}</p></details>)}</div>
    </div>
  </section>

  <RdCta
    heading="Fund a cohort that funds itself."
    body="Sustainability tools, vocational training, and women’s programs are built to multiply. Favor Partners get them started."
    ctaLabel="Become a Favor Partner"
    ctaHref="/give/partner-monthly/"
    image="/images/field/women-empowerment-uganda.webp"
    imageAlt="Women receiving livestock at a Favor empowerment cohort in Uganda"
  />
</RedesignLayout>

<style>
  .ee-intro { text-align: center; }
  .ee-intro p:last-child { margin: var(--space-5) auto 0; color: var(--color-ink-soft); line-height: 1.8; max-width: 64ch; }

  .ee-programs { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-8); }
  @media (max-width: 900px) { .ee-programs { grid-template-columns: 1fr; max-width: 460px; margin: 0 auto; } }
  .ee-prog {
    display: flex; flex-direction: column;
    background: var(--color-white); border-radius: var(--radius-card); overflow: hidden;
    box-shadow: var(--shadow-card); text-decoration: none; color: inherit;
    transition: transform 180ms, box-shadow 180ms;
  }
  .ee-prog:hover { transform: translateY(-4px); box-shadow: 0 18px 40px rgba(31, 58, 26, 0.15); }
  .ee-prog__photo { display: block; aspect-ratio: 16 / 10; background-size: cover; background-position: center 30%; }
  .ee-prog__body { display: block; padding: var(--space-6); }
  .ee-prog__body h3 { margin: 0 0 var(--space-3); color: var(--color-green); font-size: 1.25rem; text-align: center; }
  .ee-prog__body p { margin: 0; color: var(--color-ink-soft); line-height: 1.65; }
  .ee-prog__more { display: block; margin-top: var(--space-4); color: var(--color-gold-deep); font-weight: 700; font-size: 0.9rem; text-align: center; }
  .ee-prog:hover .ee-prog__more { color: var(--color-green); }
  .ee-pathway { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-5); }
  .ee-pathway span { color: var(--color-gold-deep); font-weight: 800; }
  .ee-pathway h3 { color: var(--color-green); margin: var(--space-4) 0 var(--space-3); }
  .ee-pathway p { color: var(--color-ink-soft); margin: 0; line-height: 1.65; }
  .ee-faq { display: grid; gap: var(--space-3); }
  .ee-faq details { padding: var(--space-5) var(--space-6); border: 1px solid rgba(31,58,26,.12); border-radius: var(--rd-radius); background: var(--color-white); }
  .ee-faq summary { cursor: pointer; color: var(--color-green); font-weight: 800; }
  .ee-faq p { color: var(--color-ink-soft); margin: var(--space-4) 0 0; }
  @media (max-width: 960px) { .ee-pathway { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .ee-pathway { grid-template-columns: 1fr; } }
</style>
