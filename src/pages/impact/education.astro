---
import RedesignLayout from '../../layouts/RedesignLayout.astro';
import PageHero from '../../components/band/PageHero.astro';
import LeafHeading from '../../components/redesign/LeafHeading.astro';
import RdFeature from '../../components/redesign/RdFeature.astro';
import RdGallery from '../../components/redesign/RdGallery.astro';
import RdStoryStrip from '../../components/redesign/RdStoryStrip.astro';
import RdCta from '../../components/redesign/RdCta.astro';
import VideoEmbed from '../../components/global/VideoEmbed.astro';

const gallery = [
  { src: '/images/field-2026/pbs-10.webp', caption: 'Students in class in Gulu, Uganda' },
  { src: '/images/field-2026/education-6.webp', caption: 'A new Favor school under construction' },
  { src: '/images/stories/student-on-a-mission.jpg', caption: 'A Favor student carrying the Gospel' },
  { src: '/images/field-2026/education-7.webp', caption: 'Graduation day for a Bible-school cohort' },
];

// Program copy is verbatim from the live program sub-pages (src/data/programs.ts).
const depth = [
  { name: 'Village Learning Centers', href: '/impact/education/centers/', image: '/images/field-2026/vlc-2.webp', body: 'Our approach is to increase access to quality education by implementing village learning centers, in church buildings, that younger students in a village locale can reach on foot. We use the Roots to Fruit curriculum, which is a Bible-based, Christian approach to education approved by the Ugandan government, for primary school.' },
  { name: 'Favor Primary School', href: '/impact/education/primary/', image: '/images/field-2026/education-2.webp', body: 'The mission of Favor Primary Schools is to educate the next generation of Uganda’s and South Sudan’s leadership on the Word of God, prayer, and academic excellence. Our schools in both Gulu and Juba receive kids from all walks of life, religions, and income levels. We strive to maintain a 30:1 student-to-teacher ratio, and the schools have gained a reputation of excellence with some of our students in Uganda scoring the highest in the Gulu district of 160 schools.' },
  { name: 'Favor Secondary School', href: '/impact/education/secondary/', image: '/images/field-2026/secondary-1.webp', body: 'Our Favor Secondary School opened to the public for the first time in February 2023. We have welcomed 135 registered students from all walks of life, religions, and income levels. We openly teach and practice the Word of God, and these amazing young men and women routinely come to know the love of Jesus as they pray and see God move.' },
  { name: 'Leadership Training Institute', href: '/impact/education/leadership/', image: '/images/about-leadership-training.jpg', body: 'Favor’s Leadership Training Institute addresses both in a blend of in-class and hands-on instruction tailored to produce powerful ministers of spiritual and cultural transformation. All our indigenous staff participate in constant training including Bible training, prayer, marriage enrichment, household finances, small business entrepreneurship, and much much more!' },
];
---
<RedesignLayout
  title="Education"
  description="Village Learning Centers, primary and secondary schools, and leadership training: Favor International's education pillar."
>
  <PageHero
    label="What we do"
    title="Education."
    promise="Village learning centers and schools that pull children out of poverty and into the Kingdom."
    image="/images/pillar-education.jpg"
    imageAlt="Village learning center in South Sudan"
    ctaLabel="Sponsor a student"
    ctaHref="/give/specific-project/gulu-primary-school/"
  />

  <section class="band band--white">
    <div class="container">
      <LeafHeading
        label="From the field"
        title="Watch a Favor school."
        intro="Educated for the Kingdom. See what a Christ-centered classroom looks like in Gulu and Juba, taught by Ugandan and South Sudanese staff."
      />
      <div class="rd-video">
        <VideoEmbed id="DEydcLqBQW0" title="Favor's Primary Schools" />
      </div>
    </div>
  </section>

  <RdFeature
    image="/images/field-2026/vlc-4.webp"
    imageAlt="A village learning center class in Jondoru"
    eyebrow="On the ground"
    heading="A real classroom, in a real village."
    side="left"
    background="cream"
  >
    <p>Every student photo in this section is from a real classroom in northern Uganda, South Sudan, or Ethiopia. The field teams publish a new field report most weeks. Each one is a named teacher, a named village, and an outcome they can stand behind.</p>
    <p><a href="/stories/">See stories from the field &rarr;</a></p>
  </RdFeature>

  <section class="band band--white">
    <div class="container">
      <LeafHeading label="Next generation leadership" title="From letters to leaders, program by program." />
      <div class="rd-grid rd-grid--2">
        {depth.map((d) => (
          <a class="rd-tile" href={d.href}>
            <div class="rd-tile__img" style={`background-image:url('${d.image}')`} role="img" aria-label={d.name}></div>
            <div class="rd-tile__meta">
              <h3>{d.name}</h3>
              <p>{d.body}</p>
              <span class="rd-more">Learn more &rarr;</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="band band--greenlight">
    <div class="container">
      <LeafHeading label="From the field" title="Real classrooms, real children." leaves={false} />
      <RdGallery items={gallery} />
    </div>
  </section>

  <RdStoryStrip tags={['Children/Youth', 'Skills Development']} heading="Stories from the classrooms." background="cream" />

  <RdCta
    heading="Stand with the schools."
    body="Favor Partners make Village Learning Centers and the primary and secondary schools possible every month. Pick the tier that fits."
    ctaLabel="Become a Favor Partner"
    ctaHref="/give/partner-monthly/"
  />
</RedesignLayout>

<style>
  .rd-video { max-width: 940px; margin: 0 auto; }
  .rd-more { display: inline-block; margin-top: var(--space-3); color: var(--color-gold-deep); font-weight: 700; font-size: var(--rd-fs-small); }
  .rd-tile:hover .rd-more { color: var(--color-green); }
</style>
