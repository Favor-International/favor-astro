---
import RedesignLayout from '../../layouts/RedesignLayout.astro';
import PageHero from '../../components/band/PageHero.astro';
import RdFeature from '../../components/redesign/RdFeature.astro';
import LeafHeading from '../../components/redesign/LeafHeading.astro';
import NumberScroller from '../../components/redesign/NumberScroller.astro';
import SavannaBand from '../../components/redesign/SavannaBand.astro';
import RdCta from '../../components/redesign/RdCta.astro';
import { PILLARS, IMPACT_STATS } from '../../lib/site';

const pillarImages: Record<string, string> = {
  'evangelism-discipleship': '/images/field-2026/evangelism-9.webp',
  'education': '/images/field-2026/baptism-7.webp',
  'community-development': '/images/field-2026/church-4.webp',
  'economic-empowerment': '/images/field-2026/agriculture-1.webp',
};
const deeper = [
  { href: '/newsletter/', image: '/images/hero-newsletter-field.jpg', title: 'Field updates', desc: 'Monthly reports from the country teams, straight to your inbox.', action: 'Subscribe' },
  { href: '/about/accountability/', image: '/images/field-2026/evangelism-2.webp', title: 'Impact reports', desc: 'Quarterly and annual PDFs with audited numbers.', action: 'View reports' },
  { href: '/stories/', image: '/images/field-2026/prayer-8.webp', title: 'Stories of transformation', desc: 'Real names, real places, real outcomes.', action: 'Read stories' },
];
---
<RedesignLayout
  title="Impact"
  description="Four ministry pillars across East Africa. Field reports, real stories, and the indigenous leaders behind the work."
  image="/images/field-2026/baptism-3.webp"
>
  <PageHero
    label="Impact"
    title="Four ministries. One Kingdom outcome."
    promise="Every Favor program flows from one conviction: transformed hearts transform nations."
    image="/images/field-2026/baptism-5.webp"
    imageAlt="PBS graduates with certificates"
  />

  <RdFeature
    image="/images/field-2026/evangelism-10.webp"
    imageAlt="Indigenous missionaries evangelizing in the field"
    eyebrow="What we do"
    heading="A non-denominational missionary movement."
    side="left"
  >
    <p>Founded in northern Uganda and also operating in neighboring South Sudan, Favor International serves and trains war-torn victims into purpose-driven Christian missionaries, equipped to advance the Gospel in villages and mobilized to advance the Kingdom in nations.</p>
    <p>Prayer is the fuel and engine of everything Favor does. We started as a prayer movement. Today we start with prayer, we go with prayer, and we end with prayer. From that foundation, the work flows through four departments: evangelism and discipleship, education, community development, and economic empowerment.</p>
  </RdFeature>

  <NumberScroller
    label="Audited financials"
    heading="The numbers behind the work."
    stats={IMPACT_STATS}
  />

  <section class="band band--white band--tight">
    <div class="container">
      <p class="impact-lede">Every number above is sourced from Favor's FY2024 audited financials, filed with ECFA and IRS Form 990. No estimates. No projections.</p>
      <p class="impact-sources">
        Sources: <a href="https://www.ecfa.org/MemberProfile.aspx?ID=50004" target="_blank" rel="noopener">ECFA member profile</a> ·
        <a href="https://www.charitynavigator.org/ein/475225697" target="_blank" rel="noopener">Charity Navigator</a> ·
        <a href="https://app.candid.org/profile/9511233" target="_blank" rel="noopener">Candid (Guidestar)</a>
      </p>
    </div>
  </section>

  <section class="band band--cream">
    <div class="container">
      <LeafHeading label="The pillars" title="How the work breaks down." leaves={false} />
      <div class="rd-grid rd-grid--2">
        {PILLARS.map((p) => (
          <a class="rd-tile" href={`/impact/${p.slug}/`}>
            <div class="rd-tile__img" style={`background-image:url('${pillarImages[p.slug]}')`} role="img" aria-label={p.label}></div>
            <div class="rd-tile__meta">
              <h3>{p.label}</h3>
              <p>{p.blurb}</p>
              <span class="rd-more">See the work &rarr;</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <SavannaBand>
    <LeafHeading label="Deeper" title="Reports, stories, and the field record." leaves={false} />
    <div class="rd-grid rd-grid--3">
      {deeper.map((d) => (
        <a class="rd-tile" href={d.href}>
          <div class="rd-tile__img" style={`background-image:url('${d.image}')`} role="img" aria-label={d.title}></div>
          <div class="rd-tile__meta">
            <h3>{d.title}</h3>
            <p>{d.desc}</p>
            <span class="rd-more">{d.action} &rarr;</span>
          </div>
        </a>
      ))}
    </div>
  </SavannaBand>

  <RdCta
    heading="Want the field report in your inbox?"
    body="One email a month. The team's honest take on what worked and what didn't."
    ctaLabel="Send Me the Field Report"
    ctaHref="/newsletter/"
  />
</RedesignLayout>

<style>
  .impact-lede { text-align: center; margin: 0 auto; color: var(--color-ink-soft); max-width: 60ch; line-height: 1.75; }
  .impact-sources { text-align: center; margin: var(--space-6) 0 0; color: var(--color-sage); font-size: var(--rd-fs-small); }
  .impact-sources a { color: var(--color-gold-deep); }
  .rd-more { display: inline-block; margin-top: var(--space-3); color: var(--color-gold-deep); font-weight: 700; font-size: var(--rd-fs-small); }
  .rd-tile:hover .rd-more { color: var(--color-green); }
</style>
