---
import RedesignLayout from '../../layouts/RedesignLayout.astro';
import PageHero from '../../components/band/PageHero.astro';
import PostCard from '../../components/band/PostCard.astro';
import OverlayCard from '../../components/global/OverlayCard.astro';
import RdFeature from '../../components/redesign/RdFeature.astro';
import LeafHeading from '../../components/redesign/LeafHeading.astro';
import RdCta from '../../components/redesign/RdCta.astro';
import { PILLARS, IMPACT_STATS } from '../../lib/site';
import storiesData from '../../data/stories.json';

const pillarImages: Record<string, string> = {
  'evangelism-discipleship': '/images/field-2026/evangelism-9.webp',
  'education': '/images/field-2026/baptism-7.webp',
  'community-development': '/images/field-2026/church-4.webp',
  'economic-empowerment': '/images/field-2026/agriculture-1.webp',
};
const deeper = [
  { href: '/newsletter/', image: '/images/hero-newsletter-field.jpg', title: 'Field updates', desc: 'Monthly reports from the country teams, straight to your inbox.', action: 'Subscribe' },
  { href: '/about/accountability/', image: '/images/field-2026/evangelism-2.webp', title: 'Impact reports', desc: 'Quarterly and annual PDFs with audited numbers.', action: 'View reports' },
  { href: '/stories/', image: '/images/field-2026/prayer-8.webp', title: 'Stories of transformation', desc: 'Real names, real places, real outcomes.', action: 'Read stories' },
];
const movement = [
  { n: '01', title: 'Prayer goes first.', body: 'Favor began as a prayer movement. Prayer remains the foundation beneath field decisions, outreach, training, and care.' },
  { n: '02', title: 'A heart encounters the Gospel.', body: 'Indigenous evangelists carry Scripture into communities in languages and cultural contexts they already understand.' },
  { n: '03', title: 'Disciples become leaders.', body: 'Bible training, schools, counseling, vocational instruction, and ongoing mentorship prepare people to serve others.' },
  { n: '04', title: 'Local leadership multiplies.', body: 'The work continues through pastors, teachers, parents, students, and community leaders who remain rooted where they serve.' },
];
const impactFaqs = [
  { q: 'Why does Favor organize the work into four pillars?', a: 'The pillars make a wide ministry easier to understand, but field programs overlap. A church may host a learning center; counseling may prepare a community for discipleship; vocational training may help a family keep children in school.' },
  { q: 'Who leads the work in Africa?', a: 'Favor centers indigenous leadership. National staff, pastors, teachers, counselors, broadcasters, and ministry leaders carry the day-to-day work in their own nations and communities.' },
  { q: 'How does Favor report impact?', a: 'We publish field stories, financial statements, Form 990 filings, and external accountability profiles. When we share a program total, we cite the reporting year and source with it.' },
  { q: 'Where should I start?', a: 'Explore the pillar that most interests you, read the field stories connected to it, and review Favor’s accountability record. You can then pray, become a monthly partner, or ask about a current project.' },
];
const impactStory = storiesData.find((s) => s.slug === 'full-circle-transformation');
---
<RedesignLayout
  title="Impact"
  description="Four ministry pillars in Uganda, South Sudan, and Chad. Field reports, real stories, and the indigenous leaders behind the work."
  image="/images/field-2026/baptism-3.webp"
>
  <PageHero waveColor="cream"
    label="Impact"
    title="Four ministries. One Kingdom outcome."
    promise="Every Favor program flows from the conviction that transformed hearts transform nations."
    image="/images/field-2026/baptism-5.webp"
    imageAlt="PBS graduates with certificates"
  />

  <RdFeature
    image="/images/field-2026/evangelism-10.webp"
    imageAlt="Indigenous missionaries evangelizing in the field"
    eyebrow="What we do"
    heading="A non-denominational missionary movement."
    side="left"
    background="cream"
  >
    <p>Founded in northern Uganda and also operating in neighboring South Sudan, Favor International serves and trains war-torn victims into purpose-driven Christian missionaries, equipped to advance the Gospel in villages and mobilized to advance the Kingdom in nations.</p>
    <p>Prayer is the fuel and engine of everything Favor does. We started as a prayer movement. Today we start with prayer, we go with prayer, and we end with prayer. From that foundation, the work flows through four departments: evangelism and discipleship, education, community development, and economic empowerment.</p>
  </RdFeature>

  <section class="band band--white">
    <div class="container"><LeafHeading label="Audited financials" title="The numbers behind the work." intro="Every number below comes from our FY2024 audited financials, filed with ECFA and IRS Form 990, with no estimates or projections." /></div>
    <div class="container impact-stats">
      {IMPACT_STATS.map((s) => (
        <div class="impact-stat">
          <span class="impact-stat__num">{s.value}</span>
          <span class="impact-stat__label">{s.label}</span>
          <span class="impact-stat__src">{s.source}</span>
        </div>
      ))}
    </div>
    <p class="impact-sources">
      Sources: <a href="https://www.ecfa.org/MemberProfile.aspx?ID=50004" target="_blank" rel="noopener">ECFA member profile</a> ·
      <a href="https://www.charitynavigator.org/ein/475225697" target="_blank" rel="noopener">Charity Navigator</a> ·
      <a href="https://app.candid.org/profile/9511233" target="_blank" rel="noopener">Candid (Guidestar)</a>
    </p>
  </section>

  <section class="band band--cream">
    <div class="container"><LeafHeading label="The pillars" title="Four pillars carry one movement." intro="The work begins in prayer, reaches a heart with the Gospel, and continues until people and communities can flourish and lead." leaves={false} /></div>
    <div class="container pillar-grid">
      {PILLARS.map((p) => (
        <OverlayCard
          href={`/impact/${p.slug}/`}
          image={pillarImages[p.slug]}
          title={p.label}
          desc={p.blurb}
          cta="See the work"
          ratio="16 / 10"
        />
      ))}
    </div>
  </section>

  <section class="band band--white">
    <div class="container">
      <LeafHeading label="How transformation moves" title="The work is connected from the beginning." intro="The programs form one field-led path from prayer and first response to mature local leadership." />
      <ol class="movement-grid">
        {movement.map((item) => (
          <li class="rd-card movement-card reveal">
            <span>{item.n}</span><h3>{item.title}</h3><p>{item.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {impactStory && (
    <RdFeature image={impactStory.image} imageAlt={impactStory.title} eyebrow={`${impactStory.category} · ${impactStory.date}`} heading={impactStory.title} side="right" background="cream" decor="leaf">
      {impactStory.paragraphs.slice(0, 2).map((paragraph) => <p>{paragraph}</p>)}
      <p><a class="story-link" href={`/stories/${impactStory.slug}/`}>Read the complete field story &rarr;</a></p>
    </RdFeature>
  )}

  <section class="band band--white">
    <div class="container"><LeafHeading label="Go deeper" title="Reports, stories, and the field record." intro="Follow the evidence behind the work and hear directly from the people living it." /></div>
    <div class="container grid grid-3">
      {deeper.map((d) => (
        <PostCard href={d.href} image={d.image} imageAlt={d.title} title={d.title} desc={d.desc} actionLabel={d.action} />
      ))}
    </div>
  </section>

  <section class="band band--cream">
    <div class="container container--narrow">
      <LeafHeading label="Questions" title="Understanding Favor’s impact model." leaves={false} />
      <div class="faq impact-faq">{impactFaqs.map((item) => <details><summary>{item.q}</summary><p>{item.a}</p></details>)}</div>
    </div>
  </section>

  <RdCta
    background="cream"
    heading="See what transformation looks like month by month."
    body="Receive field reports, stories, and prayer needs from the teams carrying the work."
    ctaLabel="Send me the field report"
    ctaHref="/newsletter/"
    secondaryLabel="Fund the work"
    secondaryHref="/give/donate/"
    image="/images/field-2026/prayer-8.webp"
    imageAlt="Favor leaders praying together in the field"
  />
</RedesignLayout>

<style>
  .impact-head { text-align: center; max-width: 760px; margin-left: auto; margin-right: auto; }
  .impact-intro { text-align: center; max-width: 760px; }
  .impact-intro p { color: var(--color-ink-soft); line-height: 1.8; margin: var(--space-5) auto 0; max-width: 66ch; }
  .impact-lede { margin: var(--space-3) auto 0; color: var(--color-ink-soft); max-width: 60ch; }
  .impact-stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-8); margin-top: var(--space-12); text-align: center; }
  @media (max-width: 760px) { .impact-stats { grid-template-columns: repeat(2, 1fr); gap: var(--space-10) var(--space-6); } }
  .impact-stat__num { display: block; font-family: var(--font-sans); font-weight: 800; font-size: clamp(2.4rem, 5.5vw, 3.8rem); color: var(--color-green-deep); line-height: 1; letter-spacing: -0.02em; }
  .impact-stat__label { display: block; margin-top: var(--space-4); font-weight: 800; font-size: 0.8rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-gold-deep); }
  .impact-stat__src { display: block; margin-top: var(--space-3); font-size: 0.78rem; color: var(--color-sage); }
  .impact-sources { text-align: center; margin: var(--space-10) 0 0; color: var(--color-sage); font-size: 0.85rem; }
  .impact-sources a { color: var(--color-gold-deep); }

  .pillar-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-8); margin-top: var(--space-10); }
  @media (max-width: 680px) { .pillar-grid { grid-template-columns: 1fr; } }
  .grid-3 { margin-top: var(--space-10); }
  .movement-grid { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-5); }
  .movement-card { position:relative; min-height:330px; overflow:hidden; border:0; color:white; }
  .movement-card:nth-child(1){background:var(--color-green-deep)}
  .movement-card:nth-child(2){background:color-mix(in srgb,var(--color-sage) 78%,var(--color-green-deep))}
  .movement-card:nth-child(3){background:color-mix(in srgb,var(--color-gold-deep) 88%,var(--color-green-deep))}
  .movement-card:nth-child(4){background:color-mix(in srgb,var(--color-terracotta) 82%,var(--color-green-deep))}
  .movement-card span { position:absolute; right:18px; top:8px; color:rgba(255,255,255,.2); font-size:clamp(4rem,7vw,6.5rem); line-height:1; font-weight:900; }
  .movement-card h3 { color:white; margin:clamp(90px,9vw,120px) 0 var(--space-4); font-size:1.55rem; }
  .movement-card p { color:rgba(255,255,255,.9); margin:0; line-height:1.65; }
  .impact-faq { display: grid; gap: var(--space-3); }
  .impact-faq details { padding: var(--space-5) var(--space-6); border: 1px solid rgba(31,58,26,.12); border-radius: var(--rd-radius); background: var(--color-white); }
  .impact-faq summary { cursor: pointer; color: var(--color-green); font-weight: 800; }
  .impact-faq p { color: var(--color-ink-soft); margin: var(--space-4) 0 0; line-height: 1.7; }
  @media (max-width: 960px) { .movement-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .movement-grid { grid-template-columns: 1fr; } }
</style>
