---
import PageLayout from '../../layouts/PageLayout.astro';
import PageHero from '../../components/band/PageHero.astro';
import CtaBand from '../../components/band/CtaBand.astro';
import newsletters from '../../data/newsletters.json';

// Past newsletters, ported from the live site's Testimonies & Updates >
// Past Newsletters page (titles, dates, and links captured 2026-06-10).
// Links open the original newsletter (Google Drive / bit.ly) in a new tab.
const byYear = new Map<string, typeof newsletters>();
for (const n of newsletters) {
  const y = n.date.slice(-4);
  if (!byYear.has(y)) byYear.set(y, []);
  byYear.get(y)!.push(n);
}
const years = [...byYear.keys()].sort((a, b) => +b - +a);
---
<PageLayout
  title="Past Newsletters"
  description="The Favor International newsletter archive: weekly field stories, impact reports, and annual reports from across the nations Favor serves."
>
  <PageHero
    label="Newsletter archive"
    title="Past newsletters."
    promise="Every issue is a real report from the field: testimonies, impact reports, and annual reports."
    image="/images/field-2026/bibles-5.webp"
    imageAlt="Bibles ready for the field"
  />

  <section class="band band--white">
    <div class="container container--narrow">
      {years.map((y) => (
        <div class="nl-year">
          <h2 class="nl-year__h">{y}</h2>
          <ul class="nl-list">
            {byYear.get(y)!.map((n) => (
              <li>
                <a class="nl-item" href={n.href} target="_blank" rel="noopener">
                  <span class="nl-item__date">{n.date.replace(', ' + y, '')}</span>
                  <span class="nl-item__title">{n.title}</span>
                  <span class="nl-item__go" aria-hidden="true">&rarr;</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <CtaBand
    heading="Get the next one in your inbox."
    body="One report from the field, straight to you. Real names, real places, real outcomes."
    ctaLabel="Subscribe to the newsletter"
    ctaHref="/newsletter/"
  />
</PageLayout>

<style>
  .nl-year { margin-bottom: var(--space-16); }
  .nl-year__h { text-align: center; margin-bottom: var(--space-8); }
  .nl-list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--color-border); }
  .nl-item {
    display: grid;
    grid-template-columns: 110px 1fr auto;
    gap: var(--space-6);
    align-items: center;
    padding: var(--space-4) var(--space-2);
    border-bottom: 1px solid var(--color-border);
    text-decoration: none;
    transition: background 160ms, padding-left 160ms;
  }
  .nl-item:hover { background: var(--color-cream); padding-left: var(--space-4); }
  .nl-item__date { font-size: 0.78rem; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-sage); }
  .nl-item__title { font-weight: 700; color: var(--color-green); line-height: 1.35; }
  .nl-item__go { color: var(--color-gold-deep); font-weight: 800; }
  @media (max-width: 560px) {
    .nl-item { grid-template-columns: 1fr auto; }
    .nl-item__date { grid-column: 1 / -1; }
  }
</style>
