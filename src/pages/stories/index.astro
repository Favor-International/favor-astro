---
import PageLayout from '../../layouts/PageLayout.astro';
import PageHero from '../../components/band/PageHero.astro';
import PostCard from '../../components/band/PostCard.astro';
import CtaBand from '../../components/band/CtaBand.astro';
import storiesData from '../../data/stories.json';

const sorted = [...storiesData].sort(
  (a, b) => new Date(b.date).getTime() - new Date(a.date).getTime()
);
const featured = sorted[0];
const stories = sorted.slice(1);
// Ministry filters from the live site's per-story tags (restored 2026-06-10;
// every story carries its real live tags in stories.json).
const categories = ['All', 'Testimony', 'Discipleship', 'New Believers', 'Salvation', 'Spiritual Deliverance', 'Emotional Healing', 'Physical Healing', 'Community Transformation', 'Women', 'Children/Youth', 'Training & Multiplication', 'Skills Development', 'Unreached People Groups', 'Rural Communities', 'Humanitarian Impact', 'Favor Team'];
function excerpt(paras: string[], n = 150) {
  const t = paras && paras[0] ? paras[0] : '';
  return t.length > n ? t.slice(0, n).replace(/\s+\S*$/, '') + '…' : t;
}
---
<PageLayout
  title="Stories of Transformation"
  description="Real transformation stories from the field across East Africa, in the words of the Favor International teams who witnessed them."
>
  <PageHero pattern
    label="Stories"
    title="Stories of transformation."
    promise="Every story here is a real person, in a real place, in a real work of God. Read them in the words of the teams who witnessed them."
    image="/images/field-2026/prayer-gathering-1.webp"
    imageAlt="A Favor field gathering"
  />

  <section class="band band--white">
    <div class="container">
      <a class="story-featured" href={`/stories/${featured.slug}/`}>
        <span class="story-featured__photo" style={`background-image:url(${featured.image})`} role="img" aria-label={featured.title}></span>
        <span class="story-featured__body">
          <span class="story-featured__kicker">Latest from the field</span>
          <h2>{featured.title}</h2>
          <p>{excerpt(featured.paragraphs, 220)}</p>
          <span class="story-featured__meta">{featured.date}{(featured.tags||[])[0] ? ' · ' + featured.tags[0] : ''}</span>
          <span class="story-featured__cta">Read the story &rarr;</span>
        </span>
      </a>

      <p class="stories-count">{sorted.length} stories from the field.</p>

      <div class="story-filters" role="group" aria-label="Filter stories by ministry">
        {categories.map((c, i) => (
          <button class="story-filter" type="button" data-cat={c} aria-pressed={i === 0 ? 'true' : 'false'}>{c}</button>
        ))}
      </div>

      <div class="stories-grid">
        {stories.map((s) => (
          <PostCard
            href={`/stories/${s.slug}/`}
            image={s.image}
            imageAlt={s.title}
            chip={s.category}
            category={s.category}
            tags={(s.tags || []).join('|')}
            title={s.title}
            desc={excerpt(s.paragraphs)}
            actionLabel="Read the story"
          />
        ))}
      </div>

      <div class="story-pager">
        <button class="story-pager__btn" type="button" data-prev>&larr; Prev</button>
        <span class="story-pager__info"></span>
        <button class="story-pager__btn" type="button" data-next>Next &rarr;</button>
      </div>
    </div>
  </section>

  <CtaBand
    heading="Get a story in your inbox every month."
    body="The field report carries one new story each month."
    ctaLabel="Send Me the Field Report"
    ctaHref="/newsletter/"
  />
</PageLayout>

<script>
  const PER = 12;
  const grid = document.querySelector('.stories-grid');
  const cards = Array.from(document.querySelectorAll('.stories-grid .post-card')) as HTMLElement[];
  const filters = Array.from(document.querySelectorAll('.story-filter')) as HTMLElement[];
  const info = document.querySelector('.story-pager__info');
  const prev = document.querySelector('[data-prev]') as HTMLButtonElement | null;
  const next = document.querySelector('[data-next]') as HTMLButtonElement | null;
  let cat = 'All';
  let page = 1;
  const matches = () => (cat === 'All' ? cards : cards.filter((c) => (c.dataset.tags || '').split('|').includes(cat) || c.dataset.category === cat));
  function render() {
    const list = matches();
    const pages = Math.max(1, Math.ceil(list.length / PER));
    if (page > pages) page = pages;
    cards.forEach((c) => { c.style.display = 'none'; });
    list.slice((page - 1) * PER, (page - 1) * PER + PER).forEach((c) => { c.style.display = ''; });
    if (info) info.textContent = `Page ${page} of ${pages} · ${list.length} stories`;
    if (prev) prev.disabled = page <= 1;
    if (next) next.disabled = page >= pages;
  }
  filters.forEach((b) => b.addEventListener('click', () => {
    cat = b.dataset.cat || 'All';
    page = 1;
    filters.forEach((x) => x.setAttribute('aria-pressed', x === b ? 'true' : 'false'));
    render();
  }));
  const jump = () => { if (grid) window.scrollTo({ top: (grid as HTMLElement).offsetTop - 120, behavior: 'smooth' }); };
  prev?.addEventListener('click', () => { if (page > 1) { page--; render(); jump(); } });
  next?.addEventListener('click', () => { page++; render(); jump(); });
  render();
</script>

<style>
  /* Featured latest story: editorial split card. */
  .story-featured {
    display: grid; grid-template-columns: 1.15fr 1fr; align-items: stretch;
    background: var(--color-white); border: 1px solid var(--color-border);
    border-radius: 14px; overflow: hidden; box-shadow: var(--shadow-card);
    text-decoration: none; color: inherit; margin-bottom: var(--space-16);
    transition: box-shadow 200ms;
  }
  .story-featured:hover { box-shadow: 0 22px 48px rgba(31, 58, 26, 0.18); }
  .story-featured__photo { min-height: 340px; background-size: cover; background-position: center 30%; transition: transform 400ms ease; }
  .story-featured:hover .story-featured__photo { transform: scale(1.03); }
  .story-featured__body { display: flex; flex-direction: column; justify-content: center; gap: var(--space-3); padding: clamp(var(--space-8), 4vw, var(--space-12)); text-align: center; align-items: center; }
  .story-featured__kicker { font-size: 0.75rem; font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-gold-deep); }
  .story-featured__body h2 { margin: 0; font-size: clamp(1.5rem, 3vw, 2.2rem); }
  .story-featured__body p { margin: 0; color: var(--color-ink-soft); line-height: 1.7; max-width: 48ch; }
  .story-featured__meta { font-size: 0.8rem; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; color: var(--color-sage); }
  .story-featured__cta { font-weight: 800; color: var(--color-gold-deep); }
  .story-featured:hover .story-featured__cta { color: var(--color-green); }
  @media (max-width: 800px) { .story-featured { grid-template-columns: 1fr; } .story-featured__photo { min-height: 240px; } }

  .stories-count { text-align: center; color: var(--color-sage); font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; font-size: 0.85rem; margin: 0 0 var(--space-6); }
  /* Quiet underline tabs instead of pills. */
  .story-filters { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-6); justify-content: center; margin: 0 0 var(--space-12); border-bottom: 1px solid var(--color-border); padding-bottom: 0; }
  .story-filter { padding: 10px 2px 14px; border: 0; border-bottom: 3px solid transparent; background: none; font-weight: 700; font-size: 0.85rem; color: var(--color-sage); cursor: pointer; transition: color 140ms, border-color 140ms; margin-bottom: -1px; }
  .story-filter:hover { color: var(--color-green); }
  .story-filter[aria-pressed="true"] { color: var(--color-green); border-bottom-color: var(--color-gold); }
  .stories-grid :global(.post-card) { border-radius: 12px; }
  .stories-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-8); }
  @media (max-width: 900px) { .stories-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { .stories-grid { grid-template-columns: 1fr; } }
  .story-pager { display: flex; align-items: center; justify-content: center; gap: var(--space-6); margin-top: var(--space-12); }
  .story-pager__btn { padding: 11px 22px; border-radius: var(--radius-pill); border: 2px solid var(--color-green); background: transparent; color: var(--color-green); font-weight: 700; cursor: pointer; transition: background 140ms, color 140ms; }
  .story-pager__btn:hover:not(:disabled) { background: var(--color-green); color: var(--color-white); }
  .story-pager__btn:disabled { opacity: 0.4; cursor: not-allowed; }
  .story-pager__info { color: var(--color-ink-soft); font-size: 0.9rem; }
</style>
