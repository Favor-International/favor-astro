---
import { getCollection, render } from 'astro:content';
import RedesignLayout from '../../../layouts/RedesignLayout.astro';
import PageHero from '../../../components/band/PageHero.astro';
import LeafHeading from '../../../components/redesign/LeafHeading.astro';
import RdCta from '../../../components/redesign/RdCta.astro';

// One page per posting in src/content/jobs. Drafts and closed postings are
// not built. A sending-countries posting renders inside the recruit-geo
// markers so functions/_middleware.ts can strip it outside the allowlist and
// show the "no posting for your location" note instead.
export async function getStaticPaths() {
  const jobs = await getCollection('jobs', ({ data }) => data.status === 'open');
  return jobs.map((job) => ({ params: { slug: job.id }, props: { job } }));
}
const { job } = Astro.props;
const { Content } = await render(job);
const d = job.data;
const gated = d.visibility === 'sending-countries';

const REC_ONLY_OPEN = '<!--recruit-only-->';
const REC_ONLY_CLOSE = '<!--/recruit-only-->';
const REC_CLOSED_OPEN = '<!--recruit-closed-->';
const REC_CLOSED_CLOSE = '<!--/recruit-closed-->';

const applyHref = `mailto:${d.applyEmail}${d.applySubject ? `?subject=${encodeURIComponent(d.applySubject)}` : ''}`;
const fmt = (x: Date) => x.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });

const jobSchema = {
  '@context': 'https://schema.org',
  '@type': 'JobPosting',
  title: d.title,
  description: d.summary,
  datePosted: d.posted.toISOString().slice(0, 10),
  employmentType: 'FULL_TIME',
  hiringOrganization: { '@type': 'Organization', name: 'Favor International', sameAs: 'https://favorintl.org' },
  jobLocationType: /remote/i.test(d.location) ? 'TELECOMMUTE' : undefined,
  jobLocation: { '@type': 'Place', address: d.location },
  applicantLocationRequirements: /united states/i.test(d.location) ? { '@type': 'Country', name: 'United States' } : undefined,
  directApply: false,
};
---
{/* A gated posting keeps a generic <head> so the title and description do
    not name the role for visitors the middleware hides it from. */}
<RedesignLayout
  title={gated ? 'Careers' : `${d.title} | Careers`}
  description={gated ? 'Full-time positions with Favor International.' : d.summary}
  image={gated ? '/images/field-2026/pbs-6.webp' : d.image}
>
  {gated && <Fragment set:html={REC_ONLY_OPEN} />}
  <script type="application/ld+json" set:html={JSON.stringify(jobSchema)} />
  <PageHero
    label="Careers"
    title={d.title}
    promise={d.summary}
    image={d.image}
    imageAlt={d.imageAlt}
    ctaLabel="Apply by email"
    ctaHref={applyHref}
    secondaryLabel="All positions"
    secondaryHref="/go/careers/"
  />

  <section class="band band--white">
    <div class="container container--narrow">
      <p class="job-back"><a href="/go/careers/">&larr; All open positions</a></p>
      <dl class="cd-meta">
        <div><dt>Type</dt><dd>{d.type}</dd></div>
        <div><dt>Location</dt><dd>{d.location}</dd></div>
        {d.team && <div><dt>Team</dt><dd>{d.team}</dd></div>}
        <div><dt>Compensation</dt><dd>{d.compensation}</dd></div>
        <div><dt>Posted</dt><dd>{fmt(d.posted)}</dd></div>
      </dl>

      <article class="job-body rd-prose">
        <Content />
      </article>

      {d.applyNote && <p class="job-note">{d.applyNote}</p>}
      <p class="band__cta-row"><a class="btn btn--primary" href={applyHref}>Apply by email</a></p>
    </div>
  </section>

  <RdCta
    heading={`Apply for ${d.title}.`}
    body={`Email ${d.applyEmail} with your resume and a few sentences on why this role and this mission interest you.`}
    ctaLabel="Apply by email"
    ctaHref={applyHref}
    background="greenlight"
    image={d.image}
    imageAlt={d.imageAlt}
  />
  {gated && (
    <Fragment>
      <Fragment set:html={REC_ONLY_CLOSE} />
      <Fragment set:html={REC_CLOSED_OPEN} />
      <PageHero
        label="Careers"
        title="Work with Favor."
        promise="Full-time positions are listed when a posting is open for your location."
        image="/images/field-2026/pbs-6.webp"
        imageAlt="A line of commissioned Favor leaders holding Bibles outside their village"
        ctaLabel="See all positions"
        ctaHref="/go/careers/"
        secondaryLabel="Volunteer from home"
        secondaryHref="/go/volunteer/"
      />
      <section class="band band--white">
        <div class="container container--narrow">
          <LeafHeading
            label="Open positions"
            title="No posting is listed for your location."
            intro="Internships and volunteer roles stay open. Email us if you have another question."
          />
          <p class="band__cta-row"><a class="btn btn--primary" href="/about/contact/">Email Favor</a></p>
        </div>
      </section>
      <Fragment set:html={REC_CLOSED_CLOSE} />
    </Fragment>
  )}
</RedesignLayout>

<style>
  .job-back { margin: 0 0 var(--space-6); }
  .job-back a { color: var(--color-green); font-weight: 700; text-decoration: none; }
  .job-back a:hover { color: var(--color-gold-deep); }
  .cd-meta { display: flex; flex-wrap: wrap; gap: var(--space-4); margin: 0 0 clamp(40px, 5vw, 64px); padding: 0; }
  .cd-meta div { flex: 1 1 200px; background: var(--color-cream); border: 1px solid rgba(31, 58, 26, 0.12); border-radius: var(--radius-card); padding: var(--space-4) var(--space-5); }
  .cd-meta dt { font-size: 0.72rem; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-gold-deep); }
  .cd-meta dd { margin: var(--space-2) 0 0; font-weight: 600; color: var(--color-green); }

  .job-body :global(h2) { color: var(--color-green); font-size: var(--rd-fs-sub); margin: clamp(32px, 4vw, 44px) 0 var(--space-4); }
  .job-body :global(h2:first-child) { margin-top: 0; }
  .job-body :global(h3) { color: var(--color-ink); font-size: 1.05rem; margin: var(--space-6) 0 var(--space-3); }
  .job-body :global(p) { color: var(--color-ink-soft); line-height: 1.75; margin: 0 0 var(--space-4); }
  .job-body :global(ul) { margin: 0 0 var(--space-4); padding-left: var(--space-6); color: var(--color-ink-soft); line-height: 1.7; }
  .job-body :global(li) { margin-bottom: var(--space-2); }
  .job-body :global(a) { color: var(--color-green); font-weight: 700; }
  .job-note { margin: var(--space-6) 0 0; padding: var(--space-4) var(--space-5); background: var(--color-cream); border-left: 4px solid var(--color-gold); color: var(--color-ink-soft); line-height: 1.7; border-radius: 0 var(--radius-card) var(--radius-card) 0; }
</style>
