---
import RedesignLayout from '../../layouts/RedesignLayout.astro';
import PageHero from '../../components/band/PageHero.astro';
import LeafHeading from '../../components/redesign/LeafHeading.astro';
import ScriptBand from '../../components/redesign/ScriptBand.astro';
import RdCta from '../../components/redesign/RdCta.astro';

// Paths as full vertical sections (per Daniel 2026-07-08): image or video on
// one side, expanded copy on the other, alternating down the page. Every
// claim comes from the destination page it links to (which is itself
// fact-audited); no trip specifics, role lists, or program claims beyond
// what those pages state.
//
// Team decision, 2026-08: field travel is project-based. Framing is inviting,
// the field staff time, vehicles, and money, so this page no longer sells
// ordinary short-term trips. The first path is a funded project you see
// through, and the copy is written to filter out mission-trip tourism.
const paths = [
  {
    key: 'vision-trips', href: '/go/vision-trips/', label: 'Project Trips',
    title: 'Come build something that lasts.',
    video: '/videos/vision-trips-hero.mp4', poster: '/videos/vision-trips-hero-poster.jpg',
    imageAlt: 'A village congregation gathered for worship, from the film They Once Met Under Trees',
    body: [
      'Field travel with Favor is tied to a project. You raise the funds for something concrete, around $20,000 for a rural school or a Village Learning Center building, and you travel with a small team to see that project through with the leaders who will run it.',
      'Every trip ends with something to dedicate: a school or a Learning Center building the field asked for, funded by you and opened together with the village it serves.',
    ],
    points: ['A concrete project with a name and a place', 'Small teams, hosted by the field leaders who run the work', 'What you fund outlasts your visit'],
    cta: 'See how project trips work',
  },
  {
    key: 'volunteer', href: '/go/volunteer/', label: 'Volunteer',
    title: 'Serve from home.',
    image: '/images/field-2026/street-outreach-3.webp',
    imageAlt: 'A Favor street outreach team serving',
    body: [
      'Favor’s US team is greatly supported by volunteer team members to keep operations going. From media, to accounting, to mailing and other administrative assistance, there are people who keep the vision running and ensure all our partners are honored.',
      'Volunteers can work from anywhere but are welcome to visit Favor’s office.',
    ],
    points: ['Prayer & intercession', 'Media & creative', 'Accounting & administrative', 'Mailing & partner care'],
    cta: 'See volunteer roles',
  },
  {
    key: 'internships', href: '/go/internships/', label: 'Internships',
    title: 'Months that change your life.',
    image: '/images/field-2026/vlc-3.webp',
    imageAlt: 'A Village Learning Center class in session',
    body: [
      'A months-long internship alongside the US team, working on the real operations that carry the field: media, administration, partner care, and more.',
      'An internship that will change your life.',
    ],
    points: ['Months-long, alongside the US team', 'Real responsibility: media, administration, partner care'],
    cta: 'Ask about internships',
  },
  {
    key: 'careers', href: '/go/careers/', label: 'Careers',
    title: 'Work with Favor full-time.',
    image: '/images/field-2026/missionaries-2.webp',
    imageAlt: 'Indigenous Favor leaders in South Sudan',
    body: [
      'Open positions with the ministry, starting with the Country Director posting: full-time, living in country, based in Gulu, Uganda or Juba, South Sudan.',
      'The full posting, responsibilities, and qualifications are on the careers page.',
    ],
    points: ['Country Director: Uganda or South Sudan', 'Reports to the Founder and the Board'],
    cta: 'See open positions',
  },
  {
    key: 'ambassadors', href: '/go/ambassadors/', label: 'Ambassadors',
    title: 'Be a voice to the vision.',
    image: '/images/field-2026/prayer-gathering-3.webp',
    imageAlt: 'Worshippers singing at a Favor gathering',
    body: [
      'Represent Favor where you live. Share the story with your church, Bible study, prayer group, or team of colleagues, with resources we provide, a video call with a team member, or an in-person visit.',
    ],
    points: ['Share the story where you live', 'Gather prayer for the nations Favor serves'],
    cta: 'Become a voice',
  },
  {
    key: 'church', href: '/go/church-partnerships/', label: 'Church Partnerships',
    title: 'Mobilize your church around a field team.',
    image: '/images/field-2026/evangelism-6.webp',
    imageAlt: 'A Favor evangelism gathering',
    body: [
      'Point your congregation at an indigenous Favor field team: pray together as a church, partner together, and carry a project your whole church can fund and then send a few of its own to see through.',
    ],
    points: ['Church-wide prayer and partnership', 'A field team your church can know by name'],
    cta: 'Church partnerships',
  },
];
---
<RedesignLayout
  title="Go"
  description="Fund a field project and come see it through, or serve from home: volunteering, internships, careers, and church partnerships with Favor International."
  image="/images/field-2026/missionaries-1.webp"
>
  <PageHero
    label="Go"
    title="Come to build. Or serve from where you are."
    promise="Field travel with Favor is tied to a project you fund and see through. There are also real ways to serve without a plane ticket."
    image="/images/field-2026/missionaries-3.webp"
    imageAlt="PBS graduation in Karamoja, Uganda"
    ctaLabel="See project trips"
    ctaHref="/go/vision-trips/"
    secondaryLabel="Serve from home"
    secondaryHref="/go/volunteer/"
    scrollCue
  />

  <section class="band band--white">
    <div class="container">
      <LeafHeading label="The paths" title="Pick how you go." />
      <div class="paths">
        {paths.map((p, i) => (
          <article class="path reveal" data-side={i % 2 === 0 ? 'left' : 'right'} id={p.key}>
            <div class="path__media">
              {p.video ? (
                <video class="path__video" autoplay muted loop playsinline preload="metadata" poster={p.poster} aria-label={p.imageAlt}>
                  <source src={p.video} type="video/mp4" />
                </video>
              ) : (
                <img src={p.image} alt={p.imageAlt} loading="lazy" width="1200" height="900" />
              )}
            </div>
            <div class="path__copy">
              <p class="label">{p.label}</p>
              <h3>{p.title}</h3>
              {p.body.map((b) => <p class="path__p">{b}</p>)}
              <ul class="path__points">
                {p.points.map((pt) => <li>{pt}</li>)}
              </ul>
              <a class="btn btn--primary path__btn" href={p.href}>{p.cta} <span aria-hidden="true">&rarr;</span></a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <ScriptBand
    image="/images/field-2026/crusade-2.webp"
    imageAlt="People praying with raised hands at an open-air gathering at dusk"
    label="The prayer of Favor's indigenous missionaries"
    phrase="Lord, send us where no one else wants to go. Send us! We will go!"
    cite="From Lord Send Us Where No One Wants to Go (2025)"
    font="serif"
    objectPosition="center 25%"
    tall
  />

  <RdCta
    heading="Not sure which fits?"
    body="Email us a one-line note about your time and your context. We will point you to the right path."
    ctaLabel="Email the Go team"
    ctaHref="/about/contact/?topic=go"
    image="/images/field-2026/evangelism-5.webp"
    imageAlt="Favor leadership at a training session"
  />
</RedesignLayout>

<style>
  /* Five paths as full alternating sections: big media, expanded copy. */
  .paths { display: flex; flex-direction: column; gap: clamp(64px, 8vw, 128px); margin-top: clamp(48px, 6vw, 80px); }
  .path { display: grid; grid-template-columns: 1.1fr 1fr; gap: clamp(36px, 5vw, 88px); align-items: center; }
  .path[data-side='right'] .path__media { order: 2; }
  .path[data-side='right'] .path__copy { order: 1; }
  .path__media img,
  .path__video {
    display: block; width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover;
    border-radius: var(--rd-radius); box-shadow: var(--rd-shadow);
  }
  .path__copy .label { margin-bottom: var(--space-2); }
  .path__copy h3 {
    color: var(--color-green); font-family: var(--font-display); font-weight: 600;
    font-size: var(--rd-fs-title); line-height: 1.16; margin: 0 0 var(--space-5); text-wrap: balance;
  }
  .path__p { margin: 0 0 var(--space-4); color: var(--color-ink-soft); line-height: 1.75; }
  .path__points { list-style: none; padding: 0; margin: var(--space-5) 0 var(--space-6); display: flex; flex-direction: column; gap: var(--space-3); }
  .path__points li { position: relative; padding-left: var(--space-6); color: var(--color-ink); font-weight: 600; line-height: 1.5; }
  .path__points li::before { content: '✓'; position: absolute; left: 0; color: var(--color-gold-deep); font-weight: 800; }
  .path__btn { display: inline-flex; align-items: center; gap: 8px; }
  @media (max-width: 900px) {
    .path { grid-template-columns: 1fr; gap: var(--space-6); }
    .path[data-side='right'] .path__media { order: 0; }
    .path[data-side='right'] .path__copy { order: 0; }
  }
</style>
