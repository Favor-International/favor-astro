---
import RedesignLayout from '../../layouts/RedesignLayout.astro';
import PageHero from '../../components/band/PageHero.astro';
import LeafHeading from '../../components/redesign/LeafHeading.astro';
import ScriptBand from '../../components/redesign/ScriptBand.astro';
import RdCta from '../../components/redesign/RdCta.astro';

// Five ways to go. Descriptions are navigational only - no trip frequencies,
// role lists, or program specifics that Favor has not published (fact-audit
// rule, see docs/06-reference/about-fact-audit-2026-07-08.md).
const paths = [
  { href: '/go/vision-trips/', label: 'Vision Trips', desc: 'Walk the field with the leaders who live there, in a small team.', image: '/images/story-vision-trip-team.jpg' },
  { href: '/go/volunteer/', label: 'Volunteer', desc: 'Serve the US team from anywhere: media, accounting, mailing, and administrative help.', image: '/images/field-2026/street-outreach-3.webp' },
  { href: '/go/volunteer/', label: 'Internships', desc: 'Months-long internships alongside the US team and the field.', image: '/images/field-2026/vlc-3.webp' },
  { href: '/go/careers/', label: 'Careers', desc: 'Open positions with Favor, starting with the Country Director posting.', image: '/images/field-2026/street-outreach-2.webp' },
  { href: '/give/church-partnership/', label: 'Church Partnerships', desc: 'Mobilize your church around an indigenous Favor field team.', image: '/images/field-2026/evangelism-6.webp' },
];
---
<RedesignLayout
  title="Go"
  description="Walk the field. Volunteer from home. Intern, serve, or mobilize your church. Five paths to go with Favor International."
  image="/images/field-2026/missionaries-1.webp"
>
  <PageHero
    label="Go"
    title="Travel with us. Or send someone in your place."
    promise="Five ways to go: vision trips, volunteering, internships, careers, and church partnerships."
    image="/images/field-2026/missionaries-3.webp"
    imageAlt="PBS graduation in Karamoja, Uganda"
    ctaLabel="See vision trips"
    ctaHref="/go/vision-trips/"
    secondaryLabel="Serve from home"
    secondaryHref="/go/volunteer/"
    scrollCue
  />

  <section class="band band--white">
    <div class="container">
      <LeafHeading label="Five paths" title="Pick how you go." />
      <div class="rd-grid rd-grid--3">
        {paths.map((p) => (
          <a class="rd-tile" href={p.href}>
            <div class="rd-tile__img" style={`background-image:url('${p.image}')`} role="img" aria-label={p.label}></div>
            <div class="rd-tile__meta">
              <h3>{p.label}</h3>
              <p>{p.desc}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <ScriptBand
    image="/images/field-2026/missionaries-1.webp"
    imageAlt="Favor's indigenous missionaries gathered in the field"
    label="The prayer of Favor's indigenous missionaries"
    phrase="Lord, send us where no one else wants to go. Send us! We will go!"
    cite="From Lord Send Us Where No One Wants to Go (2025)"
    font="serif"
    tall
  />

  <RdCta
    heading="Not sure which fits?"
    body="Email us a one-line note about your time and your context. We will point you to the right path."
    ctaLabel="Email the Go team"
    ctaHref="/about/contact/?topic=go"
    image="/images/field-2026/evangelism-5.webp"
    imageAlt="Favor leadership at a training session"
  />
</RedesignLayout>
