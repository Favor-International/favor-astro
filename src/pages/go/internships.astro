---
import RedesignLayout from '../../layouts/RedesignLayout.astro';
import PageHero from '../../components/band/PageHero.astro';
import RdFeature from '../../components/redesign/RdFeature.astro';
import LeafHeading from '../../components/redesign/LeafHeading.astro';
import ScriptBand from '../../components/redesign/ScriptBand.astro';
import RdCta from '../../components/redesign/RdCta.astro';

// Logistics without fabricated deadlines: Favor has no published cohort
// calendar, so timing is stated honestly (a season of months, planned around
// the intern's own calendar) instead of invented application windows.
const logistics = [
  { title: 'When', body: 'A season of months, timed around your calendar. Semesters and summers fit naturally; start the conversation before your season begins.' },
  { title: 'Where', body: 'Remote from anywhere in the US, working alongside the US team.' },
  { title: 'How it starts', body: 'One note through the contact form: who you are, your skills, and the months you have.' },
];

// What an intern walks away with. Kept to what the operation really is (the
// roster runs these functions daily); no invented systems or certifications.
const takeaways = [
  { title: 'Real nonprofit operations', body: 'Hands-on experience inside a working international ministry: administration, records, and the day-to-day that keeps an ECFA-accredited organization running.' },
  { title: 'Storytelling with real stakes', body: 'Media, newsletters, and social content built from field material, for the partners who support the work.' },
  { title: 'How indigenous missions work', body: 'A close-up view of how a US office serves indigenous field teams across Uganda, South Sudan, and Chad.' },
];

// FAQ: process-honest answers only. Credit, funding, and housing are shaped
// in the planning conversation - no promises Favor has not published.
const faqs = [
  { q: 'When should I ask?', a: 'Before the season you have in mind - ahead of your semester or summer. The earlier the conversation starts, the better the internship fits.' },
  { q: 'Can I get academic or seminary credit?', a: 'If your school offers internship credit, bring its requirements to the planning conversation and the US team will work with them.' },
  { q: 'Can I intern while working or studying part-time?', a: 'Internships are shaped around your season and your schedule, and remote work is normal. Tell us what your months actually look like.' },
  { q: 'Is fundraising required? What about housing?', a: 'It depends on the shape of your internship. Support and any housing or travel details are worked out with the US team during planning, before you commit.' },
];

// Internships as their own page (per Daniel 2026-07-08: the menu has both an
// Internships link and a Careers link, so they are two different things).
// Content stays inside Favor's verbatim material: "a months long internship
// that will change your life" and the operational areas Favor's own text
// names (media, accounting, mailing, administrative assistance). No invented
// eligibility, stipends, or start dates - all of that is shaped in the
// planning conversation.
const areas = [
  { icon: 'media', title: 'Media & creative', body: 'Video, design, newsletters, and the social content that keeps partners connected to the field.' },
  { icon: 'admin', title: 'Administration & operations', body: 'The office work that carries the ministry: records, data, and day-to-day operations support.' },
  { icon: 'mail', title: 'Partner care & mailings', body: 'The mailings, notes, and receipts that ensure all our partners are honored.' },
  { icon: 'pray', title: 'Prayer at the center', body: 'Whatever your track, prayer is part of the rhythm. Every Favor day begins there.' },
];
const AREA_ICONS: Record<string, string> = {
  media: '<rect x="3" y="6" width="13" height="12" rx="2"/><path d="M16 10.5 21 7v10l-5-3.5"/>',
  admin: '<rect x="4" y="4" width="16" height="16" rx="2"/><path d="M8 9h8M8 13h8M8 17h5"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>',
  pray: '<path d="M12 3v3M8 5l1.5 2M16 5l-1.5 2"/><path d="M12 21c-3.5-1.6-5.5-4.2-5.5-7.5V9l5.5 2.5L17.5 9v4.5c0 3.3-2 5.9-5.5 7.5Z"/>',
};

const steps = [
  { n: '1', title: 'Inquire', body: 'Tell us who you are, what you can do, and the months you have.' },
  { n: '2', title: 'Shape it together', body: 'The US team builds the internship around your skills and season.' },
  { n: '3', title: 'Serve for a season', body: 'Months alongside the US team, on the real operations that carry the field.' },
];
---
<RedesignLayout
  title="Internships"
  description="Months-long internships with Favor International, alongside the US team: media, administration, and partner care. An internship that will change your life."
>
  <PageHero
    label="Internships"
    title="A season that changes your life."
    promise="Months-long internships alongside the US team, on the work that carries the field."
    image="/images/field-2026/vlc-3.webp"
    imageAlt="A Village Learning Center class in session"
    ctaLabel="Ask about internships"
    ctaHref="/about/contact/?topic=internship"
    scrollCue
  />

  <RdFeature
    image="/images/field-2026/street-outreach-5.webp"
    imageAlt="A Favor team serving together in the field"
    eyebrow="What an internship is"
    heading="Real responsibility, for a season."
    side="right"
  >
    <p>
      A months-long internship that will change your life. Interns serve alongside the US
      team on the operations that carry the field: media, administration, and partner care.
    </p>
    <p>
      You bring your skills and your season; the US team shapes the internship with you. You
      can work remotely, working alongside the US team wherever you are.
    </p>
  </RdFeature>

  <section class="band band--cream">
    <div class="container">
      <LeafHeading label="The logistics" title="Plain answers up front." leaves={false} />
      <div class="logi">
        {logistics.map((l) => (
          <div class="logi__col reveal">
            <h3>{l.title}</h3>
            <p>{l.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="band band--white">
    <div class="container">
      <LeafHeading label="The work" title="Where interns serve." leaves={false} />
      <div class="areas">
        {areas.map((a) => (
          <div class="areas__col reveal">
            <span class="areas__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={AREA_ICONS[a.icon]}></svg>
            </span>
            <h3>{a.title}</h3>
            <p>{a.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="band band--cream">
    <div class="container">
      <LeafHeading label="What you'll take with you" title="A season that counts twice." intro="Interns leave with experience in nonprofit operations, storytelling, and indigenous missions." leaves={false} />
      <div class="gains">
        {takeaways.map((t, i) => (
          <div class="gains__col reveal">
            <span class="gains__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h3>{t.title}</h3>
            <p>{t.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <ScriptBand
    image="/images/field-2026/prayer-7.webp"
    imageAlt="A Favor team praying together"
    label="The spiritual core"
    phrase="Prayer is not optional but necessary if you want to live. That's how we treat prayer and the Word of God here."
    cite="Carole Ward, to young visitors at the mission - Lord Send Us Where No One Wants to Go"
    font="serif"
    tall
  />

  <section class="band band--white">
    <div class="container">
      <LeafHeading label="How it works" title="Three steps to a season that counts." leaves={false} />
      <ol class="steps">
        {steps.map((s) => (
          <li class="rd-card steps__item reveal">
            <span class="steps__n" aria-hidden="true">{s.n}</span>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="band band--cream">
    <div class="container container--narrow">
      <LeafHeading label="Questions, answered" title="Before you ask." leaves={false} />
      <div class="faq">
        {faqs.map((f) => (
          <details class="faq__item rd-outline">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="band band--greenlight">
    <div class="container">
      <LeafHeading label="Not an internship?" title="Two doors right next to this one." leaves={false} />
      <div class="also">
        <a class="also__card rd-card reveal" href="/go/volunteer/">
          <p class="label">Ongoing, from home</p>
          <h3>Volunteer</h3>
          <p>Serve the US team from anywhere, on your own schedule: prayer, media, accounting, mailing, and partner care.</p>
          <span class="also__link">Serve from home &rarr;</span>
        </a>
        <a class="also__card rd-card reveal" href="/go/careers/">
          <p class="label">Full-time</p>
          <h3>Careers</h3>
          <p>Full-time positions with the ministry. Current openings, when we have them, are on the careers page.</p>
          <span class="also__link">See open positions &rarr;</span>
        </a>
      </div>
    </div>
  </section>

  <RdCta
    heading="Ask about an internship."
    body="Tell us who you are and the months you have. The US team takes it from there."
    ctaLabel="Ask about internships"
    ctaHref="/about/contact/?topic=internship"
    background="greenlight"
    image="/images/field-2026/vlc-3.webp"
    imageAlt="A Village Learning Center class in session"
  />
</RedesignLayout>

<style>
  /* Where interns serve: open columns with gold medallions (house idiom). */
  .areas { display: grid; grid-template-columns: repeat(4, 1fr); margin-top: clamp(36px, 4.4vw, 58px); }
  .areas__col { padding: var(--space-2) clamp(18px, 2.2vw, 36px); text-align: center; }
  .areas__col + .areas__col { border-left: 1px solid rgba(31, 58, 26, 0.14); }
  .areas__icon {
    display: inline-flex; align-items: center; justify-content: center;
    width: 60px; height: 60px; border-radius: 50%;
    background: color-mix(in srgb, var(--color-gold) 16%, var(--color-white));
    color: var(--color-gold-deep);
    margin-bottom: var(--space-5);
  }
  .areas__icon svg { width: 28px; height: 28px; }
  .areas__col h3 { color: var(--color-green); margin: 0 0 var(--space-3); font-size: var(--rd-fs-sub); }
  .areas__col p { margin: 0 auto; color: var(--color-ink-soft); line-height: 1.7; font-size: var(--rd-fs-body); max-width: 30ch; }
  @media (max-width: 1024px) {
    .areas { grid-template-columns: repeat(2, 1fr); row-gap: var(--space-8); }
    .areas__col:nth-child(3) { border-left: 0; }
  }
  @media (max-width: 560px) {
    .areas { grid-template-columns: 1fr; row-gap: var(--space-6); }
    .areas__col + .areas__col { border-left: 0; border-top: 1px solid rgba(31, 58, 26, 0.14); padding-top: var(--space-6); }
  }

  /* Steps (house idiom). */
  .steps { list-style: none; padding: 0; margin: clamp(36px, 4.4vw, 58px) 0 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(20px, 2.4vw, 32px); }
  @media (max-width: 860px) { .steps { grid-template-columns: 1fr; } }
  .steps__n {
    display: inline-flex; align-items: center; justify-content: center;
    width: 44px; height: 44px; border-radius: 50%;
    background: var(--rd-bg-green); color: var(--color-green);
    font-weight: 800; font-size: 1.15rem; margin-bottom: var(--space-4);
  }
  .steps__item h3 { color: var(--color-green); margin: 0 0 var(--space-3); }
  .steps__item p { margin: 0; color: var(--color-ink-soft); line-height: 1.7; }

  /* Logistics: three plain columns, hairline separated. */
  .logi { display: grid; grid-template-columns: repeat(3, 1fr); margin-top: clamp(36px, 4.4vw, 58px); }
  .logi__col { padding: var(--space-2) clamp(20px, 2.6vw, 44px); text-align: center; }
  .logi__col + .logi__col { border-left: 1px solid rgba(31, 58, 26, 0.14); }
  .logi__col h3 { color: var(--color-gold-deep); font-size: var(--rd-fs-small); font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; margin: 0 0 var(--space-3); }
  .logi__col p { margin: 0 auto; color: var(--color-ink); line-height: 1.7; max-width: 34ch; font-weight: 500; }
  @media (max-width: 860px) {
    .logi { grid-template-columns: 1fr; row-gap: var(--space-6); }
    .logi__col + .logi__col { border-left: 0; border-top: 1px solid rgba(31, 58, 26, 0.14); padding-top: var(--space-6); }
  }

  /* Takeaways: gold-ruled numbered columns. */
  .gains { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(28px, 4vw, 56px); margin-top: clamp(36px, 4.4vw, 58px); }
  @media (max-width: 860px) { .gains { grid-template-columns: 1fr; } }
  .gains__col { border-top: 2px solid color-mix(in srgb, var(--color-gold) 55%, transparent); padding-top: var(--space-5); }
  .gains__num { font-family: var(--font-display); font-weight: 700; color: var(--color-gold-deep); letter-spacing: 0.08em; }
  .gains__col h3 { color: var(--color-green); margin: var(--space-3) 0; font-size: var(--rd-fs-sub); }
  .gains__col p { margin: 0; color: var(--color-ink-soft); line-height: 1.7; }

  /* FAQ accordion (house idiom). */
  .faq { display: flex; flex-direction: column; gap: var(--space-3); margin-top: clamp(36px, 4.4vw, 58px); }
  .faq__item { padding: 0; overflow: hidden; }
  .faq__item summary {
    cursor: pointer; list-style: none; position: relative;
    padding: var(--space-5) var(--space-12) var(--space-5) var(--space-6);
    font-weight: 700; color: var(--color-ink);
  }
  .faq__item summary::-webkit-details-marker { display: none; }
  .faq__item summary::after {
    content: '+'; position: absolute; right: var(--space-6); top: 50%; transform: translateY(-50%);
    color: var(--color-green); font-weight: 700; font-size: 1.3rem; line-height: 1;
    transition: transform 160ms ease;
  }
  .faq__item[open] summary::after { transform: translateY(-50%) rotate(45deg); }
  .faq__item summary:hover { color: var(--color-green); }
  .faq__item p { margin: 0; padding: 0 var(--space-6) var(--space-5); color: var(--color-ink-soft); line-height: 1.7; }

  /* The two doors next to this one. */
  .also { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(20px, 2.4vw, 32px); margin-top: clamp(36px, 4.4vw, 58px); max-width: 900px; margin-inline: auto; }
  @media (max-width: 700px) { .also { grid-template-columns: 1fr; } }
  .also__card { display: flex; flex-direction: column; text-decoration: none; color: inherit; }
  .also__card .label { margin-bottom: var(--space-2); }
  .also__card h3 { color: var(--color-green); margin: 0 0 var(--space-3); }
  .also__card p:not(.label) { margin: 0 0 var(--space-4); color: var(--color-ink-soft); line-height: 1.7; }
  .also__link { margin-top: auto; color: var(--color-green); font-weight: 700; border-bottom: 2px solid var(--color-gold); padding-bottom: 2px; width: fit-content; }
  .also__card:hover .also__link { color: var(--color-gold-deep); }
</style>
