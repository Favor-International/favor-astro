---
import RedesignLayout from '../../layouts/RedesignLayout.astro';
import PageHero from '../../components/band/PageHero.astro';
import LeafHeading from '../../components/redesign/LeafHeading.astro';
import RdCta from '../../components/redesign/RdCta.astro';

// Moved from /give/church-partnership/ (2026-07-08, per Daniel): church
// partnerships is a GO path, and living under /go/ makes the GO menu
// highlight correctly. The old URL redirects here (astro.config).
// Content is unchanged: the "Invitation to Share" copy is verbatim from
// favorintl.org; the three ways are real engagement paths (the invented
// tier packages were removed back in June and stay gone).
const ways = [
  {
    title: 'Share Favor with your church',
    image: '/images/field/pbs-chad.webp',
    alt: 'A Portable Bible School congregation in Chad',
    body: 'Resources to present to your group, a video call with a team member, or an in-person visit. Sharing what God is doing is the best way to learn what God is doing.',
    cta: 'Request a presentation',
    href: '/about/contact/?topic=church',
  },
  {
    title: 'Give as a church',
    image: '/images/field/bibles-south-sudan.webp',
    alt: 'A young woman receives a Bible in South Sudan',
    body: 'Give online as a congregation, by check, or through stock and non-cash gifts. Every gift is tax-deductible and accounted for under ECFA standards.',
    cta: 'See the ways to give',
    href: '/give/',
  },
  {
    title: 'Send your people',
    image: '/images/field/youth-south-sudan.webp',
    alt: 'Young men reached through youth ministry in South Sudan',
    body: 'Two-week mission trips and internships put your members alongside the indigenous teams: children’s ministry, rural evangelism, prison ministry, radio, and more.',
    cta: 'See trips and volunteering',
    href: '/go/vision-trips/',
  },
];
---
<RedesignLayout
  title="Church Partnerships"
  description="Connect your church with Favor International: presentations for your congregation, church giving, and short-term mission trips alongside indigenous field teams."
>
  <PageHero
    label="For churches"
    title="Your church can be part of what God is doing."
    promise="A real relationship with a field team: share the work with your congregation, give together, and send your people."
    image="/images/field-2026/gift-1.webp"
    imageAlt="Church partnership gathering"
    ctaLabel="Start a conversation"
    ctaHref="/about/contact/?topic=church"
    scrollCue
  />

  <section class="band band--white">
    <div class="container church-intro">
      <img src="/images/field-2026/church-7.webp" alt="A church community gathered with Favor" loading="lazy" />
      <div>
        <p class="label">Churches and missions</p>
        <h2>Built on trust and transparency.</h2>
        <p>We know that most churches love to support missions. We also know that a relationship between congregation and missionary builds trust and transparency.</p>
        <p>If you are a pastor or church leader, the Favor team can answer questions, share current information, and help your congregation understand the field relationship before making a commitment.</p>
      </div>
    </div>
  </section>

  <section class="band band--cream">
    <div class="container">
      <LeafHeading label="Three real ways in" title="How churches stand with Favor." leaves={false} />
      <div class="church-ways">
        {ways.map((w) => (
          <a class="church-way reveal" href={w.href}>
            <span class="church-way__photo" style={`background-image:url(${w.image})`} role="img" aria-label={w.alt}></span>
            <span class="church-way__body">
              <h3>{w.title}</h3>
              <p>{w.body}</p>
              <span class="church-way__more">{w.cta} &rarr;</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="voice" aria-label="Invitation to share: be a voice to the vision">
    <div class="voice__grid">
      <div class="voice__copy rd-prose">
        <p class="label">Invitation to share</p>
        <h2>Be a voice to the vision.</h2>
        <p>Revival is happening and the testimonies about what God is doing abound! Whether you found us through Carole&rsquo;s book, or via word of mouth, or you heard Carole speak, or just stumbled across us on the internet&hellip; if your heart is connected with us as an organization and the work that we&rsquo;re doing, then we invite you to be a voice to the vision.</p>
        <p>Do you have a missions conference, church, Bible study, prayer group, or team of colleagues with whom you&rsquo;d like to share about our missions work and the revival happening? Depending on the circumstances and what makes the most sense, we may be able to:</p>
        <ul>
          <li>Provide you with resources for you to present to your group,</li>
          <li>Schedule a video call in which one of our team members could virtually share about the organization with your group,</li>
          <li>Schedule a physical visit for one of our team members to present to your group in person.</li>
        </ul>
      </div>
      <div class="voice__media" role="img" aria-label="A Favor evangelist sharing with a family in a rural settlement" style="background-image:url('/images/field/street-outreach-south-sudan.webp')"></div>
    </div>
  </section>

  <RdCta
    heading="Start a conversation."
    body="Tell us about your church and the missions vision your team has been carrying. We will answer any questions and send you any information."
    ctaLabel="Send the church team an email"
    ctaHref="/about/contact/?topic=church"
    background="white"
    image="/images/field-2026/gift-2.webp"
    imageAlt="A Favor field team"
  />
</RedesignLayout>

<style>
  .church-intro { display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1fr); gap:clamp(36px,6vw,84px); align-items:center; }
  .church-intro img { display:block; width:100%; aspect-ratio:4/3; object-fit:cover; border-radius:var(--rd-radius); }
  .church-intro h2 { margin:0 0 var(--space-5); color:var(--color-green); }
  .church-intro p:not(.label) { color:var(--color-ink-soft); line-height:1.75; }
  @media(max-width:760px){.church-intro{grid-template-columns:1fr}.church-intro img{aspect-ratio:16/10}}

  .church-ways { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(24px, 3vw, 40px); margin-top: clamp(36px, 4.4vw, 58px); }
  @media (max-width: 900px) { .church-ways { grid-template-columns: 1fr; max-width: 460px; margin-inline: auto; } }
  .church-way {
    display: flex; flex-direction: column;
    text-decoration: none; color: inherit;
    transition: transform 200ms ease;
  }
  .church-way:hover { transform: translateY(-4px); }
  .church-way__photo { display: block; aspect-ratio: 16 / 10; background-size: cover; background-position: center 30%; border-radius:var(--rd-radius); }
  .church-way__body { display: flex; flex-direction: column; padding: var(--space-5) var(--space-1) 0; flex: 1; }
  .church-way__body h3 { margin: 0 0 var(--space-3); color: var(--color-green); }
  .church-way__body p { margin: 0; color: var(--color-ink-soft); line-height: 1.65; }
  .church-way__more { display: block; margin-top: auto; padding-top: var(--space-4); color: var(--color-gold-deep); font-weight: 700; font-size: var(--rd-fs-small); }
  .church-way:hover .church-way__more { color: var(--color-green); }

  /* Be a voice to the vision: text and image share one white surface; the
     image bleeds to the right edge with rounded left corners so it reads as
     part of the same composition (per Daniel, 2026-07-08). */
  .voice { background: var(--color-white); padding: clamp(58px, 6.6vw, 100px) 0; }
  .voice__grid {
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    gap: clamp(36px, 5vw, 80px); align-items: center;
  }
  .voice__copy {
    padding-left: max(var(--space-6), calc((100vw - var(--content-max)) / 2 + var(--space-6)));
    padding-right: var(--space-4);
  }
  .voice__copy .label { margin-bottom: var(--space-2); }
  .voice__copy h2 { color: var(--color-green); font-size: var(--rd-fs-title); margin: 0 0 var(--space-5); font-family: var(--font-display); font-weight: 600; }
  .voice__copy ul { margin: 0; padding-left: var(--space-6); color: var(--color-ink-soft); line-height: 1.75; }
  .voice__copy ul li { margin-bottom: var(--space-2); }
  .voice__media {
    min-height: clamp(380px, 42vw, 620px);
    background-size: cover; background-position: center;
    border-radius: var(--rd-radius) 0 0 var(--rd-radius);
    box-shadow: var(--rd-shadow);
  }
  @media (max-width: 900px) {
    .voice__grid { grid-template-columns: 1fr; gap: var(--space-6); }
    .voice__copy { padding: 0 var(--space-6); }
    .voice__media { min-height: 300px; border-radius: var(--rd-radius) 0 0 var(--rd-radius); margin-left: var(--space-6); }
  }
</style>
