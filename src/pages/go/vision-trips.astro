---
import RedesignLayout from '../../layouts/RedesignLayout.astro';
import PageHero from '../../components/band/PageHero.astro';
import RdFeature from '../../components/redesign/RdFeature.astro';
import LeafHeading from '../../components/redesign/LeafHeading.astro';
import VideoFeature from '../../components/redesign/VideoFeature.astro';
import RdCta from '../../components/redesign/RdCta.astro';

// Team decision, 2026-08: public field travel is project-based. The model is
// a concrete project (around $20,000, e.g. a rural school or a Village
// Learning Center building) that the traveler funds and comes to dedicate.
// Will, 2026-08-07: the page must INVITE, never lecture. The commitment of a
// real project is the filter; the page never describes visitors as a cost or
// a burden. The honest boundaries (no trips without a project, no student
// mission teams) live in two gracious FAQ answers and nowhere else. The URL
// and nav label stay "vision trips"; the content is project participation.
//
// Fact-audit rules still apply (docs/06-reference/about-fact-audit-2026-07-08.md):
// no invented calendars, itineraries, or safety protocols. The $20,000 figure
// and the project examples come from the 2026-08 team decision. Everything
// else is documented program material or an honest "worked out with you"
// process answer.

// Example projects. Program claims stay inside Favor's published material
// (education pillar: primary schools and Village Learning Centers).
const projects = [
  {
    name: 'A rural primary school',
    image: '/images/field-2026/education-5.webp',
    alt: 'A Favor school under construction',
    body: 'Classrooms for a village whose children have never had one, with the Word of God at the center of the teaching. Your church or family funds the build, and you come for the opening.',
  },
  {
    name: 'A Village Learning Center building',
    image: '/images/field-2026/vlc-3.webp',
    alt: 'A Village Learning Center class in session',
    body: 'A permanent home for a Village Learning Center, where a village gathers week after week for literacy, discipleship, and practical training. When the doors open, you are there.',
  },
];

// Films from Favor's YouTube channel (titles match the channel).
const films = [
  { id: '25f290un21o', title: 'They Once Met Under Trees', eyebrow: 'Church planting', heading: 'They once met under trees. Now they have a church.', body: 'The kind of congregation your project serves: villages where the church was planted by leaders who grew up there.' },
  { id: '4YpOvDoc6k4', title: 'Where Medicine Meets Miracles', eyebrow: 'Medical work', heading: 'Inside Favor’s medical center in Africa.', body: 'The daily work your project joins on the ground, run by indigenous leaders year-round.' },
];

// Who project trips are for. The invitation names real people; the scale of
// a real project speaks for itself without any gatekeeping language.
const audiences = [
  { icon: 'church', title: 'Churches', body: 'A congregation that turns its missions giving into one specific place: a school its people funded, prayed over, and came to see opened.' },
  { icon: 'pin', title: 'Families and friends', body: 'A family or a few close friends who take on a project together and celebrate its opening together.' },
  { icon: 'compass', title: 'Long-time partners', body: 'Givers who have carried the work from home for years and are ready to meet the people they have been serving.' },
];
const WHO_ICONS: Record<string, string> = {
  church: '<path d="M12 3v4M10 5h4"/><path d="M4 21v-8l8-5 8 5v8"/><path d="M10 21v-5a2 2 0 0 1 4 0v5"/><path d="M3 21h18"/>',
  pin: '<path d="M12 21s-6.2-5.4-6.2-10.2a6.2 6.2 0 1 1 12.4 0C18.2 15.6 12 21 12 21Z"/><circle cx="12" cy="10.6" r="2.4"/>',
  compass: '<circle cx="12" cy="12" r="9"/><path d="M15.5 8.5l-1.8 5.2-5.2 1.8 1.8-5.2 5.2-1.8Z"/>',
};

const steps = [
  { n: '1', title: 'Start the conversation', body: 'Write to the US team. Tell us about you, your church or family, and the kind of project you could take on.' },
  { n: '2', title: 'Take on a project', body: 'The field names its current needs. You choose one, and the people around you raise its funding with the US team alongside you.' },
  { n: '3', title: 'Come for the opening', body: 'You travel in a small team, hosted by the field leaders, and dedicate what God built through you with the village it serves.' },
];

// FAQ: honest process answers, said graciously. This is the only place the
// no-project and no-student-team boundaries appear, and both leave a door open.
const faqs = [
  { q: 'What does a project cost?', a: 'Most projects the field names, like a rural school or a Learning Center building, come in around $20,000, and travelers cover their own travel. The US team talks through the project and the fundraising with you before you commit to anything.' },
  { q: 'Can we visit without a project?', a: 'Every Favor trip is built around a project, so there is a reason to be there and something to dedicate when you arrive. If travel is not in season for you, specific-project giving carries the same work from home.' },
  { q: 'Do you host student mission teams?', a: 'Our trips are built around funded projects rather than team experiences, so we do not host traditional student mission trips. A student group that wants to take on a project is welcome to start that conversation.' },
  { q: 'How long does this take?', a: 'As long as the project takes. Fundraising moves at your pace, the build runs on the field’s schedule, and travel is planned around the opening.' },
  { q: 'Who plans the travel?', a: 'Adaliah and Terry plan partner project trips in full: timing, lodging, documents, and the days on the ground. The US team only plans travel that is for staff.' },
  { q: 'How do I start?', a: 'Use the contact form. Tell us who you are, who would travel with you, and the kind of project you could take on.' },
];
---
<RedesignLayout
  title="Vision Trips"
  description="Favor's field travel is project-based. Fund a concrete project, around $20,000 for a rural school or a Village Learning Center building, and come see it through with the leaders who run the work."
  image="/images/field/hero-jesusfilm-chad.webp"
>
  <PageHero
    label="Project trips"
    title="Come build something that lasts."
    promise="Favor partners take on one project with the field, a rural school or a Village Learning Center, fund it with the people around them, and travel to dedicate it with the leaders who run it."
    image="/videos/vision-trips-hero-poster.jpg"
    imageAlt="A village congregation gathered for worship, from the film They Once Met Under Trees"
    video="/videos/vision-trips-hero.mp4"
    ctaLabel="Start a project inquiry"
    ctaHref="/about/contact/?topic=vision-trip"
    scrollCue
  />

  <RdFeature
    image="/images/story-vision-trip-team.jpg"
    imageAlt="A vision-trip team with villagers in the field"
    eyebrow="How going works"
    heading="One project, carried together."
    side="right"
  >
    <p>
      A trip with Favor begins with a project the field has asked for. You take it on with
      your church, your family, or your own giving, and when it is built you travel with a
      small team to dedicate it with the leaders and the village it serves.
    </p>
    <p>
      The school keeps teaching after you fly home. The work your project joins runs every
      day across Uganda, South Sudan, and Chad. See
      <a class="story-link" href="/about/where-we-work/">where we work</a> for what it looks
      like in each nation.
    </p>
  </RdFeature>

  <section class="band band--cream">
    <div class="container container--narrow">
      <LeafHeading
        label="Why projects"
        title="The best trips end in a dedication."
        leaves={false}
      />
      <div class="why rd-prose">
        <p>
          Favor&rsquo;s missionaries are Ugandan, South Sudanese, and Chadian, and the
          ministry on the ground is theirs year-round. So when partners travel, we build the
          trip around something the field has asked for: a project you helped fund, opened
          together with the village it serves.
        </p>
        <p>
          You arrive as a partner the field already knows. There is work to celebrate the
          day you land, and what you came to see keeps serving long after you leave.
        </p>
      </div>
    </div>
  </section>

  <section class="band band--white">
    <div class="container">
      <LeafHeading
        label="The projects"
        title="Projects you can carry."
        intro="The field team names its current needs, and most projects like these come in around $20,000. The first step is a conversation."
        leaves={false}
      />
      <div class="projects">
        {projects.map((p, i) => (
          <div class="projects__row reveal" data-side={i % 2 === 0 ? 'left' : 'right'}>
            <figure class="projects__media">
              <img src={p.image} alt={p.alt} loading="lazy" width="1200" height="800" />
            </figure>
            <div class="projects__copy rd-prose">
              <h3>{p.name}</h3>
              <p>{p.body}</p>
            </div>
          </div>
        ))}
      </div>
      <p class="projects__note">
        Want to fund a project without traveling? Start with
        <a class="story-link" href="/give/specific-project/">specific-project giving</a>.
      </p>
    </div>
  </section>

  <section class="band band--cream">
    <div class="container">
      <LeafHeading label="How it works" title="From first conversation to opening day." leaves={false} />
      <ol class="steps">
        {steps.map((s) => (
          <li class="rd-card steps__item reveal">
            <span class="steps__n" aria-hidden="true">{s.n}</span>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="band band--white">
    <div class="container">
      <LeafHeading label="Who goes" title="Who project trips are for." leaves={false} />
      <div class="who">
        {audiences.map((a) => (
          <div class="who__col reveal">
            <span class="who__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={WHO_ICONS[a.icon]}></svg>
            </span>
            <h3>{a.title}</h3>
            <p>{a.body}</p>
          </div>
        ))}
      </div>

    </div>
  </section>

  <section class="band band--cream">
    <div class="container">
      <LeafHeading label="From the field" title="The work your project joins." />
      <div class="vrows">
        {films.map((f, i) => (
          <VideoFeature id={f.id} videoTitle={f.title} eyebrow={f.eyebrow} heading={f.heading} side={i % 2 === 0 ? 'left' : 'right'} decor="leaf">
            <p>{f.body}</p>
          </VideoFeature>
        ))}
      </div>
    </div>
  </section>

  <section class="band band--white">
    <div class="container container--narrow">
      <LeafHeading label="Questions" title="Common questions." leaves={false} />
      <div class="faq">
        {faqs.map((f) => (
          <details class="faq__item rd-outline">
            <summary>{f.q}</summary>
            <p>{f.a} {f.q === 'How do I start?' && <a class="story-link" href="/about/contact/?topic=vision-trip">Start here</a>}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <RdCta
    heading="Take on a project."
    body="Tell us about you and the people who would build it with you. The US team will bring you the field's current needs and help you plan from first gift to dedication."
    ctaLabel="Start the conversation"
    ctaHref="/about/contact/?topic=vision-trip"
    background="cream"
    image="/images/field-2026/gift-4.webp"
    imageAlt="A Favor gathering in the field"
  />
</RedesignLayout>

<style>
  /* Why project-based: narrow prose band. */
  .why { margin-top: clamp(28px, 3.5vw, 44px); }
  .why p { color: var(--color-ink-soft); line-height: 1.75; }

  /* Example projects: alternating photo + text rows. */
  .projects { display: flex; flex-direction: column; gap: clamp(48px, 6vw, 88px); margin-top: clamp(40px, 5vw, 64px); }
  .projects__row { display: grid; grid-template-columns: 1.15fr 1fr; gap: clamp(36px, 5vw, 84px); align-items: center; }
  .projects__row[data-side='right'] .projects__media { order: 2; }
  .projects__row[data-side='right'] .projects__copy { order: 1; }
  .projects__media { margin: 0; }
  .projects__media img {
    display: block; width: 100%; height: auto; aspect-ratio: 3 / 2; object-fit: cover;
    border-radius: var(--rd-radius); box-shadow: var(--rd-shadow);
  }
  .projects__copy h3 { color: var(--color-green); margin: 0 0 var(--space-3); }
  .projects__copy p { color: var(--color-ink-soft); }
  .projects__note { text-align: center; color: var(--color-ink-soft); margin: clamp(40px, 5vw, 64px) 0 0; }
  @media (max-width: 860px) {
    .projects__row { grid-template-columns: 1fr; gap: var(--space-6); }
    .projects__row[data-side='right'] .projects__media { order: 0; }
    .projects__row[data-side='right'] .projects__copy { order: 0; }
  }

  /* Video rows share the WWW spacing. */
  .vrows { display: flex; flex-direction: column; gap: clamp(56px, 7vw, 100px); margin-top: clamp(40px, 5vw, 64px); }

  /* Who it's for: open columns with gold icon medallions and hairline
     separators. Deliberately NOT boxed cards, so it reads nothing like the
     numbered "How it works" cards above. */
  .who { display: grid; grid-template-columns: repeat(3, 1fr); margin-top: clamp(36px, 4.4vw, 58px); }
  .who__col { padding: var(--space-2) clamp(24px, 3vw, 48px); text-align: center; }
  .who__col + .who__col { border-left: 1px solid rgba(31, 58, 26, 0.14); }
  .who__icon {
    display: inline-flex; align-items: center; justify-content: center;
    width: 64px; height: 64px; border-radius: 50%;
    background: color-mix(in srgb, var(--color-gold) 16%, var(--color-white));
    color: var(--color-gold-deep);
    margin-bottom: var(--space-5);
  }
  .who__icon svg { width: 30px; height: 30px; }
  .who__col h3 { color: var(--color-green); margin: 0 0 var(--space-3); }
  .who__col p { margin: 0 auto; color: var(--color-ink-soft); line-height: 1.7; max-width: 34ch; }
  @media (max-width: 860px) {
    .who { grid-template-columns: 1fr; gap: var(--space-8); }
    .who__col { padding: 0; }
    .who__col + .who__col { border-left: 0; border-top: 1px solid rgba(31, 58, 26, 0.14); padding-top: var(--space-8); }
  }

  /* Steps. */
  .steps { list-style: none; padding: 0; margin: clamp(36px, 4.4vw, 58px) 0 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(20px, 2.4vw, 32px); }
  @media (max-width: 860px) { .steps { grid-template-columns: 1fr; } }
  .steps__n {
    display: inline-flex; align-items: center; justify-content: center;
    width: 44px; height: 44px; border-radius: 50%;
    background: var(--rd-bg-green); color: var(--color-green);
    font-weight: 800; font-size: 1.15rem; margin-bottom: var(--space-4);
  }
  .steps__item h3 { color: var(--color-green); margin: 0 0 var(--space-3); }
  .steps__item p { margin: 0; color: var(--color-ink-soft); line-height: 1.7; }

  /* FAQ: native accordion, outlined rows. */
  .faq { display: flex; flex-direction: column; gap: var(--space-3); margin-top: clamp(36px, 4.4vw, 58px); }
  .faq__item { padding: 0; overflow: hidden; }
  .faq__item summary {
    cursor: pointer; list-style: none; position: relative;
    padding: var(--space-5) var(--space-12) var(--space-5) var(--space-6);
    font-weight: 700; color: var(--color-ink);
  }
  .faq__item summary::-webkit-details-marker { display: none; }
  .faq__item summary::after {
    content: '+'; position: absolute; right: var(--space-6); top: 50%; transform: translateY(-50%);
    color: var(--color-green); font-weight: 700; font-size: 1.3rem; line-height: 1;
    transition: transform 160ms ease;
  }
  .faq__item[open] summary::after { transform: translateY(-50%) rotate(45deg); }
  .faq__item summary:hover { color: var(--color-green); }
  .faq__item p { margin: 0; padding: 0 var(--space-6) var(--space-5); color: var(--color-ink-soft); line-height: 1.7; }
</style>
