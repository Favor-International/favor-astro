---
import RedesignLayout from '../../layouts/RedesignLayout.astro';
import PageHero from '../../components/band/PageHero.astro';
import RdFeature from '../../components/redesign/RdFeature.astro';
import LeafHeading from '../../components/redesign/LeafHeading.astro';
import RdCta from '../../components/redesign/RdCta.astro';
import { SITE } from '../../lib/site';

// "Serve from Home" is now exactly that (per Daniel, 2026-07-08): remote and
// US-side serving only. The Country Director posting moved to /go/careers/;
// the short-term mission trips section moved to /go/vision-trips/. The core
// copy here stays verbatim from Favor's material.
//
// The skill areas below are the ones Favor's own text names ("From media, to
// accounting, to mailing and other administrative assistance") plus prayer,
// which is the ministry's stated foundation.
const skills = [
  { icon: 'pray', title: 'Prayer & intercession', body: 'Stand with the field in prayer, from wherever you are.', looks: ['Pray through the Nations Prayer Guide', 'Lift up the requests the field teams send back', 'Pray over the stories and praise reports as they come in'] },
  { icon: 'media', title: 'Media & creative', body: 'Help with the media work that keeps partners connected to the field.', looks: ['Video clips and social content from field footage', 'Newsletter and design help', 'Organizing photos from the field library'] },
  { icon: 'admin', title: 'Accounting & administrative', body: 'The office work that keeps the US operation running.', looks: ['Bookkeeping help alongside the operations team', 'Data entry and record keeping', 'General administrative support'] },
  { icon: 'mail', title: 'Mailing & partner care', body: 'The behind-the-scenes care that ensures all our partners are honored.', looks: ['Mailings that go out to partners', 'Notes and receipts that honor every gift', 'Care for the people who carry the work'] },
];
const SKILL_ICONS: Record<string, string> = {
  pray: '<path d="M12 3v3M8 5l1.5 2M16 5l-1.5 2"/><path d="M12 21c-3.5-1.6-5.5-4.2-5.5-7.5V9l5.5 2.5L17.5 9v4.5c0 3.3-2 5.9-5.5 7.5Z"/>',
  media: '<rect x="3" y="6" width="13" height="12" rx="2"/><path d="M16 10.5 21 7v10l-5-3.5"/>',
  admin: '<rect x="4" y="4" width="16" height="16" rx="2"/><path d="M8 9h8M8 13h8M8 17h5"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>',
};

const steps = [
  { n: '1', title: 'Inquire', body: 'Share who you are, your skills, and your availability through the contact form.' },
  { n: '2', title: 'Match', body: 'The US team pairs you with work that actually needs doing.' },
  { n: '3', title: 'Serve', body: 'Work from anywhere, on your schedule. You are welcome to visit Favor’s office too.' },
];
---
<RedesignLayout
  title="Serve from Home"
  description="Volunteer with Favor International from anywhere in the US: prayer, media, accounting, mailing, and administrative help. Internships too."
>
  <PageHero
    label="Volunteer"
    title="Serve from home."
    promise="Volunteer roles and internships with the US team. You don't have to fly to be useful."
    image="/images/hero-volunteer-action.jpg"
    imageAlt="Volunteer team gathering"
    ctaLabel="Sign up"
    ctaHref="/about/contact/?topic=volunteer"
    scrollCue
  />

  <RdFeature
    image="/images/field-2026/street-outreach-4.webp"
    imageAlt="A Favor training session"
    eyebrow="Volunteer and intern with the US team"
    heading="Keep the vision running."
    side="right"
    background="cream"
  >
    <p>If you have a heart for giving your time and talent to God, as expressed through this ministry, you have an opportunity with Favor International to go on a short-term 2-week mission trip or a months long internship that will change your life.</p>
    <p>Favor&rsquo;s US team is greatly supported by volunteer team members to keep operations going. From media, to accounting, to mailing and other administrative assistance, there are people who keep the vision running and ensure all our partners are honored. Volunteers can work from anywhere but are welcome to visit Favor&rsquo;s office.</p>
    <p>You must be a self-starter and finisher, yet able to work under authority and initiating to get the idea done. Constant communication is key. Are you one of these people?</p>
  </RdFeature>

  <section class="band band--white">
    <div class="container">
      <LeafHeading label="Where you fit" title="Pick your skillset." intro="Every role below supports the field from the US side." leaves={false} />
      <div class="skills">
        {skills.map((s) => (
          <div class="skills__col reveal">
            <span class="skills__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={SKILL_ICONS[s.icon]}></svg>
            </span>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
            <p class="skills__looks-label">What it can look like</p>
            <ul class="skills__looks">
              {s.looks.map((l) => <li>{l}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="band band--greenlight">
    <div class="container container--narrow">
      <p class="vol-statement">
        You keep the vision running and ensure all our partners are honored.
      </p>
      <p class="vol-statement__note">Serving from home keeps the US side strong so the field can stay focused on the field.</p>
    </div>
  </section>

  <div id="internships" class="vol-anchor" aria-hidden="true"></div>
  <RdFeature
    image="/images/field-2026/street-outreach-5.webp"
    imageAlt="A Favor team serving together in the field"
    eyebrow="Internships"
    heading="Months that change your life."
    side="left"
  >
    <p>
      A months-long internship that will change your life. Interns serve alongside the US
      team on the real operations that carry the field: media, administration, partner care,
      and more.
    </p>
    <p>
      Tell us who you are and the months you have. The US team will shape the internship
      with you.
    </p>
    <p class="band__cta-row"><a class="btn btn--secondary" href="/go/internships/">See internships &rarr;</a></p>
  </RdFeature>

  <section class="band band--cream">
    <div class="container">
      <LeafHeading label="Where you'll work" title="Anywhere. Or with us." leaves={false} />
      <div class="vol-where">
        <div class="vol-where__col reveal">
          <h3>Work from anywhere</h3>
          <p>Volunteers can work from anywhere. You serve on your own schedule, with the US team a message away.</p>
        </div>
        <div class="vol-where__col reveal">
          <h3>Or visit the office</h3>
          <p>You are welcome to visit Favor&rsquo;s office: {SITE.mailing}. Reach us at {SITE.phone}, {SITE.hours}.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="band band--white">
    <div class="container">
      <LeafHeading label="How it works" title="Three steps, on your schedule." leaves={false} />
      <ol class="steps">
        {steps.map((s) => (
          <li class="rd-card steps__item reveal">
            <span class="steps__n" aria-hidden="true">{s.n}</span>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <RdCta
    heading="Sign up for a role."
    body="One short form tells us your time, your skills, and your context."
    ctaLabel="Sign up"
    ctaHref="/about/contact/?topic=volunteer"
    background="cream"
    image="/images/field-2026/street-outreach-7.webp"
    imageAlt="A Favor street outreach team"
  />
</RedesignLayout>

<style>
  /* Skillsets: open columns with icon medallions (matches the who-for
     treatment on Vision Trips - no box grid). */
  .skills { display: grid; grid-template-columns: repeat(4, 1fr); margin-top: clamp(36px, 4.4vw, 58px); }
  .skills__col { padding: var(--space-2) clamp(18px, 2.2vw, 36px); text-align: center; }
  .skills__col + .skills__col { border-left: 1px solid rgba(31, 58, 26, 0.14); }
  .skills__icon {
    display: inline-flex; align-items: center; justify-content: center;
    width: 60px; height: 60px; border-radius: 50%;
    background: color-mix(in srgb, var(--color-gold) 16%, var(--color-white));
    color: var(--color-gold-deep);
    margin-bottom: var(--space-5);
  }
  .skills__icon svg { width: 28px; height: 28px; }
  .skills__col h3 { color: var(--color-green); margin: 0 0 var(--space-3); font-size: var(--rd-fs-sub); }
  .skills__col p { margin: 0 auto; color: var(--color-ink-soft); line-height: 1.7; font-size: var(--rd-fs-body); max-width: 30ch; }
  .skills__looks-label {
    margin: var(--space-5) auto var(--space-2) !important;
    font-size: var(--rd-fs-small); font-weight: 800; letter-spacing: 0.1em;
    text-transform: uppercase; color: var(--color-gold-deep) !important;
  }
  .skills__looks { list-style: none; padding: 0; margin: 0 auto; max-width: 30ch; text-align: left; display: flex; flex-direction: column; gap: var(--space-2); }
  .skills__looks li { position: relative; padding-left: var(--space-5); color: var(--color-ink-soft); font-size: var(--rd-fs-small); line-height: 1.55; }
  .skills__looks li::before { content: '·'; position: absolute; left: var(--space-2); color: var(--color-gold-deep); font-weight: 800; }

  /* Anchor target for /go/volunteer/#internships (RdFeature owns its own
     section tag, so the id lives on a zero-height marker above it). */
  .vol-anchor { position: relative; top: -80px; height: 0; }

  /* Work from anywhere / visit the office. */
  .vol-where { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(24px, 3vw, 48px); margin-top: clamp(36px, 4.4vw, 58px); max-width: 900px; margin-inline: auto; }
  @media (max-width: 700px) { .vol-where { grid-template-columns: 1fr; } }
  .vol-where__col { border-top: 2px solid color-mix(in srgb, var(--color-gold) 55%, transparent); padding-top: var(--space-5); }
  .vol-where__col h3 { color: var(--color-green); margin: 0 0 var(--space-3); }
  .vol-where__col p { margin: 0; color: var(--color-ink-soft); line-height: 1.75; }
  @media (max-width: 1024px) {
    .skills { grid-template-columns: repeat(2, 1fr); row-gap: var(--space-8); }
    .skills__col:nth-child(3) { border-left: 0; }
  }
  @media (max-width: 560px) {
    .skills { grid-template-columns: 1fr; row-gap: var(--space-6); }
    .skills__col + .skills__col { border-left: 0; border-top: 1px solid rgba(31, 58, 26, 0.14); padding-top: var(--space-6); }
  }

  /* The why-it-matters statement: Favor's own line, large. */
  .vol-statement {
    margin: 0 auto var(--space-5); max-width: 22em; text-align: center;
    font-family: var(--font-display); font-size: var(--rd-fs-title);
    font-weight: 600; line-height: 1.35; color: var(--color-green-deep); text-wrap: balance;
  }
  .vol-statement__note { margin: 0 auto; max-width: 52ch; text-align: center; color: var(--color-ink-soft); line-height: 1.7; }

  /* Steps (same idiom as Vision Trips). */
  .steps { list-style: none; padding: 0; margin: clamp(36px, 4.4vw, 58px) 0 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(20px, 2.4vw, 32px); }
  @media (max-width: 860px) { .steps { grid-template-columns: 1fr; } }
  .steps__n {
    display: inline-flex; align-items: center; justify-content: center;
    width: 44px; height: 44px; border-radius: 50%;
    background: var(--rd-bg-green); color: var(--color-green);
    font-weight: 800; font-size: 1.15rem; margin-bottom: var(--space-4);
  }
  .steps__item h3 { color: var(--color-green); margin: 0 0 var(--space-3); }
  .steps__item p { margin: 0; color: var(--color-ink-soft); line-height: 1.7; }
</style>
