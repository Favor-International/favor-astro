---
import RedesignLayout from '../../layouts/RedesignLayout.astro';
import PageHero from '../../components/band/PageHero.astro';
import LeafHeading from '../../components/redesign/LeafHeading.astro';
import ScriptBand from '../../components/redesign/ScriptBand.astro';
import RdCta from '../../components/redesign/RdCta.astro';

// Hiring, honestly: no invented timelines or HR machinery. Both steps route
// to the same application conversation the posting names.
const hiring = [
  { n: '1', title: 'Request the application', body: 'Write Terry-Lynne Goodman and tell her you are asking about the Africa Missionary posting.' },
  { n: '2', title: 'A real conversation', body: 'The team talks through your calling, your experience, and the mission and Statement of Faith of Favor International.' },
  { n: '3', title: 'Decide together', body: 'If it is a fit on both sides, you will know what comes next before you commit.' },
];

// Careers page: full-time field positions. Country Director posting removed
// 2026-08-18 at Carole's request (staff read it as Terry leaving). Replaced
// with Africa Missionary JD from "Africa Missionary Job Description.docx"
// (last updated 5/30/2026), posted verbatim.
const responsibilities = [
  { group: 'Leadership', items: [
    'Participate with the Country Director and the Board of Directors in learning and growing the vision and strategic plan to guide the organization within the country',
    'Identify, assess, and inform the Country Director of internal and external issues that affect the organization',
    'Foster effective teamwork with the staff and Country Director',
    'Act as a spokesperson for the organization and its programs',
  ] },
  { group: 'Operations', items: [
    'Learn and help with the operation of the organization so that it continues to meet the expectations of the vision, Board, and Partners',
    "Help with the efficient and effective day-to-day operation of the organization's operations in Country",
    'Be part of maintaining policies for the approval of the Country Director and prepare procedures to implement the organizational policies; review existing policies on an annual basis and recommend changes to the Country Director as appropriate',
    'Provide support to the Country Director as needed',
  ] },
  { group: 'Programs', items: [
    "Be part of the planning, implementation, and evaluation of the organization's programs",
    'Participate in the day-to-day delivery of the programs of the organization to maintain or improve quality',
    'Be part of the planning, implementation, execution, and evaluation of special projects',
  ] },
  { group: 'Finances', items: [
    'Learn all financial aspects of the organization, including the development of, and adherence to, the annual budget',
  ] },
  { group: 'Development and Fundraising', items: [
    'Be part of fundraising ideas and networking, and help with the development of fundraising plans, and learn to write funding proposals to increase the revenue of the organization',
    'Establish good working relationships and collaborative arrangements with funders, donors, potential donors, and other organizations to help achieve the goals of the organization',
  ] },
  { group: 'Communications and Marketing', items: [
    'Be familiar with all aspects of communications, from web presence to external relations',
    'Communicate and report to partners to keep them informed of the work of the organization and to identify changes in the community served by the organization',
    'Use external presence and relationships to garner new opportunities',
  ] },
];
const qualifications = [
  'Experience in nonprofit or ministry setting is beneficial',
  'Willing to build relationships with public sector officials (local government officials), private sector partners, funders, NGO partners operating in Country, and other diverse stakeholders to foster broad community support.',
  'Willing to learn projects management across multiple different departments and stakeholders',
  'Experience in being part of an environment of mutual accountability and collaboration, healthy work relationships and partnerships, and inclusivity among organizational staff in order to maintain a positive work environment.',
  'Excellent written and verbal communication skills',
  'Commitment to the values, mission, and Statement of Faith of Favor International',
];
const applyHref = 'mailto:Terry@favorintl.org?subject=Africa%20Missionary%20application';
const REC_ONLY_OPEN = '<!--recruit-only-->';
const REC_ONLY_CLOSE = '<!--/recruit-only-->';
const REC_CLOSED_OPEN = '<!--recruit-closed-->';
const REC_CLOSED_CLOSE = '<!--/recruit-closed-->';
---
<RedesignLayout
  title="Careers"
  description="Full-time positions with Favor International."
>
  <Fragment set:html={REC_ONLY_OPEN} />
  <PageHero
    label="Careers"
    title="Work with Favor."
    promise="Full-time positions with the ministry, on the field and alongside it."
    image="/images/field-2026/pbs-6.webp"
    imageAlt="A line of commissioned Favor leaders holding Bibles outside their village"
    ctaLabel="Request an application"
    ctaHref={applyHref}
    scrollCue
  />
  <Fragment set:html={REC_ONLY_CLOSE} />
  <Fragment set:html={REC_CLOSED_OPEN} />
  <PageHero
    label="Careers"
    title="Work with Favor."
    promise="Full-time positions are listed when a posting is open for your location."
    image="/images/field-2026/pbs-6.webp"
    imageAlt="A line of commissioned Favor leaders holding Bibles outside their village"
    ctaLabel="See internships"
    ctaHref="/go/internships/"
    secondaryLabel="Volunteer from home"
    secondaryHref="/go/volunteer/"
    scrollCue
  />
  <Fragment set:html={REC_CLOSED_CLOSE} />

  <Fragment set:html={REC_ONLY_OPEN} />
  <section class="band band--white">
    <div class="container container--narrow">
      <LeafHeading
        label="Open position"
        title="Africa Missionary"
        intro="Full-time, living in country (Uganda, South Sudan, or Chad). The Missionary will learn and grow into a position of strategic and operational responsibility for Favor's staff, programs, and execution of its mission in the country where he/she is posted."
      />
      <img class="cd-lead" src="/images/field-2026/evangelism-7.webp" alt="A Favor leader addressing a gathered village community" width="1600" height="900" loading="lazy" />
      <dl class="cd-meta">
        <div><dt>Status</dt><dd>Full-time</dd></div>
        <div><dt>Compensation</dt><dd>Fundraising requirement / based on needs and budget</dd></div>
        <div><dt>Location</dt><dd>Africa (Uganda, South Sudan, or Chad)</dd></div>
      </dl>

      <div class="cd-acc">
        <details class="cd-acc__item rd-outline" open>
          <summary>Overview</summary>
          <div class="cd-acc__body">
            <p>The Missionary will learn and grow into a position of strategic and operational responsibility for Favor&rsquo;s staff, programs, and execution of its mission in the country where he/she is posted. The Missionary, in time, could be responsible to help oversee the administration, programs, and implementation of the mission and vision of the organization. Other key duties include developing strategic partnerships, fundraising, marketing, and communications.</p>
          </div>
        </details>
        <details class="cd-acc__item rd-outline">
          <summary>Accountability &amp; relationships</summary>
          <div class="cd-acc__body">
            <p>The Missionary is a full-time position, living full-time in the country he/she is assigned to and reports directly to the Country Director and the Board of Directors of Favor International.</p>
            <p>The Missionary serves with the Country Director/Founder and the Board of Directors to develop and maintain relationships characterized by vision, trust, transparency, education, dignity, cooperation, and openness. These relationships extend to the partners, stakeholders, clients, students, employees, and contractors of Favor International both in country and abroad.</p>
          </div>
        </details>
        <details class="cd-acc__item rd-outline">
          <summary>Location</summary>
          <div class="cd-acc__body">
            <p>The Uganda Missionary position is based in Gulu, Uganda. The South Sudan Missionary position is based in Juba, South Sudan. The Chad Missionary position is based in Ndjamena, Chad.</p>
            <p>There may be in-country travel required plus potential opportunities for international travel.</p>
          </div>
        </details>
        {responsibilities.map((r) => (
          <details class="cd-acc__item rd-outline">
            <summary>Responsibilities: {r.group}</summary>
            <div class="cd-acc__body">
              <ul>{r.items.map((i) => <li>{i}</li>)}</ul>
            </div>
          </details>
        ))}
        <details class="cd-acc__item rd-outline">
          <summary>Qualifications</summary>
          <div class="cd-acc__body">
            <p>The candidate must have a passion for the mission and vision of Favor International, integrity, a strong sense of accountability, and a long-term perspective. The ideal candidate has a track record of exercising good judgment, and has a practical ability to get things done. He/she brings a fair and thoughtful approach to the management team, combined with the flexibility and courage to shift direction and experiment with new initiatives.</p>
            <p>Strong prayer and study in the Word ethic. Willingness to serve in multifaceted roles. Essential qualifications also include:</p>
            <ul>{qualifications.map((q) => <li>{q}</li>)}</ul>
          </div>
        </details>
        <details class="cd-acc__item rd-outline">
          <summary>Compensation</summary>
          <div class="cd-acc__body">
            <p>Compensation will be fairly based on experience and determined in coordination with fundraising and personal needs budget of the country of appointment.</p>
          </div>
        </details>
        <details class="cd-acc__item rd-outline">
          <summary>How to apply</summary>
          <div class="cd-acc__body">
            <p>Write Terry-Lynne Goodman, Country Director for Uganda and South Sudan.</p>
            <p>
              US / WhatsApp: <a href="tel:+18137084944">+1 (813) 708-4944</a><br />
              Uganda: <a href="tel:+258782646065">+258 782 646 065</a><br />
              Email: <a href={applyHref}>Terry@favorintl.org</a>
            </p>
          </div>
        </details>
      </div>

      <p class="band__cta-row"><a class="btn btn--primary" href={applyHref}>Request an application</a></p>
    </div>
  </section>
  <Fragment set:html={REC_ONLY_CLOSE} />

  <Fragment set:html={REC_CLOSED_OPEN} />
  <section class="band band--white">
    <div class="container container--narrow">
      <LeafHeading
        label="Open positions"
        title="No posting is listed for your location."
        intro="Internships and volunteer roles stay open. Email us if you have another question."
      />
      <p class="band__cta-row"><a class="btn btn--primary" href="/about/contact/">Email Favor</a></p>
    </div>
  </section>
  <Fragment set:html={REC_CLOSED_CLOSE} />

  <ScriptBand
    image="/images/field-2026/prayer-1.webp"
    imageAlt="Favor leaders kneeling in fervent prayer"
    label="Who Favor hires for"
    phrase="Unlike the world, He doesn't call the qualified, but qualifies the called."
    cite="Carole Ward, Lord Send Us Where No One Wants to Go"
    font="serif"
    tall
  />

  <Fragment set:html={REC_ONLY_OPEN} />
  <section class="band band--white">
    <div class="container">
      <LeafHeading label="How hiring works" title="Three steps, both directions." leaves={false} />
      <ol class="steps">
        {hiring.map((s) => (
          <li class="rd-card steps__item reveal">
            <span class="steps__n" aria-hidden="true">{s.n}</span>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>
  <Fragment set:html={REC_ONLY_CLOSE} />

  <section class="band band--greenlight">
    <div class="container">
      <LeafHeading label="Not full-time?" title="Two doors right next to this one." leaves={false} />
      <div class="also">
        <a class="also__card rd-card reveal" href="/go/internships/">
          <p class="label">A season</p>
          <h3>Internships</h3>
          <p>Months alongside the US team, on the real operations that carry the field.</p>
          <span class="also__link">See internships &rarr;</span>
        </a>
        <a class="also__card rd-card reveal" href="/go/volunteer/">
          <p class="label">Ongoing, from home</p>
          <h3>Volunteer</h3>
          <p>Serve the US team from anywhere, on your own schedule: prayer, media, accounting, mailing, and partner care.</p>
          <span class="also__link">Serve from home &rarr;</span>
        </a>
      </div>
    </div>
  </section>

  <Fragment set:html={REC_ONLY_OPEN} />
  <RdCta
    heading="Request an application."
    body="Write Terry-Lynne Goodman and tell her you are asking about the Africa Missionary posting."
    ctaLabel="Email Terry"
    ctaHref={applyHref}
    background="greenlight"
    image="/images/field-2026/pbs-6.webp"
    imageAlt="A line of commissioned Favor leaders holding Bibles"
  />
  <Fragment set:html={REC_ONLY_CLOSE} />
</RedesignLayout>

<style>
  .cd-lead { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; border-radius: var(--rd-radius); margin: clamp(32px, 4vw, 48px) 0 0; box-shadow: var(--rd-shadow); }
  .cd-meta { display: flex; flex-wrap: wrap; gap: var(--space-4); margin: var(--space-8) 0 clamp(40px, 5vw, 64px); padding: 0; }
  .cd-meta div { flex: 1 1 200px; background: var(--color-cream); border: 1px solid rgba(31, 58, 26, 0.12); border-radius: var(--radius-card); padding: var(--space-4) var(--space-5); }
  .cd-meta dt { font-size: 0.72rem; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-gold-deep); }
  .cd-meta dd { margin: var(--space-2) 0 0; font-weight: 600; color: var(--color-green); }

  .cd-acc { display: flex; flex-direction: column; gap: var(--space-3); }
  .cd-acc__item { padding: 0; overflow: hidden; }
  .cd-acc__item summary {
    cursor: pointer; list-style: none; position: relative;
    padding: var(--space-5) var(--space-12) var(--space-5) var(--space-6);
    font-weight: 700; color: var(--color-ink);
  }
  .cd-acc__item summary::-webkit-details-marker { display: none; }
  .cd-acc__item summary::after {
    content: '+'; position: absolute; right: var(--space-6); top: 50%; transform: translateY(-50%);
    color: var(--color-green); font-weight: 700; font-size: 1.3rem; line-height: 1;
    transition: transform 160ms ease;
  }
  .cd-acc__item[open] summary::after { transform: translateY(-50%) rotate(45deg); }
  .cd-acc__item summary:hover { color: var(--color-green); }
  .cd-acc__body { padding: 0 var(--space-6) var(--space-5); }
  .cd-acc__body p { margin: 0 0 var(--space-4); color: var(--color-ink-soft); line-height: 1.75; }
  .cd-acc__body p:last-child { margin-bottom: 0; }
  .cd-acc__body ul { margin: 0; padding-left: var(--space-6); color: var(--color-ink-soft); line-height: 1.7; }
  .cd-acc__body ul li { margin-bottom: var(--space-2); }
  .cd-acc__body a { color: var(--color-green); font-weight: 700; }

  .steps { list-style: none; padding: 0; margin: clamp(36px, 4.4vw, 58px) 0 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(20px, 2.4vw, 32px); }
  @media (max-width: 860px) { .steps { grid-template-columns: 1fr; } }
  .steps__n {
    display: inline-flex; align-items: center; justify-content: center;
    width: 44px; height: 44px; border-radius: 50%;
    background: var(--rd-bg-green); color: var(--color-green);
    font-weight: 800; font-size: 1.15rem; margin-bottom: var(--space-4);
  }
  .steps__item h3 { color: var(--color-green); margin: 0 0 var(--space-3); }
  .steps__item p { margin: 0; color: var(--color-ink-soft); line-height: 1.7; }

  .also { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(20px, 2.4vw, 32px); margin-top: clamp(36px, 4.4vw, 58px); max-width: 900px; margin-inline: auto; }
  @media (max-width: 700px) { .also { grid-template-columns: 1fr; } }
  .also__card { display: flex; flex-direction: column; text-decoration: none; color: inherit; }
  .also__card .label { margin-bottom: var(--space-2); }
  .also__card h3 { color: var(--color-green); margin: 0 0 var(--space-3); }
  .also__card p:not(.label) { margin: 0 0 var(--space-4); color: var(--color-ink-soft); line-height: 1.7; }
  .also__link { margin-top: auto; color: var(--color-green); font-weight: 700; border-bottom: 2px solid var(--color-gold); padding-bottom: 2px; width: fit-content; }
  .also__card:hover .also__link { color: var(--color-gold-deep); }
</style>
