---
import RedesignLayout from '../../layouts/RedesignLayout.astro';
import PageHero from '../../components/band/PageHero.astro';
import LeafHeading from '../../components/redesign/LeafHeading.astro';
import RdCta from '../../components/redesign/RdCta.astro';
import { SITE } from '../../lib/site';

const links = [
  { href: '/about/mission-vision/', label: 'Mission and Vision', desc: 'What we believe Favor is for, and why we still exist.', image: '/images/hero-new-believers.jpg' },
  { href: '/about/our-story/', label: 'Our Story', desc: 'How Favor started and where the founding conviction came from.', image: '/images/about-original-house.jpg' },
  { href: '/about/where-we-work/', label: 'Where We Work', desc: 'The nations we serve, and how we got to each one.', image: '/images/hero-about-overview.jpg' },
  { href: '/about/team/', label: 'Team', desc: 'US staff and key field leaders.', image: '/images/about-leadership-training.jpg' },
  { href: '/about/board/', label: 'Board of Directors', desc: 'Volunteer governance, term-limited.', image: '/images/field-2026/pbs-1.webp' },
  { href: '/about/statement-of-faith/', label: 'Statement of Faith', desc: 'Doctrinal core. Where we stand.', image: '/images/field-2026/bibles-1.webp' },
  { href: '/about/accountability/', label: 'Accountability + Financials', desc: 'ECFA, 990s, audits, and the public profiles.', image: '/images/hero-foundation-cohort.jpg' },
  { href: '/about/contact/', label: 'Contact', desc: 'Email, phone, and mailing address for the US team.', image: '/images/field-2026/radio-1.webp' },
];
---
<RedesignLayout
  title="About Favor International"
  description="Indigenous-led, prayer-birthed, partner-powered. The story, the team, the board, and the financials behind Favor International."
>
  <PageHero
    label="About"
    title="Indigenous-led. Prayer-birthed. Partner-powered."
    promise="The story, the team, the board, and the financials behind Favor International."
    image="/images/field-2026/church-1.webp"
    imageAlt="An indigenous church congregation gathered outside their church"
  />

  <section class="band band--white">
    <div class="container">
      <LeafHeading label="About sections" title="The full picture." />
      <div class="rd-grid rd-grid--4">
        {links.map((l) => (
          <a class="rd-tile" href={l.href}>
            <div class="rd-tile__img" style={`background-image:url('${l.image}')`} role="img" aria-label={l.label}></div>
            <div class="rd-tile__meta">
              <h3>{l.label}</h3>
              <p>{l.desc}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <RdCta
    heading="Reach out."
    body={`Email ${SITE.emailGeneral} or call ${SITE.phone}, ${SITE.hours}.`}
    ctaLabel="Contact us"
    ctaHref="/about/contact/"
    image="/images/field/country-uganda.webp"
    imageAlt="A vision-trip team with Karamojong villagers in the savanna"
  />
</RedesignLayout>
