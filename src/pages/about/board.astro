---
import RedesignLayout from '../../layouts/RedesignLayout.astro';
import PageHero from '../../components/band/PageHero.astro';
import RdFeature from '../../components/redesign/RdFeature.astro';
import LeafHeading from '../../components/redesign/LeafHeading.astro';
import PersonCard from '../../components/redesign/PersonCard.astro';
import RdCta from '../../components/redesign/RdCta.astro';
import directorsData from '../../data/directors.json';

// Board of Directors: 9 volunteer board members. Source: Webflow CMS Directors collection.
const board = directorsData
  .filter(d => /board/i.test(d.type))
  .sort((a, b) => (a.order || 999) - (b.order || 999));
const personHref = (slug) => slug === 'carole-ward' ? '/about/our-story/founder/' : `/about/people/${slug}/`;

const governance = [
  { title: 'Term limits', body: 'Board members serve renewable three-year terms, with a maximum tenure that keeps fresh perspective and continuity in balance.' },
  { title: 'Volunteer service', body: 'Board service is fully volunteer. No board member receives any compensation for their role.' },
  { title: 'Independence', body: 'A majority of the board is independent of paid staff, and the board reviews the executive team’s compensation every year.' },
  { title: 'Annual audit', body: 'Favor is audited every year by an independent firm. The audited financials are filed with the IRS as Form 990 and reviewed by ECFA.' },
  { title: 'Conflict-of-interest policy', body: 'A written conflict-of-interest policy is signed by every board member each year and reviewed by counsel.' },
];
---
<RedesignLayout
  title="Board of Directors"
  description="The volunteer Board of Directors providing governance and financial oversight for Favor International."
>
  <PageHero
    label="Governance"
    title="Board of Directors."
    promise="Volunteer governance. Term-limited. Independent of paid staff per ECFA best practice."
    image="/images/hero-tot-bishoftu.jpg"
    imageAlt="A Training of Trainers session in Bishoftu, Ethiopia"
  />

  <section class="band band--white">
    <div class="container">
      <LeafHeading
        label="The Board"
        title="The volunteers who govern Favor."
        intro="Favor International's Board of Directors meets quarterly and is responsible for governance, financial oversight, executive review, and strategic direction. Each member serves without compensation. The board is independent of paid staff and operates under the conflict-of-interest and best-practice standards required for ECFA accreditation."
      />
      <div class="rd-grid rd-grid--3">
        {board.map((m) => (
          <PersonCard
            href={personHref(m.slug)}
            image={m.imagePath}
            name={m.fullName}
            role={m.position}
            location={m.location}
            objectPosition="center top"
          />
        ))}
      </div>
    </div>
  </section>

  <section class="band band--greenlight">
    <div class="container">
      <LeafHeading label="Governance" title="How the board works." />
      <div class="gov-grid">
        {governance.map((g) => (
          <article class="rd-card">
            <h3>{g.title}</h3>
            <p>{g.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <RdFeature
    image="/images/hero-prayer-team.jpg"
    imageAlt="Favor leaders gathered in prayer"
    eyebrow="Built to be trusted"
    heading="Oversight that protects every gift."
    side="right"
  >
    <p>Favor International is accredited by the <strong>Evangelical Council for Financial Accountability (ECFA)</strong> and audited every year by an independent firm.</p>
    <p>Our audited financials are filed with the IRS as a public Form 990, rated by Charity Navigator, and listed on Candid. The board reviews them, along with executive compensation, every year.</p>
  </RdFeature>

  <RdCta
    heading="Read the financial accountability page."
    body="ECFA, Charity Navigator, Candid Platinum: the third-party signals that show where the money goes."
    ctaLabel="Financial accountability"
    ctaHref="/about/accountability/"
  />
</RedesignLayout>

<style>
  .gov-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-6);
    max-width: 960px;
    margin-inline: auto;
  }
  @media (max-width: 700px) { .gov-grid { grid-template-columns: 1fr; } }
  .gov-grid article:last-child { grid-column: 1 / -1; }
  .gov-grid h3 { margin: 0 0 var(--space-3); color: var(--color-green); }
  .gov-grid p { margin: 0; color: var(--color-ink-soft); line-height: 1.7; }
</style>
