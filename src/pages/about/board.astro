---
import RedesignLayout from '../../layouts/RedesignLayout.astro';
import PageHero from '../../components/band/PageHero.astro';
import RdFeature from '../../components/redesign/RdFeature.astro';
import LeafHeading from '../../components/redesign/LeafHeading.astro';
import PersonCard from '../../components/redesign/PersonCard.astro';
import RdCta from '../../components/redesign/RdCta.astro';
import Leaf from '../../components/redesign/Leaf.astro';
import directorsData from '../../data/directors.json';

// Board of Directors: the CURRENT board only, verified 2026-07-07 against
// Favor's live directors page (favorintl.org/about/directors) and the FY2024
// Form 990 (EIN 47-5225697), which list the same six people. directors.json
// still holds three FORMER members from the old Webflow export (Lisa Coggin,
// last on the FY2022 990; Rev. Louis Kayatin, removed from the live site fall
// 2024; Dr. Vilma Vega, last on the FY2021 990) - do not render them here.
// Full audit: docs/06-reference/about-fact-audit-2026-07-08.md
const CURRENT_BOARD = ['carole-ward', 'jared-buswell', 'michael-blickensderfer', 'alexander-kramer', 'david-blandford', 'martha-mott'];
const board = CURRENT_BOARD
  .map(slug => directorsData.find(d => d.slug === slug))
  .filter(Boolean);
const personHref = (slug) => slug === 'carole-ward' ? '/about/our-story/founder/' : `/about/people/${slug}/`;

// Every line below is backed by a named source (see the audit doc): the live
// directors page, the FY2024 Form 990 (Part VI/VII, Schedule O), or the
// published audits on favorintl.org/about/ecfa-accountability.
const governance = [
  { title: 'Volunteer service', body: 'Board service is fully volunteer. No board member receives any compensation for their role.' },
  { title: 'Independence', body: 'A majority of the board is independent of paid staff, and independent board members review the Executive Director’s compensation annually.' },
  { title: 'Annual audit', body: 'Favor is audited every year by an independent firm. The audits and the public IRS Form 990s are published on the accountability page.' },
  { title: 'Conflict-of-interest policy', body: 'A written conflict-of-interest policy is in place, and board members are required to disclose potential conflicts annually.' },
];
---
<RedesignLayout
  title="Board of Directors"
  description="The volunteer Board of Directors providing governance and financial oversight for Favor International."
>
  <PageHero
    label="Governance"
    title="Board of Directors."
    promise="The board of directors are volunteers who give time and wisdom to oversee the ministry."
    image="/images/field-2026/missionaries-5.webp"
    imageAlt="Favor field and office leaders together"
  />

  <section class="band band--white">
    <div class="container">
      <LeafHeading
        label="The Board"
        title="The volunteers who govern Favor."
        intro="The board of directors are volunteers who give time and wisdom to oversee the ministry. The majority are independent members and have no potential family/financial ties to the decisions of the board."
      />
      <div class="rd-grid rd-grid--3">
        {board.map((m) => (
          <PersonCard
            href={personHref(m.slug)}
            image={m.imagePath}
            name={m.fullName}
            role={m.position}
            location={m.location}
            objectPosition="center top"
          />
        ))}
      </div>
    </div>
  </section>

  <section class="band band--greenlight gov-band">
    <Leaf class="gov-band__leaf" />
    <svg class="gov-band__bush" viewBox="0 0 110 40" aria-hidden="true">
      <path fill="currentColor" d="M0 40 C2 28 12 19 24 19 C28 8 42 4 52 11 C58 2 74 2 81 11 C93 9 103 18 103 28 C105 35 100 40 94 40 Z" />
    </svg>
    <div class="container gov-band__content">
      <LeafHeading label="Governance" title="How the board works." leaves={false} />
      <div class="gov-grid">
        {governance.map((g) => (
          <article class="rd-card">
            <h3>{g.title}</h3>
            <p>{g.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <RdFeature
    image="/images/hero-prayer-team.jpg"
    imageAlt="Favor leaders gathered in prayer"
    eyebrow="Built to be trusted"
    heading="Oversight that protects every gift."
    side="right"
  >
    <p>Favor International is accredited by the <strong>Evangelical Council for Financial Accountability (ECFA)</strong> and audited every year by an independent firm.</p>
    <p>The annual audits and the public IRS Form 990s are published on our accountability page. Favor holds a 4-star Charity Navigator rating and is listed on Candid. The board oversees the audit, and independent board members review the Executive Director&rsquo;s compensation annually.</p>
  </RdFeature>

  <RdCta
    heading="Read the financial accountability page."
    body="ECFA, Charity Navigator, Candid Platinum: the third-party signals that show where the money goes."
    ctaLabel="Financial accountability"
    ctaHref="/about/accountability/"
    image="/images/hero-prayer-team.jpg"
    imageAlt="Favor leaders gathered in prayer"
  />
</RedesignLayout>

<style>
  /* One big, very transparent leaf living behind the governance section.
     A touch of Africa in the background; never competing for attention. */
  .gov-band { position: relative; isolation: isolate; overflow: hidden; }
  .gov-band :global(.gov-band__leaf) {
    position: absolute;
    right: -70px;
    bottom: -90px;
    width: clamp(320px, 34vw, 540px);
    height: auto;
    color: var(--color-green);
    opacity: 0.05;
    transform: rotate(18deg);
    pointer-events: none;
    z-index: 0;
  }
  .gov-band__bush {
    position: absolute;
    left: 2%;
    bottom: -6px;
    width: clamp(180px, 18vw, 300px);
    height: auto;
    color: var(--color-green);
    opacity: 0.05;
    pointer-events: none;
    z-index: 0;
  }
  .gov-band__content { position: relative; z-index: 1; }

  .gov-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-6);
    max-width: 960px;
    margin-inline: auto;
  }
  @media (max-width: 700px) { .gov-grid { grid-template-columns: 1fr; } }
  .gov-grid h3 { margin: 0 0 var(--space-3); color: var(--color-green); }
  .gov-grid p { margin: 0; color: var(--color-ink-soft); line-height: 1.7; }
</style>
