---
import RedesignLayout from '../../layouts/RedesignLayout.astro';
import PageHero from '../../components/band/PageHero.astro';
import LeafHeading from '../../components/redesign/LeafHeading.astro';
import Leaf from '../../components/redesign/Leaf.astro';
import RdCta from '../../components/redesign/RdCta.astro';

// Verbatim from favorintl.org/about/statement-of-faith (14 articles, in the
// live order). Titles are added for scannability; the bodies are Favor's exact
// wording. Two spaced hyphens in the live text were changed to commas per the
// brand no-dash rule (no words altered).
const articles = [
  { title: 'God', body: `We believe in the one and only true God. We believe in the trinity of the Godhead; God the Father, God the Son, and God the Holy Spirit. We believe that these three are one.` },
  { title: 'The Bible', body: `We believe the Holy Scriptures of both the Old and New Testament, which together form the Holy Bible. It is the infallible written Word of God, unchangeable, immutable, and as powerful today as the day it was wholly inspired by the Holy Spirit. His Word is the supreme and final authority in all matters.` },
  { title: 'Jesus Christ', body: `We believe that Jesus Christ is the Son of God who was made manifest in the flesh; that he was born of the Virgin Mary, lived, died on the cross, rose from the dead, and ascended to heaven as God's plan for the redemption of all mankind by faith through Jesus Christ. He is now seated at the right hand of the Father, ever living to make intercession for us, His church (Hebrews 7:25).` },
  { title: 'Sin and Justification', body: `We believe that all mankind has sinned and fallen short of the glory of God, thereby deserving death, since men are born of the seed of the sinful seed Adam. All mankind may be justified by grace, through faith, in Jesus Christ, who died to be a ransom for all.` },
  { title: 'Transformation', body: `We believe in the transformation of sinners when they believe in Jesus Christ. As one comes to Jesus Christ and personally receives Him as Lord and Savior, he becomes a new creation, the old has passed away and new life begins. Therefore we do not hold one's past against them but see them forgiven by Jesus Christ who justifies all men.` },
  { title: 'Baptism', body: `We believe in the baptism of all believers by immersion as a physical sign of the inward faith in Jesus Christ. Baptism symbolizes our death and resurrection with Him.` },
  { title: 'The Resurrection', body: `We believe in the resurrection of the dead and that the dead in Christ will rise never to die again, and those who are still living will be caught up with them to meet the Lord in the air, and to live with Christ throughout eternity.` },
  { title: 'Holy Matrimony', body: `We believe in holy matrimony, that is marriage between one man and one woman, as having been sanctioned in the Christian life according to the Word of God. We believe that in marriage, a man leaves his father and mother and joins his wife and the two become one flesh (Genesis 2:24).` },
  { title: 'Tithing and Giving', body: `We believe in tithing and giving offerings in the Kingdom of God so that there may be enough supply for the work of God and His servants. We apply the power of prayer, fasting, and giving within our lives, as has been taught us by our Lord Jesus Christ through His Word (Matthew 6:3-18).` },
  { title: 'The Church', body: `We believe in the Church as the body of Christ, which He laid down His life to purchase. Jesus Christ is the head of His Church and He is coming back to take this same Church to be with Him for eternity, a Church without spot or wrinkle. His church is made up of all races, classes, nations, tribes, languages, and generations. Together we represent God's love and equal value for all mankind. Members of His church are all those that have become children of God, through their faith and confession of Jesus as their Savior and Lord.` },
  { title: 'The Holy Spirit', body: `We believe in the in-filling of the Holy Spirit in all believers of the Lord Jesus Christ. The empowerment of the Holy Spirit upon believers is for the manifestation of His works through signs, wonders, and miracles, as was demonstrated by Jesus and the New Testament Church, throughout the whole Word of God, and by His church since then.` },
  { title: 'The Great Commission', body: `We believe in preaching the Gospel of Jesus Christ and being witnesses of His Word and works to the entire world, in fulfillment of the Great Commission. This was commanded to us, by the Lord Jesus Christ, and is His commission for the whole body of Christ worldwide.` },
  { title: 'Spiritual Authority', body: `We believe that the devil is the prince of demons and darkness, and as the adversary of God is therefore an enemy of the children of God. When Jesus died on the cross, He guaranteed the ultimate triumph of God and His church, over all darkness. He has given believers power and authority for prayer, doing His Word and will, fulfilling His commission, and setting people free from the works of the enemy, in His Name. (Mark 16:16-17, Ephesians 2:2, Colossians 2:13-15, 1 Peter 5:8, and Revelation 20:10.)` },
  { title: 'The Return of Christ', body: `We believe in and eagerly await the second return of this same Jesus Christ, to take the Church to Himself, a Church without spot or wrinkle. This is our driving force in preparing ourselves and the rest of the world, as we 'occupy' until His return.` },
];
const slug = (t) => t.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
---
<RedesignLayout
  title="Statement of Faith"
  description="The doctrinal statement of Favor International. Where we stand."
>
  <PageHero
    label="Statement of Faith"
    title="Where we stand."
    promise="The doctrinal core that every Favor staff member, board member, and field leader affirms."
    image="/images/field/hero-bibles-uganda.webp"
    imageAlt="Bibles ready for distribution in Uganda"
  />

  <!-- Preamble: frame the confession before the articles. -->
  <section class="band band--cream sof-preamble">
    <div class="container">
      <LeafHeading
        label="What we believe"
        title="In one accord, we believe."
        intro="This is Favor International's statement of faith, word for word. These convictions are the foundation under everything we do, in every country we serve."
      />
      <blockquote class="sof-verse">
        “One Lord, one faith, one baptism.”
        <cite>Ephesians 4:5</cite>
      </blockquote>
    </div>
  </section>

  <!-- The articles, with a sticky contents rail filling the margin. -->
  <section class="band band--white sof-band">
    <div class="container sof-layout">
      <aside class="sof-contents" aria-label="Articles of faith">
        <p class="sof-contents__label">The articles</p>
        <ol>
          {articles.map((a) => (
            <li><a href={`#${slug(a.title)}`}>{a.title}</a></li>
          ))}
        </ol>
      </aside>
      <ol class="faith-list">
        {articles.map((a) => (
          <li id={slug(a.title)}>
            <h3>{a.title}</h3>
            <p>{a.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Closing affirmation: the page's own final line, set as a pull-quote. -->
  <section class="band band--greenlight sof-close">
    <Leaf class="sof-close__leaf" />
    <div class="container sof-close__content">
      <p class="label">In one accord</p>
      <blockquote class="sof-close__quote">
        This is our driving force in preparing ourselves and the rest of the world, as we ‘occupy’ until His return.
      </blockquote>
    </div>
  </section>

  <RdCta
    heading="Questions on doctrine?"
    body="Email the team. We are happy to discuss what we believe and why."
    ctaLabel="Email the team"
    ctaHref="mailto:info@favorintl.org"
    background="cream"
    image="/images/hero-pastor-preaching.jpg"
    imageAlt="An indigenous pastor preaching to a crowd under an acacia tree"
  />
</RedesignLayout>

<style>
  /* A guiding verse beneath the preamble. */
  .sof-verse {
    margin: clamp(36px, 4vw, 56px) auto 0;
    max-width: 24ch;
    text-align: center;
    border: 0;
    padding: 0;
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--rd-fs-title);
    line-height: 1.3;
    color: var(--color-green-deep);
  }
  .sof-verse cite {
    display: block;
    margin-top: var(--space-4);
    font-style: normal;
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: var(--rd-fs-small);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-gold-deep);
  }

  /* Two columns: a sticky contents rail + the confession. */
  .sof-layout { display: grid; grid-template-columns: 240px 1fr; gap: clamp(40px, 6vw, 96px); align-items: start; }
  .sof-contents { position: sticky; top: clamp(90px, 12vh, 130px); }
  .sof-contents__label { font-size: var(--rd-fs-small); font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-sage); margin: 0 0 var(--space-4); }
  .sof-contents ol { list-style: none; margin: 0; padding: 0; counter-reset: toc; display: grid; gap: var(--space-2); }
  .sof-contents li { counter-increment: toc; }
  .sof-contents a { display: flex; gap: var(--space-3); color: var(--color-ink-soft); text-decoration: none; font-size: var(--rd-fs-body); line-height: 1.35; transition: color 140ms; }
  .sof-contents a::before { content: counter(toc, decimal-leading-zero); color: var(--color-gold-deep); font-weight: 700; font-variant-numeric: tabular-nums; }
  .sof-contents a:hover { color: var(--color-green); }
  @media (max-width: 900px) { .sof-layout { grid-template-columns: 1fr; } .sof-contents { display: none; } }

  /* A confession reads as one quiet column; hierarchy from size + air. */
  .faith-list { list-style: none; padding: 0; margin: 0; max-width: 720px; counter-reset: faith; scroll-margin-top: 100px; }
  .faith-list li {
    position: relative;
    padding: clamp(40px, 5vw, 64px) var(--space-4) clamp(40px, 5vw, 64px) 84px;
    border-bottom: 1px solid var(--color-border);
    scroll-margin-top: 110px;
  }
  .faith-list li:first-child { padding-top: 0; }
  .faith-list li:first-child::before { top: 2px; }
  .faith-list li:last-child { border-bottom: 0; }
  .faith-list li::before {
    counter-increment: faith;
    content: counter(faith, decimal-leading-zero);
    position: absolute;
    left: var(--space-4);
    top: calc(clamp(40px, 5vw, 64px) + 2px);
    font-family: var(--font-display);
    font-size: var(--rd-fs-sub);
    line-height: 1.1;
    color: var(--color-gold-deep);
    opacity: 0.8;
  }
  .faith-list h3 { margin: 0 0 var(--space-4); color: var(--color-green); }
  .faith-list p { margin: 0; color: var(--color-ink-soft); line-height: 1.8; }
  @media (max-width: 560px) {
    .faith-list li { padding-left: 56px; padding-right: 0; }
    .faith-list li::before { left: 0; }
  }

  /* Closing affirmation. */
  .sof-close { position: relative; isolation: isolate; overflow: hidden; }
  .sof-close :global(.sof-close__leaf) { position: absolute; right: -60px; bottom: -80px; width: clamp(280px, 30vw, 460px); height: auto; color: var(--color-green); opacity: 0.06; transform: rotate(18deg); pointer-events: none; z-index: 0; }
  .sof-close__content { position: relative; z-index: 1; text-align: center; }
  .sof-close__quote {
    margin: var(--space-5) auto 0;
    max-width: 30ch;
    border: 0;
    padding: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--rd-fs-title);
    line-height: 1.35;
    color: var(--color-green-deep);
    text-wrap: balance;
  }
</style>
