                 M88 116 C101 111 114 118 112 131 C110 142 95 146 86 137 C79 130 80 121 88 116 Z" />
      </g>
    </svg>
    <svg class="faith-leaf faith-leaf--2" viewBox="0 0 220 220" aria-hidden="true">
      <g fill="currentColor" fill-rule="evenodd">
        <path d="M112 18 C70 8 30 30 18 68 C6 106 22 150 54 174 C78 192 104 198 114 193 C109 174 110 154 116 137 C156 144 190 121 198 86 C205 54 186 28 152 18 C138 14 124 15 112 18 Z
                 M64 64 C74 55 90 59 93 72 C95 84 82 93 70 87 C61 82 58 71 64 64 Z
                 M132 52 C145 47 158 56 156 69 C154 80 139 84 130 75 C123 68 124 57 132 52 Z
                 M88 116 C101 111 114 118 112 131 C110 142 95 146 86 137 C79 130 80 121 88 116 Z" />
      </g>
    </svg>
    <svg class="faith-leaf faith-leaf--3" viewBox="0 0 220 220" aria-hidden="true">
      <g fill="currentColor" fill-rule="evenodd">
        <path d="M112 18 C70 8 30 30 18 68 C6 106 22 150 54 174 C78 192 104 198 114 193 C109 174 110 154 116 137 C156 144 190 121 198 86 C205 54 186 28 152 18 C138 14 124 15 112 18 Z
                 M64 64 C74 55 90 59 93 72 C95 84 82 93 70 87 C61 82 58 71 64 64 Z
                 M132 52 C145 47 158 56 156 69 C154 80 139 84 130 75 C123 68 124 57 132 52 Z
                 M88 116 C101 111 114 118 112 131 C110 142 95 146 86 137 C79 130 80 121 88 116 Z" />
      </g>
    </svg>
    <svg class="faith-leaf faith-leaf--4" viewBox="0 0 220 220" aria-hidden="true">
      <g fill="currentColor" fill-rule="evenodd">
        <path d="M112 18 C70 8 30 30 18 68 C6 106 22 150 54 174 C78 192 104 198 114 193 C109 174 110 154 116 137 C156 144 190 121 198 86 C205 54 186 28 152 18 C138 14 124 15 112 18 Z
                 M64 64 C74 55 90 59 93 72 C95 84 82 93 70 87 C61 82 58 71 64 64 Z
                 M132 52 C145 47 158 56 156 69 C154 80 139 84 130 75 C123 68 124 57 132 52 Z
                 M88 116 C101 111 114 118 112 131 C110 142 95 146 86 137 C79 130 80 121 88 116 Z" />
      </g>
    </svg>
    <div class="container faith-band__content">
      <LeafHeading
        label="What we believe"
        title="In one accord, we believe."
        intro="Every Favor staff member, board member, and field leader affirms this statement of faith."
      />
      <ol class="faith-list">
        {articles.map((a) => (
          <li>
            <h3>{a.title}</h3>
            <p>{a.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <RdCta
    heading="Questions on doctrine?"
    body="Email the team. We are happy to discuss what we believe and why."
    ctaLabel="Email the team"
    ctaHref="mailto:info@favorintl.org"
  />
</RedesignLayout>

<style>
  /* Faint leaves drifting down the margins as you scroll. African touch,
     never in the reading column, never asking for attention. */
  .faith-band { position: relative; isolation: isolate; overflow: hidden; }
  .faith-band__content { position: relative; z-index: 1; }
  .faith-leaf {
    position: absolute;
    width: clamp(150px, 16vw, 230px);
    height: auto;
    color: #cfe0c6;
    opacity: 0.42;
    pointer-events: none;
    z-index: 0;
  }
  .faith-leaf--1 { top: 16%; left: 3%; transform: rotate(-10deg); }
  .faith-leaf--2 { top: 38%; right: 4%; transform: rotate(152deg); }
  .faith-leaf--3 { top: 62%; left: 5%; transform: rotate(8deg); }
  .faith-leaf--4 { top: 84%; right: 3%; transform: rotate(168deg); }
  @media (max-width: 1100px) { .faith-leaf { display: none; } }

  /* A confession reads as one quiet column, not a grid of loud boxes.
     Hierarchy from size, weight, and lightness; air between articles. */
  .faith-list {
    list-style: none;
    padding: 0;
    margin: 0 auto;
    max-width: 720px;
    counter-reset: faith;
  }
  .faith-list li {
    position: relative;
    padding: clamp(48px, 6vw, 72px) var(--space-4) clamp(48px, 6vw, 72px) 96px;
    border-bottom: 1px solid var(--color-border);
  }
  .faith-list li:first-child { padding-top: 0; }
  .faith-list li:first-child::before { top: 2px; }
  .faith-list li:last-child { border-bottom: 0; }
  .faith-list li::before {
    counter-increment: faith;
    content: counter(faith, decimal-leading-zero);
    position: absolute;
    left: var(--space-4);
    top: calc(clamp(48px, 6vw, 72px) + 2px);
    font-family: var(--font-display);
    font-size: var(--rd-fs-body);
    line-height: 1.3;
    color: var(--color-gold-deep);
    opacity: 0.75;
  }
  .faith-list h3 { margin: 0 0 var(--space-4); color: var(--color-green); }
  .faith-list p { margin: 0; color: var(--color-ink-soft); line-height: 1.8; }
  @media (max-width: 560px) {
    .faith-list li { padding-left: var(--space-2); padding-right: var(--space-2); padding-top: var(--space-16); }
    .faith-list li::before { left: var(--space-2); top: var(--space-8); }
    .faith-list li:first-child { padding-top: var(--space-10); }
    .faith-list li:first-child::before { top: 0; }
  }
</style>
