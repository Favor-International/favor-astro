---
import RedesignLayout from '../../../layouts/RedesignLayout.astro';
import PageHero from '../../../components/band/PageHero.astro';
import RdFeature from '../../../components/redesign/RdFeature.astro';
import RdCta from '../../../components/redesign/RdCta.astro';
import directorsData from '../../../data/directors.json';

// Profile pages for every CURRENT director/leader except Carole Ward, who has
// a dedicated founder page at /about/our-story/founder/. Source: Directors
// data. Former board members in the data (Coggin, Kayatin, Vega - verified
// against the live directors page + FY2024 Form 990, see
// docs/06-reference/about-fact-audit-2026-07-08.md) get no page.
export function getStaticPaths() {
  const FORMER = ['lisa-coggin', 'rev-louis-kayatin', 'dr-vilma-vega'];
  return directorsData
    .filter((d) => d.slug !== 'carole-ward' && !FORMER.includes(d.slug))
    .map((d) => ({ params: { slug: d.slug }, props: { person: d } }));
}

const { person } = Astro.props as {
  person: {
    slug: string;
    fullName: string;
    type: string;
    position: string;
    location: string;
    bioIntro: string;
    imagePath: string;
  };
};

const isBoard = /board/i.test(person.type);
const backHref = isBoard ? '/about/board/' : '/about/team/';
const backLabel = isBoard ? 'Back to the Board' : 'Back to the team';
const desc = `${person.fullName}, ${person.position} at Favor International. ${person.bioIntro}`.slice(0, 155);
---
<RedesignLayout title={person.fullName} description={desc}>
  <PageHero
    label={person.position}
    title={`${person.fullName}.`}
    promise={person.location}
    image="/images/field/hero-gift-uganda.webp"
    imageAlt="GIFT leadership-training students in Uganda"
  />

  <RdFeature
    image={person.imagePath}
    imageAlt={`${person.fullName}, ${person.position}`}
    eyebrow={person.type}
    heading={person.position}
    side="right"
    objectPosition="center top"
  >
    <p>{person.bioIntro}</p>
    <p class="profile-back-row"><a href={backHref} class="profile-back">{backLabel} &rarr;</a></p>
  </RdFeature>

  <RdCta
    heading="Stand with the work this team carries."
    body="Favor Partners keep indigenous missionaries on the field across northeast Africa. Monthly partnership, any tier, makes the work possible."
    ctaLabel="Become a Favor Partner"
    ctaHref="/give/partner-monthly/"
    image="/images/hero-pastor-preaching.jpg"
    imageAlt="An indigenous pastor preaching to a crowd under an acacia tree"
  />
</RedesignLayout>

<style>
  .profile-back-row { margin-top: var(--space-8); }
  .profile-back { color: var(--color-green); font-weight: 700; text-decoration: none; border-bottom: 2px solid var(--color-gold); }
</style>
