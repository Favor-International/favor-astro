---
import RedesignLayout from '../../layouts/RedesignLayout.astro';
import PageHero from '../../components/band/PageHero.astro';
import RdFeature from '../../components/redesign/RdFeature.astro';
import ScriptBand from '../../components/redesign/ScriptBand.astro';
import LeafHeading from '../../components/redesign/LeafHeading.astro';
import RdCta from '../../components/redesign/RdCta.astro';
import VideoEmbed from '../../components/global/VideoEmbed.astro';

// The fruit of the first 90 national leaders. Each figure gets its own
// container with an icon, the number, and a short label of what it is
// (per Daniel). `feature` makes a stat span a larger cell. The source lines
// (verbatim, see the 2004 entry): "Distributed 80,000+ Bibles", "Trained
// 7,000+ pastors", "Held crusades with 1 million+ attending", "Built the
// first Christian radio station", "Trained government leaders", "Graduated
// 500+ leaders from a Bible college", "Built a school with 400 attending",
// "Reached 50,000+ through trauma counseling", "Conducted mobile medical
// clinics for 8,000+ patients".
const ICONS: Record<string, string> = {
  crusade: '<path d="M3 11v2a1 1 0 0 0 1 1h2l4 4V6L6 10H4a1 1 0 0 0-1 1Z"/><path d="M14 8a4 4 0 0 1 0 8M16 5a7 7 0 0 1 0 14"/>',
  book: '<path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H19v15H6.5A2.5 2.5 0 0 0 4 20.5V5.5Z"/><path d="M19 18v3H6.5A2.5 2.5 0 0 1 4 18.5"/>',
  people: '<circle cx="9" cy="8" r="3"/><path d="M3.5 20a5.5 5.5 0 0 1 11 0"/><path d="M16 6a3 3 0 0 1 0 6M16.5 14.2A5.5 5.5 0 0 1 20.5 19.5"/>',
  cap: '<path d="M12 4 2 9l10 5 10-5-10-5Z"/><path d="M6 11v4c0 1.1 2.7 3 6 3s6-1.9 6-3v-4"/>',
  school: '<path d="M3 21h18M5 21V8l7-4 7 4v13"/><path d="M10 21v-5h4v5"/>',
  heart: '<path d="M12 20s-7-4.3-7-9a3.6 3.6 0 0 1 7-1.2A3.6 3.6 0 0 1 19 11c0 4.7-7 9-7 9Z"/>',
  medical: '<rect x="4" y="6" width="16" height="14" rx="2"/><path d="M12 10v6M9 13h6M9 3h6v3H9z"/>',
  radio: '<rect x="3" y="9" width="18" height="11" rx="2"/><path d="M8 9 17 4M8 14.5h.01M16 14a1.5 1.5 0 0 1 0 3 1.5 1.5 0 0 1 0-3Z"/>',
  landmark: '<path d="M3 21h18M4 10h16M12 3 4 7h16l-8-4ZM6 10v8M10 10v8M14 10v8M18 10v8"/>',
};
const fruitStats = [
  { icon: 'crusade', num: '1 million+', label: 'gathered at Gospel crusades', feature: true },
  { icon: 'book', num: '80,000+', label: 'Bibles distributed' },
  { icon: 'people', num: '7,000+', label: 'pastors trained' },
  { icon: 'heart', num: '50,000+', label: 'reached through trauma counseling' },
  { icon: 'medical', num: '8,000+', label: 'patients at mobile medical clinics' },
  { icon: 'cap', num: '500+', label: 'graduated from a Bible college' },
  { icon: 'school', num: '400', label: 'attending a school they built' },
  { icon: 'radio', num: '', label: 'Built the first Christian radio station' },
  { icon: 'landmark', num: '', label: 'Trained government leaders' },
];
---
<RedesignLayout
  title="Our Story"
  description="How Favor International started, where the founding conviction came from, and how the work grew across East Africa."
>
  <PageHero
    label="Our story"
    title="The conviction Favor was born from."
    promise="How one woman's prayer grew into an indigenous missions movement across East and Central Africa."
    image="/images/story-historic-prayer.jpg"
    imageAlt="A national prayer gathering in northern Uganda"
    scrollCue
  />

  <RdFeature
    image="/images/field-2026/carole-1.webp"
    imageAlt="The original Favor House in northern Uganda"
    eyebrow="2002 to 2004"
    heading="The beginning."
    side="left"
    decor="leaf"
  >
    <p class="rd-lede">Carole Ward moved to Uganda in 2002 during a 20-year horrific war, serving and training African leaders from all backgrounds to pray. Together they saw the war end, and she began equipping them to reach their own people with the power of the Gospel.</p>
    <p>After six months of prayer, Ugandans came to her with desperate visions for reaching their own people with Bibles, discipleship, education, and evangelism. In 2004, Carole formed Favour of God Ministries and began training indigenous missionaries to run that vision.</p>
  </RdFeature>

  <ScriptBand
    image="/images/field-2026/carole-4.webp"
    imageAlt="Carole Ward in prayer in the field"
    label="The founding prayer"
    phrase="Lord, send me where no one wants to go, to do what no one wants to do."
    cite="Carole Ward, Founder"
    objectPosition="center 30%"
  />

  <section class="band band--cream">
    <div class="container">
      <LeafHeading label="The story, year by year" title="How the work grew." leaves={false} />

      <div class="tl">
        <div class="tl-item">
          <div class="tl-item__inner rd-prose">
            <span class="tl-year">2004</span>
            <div class="tl-photo" style="background-image:url('/images/field-2026/carole-2.webp')" role="img" aria-label="The original House of Prayer in Gulu"></div>
            <p>In time, after much intercessory prayer, many came to join Carole in the ministry of evangelism, Bible teaching, and caring for the orphans. When the government required registration to continue the work in this dangerous area, Carole formed the ministry in 2004, with two Ugandans. Though the needs were enormous, God told her, &ldquo;Build My house, and I&rsquo;ll build yours!&rdquo; (1 Chronicles 17:10 &amp; 25).</p>
            <p>Soon after, Favor opened a simple community called the House of Prayer in Gulu, the regional capital in the center of the war. It became a center for a missionary movement that was in part instrumental to end the war through the power of the Gospel.</p>
          </div>
        </div>

        <div class="tl-item">
          <div class="tl-item__inner rd-prose">
            <span class="tl-year">2005</span>
            <div class="tl-photo" style="background-image:url('/images/field-2026/prayer-2.webp')" role="img" aria-label="The National Prayer Gathering in Gulu, 2005"></div>
            <p>A real turning point in our story was the National Prayer Gathering in Gulu. The Lord prompted us to organize a gathering in the War Memorial Stadium to unify the tribes, leaders, churches, and regions in Uganda in repentant prayer for the ending of the war. We planned a 77 hour prayer meeting, 11 hours a day for 7 days in December 2005. Radio stations were contacted to spread the news and word spread like wildfire. The day finally approached and over 1,000 people, including political leaders, gathered inside this humble stadium to join in intense, radical, united prayer.</p>
            <p>As a result, the war stopped and many significant stories of radical transformation followed. Pastors reported that they sensed heaven opening in a new way. Government officials called and testified of a strong sense that the spiritual climate over the area had changed. Miracles were occurring in local churches. It even led to inaugurating the month of January as the month of prayer.</p>
          </div>
        </div>

        <div class="tl-item">
          <div class="tl-item__inner rd-prose">
            <span class="tl-year">2007 to 2014</span>
            <div class="tl-photo" style="background-image:url('/images/field-2026/education-1.webp')" role="img" aria-label="Graduates celebrating in DR Congo"></div>
            <p>In 2007, the Lord led Carole to begin extending the work into Sudan before liberation. National prayer gatherings were mobilized in Juba, the capital of South Sudan, in 2015 and again in 2019, to see enough peace for the Gospel to extend to the farthest regions of the nation and into the most remote tribes and villages. In 2014, FAMI was birthed as a sister organization to FOGM in Northern Uganda, with the same vision, prayer foundation, and indigenous leadership development in each country.</p>
          </div>
        </div>

        <div class="tl-item">
          <div class="tl-item__inner rd-prose">
            <span class="tl-year">2015 to now</span>
            <div class="tl-photo" style="background-image:url('/images/field/prayer-gathering-chad.webp')" role="img" aria-label="A national prayer gathering in Chad"></div>
            <p>We began to focus more direct efforts to South Sudan in 2007 by sending missionaries and Portable Bible School (PBS) programs. We organized a legal presence in the nation through trusted Portable Bible School graduates and purchased our first office space in Juba in 2015. That same year we hosted a national prayer meeting in Juba, the capital of South Sudan, just as we did in Uganda, to bring God&rsquo;s repentance, revival, and restoration.</p>
            <p>In the years since, we have continued establishing Houses of Prayer in strategic locations across Uganda and South Sudan. In the early part of 2024, we also established a House of Prayer in N&rsquo;Djamena, the capital city of Chad.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="band band--cream">
    <div class="container">
      <header class="band__header fruit-head">
        <p class="label">The fruit</p>
        <h2>What ninety leaders did.</h2>
        <p>The ministry quickly grew to 90 national leaders in a few years. Those 90 leaders:</p>
      </header>
      <div class="fruit-grid">
        {fruitStats.map((s) => (
          <article class={`fruit-cell ${s.feature ? 'fruit-cell--feature' : ''} ${!s.num ? 'fruit-cell--milestone' : ''}`}>
            <span class="fruit-cell__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={ICONS[s.icon]}></svg>
            </span>
            {s.num && <span class="fruit-cell__num">{s.num}</span>}
            <span class="fruit-cell__label">{s.label}</span>
          </article>
        ))}
      </div>
    </div>
  </section>

  <ScriptBand
    image="/images/hero-pastor-preaching.jpg"
    imageAlt="An indigenous pastor preaching to a gathered crowd under an acacia tree"
    label="The vision"
    phrase="Every tribe and language reaching their own people, and beyond, with the power of God's Word."
    font="serif"
    tall
    objectPosition="center 40%"
  />

  <section class="band band--white">
    <div class="container">
      <div class="film">
        <div class="film__video">
          <svg class="film__leaf" viewBox="0 0 220 220" aria-hidden="true">
            <g fill="currentColor" fill-rule="evenodd">
              <path d="M112 18 C70 8 30 30 18 68 C6 106 22 150 54 174 C78 192 104 198 114 193 C109 174 110 154 116 137 C156 144 190 121 198 86 C205 54 186 28 152 18 C138 14 124 15 112 18 Z M64 64 C74 55 90 59 93 72 C95 84 82 93 70 87 C61 82 58 71 64 64 Z M132 52 C145 47 158 56 156 69 C154 80 139 84 130 75 C123 68 124 57 132 52 Z M88 116 C101 111 114 118 112 131 C110 142 95 146 86 137 C79 130 80 121 88 116 Z" />
            </g>
          </svg>
          <VideoEmbed id="g2fB1RwyHNM" title="The Carole Ward Story" />
        </div>
        <div class="film__copy rd-prose">
          <p class="label">In her own words</p>
          <h2>Hear the story from Carole.</h2>
          <p>Carole Ward is a missionary, leader, and teacher fostering an indigenous missions movement in Northern Uganda and South Sudan. She moved to Uganda in 2002 during a 20-year horrific war, where she served and trained African leaders from all backgrounds to pray.</p>
          <ul class="film__more">
            <li><a href="https://www.youtube.com/watch?v=Y5pWE0AX97M" target="_blank" rel="noopener"><span class="film__more-play" aria-hidden="true">&#9654;</span> Reigniting a Passion for Prayer</a></li>
            <li><a href="https://www.youtube.com/watch?v=5oUghxzqGXU" target="_blank" rel="noopener"><span class="film__more-play" aria-hidden="true">&#9654;</span> Nations Media Podcast with Carole Ward</a></li>
          </ul>
          <p><a href="/about/our-story/founder/" class="story-link">Read the full founder's story &rarr;</a></p>
        </div>
      </div>
    </div>
  </section>

  <RdFeature
    image="/images/field-2026/missionaries-5.webp"
    imageAlt="Favor field and office leaders together"
    eyebrow="Today"
    heading="Indigenous-led, across East Africa."
    side="right"
    background="cream"
    decor="leaf"
  >
    <p class="rd-lede">Favor International serves and trains indigenous leaders across East Africa. Each field team is led by African nationals.</p>
    <p>The U.S. team raises support, stewards funds, and provides accountability so the field can do the work it was called to.</p>
    <p class="today-links"><a href="/about/where-we-work/" class="story-link">See where we work &rarr;</a> <a href="/about/team/" class="story-link">Meet the team &rarr;</a></p>
  </RdFeature>

  <RdCta
    heading="Be part of the next chapter."
    body="Favor Partners keep this story going. Monthly partnership, any tier, makes the field work possible."
    ctaLabel="Become a Favor Partner"
    ctaHref="/give/partner-monthly/"
    background="cream"
    image="/images/field/country-uganda.webp"
    imageAlt="A vision-trip team with Karamojong villagers in the savanna"
  />
</RedesignLayout>

<style>
  /* Alternating timeline: a center line, entries stepping left / right /
     left / right down the page for a gentle zigzag. Same content size. */
  .tl { position: relative; max-width: 1140px; margin: clamp(40px, 5vw, 72px) auto 0; }
  .tl::before { content: ''; position: absolute; left: 50%; top: 8px; bottom: 8px; width: 2px; transform: translateX(-50%); background: var(--color-sage-light); }
  .tl-item { position: relative; width: 50%; box-sizing: border-box; padding-bottom: clamp(56px, 7vw, 104px); }
  .tl-item:nth-child(odd) { left: 0; padding-right: clamp(36px, 4vw, 64px); }
  .tl-item:nth-child(even) { left: 50%; padding-left: clamp(36px, 4vw, 64px); }
  .tl-item:last-child { padding-bottom: 0; }
  /* Dot sitting on the center line at the start of each entry. */
  .tl-item::after { content: ''; position: absolute; top: 6px; width: 15px; height: 15px; border-radius: 50%; background: var(--color-gold); box-shadow: 0 0 0 4px var(--color-cream); z-index: 1; }
  .tl-item:nth-child(odd)::after { right: -8px; }
  .tl-item:nth-child(even)::after { left: -8px; }
  .tl-year { display: block; font-family: var(--font-display); font-weight: 700; font-size: var(--rd-fs-title); color: var(--color-gold-deep); line-height: 1; margin-bottom: var(--space-5); }
  .tl-photo { aspect-ratio: 16 / 9; background-size: cover; background-position: center 35%; border-radius: var(--rd-radius); box-shadow: var(--rd-shadow); margin: 0 0 var(--space-6); }
  .tl-item__inner p { margin: 0 0 var(--space-5); }
  .tl-item__inner p:last-child { margin-bottom: 0; }
  @media (max-width: 820px) {
    .tl { max-width: 640px; }
    .tl::before { left: 7px; transform: none; }
    .tl-item { width: 100%; left: 0 !important; padding-left: 44px !important; padding-right: 0 !important; }
    .tl-item::after { left: 0 !important; right: auto !important; }
  }

  /* Emphasized opening sentence on a feature. */
  .rd-lede { font-size: var(--rd-fs-sub); line-height: 1.5; color: var(--color-ink) !important; }
  .today-links { display: flex; flex-wrap: wrap; gap: var(--space-3) var(--space-8); margin-top: var(--space-6); }

  /* The fruit of the 90 leaders: each figure its own container with an icon,
     the number, and a short label of what it is. One feature cell is larger. */
  .fruit-head p:not(.label) { font-weight: 600; }
  .fruit-grid {
    display: grid; grid-template-columns: repeat(4, 1fr);
    gap: clamp(20px, 2vw, 28px);
    grid-auto-flow: dense;
  }
  @media (max-width: 900px) { .fruit-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 440px) { .fruit-grid { grid-template-columns: 1fr; } }
  .fruit-cell {
    display: flex; flex-direction: column; align-items: flex-start;
    gap: var(--space-3);
    background: var(--color-white);
    border-radius: var(--rd-radius);
    box-shadow: var(--rd-shadow);
    padding: clamp(24px, 2.4vw, 36px);
  }
  .fruit-cell__icon {
    display: inline-flex; align-items: center; justify-content: center;
    width: 46px; height: 46px; border-radius: 12px;
    background: var(--rd-bg-green); color: var(--color-green);
  }
  .fruit-cell__icon svg { width: 24px; height: 24px; }
  .fruit-cell__num {
    font-family: var(--font-sans); font-weight: 800; line-height: 1; letter-spacing: -0.02em;
    font-size: clamp(2.1rem, 3vw, 2.8rem); color: var(--color-green);
  }
  .fruit-cell__label { color: var(--color-ink-soft); line-height: 1.45; font-size: var(--rd-fs-body); }
  /* Feature cell: spans two columns, gold accent, bigger number. */
  .fruit-cell--feature {
    grid-column: span 2; background: var(--color-green-deep);
    justify-content: center;
  }
  @media (max-width: 440px) { .fruit-cell--feature { grid-column: span 1; } }
  .fruit-cell--feature .fruit-cell__icon { background: color-mix(in srgb, var(--color-white) 14%, transparent); color: var(--color-gold); }
  .fruit-cell--feature .fruit-cell__num { color: var(--color-gold); font-size: clamp(2.8rem, 4.6vw, 4.2rem); }
  .fruit-cell--feature .fruit-cell__label { color: color-mix(in srgb, var(--color-white) 85%, transparent); font-size: var(--rd-fs-sub); }
  /* Milestone cells (no number): the label carries the verbatim line. */
  .fruit-cell--milestone { background: var(--color-cream); box-shadow: none; border: 1px solid rgba(31,58,26,0.10); }
  .fruit-cell--milestone .fruit-cell__label { font-family: var(--font-display); font-weight: 700; color: var(--color-green); font-size: var(--rd-fs-sub); line-height: 1.25; }

  /* Carole video: a large featured player (with a leaf behind it) beside
     framing copy + more talks, so the section reads full. */
  .film { display: grid; grid-template-columns: 1.5fr 1fr; gap: clamp(40px, 5vw, 80px); align-items: center; }
  @media (max-width: 860px) { .film { grid-template-columns: 1fr; gap: var(--space-12); } }
  .film__video { position: relative; }
  .film__video :global(.video-embed) { position: relative; z-index: 1; }
  .film__leaf {
    position: absolute; z-index: 0; width: clamp(200px, 46%, 320px); height: auto;
    left: clamp(-100px, -12%, -60px); bottom: clamp(-84px, -11%, -52px);
    color: #c2d6b6; transform: rotate(-16deg); pointer-events: none;
  }
  .film__copy h2 { margin: var(--space-3) 0 var(--space-5); }
  .film__more { list-style: none; padding: 0; margin: var(--space-6) 0; display: grid; gap: var(--space-3); }
  .film__more a { color: var(--color-green); font-weight: 700; text-decoration: none; display: inline-flex; align-items: center; gap: var(--space-3); }
  .film__more a:hover { color: var(--color-gold-deep); }
  .film__more-play { color: var(--color-gold-deep); font-size: 0.7rem; }

  .story-link { color: var(--color-green); font-weight: 700; text-decoration: none; border-bottom: 2px solid var(--color-gold); }
</style>
