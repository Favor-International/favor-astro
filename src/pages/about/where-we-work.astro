---
import RedesignLayout from '../../layouts/RedesignLayout.astro';
import PageHero from '../../components/band/PageHero.astro';
import AfricaMap from '../../components/global/AfricaMap.astro';
import ScriptBand from '../../components/redesign/ScriptBand.astro';
import LeafHeading from '../../components/redesign/LeafHeading.astro';
import RdCta from '../../components/redesign/RdCta.astro';

const countries = [
  { name: 'Uganda', focus: 'PBS, the GIFT Institute, Village Learning Centers, and Favor FM radio.', image: '/images/field/country-uganda.webp' },
  { name: 'South Sudan', focus: 'Church planting, trauma counseling, and schools across Lakes State and beyond.', image: '/images/field/country-south-sudan.webp' },
  { name: 'Chad', focus: 'Field teams, pastor training, wells, and a House of Prayer in N’Djamena.', image: '/images/field/country-chad.webp' },
  { name: 'Ethiopia', focus: 'The GIFT Institute campus in Bishoftu and Amharic Bible printing.', image: '/images/field/country-ethiopia.webp' },
  { name: 'Democratic Republic of Congo', focus: 'Portable Bible Schools and church planting in the eastern provinces.', image: '/images/field/country-drc.webp' },
  { name: 'Kenya', focus: 'Portable Bible Schools, a logistics hub, and the partner network.', image: '/images/field/country-kenya.webp' },
  { name: 'Sudan', focus: 'Refugee discipleship and Arabic Bible distribution.' },
  { name: 'Burundi', focus: 'Leadership-training cohorts.' },
  { name: 'Rwanda', focus: 'Vision-trip routes and partner church visits.' },
  { name: 'Tanzania', focus: 'Border-region outreach.' },
  { name: 'Eritrea', focus: 'Underground church support.' },
  { name: 'Somalia (border regions)', focus: 'Outreach via Kenya and Ethiopia partners.' },
  { name: 'Central African Republic', focus: 'Pastor support and occasional field visits.' },
  { name: 'Mozambique', focus: 'Partnership exploration.' },
];
const withImage = countries.filter((c) => c.image);
const moreCountries = countries.filter((c) => !c.image);
---
<RedesignLayout
  title="Where We Work"
  description="The East African nations Favor International serves, the field programs in each, and how we got to each one."
>
  <PageHero
    label="Where we work"
    title="East Africa, into the unreached."
    promise="Each country is led by indigenous leaders. US staff coordinate; the field directs."
    image="/images/ministry-church-planting.jpg"
    imageAlt="Planting a church in the Wedweil refugee camp"
    scrollCue
  />

  <AfricaMap />

  <ScriptBand
    image="/images/hero-pastor-preaching.jpg"
    imageAlt="An indigenous pastor preaching to a crowd under an acacia tree"
    label="Into the unreached"
    phrase="Where others will not go."
    font="serif"
    objectPosition="center 35%"
  />

  <section class="band band--white">
    <div class="container">
      <LeafHeading label="The fourteen" title="Where Favor Partners are funding work today." />
      <div class="rd-grid rd-grid--2 ww-tiles">
        {withImage.map((c) => (
          <div class="rd-tile reveal">
            <div class="rd-tile__frame"><div class="rd-tile__img" style={`background-image:url('${c.image}')`} role="img" aria-label={c.name}></div></div>
            <div class="rd-tile__meta">
              <h3>{c.name}</h3>
              <p>{c.focus}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="band band--cream">
    <div class="container">
      <LeafHeading title="Also serving across the region" leaves={false} />
      <ul class="country-list">
        {moreCountries.map((c) => (
          <li class="rd-card reveal">
            <strong>{c.name}</strong>
            <span>{c.focus}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <RdCta
    heading="Pray for a specific country."
    body="The 30-day prayer guide walks you through each nation, one day at a time."
    ctaLabel="Get the 30-Day Guide"
    ctaHref="/pray/30-day-guide/"
    image="/images/story-anaka-crusade.jpg"
    imageAlt="A nighttime worship gathering"
  />
</RedesignLayout>

<style>
  /* The fourteen: bigger tiles, more air, and interactive on hover. */
  .ww-tiles { gap: clamp(56px, 7vw, 104px) clamp(40px, 4vw, 72px); margin-top: clamp(40px, 5vw, 72px); }
  .ww-tiles .rd-tile__frame { border-radius: var(--rd-radius); overflow: hidden; box-shadow: var(--rd-shadow); transition: transform 280ms ease, box-shadow 280ms ease; }
  .ww-tiles .rd-tile__img { aspect-ratio: 3 / 2; border-radius: 0; box-shadow: none; transition: transform 600ms ease; }
  .ww-tiles .rd-tile h3 { transition: color 180ms ease; }
  .ww-tiles .rd-tile:hover .rd-tile__frame { transform: translateY(-8px); box-shadow: var(--rd-shadow-lift); }
  .ww-tiles .rd-tile:hover .rd-tile__img { transform: scale(1.06); }
  .ww-tiles .rd-tile:hover h3 { color: var(--color-gold-deep); }

  .country-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(20px, 2vw, 28px);
    max-width: 980px;
    margin-inline: auto;
  }
  @media (max-width: 700px) { .country-list { grid-template-columns: 1fr; } }
  .country-list li { display: flex; flex-direction: column; gap: var(--space-2); transition: transform 220ms ease, box-shadow 220ms ease; }
  .country-list li:hover { transform: translateY(-5px); box-shadow: var(--rd-shadow-lift); }
  .country-list strong { color: var(--color-green); font-size: var(--rd-fs-body); font-weight: 800; }
  .country-list span { color: var(--color-ink-soft); font-size: var(--rd-fs-body); line-height: 1.6; }
</style>
