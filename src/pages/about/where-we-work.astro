---
import RedesignLayout from '../../layouts/RedesignLayout.astro';
import PageHero from '../../components/band/PageHero.astro';
import AfricaMap from '../../components/global/AfricaMap.astro';
import ScriptBand from '../../components/redesign/ScriptBand.astro';
import LeafHeading from '../../components/redesign/LeafHeading.astro';
import RdCta from '../../components/redesign/RdCta.astro';
import VideoFeature from '../../components/redesign/VideoFeature.astro';

// Per Will (2026-06-18): we only speak publicly about our three main fields —
// Uganda, South Sudan, and Chad. Scale is framed as "14+ nations" with no
// salvation totals or PBS-location counts. Field films come from the Favor
// YouTube channel (@favorinternational). Copy is intentionally general; swap
// for Favor's exact wording when available. Films alternate side down the page.
const films = [
  { country: 'Uganda', id: 'GqXzE7pd79M', title: 'Gospel Crusade in Yumbe', heading: 'Gospel crusades in Yumbe', desc: "Uganda is where Favor's work began. In Yumbe and across the north, open-air crusades draw whole communities to hear the Gospel for the first time." },
  { country: 'Uganda', id: 'OpM5UYTWIso', title: 'Favor Radio carries the Gospel', heading: 'Favor FM carries the Gospel', desc: 'Favor FM puts worship and teaching on the airwaves, reaching listeners in remote villages that are hard to visit in person.' },
  { country: 'South Sudan', id: 'jKrmDKOGJ08', title: 'The City of Iron Sheets - Malakal', heading: 'Reaching Malakal', desc: 'In South Sudan, indigenous leaders bring the Gospel and practical care to people displaced by years of war, including the city of Malakal.' },
  { country: 'South Sudan', id: 'Wf_OQ1hAMoI', title: 'From the streets to safety', heading: 'From the streets to safety', desc: "Favor helps South Sudan's most vulnerable girls find safety, healing, and a future grounded in Christ." },
  { country: 'Chad', id: 'q7J30TlLkWg', title: 'Pastors Buried Alive - Chad Martyrs', heading: 'Faith that costs everything', desc: 'In Chad, following Christ can cost everything. Favor stands with the pastors and believers who carry the Gospel into hostile ground.' },
  { country: 'Chad', id: 'uQSjKwxCqYk', title: 'Indigenous missionary training in Chad', heading: "Training Chad's own missionaries", desc: 'Favor trains and sends indigenous missionaries in Chad to reach unreached villages in their own languages.' },
];
---
<RedesignLayout
  title="Where We Work"
  description="Favor International's three main fields — Uganda, South Sudan, and Chad — and the indigenous-led work in each."
>
  <PageHero
    label="Where we work"
    title="East Africa, into the unreached."
    promise="Each field is led by indigenous leaders. US staff coordinate; the field directs."
    image="/images/ministry-church-planting.jpg"
    imageAlt="Planting a church in the Wedweil refugee camp"
    scrollCue
  />

  <AfricaMap
    showStats={false}
    note="Note: this map is a work in progress and is not yet a precise representation of where Favor International works."
  />

  <ScriptBand
    image="/images/hero-pastor-preaching.jpg"
    imageAlt="An indigenous pastor preaching to a crowd under an acacia tree"
    label="Into the unreached"
    phrase="Where others will not go."
    font="serif"
    objectPosition="center 35%"
    tall
  />

  <section class="band band--white">
    <div class="container">
      <LeafHeading
        title="Our three main fields"
        intro="Favor Partners fund work across 14+ nations. These three are our main fields today."
      />
    </div>
    <div class="container films">
      {films.map((f, i) => (
        <div class="reveal">
          <VideoFeature
            id={f.id}
            videoTitle={f.title}
            eyebrow={f.country}
            heading={f.heading}
            side={i % 2 === 0 ? 'left' : 'right'}
            decor="leaf"
          >
            <p>{f.desc}</p>
          </VideoFeature>
        </div>
      ))}
    </div>
  </section>

  <RdCta
    heading="Pray for a specific country."
    body="The 30-day prayer guide walks you through each nation, one day at a time."
    ctaLabel="Get the 30-Day Guide"
    ctaHref="/pray/30-day-guide/"
    image="/images/story-anaka-crusade.jpg"
    imageAlt="A nighttime worship gathering"
  />
</RedesignLayout>

<style>
  /* Alternating video + text rows, generous space between them. */
  .films { display: flex; flex-direction: column; gap: clamp(72px, 9vw, 144px); margin-top: clamp(16px, 3vw, 40px); }
</style>
