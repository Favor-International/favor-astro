---
import RedesignLayout from '../../layouts/RedesignLayout.astro';
import PageHero from '../../components/band/PageHero.astro';
import AfricaMap from '../../components/global/AfricaMap.astro';
import ScriptBand from '../../components/redesign/ScriptBand.astro';
import LeafHeading from '../../components/redesign/LeafHeading.astro';
import RdCta from '../../components/redesign/RdCta.astro';
import VideoEmbed from '../../components/global/VideoEmbed.astro';

// Per Will (2026-06-18): we only speak publicly about our three main fields —
// Uganda, South Sudan, and Chad. Scale is framed as "14+ nations" with no
// salvation totals or PBS-location counts. Field films come from the Favor
// YouTube channel (@favorinternational). Country blurbs are intentionally
// general; swap for Favor's exact wording when available.
const fields = [
  {
    name: 'Uganda',
    focus: "Where Favor's work began, and home to the GIFT Institute and Favor FM radio.",
    videos: [
      { id: 'GqXzE7pd79M', title: 'Gospel Crusade in Yumbe', caption: 'A gospel crusade in northern Uganda.' },
      { id: 'OpM5UYTWIso', title: 'Favor Radio carries the Gospel', caption: 'Favor FM reaches remote listeners with the Gospel.' },
    ],
  },
  {
    name: 'South Sudan',
    focus: 'Church planting and trauma healing among communities affected by war.',
    videos: [
      { id: 'jKrmDKOGJ08', title: 'The City of Iron Sheets - Malakal', caption: 'Reaching the displaced in the city of Malakal.' },
      { id: 'Wf_OQ1hAMoI', title: 'From the streets to safety', caption: "Helping South Sudan's vulnerable girls find safety." },
    ],
  },
  {
    name: 'Chad',
    focus: 'Training and sending indigenous missionaries to reach unreached villages.',
    videos: [
      { id: 'q7J30TlLkWg', title: 'Pastors Buried Alive - Chad Martyrs', caption: 'The cost of following Christ in Chad.' },
      { id: 'uQSjKwxCqYk', title: 'Indigenous missionary training in Chad', caption: 'Training national missionaries to reach their own.' },
    ],
  },
];
---
<RedesignLayout
  title="Where We Work"
  description="Favor International's three main fields — Uganda, South Sudan, and Chad — and the indigenous-led work in each."
>
  <PageHero
    label="Where we work"
    title="East Africa, into the unreached."
    promise="Each field is led by indigenous leaders. US staff coordinate; the field directs."
    image="/images/ministry-church-planting.jpg"
    imageAlt="Planting a church in the Wedweil refugee camp"
    scrollCue
  />

  <AfricaMap
    showStats={false}
    note="Note: this map is a work in progress and is not yet a precise representation of where Favor International works."
  />

  <ScriptBand
    image="/images/hero-pastor-preaching.jpg"
    imageAlt="An indigenous pastor preaching to a crowd under an acacia tree"
    label="Into the unreached"
    phrase="Where others will not go."
    font="serif"
    objectPosition="center 35%"
  />

  <section class="band band--white">
    <div class="container">
      <LeafHeading
        title="Our three main fields"
        intro="Favor Partners fund work across 14+ nations. These three are our main fields today."
      />
      <div class="fields">
        {fields.map((c) => (
          <div class="field-country reveal">
            <div class="field-country__head">
              <h3>{c.name}</h3>
              <p>{c.focus}</p>
            </div>
            <div class="field-country__videos">
              {c.videos.map((v) => <VideoEmbed id={v.id} title={v.title} caption={v.caption} />)}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <RdCta
    heading="Pray for a specific country."
    body="The 30-day prayer guide walks you through each nation, one day at a time."
    ctaLabel="Get the 30-Day Guide"
    ctaHref="/pray/30-day-guide/"
    image="/images/story-anaka-crusade.jpg"
    imageAlt="A nighttime worship gathering"
  />
</RedesignLayout>

<style>
  /* Three main fields: a header per country, then its field films (large). */
  .fields { display: grid; gap: clamp(64px, 8vw, 112px); }
  .field-country__head { max-width: 62ch; margin: 0 auto clamp(28px, 3.6vw, 48px); text-align: center; }
  .field-country__head h3 { color: var(--color-green); font-size: var(--rd-fs-title); margin: 0 0 var(--space-3); }
  .field-country__head p { color: var(--color-ink-soft); font-size: var(--rd-fs-body); line-height: 1.6; margin: 0; }
  .field-country__videos {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(28px, 3.4vw, 52px);
  }
  /* Centered little description beneath each film. */
  .field-country__videos :global(.video-embed__cap) {
    text-align: center;
    margin-top: var(--space-4);
    font-size: var(--rd-fs-body);
    color: var(--color-ink-soft);
  }
  @media (max-width: 720px) { .field-country__videos { grid-template-columns: 1fr; gap: clamp(28px, 6vw, 40px); } }
</style>
