---
import RedesignLayout from '../../layouts/RedesignLayout.astro';
import PageHero from '../../components/band/PageHero.astro';
import RdFeature from '../../components/redesign/RdFeature.astro';
import LeafHeading from '../../components/redesign/LeafHeading.astro';
import SavannaBand from '../../components/redesign/SavannaBand.astro';
import NumberScroller from '../../components/redesign/NumberScroller.astro';
import SixRs from '../../components/redesign/SixRs.astro';
import RdCta from '../../components/redesign/RdCta.astro';
import { SITE, IMPACT_STATS } from '../../lib/site';

const impactReports = [
  { label: '2025 Q1 Report', url: 'https://cdn.prod.website-files.com/62cda51656823c14ac1caf02/67f8fb06a27063a36a26d893_Impact%20Report%202025.pdf' },
  { label: '2024 Annual Report', url: 'https://cdn.prod.website-files.com/62cda51656823c14ac1caf02/679e8757459b553c8139cd68_Annual%20Report%202024%20.pdf' },
  { label: '2024 Q3 Report', url: 'https://cdn.prod.website-files.com/62cda51656823c14ac1caf02/6712aa5698186f3c16b908b7_Favor%20Q3%20Impact%20Report%202024.pdf' },
  { label: '2024 Q2 Report', url: 'https://cdn.prod.website-files.com/62cda51656823c14ac1caf02/669678d504deb0d992ef5a58_Q2%202024%20Impact%20Report.pdf' },
  { label: '2024 Q1 Report', url: 'https://cdn.prod.website-files.com/62cda51656823c14ac1caf02/679e86c02439d38e1e5915f6_FAVOR%20Q1%20IMPACT%20REPORT%202024.pdf' },
  { label: '2023 Annual Report', url: 'https://cdn.prod.website-files.com/62cda51656823c14ac1caf02/679e8468daf348cccd1ebff7_Annual%20Impact%20Report%202023.pdf' },
  { label: '2023 Q3 Report', url: 'https://cdn.prod.website-files.com/62cda51656823c14ac1caf02/65397e8ad81200f382d3b2d1_Q3%20Impact%20Report%202023%20-%20V2.pdf' },
  { label: '2023 Q2 Report', url: 'https://cdn.prod.website-files.com/62cda51656823c14ac1caf02/65397e65c8de24acbce19141_8th%20Draft%20-%20Q2%20Impact%20Report%202023.pdf' },
  { label: '2023 Q1 Report', url: 'https://cdn.prod.website-files.com/62cda51656823c14ac1caf02/646fb51c44f4f022ea4f8359_Q1%20Impact%20Report%202023%20FINAL.pdf' },
  { label: '2022 Annual Report', url: 'https://cdn.prod.website-files.com/62cda51656823c14ac1caf02/647e51a33462782bd45eda60_Annual%20Report%20Final%20-%202022.pdf' },
  { label: '2022 Q3 Report', url: 'https://cdn.prod.website-files.com/62cda51656823c14ac1caf02/64542c2a1a2f50cc3f9886ca_Q3%20REPORT%20Draft%20Five.pdf' },
  { label: '2022 Q2 Report', url: 'https://cdn.prod.website-files.com/62cda51656823c14ac1caf02/64542bd0101e245f20073754_MAILOUT%20-%20Q2%20Impact%20Report%20Summary%20FINAL%20wCROP%20(1).pdf' },
  { label: '2022 Q1 Report', url: 'https://cdn.prod.website-files.com/62cda51656823c14ac1caf02/6454299e694e0e1eb22af91b_Impact%20Report%20Quarter%20One.pdf' },
  { label: '2021 Annual Report', url: 'https://cdn.prod.website-files.com/62cda51656823c14ac1caf02/647e4e462c127232051125fa_2021%20annual%20report.pdf' },
  { label: '2020 Annual Report', url: 'https://cdn.prod.website-files.com/62cda51656823c14ac1caf02/647e52962c1272320515fd25_2020%20Annual%20Report.pdf' },
];
const form990s = [
  { label: '2024 Form 990', url: 'https://cdn.prod.website-files.com/62cda51656823c41dd1caeeb/6825484c388346ab982d5f46_Favor%202024%20Form%20990.pdf' },
  { label: '2023 Form 990', url: 'https://cdn.prod.website-files.com/62cda51656823c41dd1caeeb/672a9c1581eff2daa4f208d1_Favor%20International%202023%20Form%20990%20Final.pdf' },
  { label: '2022 Form 990', url: 'https://cdn.prod.website-files.com/62cda51656823c41dd1caeeb/64c509c8ef257386b3c251ab_Favor%202022%20Form%20990.pdf' },
  { label: '2021 Form 990', url: 'https://cdn.prod.website-files.com/62cda51656823c41dd1caeeb/642b4c63d932d73e6fc3f5c5_990%202021%20Final.pdf' },
  { label: '2020 Form 990', url: 'https://cdn.prod.website-files.com/62cda51656823c41dd1caeeb/64aed0169ebfb17d7c02bc73_Copy%20of%20Favor%20PUBLIC%20Federal%20Tax%20Form%20990%202020%20final%20(1).pdf' },
];
const audits = [
  { label: '2024 Audited Financials', url: 'https://cdn.prod.website-files.com/62cda51656823c41dd1caeeb/6825484c23dbe25d0e658940_Favor%202024%20Audited%20Fiancial%20Statements.pdf' },
  { label: '2023 Audited Financials', url: 'https://cdn.prod.website-files.com/62cda51656823c41dd1caeeb/672bdc8c698a012b9e25527c_FINAL%20audit%20-%20Favor%202023.pdf' },
  { label: '2022 Audited Financials', url: 'https://cdn.prod.website-files.com/62cda51656823c41dd1caeeb/64a2f854c1475cfd3aa52438_Favor%20Intl%20-%202022%20audit%20-%20FINAL.pdf' },
  { label: '2021 Audited Financials', url: 'https://cdn.prod.website-files.com/62cda51656823c41dd1caeeb/642b4c63b08ad1197cb8bbc6_2021%20US%20Favor%20Intl%20Audit.pdf' },
  { label: '2020 Audited Financials', url: 'https://cdn.prod.website-files.com/62cda51656823c41dd1caeeb/64aed008527fc7445992037b_Favor%20-%202020%20audit.pdf' },
];
const irsLetter = 'https://cdn.prod.website-files.com/62cda51656823c41dd1caeeb/65562b9562e1a1a1d733b585_IRS%20determination%20letter%20updated%20address.pdf';

const allFinancials = [{ label: 'IRS 2023 Determination Letter', url: irsLetter }, ...form990s, ...audits];
---
<RedesignLayout
  title="Accountability and Financials"
  description="ECFA accreditation, 990s, audited financials, and the public profiles of Favor International."
>
  <PageHero waveColor="cream"
    label="Accountability"
    title="Audited every year. Publicly profiled."
    promise="Audited, filed, and published. See the numbers for yourself."
    image="/images/hero-bibles-stacks.jpg"
    imageAlt="Stacks of Bibles ready for field distribution"
  />

  <RdFeature
    image="/images/field-2026/prayer-6.webp"
    imageAlt="A Favor prayer gathering in the field"
    eyebrow="Financials"
    side="right"
    background="cream"
  >
    <blockquote class="steward__verse">
      "Moreover it is required in stewards that one be found faithful."
      <cite>1 Corinthians 4:2, NKJV</cite>
    </blockquote>
    <p class="steward__body">We strive to be faithful stewards of the gifts entrusted to us. Scriptural standards are the means by which we make ourselves accountable to you, those we serve, and most of all to God. We are committed to wise stewardship and to efficiently making the greatest impact while advancing the kingdom of God. We focus on transformational change and self-sustenance that have a multiplying and long lasting effect. As you partner, we as the steward of your donation stand committed to bear much fruit because of your sacred trust. We have a responsibility to maintain integrity and transparency in our financial practice. If you have any questions regarding our finances, please email <a href="mailto:accounting@favourafrica.org">accounting@favourafrica.org</a>.</p>
  </RdFeature>

  <NumberScroller
    label="Audited financials"
    heading="The numbers behind the work."
    stats={IMPACT_STATS}
  />

  <section class="band band--white band--tight">
    <div class="container">
      <p class="acct-lede">Every number above is sourced from Favor's FY2024 audited financials, filed with ECFA and IRS Form 990. No estimates. No projections.</p>
      <div class="acct-badges">
        <a href={SITE.trust.ecfa} target="_blank" rel="noopener" aria-label="ECFA Accredited"><img src="/images/trust/ecfa.png" alt="ECFA Accredited" width="92" height="92" /></a>
        <a href={SITE.trust.charityNavigator} target="_blank" rel="noopener" aria-label="Charity Navigator Four-Star"><img src="/images/trust/charity-navigator.svg" alt="Charity Navigator Four-Star" width="92" height="92" /></a>
        <a href={SITE.trust.candid} target="_blank" rel="noopener" aria-label="Candid Platinum"><img src="/images/trust/candid-platinum.svg" alt="Candid Platinum Transparency" width="92" height="92" /></a>
      </div>
    </div>
  </section>

  <RdFeature
    image="/images/hero-congo-grads.jpg"
    imageAlt="Graduates celebrating in DR Congo"
    eyebrow="Stewardship"
    heading="What we promise."
    side="right"
  >
    <p><strong>89 cents of every dollar went to program in FY2024.</strong> The remainder covers U.S. operations, audit, and donor care. (Source: ECFA-filed audited financials.)</p>
    <p>Restricted gifts honor the restriction. We will refund a restricted gift before we redirect one.</p>
    <p>Field-level reporting on every project. We tell you what worked and what didn't.</p>
    <p>No anonymous outcomes. Every story we publish has a real name, a real place, and a real outcome.</p>
  </RdFeature>

  <section class="six-rs" style="background-image:url('/images/six-rs-community.jpg')" aria-label="The 6 R's, over a photo of the people Favor serves">
    <div class="container">
      <SixRs />
    </div>
  </section>

  <div class="rd-spacer" aria-hidden="true"></div>

  <SavannaBand image="/images/savanna-silhouette.png" imageAlt="An African savanna silhouette: acacia trees, elephants, and a giraffe">
    <div class="exp">
      <LeafHeading label="Expenses accountability" title="Where 2024 went." leaves={false} />
      <div class="exp-breakdown">
        <div class="exp-row exp-row--program">
          <span class="exp-pct">89.3%</span>
          <div class="exp-detail">
            <span class="exp-cat">Program</span>
            <span class="exp-amt">$6,671,668</span>
          </div>
        </div>
        <div class="exp-row">
          <span class="exp-pct">6.2%</span>
          <div class="exp-detail">
            <span class="exp-cat">General</span>
            <span class="exp-amt">$464,178</span>
          </div>
        </div>
        <div class="exp-row">
          <span class="exp-pct">4.5%</span>
          <div class="exp-detail">
            <span class="exp-cat">Fundraising</span>
            <span class="exp-amt">$341,235</span>
          </div>
        </div>
        <div class="exp-bar" aria-hidden="true">
          <span class="exp-bar__seg exp-bar__seg--program" style="width:89.3%"></span>
          <span class="exp-bar__seg exp-bar__seg--general" style="width:6.2%"></span>
          <span class="exp-bar__seg exp-bar__seg--fundraising" style="width:4.5%"></span>
        </div>
      </div>
    </div>
  </SavannaBand>

  <section class="band savanna-ground">
    <div class="container container--narrow">
      <div class="ground-statement ground-statement--prose">
        <p>We take great pride in our financial efficiency, maximizing every dollar we receive. We use the great multiplier effect (GME) to get the best outcome.</p>
        <p>The GME is our way of developing, training, and empowering indigenous faith leaders. These leaders in turn transform their villages and communities. There is no limit to what they can do.</p>
      </div>
    </div>
  </section>

  <section class="band band--cream">
    <div class="container">
      <LeafHeading
        label="Reports"
        title="Impact reports."
        intro="Quarterly and annual reports from the field, published since 2020."
        leaves={false}
      />
      <div class="doc-grid">
        {impactReports.map((r) => (
          <a class="doc-card" href={r.url} target="_blank" rel="noopener">
            <svg class="doc-card__icon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6Zm0 2 4 4h-4V4ZM8 13h8v2H8v-2Zm0 4h6v2H8v-2Z"/></svg>
            <span>{r.label}</span>
          </a>
        ))}
      </div>

      <h2 class="acct-financials-title">Form 990s and audited financials.</h2>
      <p class="acct-sub">Five years of each, plus our IRS determination letter.</p>
      <div class="doc-grid">
        {allFinancials.map((r) => (
          <a class="doc-card" href={r.url} target="_blank" rel="noopener">
            <svg class="doc-card__icon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6Zm0 2 4 4h-4V4ZM8 13h8v2H8v-2Zm0 4h6v2H8v-2Z"/></svg>
            <span>{r.label}</span>
          </a>
        ))}
      </div>
      <p class="acct-ein">EIN {SITE.ein} &middot; 501(c)(3) public charity &middot; ECFA-accredited since September 30, 2019.</p>
    </div>
  </section>

  <section class="band band--cream band--tight">
    <div class="container">
      <div class="acct-quote-wrap">
        <blockquote class="acct-quote">
          "God will not be mocked. Those who sow the Kingdom will reap the Kingdom."
          <cite>Carole Ward</cite>
        </blockquote>
      </div>
    </div>
  </section>

  <RdCta
    heading="Need anything else for due diligence?"
    body={`Email ${SITE.emailGeneral} and we will send the financial packet within one business day.`}
    ctaLabel="Request the financial packet"
    ctaHref={`mailto:${SITE.emailGeneral}?subject=Financial packet request`}
    background="cream"
    image="/images/hero-congo-grads.jpg"
    imageAlt="Graduates celebrating in DR Congo"
  />
</RedesignLayout>

<style>
  .acct-lede { text-align: center; max-width: 58ch; margin: 0 auto; color: var(--color-ink-soft); line-height: 1.75; }
  .acct-badges { display: flex; justify-content: center; align-items: center; gap: clamp(var(--space-8), 8vw, var(--space-20)); margin-top: clamp(48px, 6vw, 72px); flex-wrap: wrap; }
  .acct-badges img { height: 92px; width: auto; transition: transform 160ms; }
  .acct-badges a:hover img { transform: translateY(-3px); }

  .acct-sub { color: var(--color-ink-soft); margin: var(--space-3) 0 0; text-align: center; }
  .acct-financials-title { margin-top: clamp(72px, 9vw, 120px); text-align: center; }
  .doc-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-4); margin-top: clamp(48px, 6vw, 64px); }
  @media (max-width: 720px) { .doc-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 460px) { .doc-grid { grid-template-columns: 1fr; } }
  /* Slight, transparent border so each report reads as its own item
     (Daniel's rule: a clear edge beats a big blurry shadow). */
  .doc-card {
    display: flex; align-items: center; gap: var(--space-3);
    padding: var(--space-5) var(--space-6);
    background: var(--color-white);
    border: 1px solid rgba(31, 58, 26, 0.12);
    border-radius: var(--radius-card);
    box-shadow: 0 2px 10px rgba(31, 58, 26, 0.05);
    text-decoration: none; color: var(--color-green); font-weight: 600; font-size: var(--rd-fs-body);
    transition: transform 140ms, border-color 140ms, box-shadow 140ms;
  }
  .doc-card:hover { transform: translateY(-2px); border-color: var(--color-gold); box-shadow: 0 6px 18px rgba(31, 58, 26, 0.09); }
  .doc-card__icon { flex: 0 0 auto; color: var(--color-gold-deep); }
  .acct-ein { margin-top: clamp(56px, 7vw, 80px); font-size: var(--rd-fs-small); color: var(--color-sage); text-align: center; }

  /* Stewardship intro (verbatim from live: 1 Cor 4:2 + finance statement) */
  .steward__verse { margin: 0 0 var(--space-8); border: 0; padding: 0; font-family: var(--font-serif, Georgia, serif); font-style: italic; font-size: var(--rd-fs-title); line-height: 1.35; color: var(--color-green-deep); }
  .steward__verse cite { display: block; margin-top: var(--space-4); font-style: normal; font-size: var(--rd-fs-small); font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-gold-deep); }
  .steward__body { margin: 0; color: var(--color-ink-soft); line-height: 1.8; }
  .steward__body a { color: var(--color-green-deep); font-weight: 600; }

  /* 2024 Expenses breakdown (verbatim figures from live): typographic rows +
     one stacked bar, centered. The GME copy moved to the ground band below. */
  .exp-breakdown { max-width: 560px; margin-inline: auto; }
  .exp-row {
    display: flex;
    align-items: baseline;
    gap: var(--space-6);
    padding: var(--space-6) 0;
    border-bottom: 1px solid rgba(31, 58, 26, 0.10);
  }
  .exp-row:first-child { padding-top: 0; }
  .exp-pct {
    flex: 0 0 150px;
    font-family: var(--font-sans);
    font-weight: 800;
    font-size: var(--rd-fs-title);
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--color-ink-soft);
  }
  .exp-row--program .exp-pct { color: var(--color-green-deep); }
  .exp-detail { display: flex; flex-direction: column; gap: var(--space-1); }
  .exp-cat { font-size: var(--rd-fs-small); font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-gold-deep); }
  .exp-amt { font-weight: 700; color: var(--color-ink); }
  .exp-bar {
    display: flex;
    height: 12px;
    border-radius: var(--radius-pill);
    overflow: hidden;
    margin-top: var(--space-8);
  }
  .exp-bar__seg--program { background: var(--color-green); }
  .exp-bar__seg--general { background: var(--color-gold); }
  .exp-bar__seg--fundraising { background: var(--color-tan); }

  /* Carole Ward pull-quote: a quiet white moment on the cream band. */
  .acct-quote-wrap {
    background: var(--color-white);
    border: 1px solid rgba(31, 58, 26, 0.08);
    border-radius: calc(var(--rd-radius) + 8px);
    box-shadow: 0 2px 10px rgba(31, 58, 26, 0.04);
    padding: clamp(56px, 8vw, 104px) clamp(24px, 6vw, 96px);
    text-align: center;
  }
  .acct-quote { margin: 0 auto; max-width: 800px; border: 0; padding: 0; font-family: var(--font-serif, Georgia, serif); font-style: italic; font-size: var(--rd-fs-title); line-height: 1.4; color: var(--color-green-deep); }
  .acct-quote cite { display: block; margin-top: var(--space-5); font-style: normal; font-size: var(--rd-fs-small); font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-gold-deep); }
</style>
