  .dform__hint { margin: 0 0 var(--space-5); color: var(--color-ink-soft); line-height: 1.6; font-size: 0.95rem; }

  /* The single field on a step is large enough to be the obvious target. */
  .dform__solo {
    width: 100%;
    padding: 18px 20px;
