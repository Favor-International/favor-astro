  .dform__freq-line { text-align: center; color: var(--color-ink-soft); font-size: 0.92rem; margin: var(--space-3) 0 var(--space-5); }

  .dform__amounts { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-3); margin-bottom: var(--space-3); }
  @media (max-width: 540px) { .dform__amounts { grid-template-columns: repeat(2, 1fr); } }
  .dform__amount { font: inherit; font-weight: 800; font-size: 1.05rem; color: var(--color-green); background: var(--color-white); border: 2px solid var(--color-border); border-radius: var(--radius-input); padding: 16px 8px; cursor: pointer; transition: border-color 140ms, background 140ms, color 140ms, transform 140ms; }
  .dform__amount span { font-size: 0.75em; font-weight: 700; color: var(--color-sage); }
  .dform__amount:hover { border-color: var(--color-gold); transform: translateY(-1px); }
