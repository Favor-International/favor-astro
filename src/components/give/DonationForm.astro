  .dform__amount[aria-pressed='true'] span { color: var(--color-gold); }

  .dform__custom { display: flex; align-items: center; gap: var(--space-2); border: 2px solid var(--color-border); border-radius: var(--radius-input); padding: 4px 4px 4px var(--space-4); background: var(--color-white); margin-bottom: var(--space-4); transition: border-color 140ms; }
  .dform__custom:focus-within { border-color: var(--color-gold); }
  .dform__sym { color: var(--color-sage); font-weight: 700; }
  .dform__custom input { flex: 1; min-width: 0; border: 0; outline: 0; font: inherit; font-size: 1.15rem; font-weight: 800; color: var(--color-green-deep); padding: 13px 0; background: transparent; -moz-appearance: textfield; }
  .dform__custom input::-webkit-outer-spin-button, .dform__custom input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
  .dform__per { color: var(--color-sage); font-weight: 700; padding-right: var(--space-3); }

  .dform__grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-3); }
  @media (max-width: 540px) { .dform__grid { grid-template-columns: 1fr; } }
  .dform__field { display: block; margin-bottom: var(--space-3); }
  .dform__field span { display: block; font-size: 0.85rem; font-weight: 700; color: var(--color-green-deep); margin-bottom: 6px; }
  .dform__req { color: var(--color-gold-deep); font-style: normal; }
  .dform__field input, .dform__field select, .dform__field textarea {
    width: 100%; box-sizing: border-box; font: inherit; padding: 13px 14px;
    border: 1.5px solid var(--color-border); border-radius: var(--radius-input);
    background: var(--color-white); color: var(--color-ink); transition: border-color 140ms;
  }
  .dform__field input:focus-visible, .dform__field select:focus-visible, .dform__field textarea:focus-visible { outline: none; border-color: var(--color-gold); box-shadow: 0 0 0 3px rgba(225, 167, 48, 0.18); }


  /* Everything optional collapses into one closed row. Closed by default, so
     the default path is three fields and a button. */
  .dform__check { display: flex; gap: 10px; align-items: flex-start; cursor: pointer; font-size: 0.95rem; margin: 6px 0; }
  .dform__check input { margin-top: 3px; width: 17px; height: 17px; accent-color: var(--color-green); flex-shrink: 0; }
