---
// The canonical Blackbaud-integrated donation form (docs/03-design
// component-library: DonationForm). Three steps, no framework, one island
// script. Card capture happens inside Blackbaud Checkout (PCI stays with
// Blackbaud); our Pages Functions charge the authorization and record the
// gift in Raiser's Edge NXT.
//
// Deep links: ?frequency=once|monthly & amount=100 & designation=<fund_id>
// Same-page embeds (partner-monthly, one-time) can drive it through the
// `favor:give-intent` CustomEvent (see DonationBlock's inlineTarget).
import { SITE } from '../../lib/site';

export interface Props {
  /** Monthly is the lead path site-wide; pages can override. */
  defaultFrequency?: 'once' | 'monthly';
}
const { defaultFrequency = 'monthly' } = Astro.props as Props;

const ONE_TIME_PRESETS = [50, 100, 250, 500, 1000, 2500];
const MONTHLY_PRESETS = [25, 50, 100, 200, 500, 1200];
---

<div class="dform" id="donation-form" data-ready="false" data-default-frequency={defaultFrequency}>
  <!-- Loading -->
  <div class="dform__state dform__loading" data-panel="loading">
    <p>Loading secure giving&hellip;</p>
  </div>

  <!-- Fallback when the Blackbaud connection is not configured yet -->
  <div class="dform__state dform__fallback" data-panel="fallback" hidden>
    <h2>Give today, another way.</h2>
    <p>
      Online card giving is briefly offline. Your gift still reaches the field today through any of
      these routes:
    </p>
    <ul>
      <li><strong>Check:</strong> payable to Favor Intl., {SITE.mailing}</li>
      <li><strong>Zelle:</strong> admin@favorintl.org</li>
      <li><strong>CashApp:</strong> $FavorInternational</li>
      <li><strong>Stock, DAF, or wire:</strong> <a href="/give/non-cash/">non-cash giving</a></li>
    </ul>
    <p>Questions? Email <a href={`mailto:${SITE.emailGeneral}`}>{SITE.emailGeneral}</a>.</p>
  </div>

  <!-- The form -->
  <form class="dform__form" data-panel="form" hidden novalidate>
    <!-- Survey-style flow: one question per screen. A slim bar replaces the
         named dots, because the step count now varies (the monthly upsell only
         appears for one-time gifts). -->
    <div class="dform__progress">
      <div class="dform__progress-track"><span data-progress-fill></span></div>
      <p class="dform__progress-text">Step <span data-step-now>1</span> of <span data-step-total>4</span></p>
    </div>

    <!-- Hidden mirrors of the parsed name. Everything downstream (checkout,
         constituent match, receipt) still reads first/last, so the parsing
         stays contained to this component. -->
    <input type="hidden" name="first" />
    <input type="hidden" name="last" />

    <!-- STEP: amount + frequency -->
    <fieldset class="dform__step" data-step="amount">
      <legend class="sr-only">Gift amount and frequency</legend>

      <div class="dform__freq" role="radiogroup" aria-label="Frequency">
        <label class="dform__freq-opt">
          <input type="radio" name="frequency" value="monthly" />
          <span>Monthly <em class="dform__freq-badge">Favor Partner</em></span>
        </label>
        <label class="dform__freq-opt">
          <input type="radio" name="frequency" value="once" />
          <span>Give once</span>
        </label>
      </div>
      <p class="dform__freq-line" data-freq-line>Monthly partnership keeps indigenous missionaries on the trail every single month.</p>

      <div class="dform__amounts" data-presets-once role="group" aria-label="One-time amounts" hidden>
        {ONE_TIME_PRESETS.map((a) => (
          <button type="button" class="dform__amount" data-amount={a}>${a.toLocaleString()}</button>
        ))}
      </div>
      <div class="dform__amounts" data-presets-monthly role="group" aria-label="Monthly amounts" hidden>
        {MONTHLY_PRESETS.map((a) => (
          <button type="button" class="dform__amount" data-amount={a}>${a.toLocaleString()}<span>/mo</span></button>
        ))}
      </div>

      <div class="dform__custom">
        <span class="dform__sym">$</span>
        <input
          type="number"
          inputmode="decimal"
          min="1"
          max="250000"
          step="1"
          name="amount"
          aria-label="Gift amount in US dollars"
          placeholder="Other amount"
        />
        <span class="dform__per" data-per hidden>/month</span>
      </div>

      <label class="dform__field dform__designation" data-designation-wrap hidden>
        <span>Designate your gift</span>
        <select name="designation"></select>
      </label>

      <p class="dform__error" data-error="amount" role="alert" hidden></p>
      <div class="dform__nav dform__nav--single">
        <button type="button" class="btn btn--primary btn--large" data-next>Continue</button>
      </div>
    </fieldset>

    <!-- STEP: monthly upsell. Only reached when the gift is one-time. -->
    <fieldset class="dform__step" data-step="upsell" hidden>
      <legend class="sr-only">Consider monthly partnership</legend>
      <p class="dform__q">Would you make it monthly instead?</p>
      <p class="dform__hint">
        Monthly partners are what let field leaders send a missionary the week a village opens,
        instead of waiting on the next appeal. Cancel anytime.
      </p>
      <div class="dform__choices">
        <button type="button" class="btn btn--primary btn--large" data-upsell-yes>
          Yes, give <span data-upsell-amt></span> monthly
        </button>
        <button type="button" class="dform__ghost" data-upsell-no>No, keep my one-time gift</button>
      </div>
    </fieldset>

    <!-- STEP: name, one field, split into first/last on continue. -->
    <fieldset class="dform__step" data-step="name" hidden>
      <legend class="sr-only">Your name</legend>
      <label class="dform__q" for="dform-name">What is your name?</label>
      <input class="dform__solo" id="dform-name" type="text" name="fullname" autocomplete="name" maxlength="150" placeholder="First and last name" />
      <p class="dform__hint">So we know who to thank, and who to make the receipt out to.</p>
      <p class="dform__error" data-error="name" role="alert" hidden></p>
      <div class="dform__nav">
        <button type="button" class="dform__back" data-back>&larr; Back</button>
        <button type="button" class="btn btn--primary btn--large" data-next>Continue</button>
      </div>
    </fieldset>

    <!-- STEP: email. The updates opt-in is asked right here, in context. -->
    <fieldset class="dform__step" data-step="email" hidden>
      <legend class="sr-only">Your email</legend>
      <label class="dform__q" for="dform-email">Where should we send your receipt?</label>
      <input class="dform__solo" id="dform-email" type="email" name="email" autocomplete="email" maxlength="254" placeholder="you@example.com" />
      <label class="dform__check dform__check--inline">
        <input type="checkbox" name="email_optin" checked />
        <span>Send me stories and updates from the field too</span>
      </label>
      <p class="dform__error" data-error="email" role="alert" hidden></p>
      <div class="dform__nav">
        <button type="button" class="dform__back" data-back>&larr; Back</button>
        <button type="button" class="btn btn--primary btn--large" data-next>Continue</button>
      </div>
    </fieldset>

    <!-- STEP: phone, optional and skippable. The SMS box appears only once a
         number is typed, so the question is asked in context. Typing a number
         is deliberately NOT treated as consent: US TCPA requires express
         written consent for marketing texts, so inferring it from a phone
         field would expose Favor to per-message statutory damages. -->
    <fieldset class="dform__step" data-step="phone" hidden>
      <legend class="sr-only">Your phone number</legend>
      <label class="dform__q" for="dform-phone">
        Add a phone number? <span class="dform__optional">Optional</span>
      </label>

      <!-- The ask happens inside the field. Once the number is complete it
           fades and the same box asks about texts, so nothing new appears on
           the page and the step never grows. -->
      <div class="dform__phonewrap">
        <input
          class="dform__solo"
          id="dform-phone"
          type="tel"
          inputmode="tel"
          autocomplete="tel"
          name="phone"
          maxlength="25"
        />
        <div class="dform__inlineask" data-inline-ask hidden>
          <span class="dform__inlineask-q">Text me field updates?</span>
          <span class="dform__inlineask-btns">
            <button type="button" data-sms-yes>Yes</button>
            <button type="button" data-sms-no>No</button>
          </span>
        </div>
      </div>
      <p class="dform__microhint" data-sms-fineprint>
        A few texts a year. Reply STOP to opt out. Message and data rates may apply.
      </p>

      <!-- Carries the answer into the gift record. Never shown; the Yes/No
           buttons above are the actual control, so consent stays explicit. -->
      <input type="checkbox" name="sms_optin" hidden />

      <details class="dform__more">
        <summary>Add a note, or give anonymously</summary>
        <div class="dform__more-body">
          <label class="dform__field"><span>Note or dedication</span>
            <textarea name="note" rows="2" maxlength="400"></textarea>
          </label>
          <label class="dform__check">
            <input type="checkbox" name="anonymous" />
            <span>Keep my gift anonymous</span>
          </label>
        </div>
      </details>

      <div class="dform__turnstile" data-turnstile></div>

      <p class="dform__disclosure" data-disclosure hidden>
        You authorize Favor International to charge this card monthly until you cancel. Cancel
        anytime by emailing <a href={`mailto:${SITE.emailGeneral}`}>{SITE.emailGeneral}</a>.
      </p>

      <p class="dform__error" data-error="phone" role="alert" hidden></p>
      <div class="dform__nav">
        <button type="button" class="dform__back" data-back>&larr; Back</button>
        <button type="button" class="dform__pay btn btn--primary btn--large" data-pay>
          <span data-pay-label>Continue to card</span>
        </button>
      </div>
      <p class="dform__secure">
        Your card opens in Blackbaud secure checkout, and your gift is complete when you pay
        there. Favor never sees or stores your card number.
      </p>
    </fieldset>

    <!-- Fee prompt. A dialog over a scrim, deliberately shaped like the card
         window that follows it, so the last two screens of the gift feel like
         the same moment rather than two more survey steps. -->
    <div class="dform__modal" data-modal="fee" hidden>
      <div class="dform__modal-scrim" data-fee-dismiss></div>
      <div class="dform__modal-card" role="dialog" aria-modal="true" aria-labelledby="dform-fee-title">
        <p class="dform__modal-title" id="dform-fee-title">Add <span data-fee-amt></span> to cover processing?</p>
        <p class="dform__modal-body">
          Card processing takes <span data-fee-amt2></span> out of your gift. Cover it and the full
          <strong data-gift-amt></strong> reaches the field.
        </p>
        <div class="dform__modal-actions">
          <button type="button" class="btn btn--primary btn--large" data-fee-yes>
            Yes, add <span data-fee-amt3></span>
          </button>
          <button type="button" class="dform__yesno-no" data-fee-no>No thanks</button>
        </div>
        <p class="dform__error" data-error="fee" role="alert" hidden></p>
        <p class="dform__modal-foot">Your card opens next, in Blackbaud&rsquo;s secure window.</p>
      </div>
    </div>

    <!-- Processing overlay -->
    <div class="dform__processing" data-panel="processing" hidden aria-live="polite">
      <span class="dform__spinner" aria-hidden="true"></span>
      <p><strong>Completing your gift&hellip;</strong></p>
      <p>Keep this page open. This takes a few seconds.</p>
    </div>
  </form>
</div>

<script>
  type Designation = { fund_id: string; label: string };
  type GiveConfig = {
    connected: boolean;
    setup_incomplete?: boolean;
    public_key?: string;
    payment_configuration_id?: string;
    process_mode?: string;
    designations?: Designation[];
    fee_rate?: number;
    fee_fixed?: number;
    turnstile_site_key?: string | null;
  };

  declare global {
    interface Window {
      Blackbaud_OpenPaymentForm?: (data: Record<string, unknown>) => void;
      turnstile?: {
        render: (el: Element, opts: Record<string, unknown>) => string;
        reset: (id?: string) => void;
        getResponse: (id?: string) => string | undefined;
      };
    }
  }

  const money = (n: number) =>
    n.toLocaleString('en-US', { style: 'currency', currency: 'USD', minimumFractionDigits: n % 1 ? 2 : 0 });

  // Blackbaud Checkout dispatches document-level events. Register exactly one
  // pair of listeners per page load and delegate to the active form instance,
  // so client-side navigation can never stack handlers (stacked handlers
  // would mean duplicate gift submissions).
  type CheckoutHandlers = {
    onComplete: (transactionToken: string) => void;
    onError: (message: string) => void;
  };
  let activeCheckout: CheckoutHandlers | null = null;
  document.addEventListener('checkoutComplete', (e) => {
    const detail = (e as CustomEvent).detail as { transactionToken?: string } | undefined;
    if (detail?.transactionToken) activeCheckout?.onComplete(detail.transactionToken);
    else activeCheckout?.onError('Checkout finished without a transaction token. Your card was not charged; please try again.');
  });
  document.addEventListener('checkoutError', (e) => {
    const detail = (e as CustomEvent).detail as { errorText?: string } | undefined;
    activeCheckout?.onError(detail?.errorText || 'The payment could not be processed. Nothing was charged; please try again.');
  });

  function initDonationForm() {
    const root = document.getElementById('donation-form');
    if (!root || root.dataset.ready === 'true') return;
    root.dataset.ready = 'true';

    const q = <T extends Element = HTMLElement>(sel: string) => root.querySelector(sel) as T | null;
    const qa = <T extends Element = HTMLElement>(sel: string) => Array.from(root.querySelectorAll(sel)) as T[];

    const panels = {
      loading: q('[data-panel="loading"]')!,
      fallback: q('[data-panel="fallback"]')!,
      form: q<HTMLFormElement>('[data-panel="form"]')!,
      processing: q('[data-panel="processing"]')!,
    };
    const showPanel = (name: keyof typeof panels) => {
      panels.loading.hidden = name !== 'loading';
      panels.fallback.hidden = name !== 'fallback';
      panels.form.hidden = name !== 'form' && name !== 'processing';
      panels.processing.hidden = name !== 'processing';
      if (name === 'processing') qa<HTMLFieldSetElement>('.dform__step').forEach((s) => (s.hidden = true));
      // Tell the surrounding page that card giving is unavailable, so a hero
      // promising "finish in secure checkout in under a minute" can swap itself
      // out instead of contradicting the panel right below it.
      document.documentElement.toggleAttribute('data-give-offline', name === 'fallback');
    };

    let config: GiveConfig | null = null;
    let idempotencyKey: string | null = null;
    let checkoutToken: string | null = null;
    let cardToken: string | null = null;
    let turnstileWidget: string | undefined;
    let turnstileRendered = false;
    let submitting = false;

    const params = new URLSearchParams(location.search);

    // ---- state readers -----------------------------------------------------
    const form = panels.form;
    const freq = () =>
      (form.querySelector('input[name="frequency"]:checked') as HTMLInputElement)?.value === 'once'
        ? 'once'
        : 'monthly';
    const setFreq = (value: 'once' | 'monthly') => {
      const el = form.querySelector(`input[name="frequency"][value="${value}"]`) as HTMLInputElement | null;
      if (el) el.checked = true;
    };
    const amountInput = q<HTMLInputElement>('input[name="amount"]')!;
    const amount = () => Math.round((Number(amountInput.value) || 0) * 100) / 100;
    const designationSelect = q<HTMLSelectElement>('select[name="designation"]')!;
    const checkbox = (name: string) => (form.querySelector(`input[name="${name}"]`) as HTMLInputElement | null)?.checked ?? false;
    const field = (name: string) => (form.querySelector(`[name="${name}"]`) as HTMLInputElement)?.value.trim() ?? '';

    let feeCovered = false;
    const total = () => {
      const a = amount();
      if (!config || !feeCovered) return a;
      const rate = config.fee_rate ?? 0.029;
      const fixed = config.fee_fixed ?? 0.3;
      return Math.round((a + a * rate + fixed) * 100) / 100;
    };

    // ---- step machine ------------------------------------------------------
    // One question per screen. The order is computed, not fixed, because the
    // monthly upsell only exists for one-time gifts.
    type StepId = 'amount' | 'upsell' | 'name' | 'email' | 'phone';
    const stepOrder = (): StepId[] =>
      freq() === 'once' ? ['amount', 'upsell', 'name', 'email', 'phone'] : ['amount', 'name', 'email', 'phone'];
    let current: StepId = 'amount';

    const showError = (id: string, msg: string) => {
      const el = q(`[data-error="${id}"]`);
      if (!el) return;
      el.textContent = msg;
      el.hidden = !msg;
      if (msg) {
        const r = el.getBoundingClientRect();
        if (r.top < 0 || r.bottom > innerHeight) el.scrollIntoView({ block: 'center', behavior: 'auto' });
      }
    };
    const clearErrors = () => qa('[data-error]').forEach((el) => { el.textContent = ''; el.hidden = true; });

    const alignCardTop = () => {
      const r = root.getBoundingClientRect();
      if (r.top < 0) window.scrollTo({ top: window.scrollY + r.top - 96, behavior: 'auto' });
    };

    // Split a typed name into the first/last pair everything downstream needs.
    // Last token is the surname so "Ana Maria Diaz" keeps "Diaz"; a single
    // token is rejected, because Blackbaud needs both for the receipt.
    const applyName = (): boolean => {
      const parts = field('fullname').split(/\s+/).filter(Boolean);
      if (parts.length < 2) {
        showError('name', 'Please enter your first and last name, so the receipt is correct.');
        return false;
      }
      const first = q<HTMLInputElement>('input[name="first"]')!;
      const last = q<HTMLInputElement>('input[name="last"]')!;
      first.value = parts[0];
      last.value = parts.slice(1).join(' ');
      showError('name', '');
      return true;
    };

    const validate = (step: StepId): boolean => {
      if (step === 'amount') {
        if (!(amount() >= 1)) { showError('amount', 'Choose or enter a gift amount of at least $1.'); return false; }
        if (amount() > 250000) { showError('amount', 'For gifts over $250,000, email info@favorintl.org and we will handle it personally.'); return false; }
        showError('amount', '');
        return true;
      }
      if (step === 'name') return applyName();
      if (step === 'email') {
        if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(field('email'))) {
          showError('email', 'A valid email is required so your tax receipt can reach you.');
          return false;
        }
        showError('email', '');
        return true;
      }
      return true;
    };

    const showStep = (step: StepId) => {
      qa<HTMLElement>('.dform__step').forEach((s) => (s.hidden = s.dataset.step !== step));
      {
        current = step;
        // Leaving the last step invalidates a pending authorization, so a
        // stale one is never resubmitted after the amount or details change.
        checkoutToken = null;
        idempotencyKey = null;
      }
      const order = stepOrder();
      const idx = order.indexOf(step);
      const total = order.length;
      q('[data-step-now]')!.textContent = String(idx + 1);
      q('[data-step-total]')!.textContent = String(total);
      const fill = q<HTMLElement>('[data-progress-fill]')!;
      fill.style.width = `${Math.round(((idx + 1) / total) * 100)}%`;
      clearErrors();
      if (step === 'upsell') refreshUpsell();
      if (step === 'phone') { refreshSummary(); ensureTurnstile(); }
      alignCardTop();
    };

    const goNext = () => {
      if (!validate(current)) return;
      const order = stepOrder();
      const next = order[order.indexOf(current) + 1];
      if (next) showStep(next);
    };
    const goBack = () => {
      const order = stepOrder();
      const prev = order[order.indexOf(current) - 1];
      if (prev) showStep(prev);
    };

    const refreshPresets = () => {
      const monthly = freq() === 'monthly';
      q('[data-presets-once]')!.hidden = monthly;
      q('[data-presets-monthly]')!.hidden = !monthly;
      q('[data-per]')!.hidden = !monthly;
      q('[data-freq-line]')!.textContent = monthly
        ? 'Monthly partnership keeps indigenous missionaries on the trail every single month.'
        : 'A single gift, put to work on the field right away.';
      qa<HTMLButtonElement>('.dform__amount').forEach((b) =>
        b.setAttribute('aria-pressed', String(Number(b.dataset.amount) === amount()))
      );
    };

    const refreshUpsell = () => {
      q('[data-upsell-amt]')!.textContent = money(amount());
    };

    const feeOf = () => {
      const rate = config?.fee_rate ?? 0.029;
      const fixed = config?.fee_fixed ?? 0.3;
      return Math.round((amount() * rate + fixed) * 100) / 100;
    };

    const refreshSummary = () => {
      const monthly = freq() === 'monthly';
      q('[data-disclosure]')!.hidden = !monthly;
      q('[data-pay-label]')!.textContent = `Continue to card · ${money(total())}${monthly ? '/mo' : ''}`;
    };

    const refreshFeePrompt = () => {
      const fee = money(feeOf());
      q('[data-fee-amt]')!.textContent = fee;
      q('[data-fee-amt2]')!.textContent = fee;
      q('[data-fee-amt3]')!.textContent = fee;
      q('[data-gift-amt]')!.textContent = money(amount());
    };

    // ---- Turnstile (rendered on demand so the token is always fresh) -------
    const ensureTurnstile = () => {
      if (!config?.turnstile_site_key || !window.turnstile) return;
      if (turnstileRendered) return;
      turnstileRendered = true;
      turnstileWidget = window.turnstile.render(q('[data-turnstile]')!, {
        sitekey: config.turnstile_site_key,
        theme: 'light',
        // Invisible unless Cloudflare actually wants a challenge, so the
        // giving screen is not dominated by a verification box.
        appearance: 'interaction-only',
        size: 'flexible',
        'expired-callback': () => window.turnstile?.reset(turnstileWidget),
        'error-callback': () => {
          turnstileRendered = false;
        },
      });
    };

    // ---- wiring ------------------------------------------------------------
    qa<HTMLButtonElement>('.dform__amount').forEach((b) =>
      b.addEventListener('click', () => {
        amountInput.value = String(b.dataset.amount);
        refreshPresets();
      })
    );
    amountInput.addEventListener('input', refreshPresets);
    qa<HTMLInputElement>('input[name="frequency"]').forEach((r) =>
      r.addEventListener('change', refreshPresets)
    );

    qa<HTMLButtonElement>('[data-next]').forEach((b) => b.addEventListener('click', goNext));
    qa<HTMLButtonElement>('[data-back]').forEach((b) => b.addEventListener('click', goBack));

    // Upsell: yes switches the gift to monthly at the same amount.
    q<HTMLButtonElement>('[data-upsell-yes]')!.addEventListener('click', () => {
      setFreq('monthly');
      refreshPresets();
      showStep('name');
    });
    q<HTMLButtonElement>('[data-upsell-no]')!.addEventListener('click', () => showStep('name'));

    // ---- phone -> text-updates morph ---------------------------------------
    const phoneInput = q<HTMLInputElement>('input[name="phone"]')!;
    const smsBox = q<HTMLInputElement>('input[name="sms_optin"]')!;
    const inlineAsk = q<HTMLElement>('[data-inline-ask]')!;
    const finePrint = q<HTMLElement>('[data-sms-fineprint]')!;
    const digits = () => phoneInput.value.replace(/\D/g, '');
    // 10 digits, or 11 starting with a US country code.
    const looksComplete = () => digits().length === 10 || (digits().length === 11 && digits().startsWith('1'));

    let morphTimer: number | undefined;
    // The number fades out and the same box asks the question. Nothing is
    // added to the page, so the step height never changes.
    const showAsk = (on: boolean) => {
      if (on === !inlineAsk.hidden) return;
      if (on) {
        inlineAsk.hidden = false;
        // Force a reflow so the transition has a start frame. rAF is not
        // reliable here: it does not fire in a backgrounded tab, which left
        // the number visible underneath the question.
        void inlineAsk.offsetWidth;
        phoneInput.classList.add('is-faded');
        inlineAsk.classList.add('is-shown');
        finePrint.classList.add('is-shown');
      } else {
        phoneInput.classList.remove('is-faded');
        inlineAsk.classList.remove('is-shown');
        finePrint.classList.remove('is-shown');
        const hide = () => { inlineAsk.hidden = true; };
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) hide();
        else window.setTimeout(hide, 180);
      }
    };

    const maybeAsk = () => {
      window.clearTimeout(morphTimer);
      if (!looksComplete()) return;
      // Short settle so it fires when typing stops, not mid-digit.
      morphTimer = window.setTimeout(() => showAsk(true), 450);
    };

    phoneInput.addEventListener('input', () => {
      // Clearing the number clears the consent with it, so we never hold an
      // opt-in for a number we do not have.
      if (!digits().length) {
        smsBox.checked = false;
        showAsk(false);
      }
      maybeAsk();
    });
    phoneInput.addEventListener('blur', () => {
      if (digits().length >= 7) showAsk(true);
    });

    // Answering either way records the choice and carries straight on, so the
    // question costs one tap and never strands anyone on this screen.
    const answerSms = (yes: boolean) => {
      smsBox.checked = yes;
      startCheckout();
    };
    q<HTMLButtonElement>('[data-sms-yes]')!.addEventListener('click', () => answerSms(true));
    q<HTMLButtonElement>('[data-sms-no]')!.addEventListener('click', () => answerSms(false));

    // ---- keyboard ----------------------------------------------------------
    // Enter advances the current step. Textareas keep their newline, and the
    // form never implicitly submits (every button is type=button).
    panels.form.addEventListener('submit', (e) => e.preventDefault());
    panels.form.addEventListener('keydown', (e) => {
      const ev = e as KeyboardEvent;
      if (ev.key !== 'Enter' || ev.shiftKey) return;
      const t = ev.target as HTMLElement;
      if (t instanceof HTMLTextAreaElement) return;
      if (t instanceof HTMLButtonElement) return;
      ev.preventDefault();
      if (current === 'phone') {
        // On the phone step Enter means "I have finished typing".
        if (!inlineAsk.hidden) return;
        if (digits().length >= 7) return showAsk(true);
        return startCheckout();
      }
      goNext();
    });

    // Same-page giving blocks (partner-monthly, one-time) hand their chosen
    // amount and frequency to the form through this event.
    document.addEventListener('favor:give-intent', (e) => {
      const d = (e as CustomEvent).detail as { amount?: number; frequency?: 'once' | 'monthly' } | undefined;
      if (!d) return;
      if (d.frequency) setFreq(d.frequency);
      if (d.amount && d.amount >= 1) amountInput.value = String(d.amount);
      refreshPresets();
      showStep('amount');
    });

    // ---- Blackbaud Checkout ------------------------------------------------
    const openCheckout = () => {
      if (!window.Blackbaud_OpenPaymentForm || !config?.public_key) {
        showError('fee', 'The secure checkout script did not load. Reload the page and try again.');
        return;
      }
      const monthly = freq() === 'monthly';
      const t = total();
      const data: Record<string, unknown> = {
        key: config.public_key,
        payment_configuration_id: config.payment_configuration_id,
        amount: Number(t.toFixed(2)),
        billing_address_first_name: field('first'),
        billing_address_last_name: field('last'),
        billing_address_email: field('email'),
        client_app_name: 'favorintl.org giving',
        description: monthly ? 'Favor Partner monthly gift (first month)' : 'Gift to Favor International',
        primary_color: '#2b4d24',
        is_email_required: true,
        use_apple_pay: false,
      };
      const phone = field('phone');
      if (phone) data.billing_address_phone = phone;
      if (monthly) {
        cardToken = crypto.randomUUID();
        data.card_token = cardToken;
      } else {
        cardToken = null;
      }
      idempotencyKey = crypto.randomUUID();
      window.Blackbaud_OpenPaymentForm(data);
    };

    // One code path on the pay button: after a failed submission the same
    // checkout token + idempotency key are resubmitted (never a second
    // charge); otherwise a fresh checkout opens.
    // Single entry point into payment, shared by the Continue button, the
    // text-updates answer, and the Enter key, so all three behave identically.
    function startCheckout() {
      if (submitting) return;
      if (checkoutToken && idempotencyKey) {
        void submitGift();
        return;
      }
      if (!validate('phone')) return;
      refreshFeePrompt();
      openFeeModal(true);
    }

    const feeModal = q<HTMLElement>('[data-modal="fee"]')!;
    function openFeeModal(open: boolean) {
      feeModal.hidden = !open;
      if (open) {
        // Pad by the scrollbar width while the page is locked, otherwise
        // removing the scrollbar shifts everything sideways as it opens.
        const bar = window.innerWidth - document.documentElement.clientWidth;
        if (bar > 0) document.body.style.paddingRight = `${bar}px`;
        document.body.style.overflow = 'hidden';
        q<HTMLButtonElement>('[data-fee-yes]')!.focus();
      } else {
        document.body.style.overflow = '';
        document.body.style.paddingRight = '';
      }
    }
    q<HTMLElement>('[data-fee-dismiss]')!.addEventListener('click', () => openFeeModal(false));
    document.addEventListener('keydown', (e) => {
      if ((e as KeyboardEvent).key === 'Escape' && !feeModal.hidden) openFeeModal(false);
    });

    // The fee question is asked here, at the moment of payment, instead of
    // as one more checkbox earlier in the flow. Either answer goes straight
    // on to the card window, so it costs one tap and never blocks.
    const proceedToCheckout = () => {
      openFeeModal(false);
      if (config?.turnstile_site_key && window.turnstile) {
        const token = window.turnstile.getResponse(turnstileWidget);
        if (!token) {
          window.turnstile.reset(turnstileWidget);
          showStep('phone');
          return showError('phone', 'One second while we confirm you are human, then press the button again.');
        }
      }
      openCheckout();
    };

    q<HTMLButtonElement>('[data-pay]')!.addEventListener('click', () => startCheckout());

    q<HTMLButtonElement>('[data-fee-yes]')!.addEventListener('click', () => {
      feeCovered = true;
      proceedToCheckout();
    });
    q<HTMLButtonElement>('[data-fee-no]')!.addEventListener('click', () => {
      feeCovered = false;
      proceedToCheckout();
    });

    activeCheckout = {
      onComplete: (transactionToken) => {
        checkoutToken = transactionToken;
        void submitGift();
      },
      onError: (message) => {
        showStep('phone');
        showError('phone', message);
      },
    };

    async function submitGift() {
      if (submitting || !checkoutToken || !idempotencyKey) return;
      submitting = true;
      showPanel('processing');
      alignCardTop();

      const monthly = freq() === 'monthly';
      const body: Record<string, unknown> = {
        idempotency_key: idempotencyKey,
        amount: amount(),
        cover_fees: checkbox('cover_fees'),
        designation_fund_id: designationSelect.value,
        donor: {
          first: field('first'),
          last: field('last'),
          email: field('email'),
          phone: field('phone') || undefined,
        },
        anonymous: checkbox('anonymous'),
        email_optin: checkbox('email_optin'),
        sms_optin: checkbox('sms_optin'),
        note: field('note') || undefined,
        checkout: { transaction_token: checkoutToken },
        turnstile_token:
          config?.turnstile_site_key && window.turnstile ? window.turnstile.getResponse(turnstileWidget) : undefined,
      };
      if (monthly) body.card_token = cardToken;

      try {
        const res = await fetch(monthly ? '/api/give/donate-recurring' : '/api/give/donate', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body),
        });
        const data = (await res.json()) as {
          ok?: boolean;
          message?: string;
          amount?: number;
          designation?: string;
          portal_login_url?: string;
        };
        if (!res.ok || !data.ok) throw new Error(data.message || 'The gift could not be completed.');
        // One-time dashboard sign-in for the thank-you page (kept out of the
        // URL so the token never lands in history, logs, or referrers).
        try {
          if (data.portal_login_url) sessionStorage.setItem('favor:portal-login', data.portal_login_url);
        } catch {
          /* storage unavailable = skip the button */
        }
        const dest = new URLSearchParams({
          amount: String(data.amount ?? total()),
          frequency: monthly ? 'monthly' : 'once',
          designation: data.designation ?? '',
          name: field('first'),
        });
        location.assign('/give/thank-you/?' + dest.toString());
      } catch (err) {
        submitting = false;
        showPanel('form');
        // goTo(2) deliberately preserves checkoutToken and idempotencyKey (it
        // only clears them below step 2), so pressing the button resubmits the
        // same authorization instead of charging a second time.
        showStep('phone');
        // Turnstile tokens are single-use; arm a fresh one for the retry.
        if (window.turnstile && turnstileWidget) window.turnstile.reset(turnstileWidget);
        showError(
          'phone',
          (err instanceof Error ? err.message : 'The gift could not be completed.') +
            ' Your card was not charged. Press the button to try again, or email info@favorintl.org and we will finish it with you.'
        );
        q('[data-pay-label]')!.textContent = 'Try again';
      }
    }

    // ---- bootstrap -----------------------------------------------------------
    (async () => {
      try {
        const res = await fetch('/api/give/config');
        config = (await res.json()) as GiveConfig;
      } catch {
        config = null;
      }
      if (!config?.connected || config.setup_incomplete || !config.public_key || !(config.designations ?? []).length) {
        showPanel('fallback');
        return;
      }

      // designations
      const wrap = q('[data-designation-wrap]')!;
      designationSelect.innerHTML = '';
      for (const d of config.designations!) {
        const opt = document.createElement('option');
        opt.value = d.fund_id;
        opt.textContent = d.label;
        designationSelect.appendChild(opt);
      }
      wrap.hidden = config.designations!.length < 2;

      // defaults + deep links
      setFreq(root.dataset.defaultFrequency === 'once' ? 'once' : 'monthly');
      const pFreq = params.get('frequency');
      if (pFreq === 'once' || pFreq === 'monthly') setFreq(pFreq);
      const pAmount = Number(params.get('amount'));
      if (pAmount >= 1) amountInput.value = String(pAmount);
      const pDesignation = params.get('designation');
      if (pDesignation && config.designations!.some((d) => d.fund_id === pDesignation)) {
        designationSelect.value = pDesignation;
      }
      refreshPresets();
      showStep('amount');

      // turnstile script loads early; the widget renders when step 3 opens so
      // its token is fresh at the moment of payment
      if (config.turnstile_site_key) {
        const s = document.createElement('script');
        s.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';
        s.async = true;
        document.head.appendChild(s);
      }

      showPanel('form');
    })();
  }

  initDonationForm();
  document.addEventListener('astro:page-load', initDonationForm);
</script>

<script src="https://payments.blackbaud.com/Checkout/bbCheckout.2.0.js" is:inline defer></script>

<style>
  .dform { max-width: 680px; margin: 0 auto; }
