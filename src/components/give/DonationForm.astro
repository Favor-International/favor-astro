  .dform__disclosure { font-size: 0.85rem; color: var(--color-ink-soft); background: var(--color-cream); padding: var(--space-3) var(--space-4); border-radius: var(--radius-input); }
  .dform__disclosure a { color: var(--color-gold-deep); }

