  .dform__error { color: #a03123; background: #fdf0ee; border: 1px solid #efc7c0; padding: var(--space-3) var(--space-4); border-radius: var(--radius-input); font-size: 0.92rem; }
  .dform__secure { font-size: 0.8rem; color: var(--color-sage); text-align: center; margin-top: var(--space-4); }

  .dform__processing { text-align: center; padding: var(--space-10) 0; color: var(--color-green-deep); }
  .dform__spinner { display: inline-block; width: 34px; height: 34px; border-radius: 50%; border: 3px solid var(--color-cream); border-top-color: var(--color-gold); animation: dform-spin 800ms linear infinite; margin-bottom: var(--space-3); }
  @keyframes dform-spin { to { transform: rotate(360deg); } }

  /* ---- survey flow ---------------------------------------------------- */
  /* One question per screen, so each step gets room to breathe and the eye
     lands on a single input and a single button. */
  .dform__progress { margin: 0 0 clamp(24px, 4vw, 36px); }
  .dform__progress-track { height: 4px; border-radius: 999px; background: color-mix(in srgb, var(--color-green) 12%, transparent); overflow: hidden; }
  .dform__progress-track span { display: block; height: 100%; width: 25%; border-radius: 999px; background: var(--color-gold); transition: width 280ms cubic-bezier(.4,0,.2,1); }
