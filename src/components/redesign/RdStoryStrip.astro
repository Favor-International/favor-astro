---
// Redesign take on StoryStrip: same live-story data and tag matching, rendered
// as uniform rd-tiles (rounded image, text below) instead of boxed cards.
import LeafHeading from './LeafHeading.astro';
import storiesData from '../../data/stories.json';

export interface Props {
  tags: string[];          // match stories carrying ANY of these live tags
  heading?: string;
  label?: string;
  count?: number;
  background?: 'white' | 'cream' | 'greenlight';
}
const { tags, heading = 'Stories from this ministry.', label = 'From the field', count = 3, background = 'cream' } = Astro.props as Props;

const matches = storiesData
  .filter((s: any) => (s.tags || []).some((t: string) => tags.includes(t)))
  .sort((a: any, b: any) => new Date(b.date).getTime() - new Date(a.date).getTime())
  .slice(0, count);

function excerpt(paras: string[], n = 130) {
  const t = paras && paras[0] ? paras[0] : '';
  return t.length > n ? t.slice(0, n).replace(/\s+\S*$/, '') + '…' : t;
}
const bandClass = background === 'cream' ? 'band--cream' : background === 'greenlight' ? 'band--greenlight' : 'band--white';
---
{matches.length > 0 && (
  <section class={`band ${bandClass}`}>
    <div class="container">
      <LeafHeading label={label} title={heading} leaves={background === 'white'} />
      <div class="rd-grid rd-grid--3">
        {matches.map((s: any) => (
          <a class="rd-tile" href={`/stories/${s.slug}/`}>
            <div class="rd-tile__img" style={`background-image:url('${s.image}')`} role="img" aria-label={s.title}></div>
            <div class="rd-tile__meta">
              {(s.tags || [])[0] && <span class="rd-kicker">{(s.tags || [])[0]}</span>}
              <h3>{s.title}</h3>
              <p>{excerpt(s.paragraphs)}</p>
            </div>
          </a>
        ))}
      </div>
      <p class="band__cta-row rd-stories__more"><a class="btn btn--secondary" href="/stories/">See all stories from the field</a></p>
    </div>
  </section>
)}

<style>
  .rd-stories__more { text-align: center; }
</style>
