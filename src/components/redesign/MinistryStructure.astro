---
// Ministry Structure — Carole's "house", rendered as a refined HTML/CSS building:
// a pitched gable roof (gold cross + Psalm 127:1) over a facade where four
// pillars frame the nine ministries in cream bays, on a PRAYER foundation.
// Verbatim wording from Favor's graphic; swappable for the new graphic later.
const pillars = [
  { name: 'Spiritual', sub: 'Strategic Plan' },
  { name: 'Legal', sub: 'NGO' },
  { name: 'Administration', sub: '' },
  { name: 'Financial', sub: 'Development Plan' },
];
const bays = [
  ['Evangelism & Discipleship', 'Prayer Ministries', "Children's Ministries"],
  ['Medical Work', 'School of Ministry', 'Primary & Secondary Schools'],
  ["Women's Empowerment", 'Rehabilitating Street Youth', 'Crusades'],
];
const colonnade: Array<{ type: 'pillar'; name: string; sub: string } | { type: 'bay'; items: string[] }> = [];
pillars.forEach((p, i) => {
  colonnade.push({ type: 'pillar', name: p.name, sub: p.sub });
  if (bays[i]) colonnade.push({ type: 'bay', items: bays[i] });
});
---
<div class="ms">
  <p class="ms__verse">
    <span>“...unless the Lord builds the house, they labor in vain who build it...”</span>
    <cite>Psalm 127:1</cite>
  </p>

  <div class="ms__building reveal">
    <div class="ms__roof">
      <span class="ms__cross" aria-hidden="true"><i></i><i></i></span>
      <div class="ms__gable"></div>
    </div>

    <div class="ms__body">
      <div class="ms__lintel" aria-hidden="true"></div>
      <div class="ms__facade">
        {colonnade.map((c) => (
          c.type === 'pillar' ? (
            <div class="ms__pillar">
              <span class="ms__pillar-name">{c.name}</span>
              {c.sub && <span class="ms__pillar-sub">{c.sub}</span>}
            </div>
          ) : (
            <div class="ms__bay">
              {c.items.map((m) => <div class="ms__ministry">{m}</div>)}
            </div>
          )
        ))}
      </div>

      <div class="ms__base">
        <span class="ms__base-label">Prayer</span>
        <div class="ms__verses">
          <blockquote>
            <span>“Do not be anxious about anything, but in every situation, by prayer and petition, with thanksgiving, present your requests to God.”</span>
            <cite>Philippians 4:6 NIV</cite>
          </blockquote>
          <blockquote>
            <span>“I also say to you that you are Peter, and upon this rock I will build My church; and the gates of Hades will not overpower it.”</span>
            <cite>Matthew 16:18 NASB 1995</cite>
          </blockquote>
        </div>
      </div>
    </div>

    <div class="ms__ground" aria-hidden="true"></div>
  </div>

  <p class="ms__caption">
    “By wisdom a house is built, and through understanding it is established...” <cite>Proverbs 24:3</cite>
  </p>
</div>

<style>
  .ms { max-width: 960px; margin-inline: auto; }

  /* Psalm lead-in above the roof. */
  .ms__verse { max-width: 42ch; margin: 0 auto clamp(22px, 3vw, 38px); text-align: center; font-family: var(--font-display); font-style: italic; color: var(--color-green-deep); line-height: 1.5; }
  .ms__verse span { font-size: clamp(1.15rem, 1.9vw, 1.45rem); font-weight: 500; }
  .ms__verse cite { display: block; margin-top: var(--space-2); font-style: normal; font-family: var(--font-sans); font-weight: 700; font-size: var(--rd-fs-small); letter-spacing: 0.16em; text-transform: uppercase; color: var(--color-gold-deep); }

  .ms__building { position: relative; }

  /* Roof: a pitched gable with a short fascia skirt, lit gradient, soft shadow. */
  .ms__roof { position: relative; }
  .ms__cross { position: absolute; left: 50%; top: -22px; transform: translateX(-50%); z-index: 2; display: block; width: 18px; height: 26px; }
  .ms__cross i { position: absolute; left: 50%; transform: translateX(-50%); background: linear-gradient(160deg, var(--color-gold), var(--color-gold-deep)); border-radius: 2px; }
  .ms__cross i:first-child { top: 0; width: 4px; height: 26px; }
  .ms__cross i:last-child { top: 7px; width: 18px; height: 4px; }
  .ms__gable {
    height: clamp(124px, 12.5vw, 178px);
    background: linear-gradient(135deg, var(--color-green) 0%, var(--color-green-deep) 100%);
    clip-path: polygon(50% 0, 100% 82%, 100% 100%, 0 100%, 0 82%);
    filter: drop-shadow(0 8px 16px rgba(31, 58, 26, 0.18));
  }

  /* Facade + base read as one building; gold lintel separates roof from facade. */
  .ms__body { position: relative; border-radius: 0 0 18px 18px; overflow: hidden; border: 1px solid rgba(31, 58, 26, 0.06); border-top: 0; box-shadow: 0 16px 44px rgba(31, 58, 26, 0.12); }
  .ms__lintel { height: 3px; background: linear-gradient(90deg, var(--color-gold), var(--color-gold-deep)); }

  .ms__facade {
    display: grid;
    grid-template-columns: var(--pw) 1fr var(--pw) 1fr var(--pw) 1fr var(--pw);
    --pw: clamp(56px, 6vw, 72px);
  }
  /* Pillars: lit gradient + a darker plinth so they read as load-bearing. */
  .ms__pillar { background: linear-gradient(180deg, var(--color-green) 0%, #234119 100%); border-bottom: 5px solid #1a3216; display: flex; align-items: center; justify-content: center; gap: 6px; padding: clamp(22px, 2.6vw, 32px) 0; }
  .ms__pillar-name, .ms__pillar-sub { writing-mode: vertical-rl; transform: rotate(180deg); white-space: nowrap; }
  .ms__pillar-name { color: var(--color-cream); font-weight: 700; text-transform: uppercase; letter-spacing: 0.18em; font-size: clamp(0.78rem, 1vw, 0.92rem); }
  .ms__pillar-sub { color: var(--color-gold); font-size: 0.7rem; letter-spacing: 0.06em; opacity: 0.95; }

  /* Bays: warm cream "rooms" with inset hairline separators (not edge-to-edge). */
  .ms__bay { background: #f3efe6; display: flex; flex-direction: column; }
  .ms__ministry { position: relative; flex: 1; display: flex; align-items: center; justify-content: center; text-align: center; padding: clamp(16px, 1.9vw, 22px) 14px; color: var(--color-green-deep); font-weight: 600; font-size: clamp(0.9rem, 1.1vw, 1rem); line-height: 1.25; }
  .ms__ministry + .ms__ministry::before { content: ''; position: absolute; top: 0; left: 16px; right: 16px; height: 1px; background: rgba(31, 58, 26, 0.12); }

  /* Base: the PRAYER footing — deep green, with gold keylines, kept compact. */
  .ms__base { position: relative; background: var(--color-green-deep); text-align: center; padding: clamp(22px, 2.6vw, 32px) clamp(22px, 4vw, 52px); }
  .ms__base::before { content: ''; position: absolute; inset: 0 0 auto; height: 1px; background: linear-gradient(90deg, transparent, rgba(225, 167, 48, 0.55), transparent); }
  .ms__base-label { display: inline-flex; align-items: center; gap: 12px; font-family: var(--font-display); color: var(--color-gold); font-weight: 600; text-transform: uppercase; letter-spacing: 0.32em; font-size: clamp(1.3rem, 2.4vw, 1.85rem); margin-bottom: clamp(16px, 2.2vw, 26px); }
  .ms__base-label::before, .ms__base-label::after { content: ''; width: 26px; height: 1px; background: rgba(225, 167, 48, 0.5); }
  .ms__verses { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(20px, 3vw, 46px); text-align: left; }
  .ms__verses blockquote { margin: 0; }
  .ms__verses span { display: block; font-family: var(--font-display); font-style: italic; color: #f3ecde; font-size: clamp(0.92rem, 1.3vw, 1.05rem); line-height: 1.55; }
  .ms__verses cite { display: block; margin-top: var(--space-3); font-style: normal; font-family: var(--font-sans); font-weight: 700; font-size: var(--rd-fs-small); letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-gold); }

  /* A faint ground line lands the house. */
  .ms__ground { width: 92%; height: 1px; margin: clamp(14px, 2vw, 22px) auto 0; background: linear-gradient(90deg, transparent, rgba(31, 58, 26, 0.22), transparent); }

  .ms__caption { margin: clamp(20px, 2.6vw, 32px) auto 0; max-width: 54ch; text-align: center; font-family: var(--font-display); font-style: italic; color: var(--color-ink-soft); font-size: clamp(1rem, 1.4vw, 1.15rem); line-height: 1.5; }
  .ms__caption cite { font-style: normal; font-family: var(--font-sans); font-weight: 700; font-size: var(--rd-fs-small); letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-gold-deep); white-space: nowrap; }

  /* Narrow screens: facade stacks into labeled green bands + their rooms. */
  @media (max-width: 820px) {
    .ms__facade { grid-template-columns: 1fr; }
    .ms__pillar { flex-direction: row; gap: 10px; padding: 13px 20px; border-bottom: 0; border-left: 5px solid #1a3216; }
    .ms__pillar-name, .ms__pillar-sub { writing-mode: horizontal-tb; transform: none; }
    .ms__pillar-sub::before { content: '· '; }
    .ms__verses { grid-template-columns: 1fr; gap: clamp(18px, 4vw, 26px); }
  }
  @media (max-width: 520px) { .ms__verses { text-align: center; } }
</style>
