---
// Favor's Ministry Structure graphic, rebuilt as a crisp, responsive inline SVG
// from Favor's own design export (their exact coordinates, colours, text, and
// dove mark). Rather than a boxed image, it IS the section: the white band
// above eases into this section's grey, the temple sits straight on that grey,
// and the green "PRAYER" foundation is a full-bleed band that floors the
// section before the next one begins. The SVG carries the temple only (title,
// roof, cross, dove, verses, four pillars, nine ministry bands); the grey and
// the foundation are page furniture so they can run edge to edge.

const GREEN = '#2B4D24'; // pillar labels (matches --color-green)
const TAN = '#E1BF80'; // ministry bands
const INK = '#231F20'; // outlines + dark text

// Four pillars: centre x and the type size of the rotated label.
const pillars = [
  { label: 'SPIRITUAL', x: 175, size: 34 },
  { label: 'LEGAL', x: 458, size: 36 },
  { label: 'ADMINISTRATION', x: 742, size: 28 },
  { label: 'FINANCIAL', x: 1025, size: 34 },
];

// Nine ministry bands, stacked in the three gaps between the pillars.
const bands = [
  { x: 175, w: 283, y: 320, h: 118, lines: ['EVANGELISM', '& DISCIPLESHIP'] },
  { x: 175, w: 283, y: 470, h: 118, lines: ['PRAYER', 'MINISTRIES'] },
  { x: 175, w: 283, y: 620, h: 130, lines: ['CHILDREN’S', 'MINISTRIES'] },
  { x: 458, w: 284, y: 320, h: 118, lines: ['MEDICAL', 'WORK'] },
  { x: 458, w: 284, y: 470, h: 118, lines: ['SCHOOL OF', 'MINISTRY'] },
  { x: 458, w: 284, y: 620, h: 130, lines: ['PRIMARY &', 'SECONDARY', 'SCHOOLS'] },
  { x: 742, w: 283, y: 320, h: 118, lines: ['WOMEN’S', 'EMPOWERMENT'] },
  { x: 742, w: 283, y: 470, h: 118, lines: ['REHABILITATING', 'STREET YOUTH'] },
  { x: 742, w: 283, y: 620, h: 130, lines: ['CRUSADES'] },
];

// Column silhouette (white fill, dark outline): wide capital -> neck -> shaft
// -> neck -> wide base, centred on cx between y=248 and y=790.
const column = (cx: number) => {
  const c = 50, n = 42, s = 36; // capital/neck/shaft half-widths
  return [
    `M${cx - c},248`, `L${cx + c},248`, `L${cx + c},266`, `L${cx + n},266`,
    `L${cx + n},284`, `L${cx + s},284`, `L${cx + s},754`, `L${cx + n},754`,
    `L${cx + n},772`, `L${cx + c},772`, `L${cx + c},790`, `L${cx - c},790`,
    `L${cx - c},772`, `L${cx - n},772`, `L${cx - n},754`, `L${cx - s},754`,
    `L${cx - s},284`, `L${cx - n},284`, `L${cx - n},266`, `L${cx - c},266`, 'Z',
  ].join(' ');
};
const SHAFT_MID = 519; // (284 + 754) / 2 — vertical centre of the shaft
const BAND_LH = 23; // band line height
---

<section class="ministry">
  <div class="ministry__art reveal">
    <svg class="ministry__svg" viewBox="0 0 1200 790" role="img"
      aria-labelledby="ms-title ms-desc" xmlns="http://www.w3.org/2000/svg">
      <title id="ms-title">Favor International Ministry Structure</title>
      <desc id="ms-desc">Unless the Lord builds the house, they labour in vain who build it (Psalm 127:1). Four pillars frame the ministry — Spiritual, Legal, Administration, and Financial — over nine ministries: Evangelism and Discipleship, Prayer Ministries, Children's Ministries, Medical Work, School of Ministry, Primary and Secondary Schools, Women's Empowerment, Rehabilitating Street Youth, and Crusades. The foundation is Prayer.</desc>

      <!-- ministry bands (drawn before the pillars so the pillars overlap them) -->
      {bands.map((b) => (
        <g>
          <rect x={b.x} y={b.y} width={b.w} height={b.h} fill={TAN} />
          <text class="ms-band" x={b.x + b.w / 2} text-anchor="middle" dominant-baseline="middle">
            {b.lines.map((ln, i) => (
              <tspan x={b.x + b.w / 2} y={b.y + b.h / 2 + (i - (b.lines.length - 1) / 2) * BAND_LH}>{ln}</tspan>
            ))}
          </text>
        </g>
      ))}

      <!-- four pillars -->
      {pillars.map((p) => (
        <g>
          <path d={column(p.x)} fill="#fff" stroke={INK} stroke-width="4" stroke-linejoin="round" />
          <text class="ms-pillar" x={p.x} y={SHAFT_MID} text-anchor="middle" dominant-baseline="central"
            transform={`rotate(-90 ${p.x} ${SHAFT_MID})`}
            style={`font-size:${p.size}px;letter-spacing:1.5px`}>{p.label}</text>
        </g>
      ))}

      <!-- pediment / roof -->
      <polygon points="90,252 600,95 1110,252" fill="#fff" stroke={INK} stroke-width="6" stroke-linejoin="round" />

      <!-- cross -->
      <rect x="593" y="8" width="14" height="92" rx="2" fill={INK} />
      <rect x="568" y="32" width="64" height="14" rx="2" fill={INK} />

      <!-- dove (Favor's mark) -->
      <image href="/images/ministry-dove.png" x="572" y="100" width="56" height="49" />

      <!-- Psalm 127:1, set inside the pediment -->
      <text class="ms-verse" x="600" y="176" text-anchor="middle">
        <tspan x="600" y="176">&#8220;...unless the Lord builds</tspan>
        <tspan x="600" y="201">the house, they labor in vain who build it...&#8221;</tspan>
        <tspan class="ms-cite" x="600" y="230">Psalm 127:1</tspan>
      </text>

      <!-- title -->
      <text class="ms-title-txt" x="36" y="80" text-anchor="start">
        <tspan x="36" y="80">Ministry</tspan>
        <tspan x="36" y="144">Structure</tspan>
      </text>

      <!-- Proverbs 24:3 -->
      <text class="ms-prov" x="1170" y="74" text-anchor="end">
        <tspan x="1170" y="74">&#8220;By wisdom a house is built, and through</tspan>
        <tspan x="1170" y="101">understanding it is established...&#8221;</tspan>
        <tspan class="ms-prov-cite" x="1170" y="132">Proverbs 24:3</tspan>
      </text>
    </svg>
  </div>

  <!-- foundation: the full-bleed floor of the section -->
  <div class="ministry__foundation">
    <div class="ministry__found-inner">
      <p class="ministry__verse ministry__verse--l">
        &#8220;Do not be anxious about anything, but in every situation, by prayer and petition, with thanksgiving, present your requests to God.&#8221;
        <span>Philippians 4:6</span>
      </p>
      <p class="ministry__word">PRAYER</p>
      <p class="ministry__verse ministry__verse--r">
        &#8220;I also say to you that you are Peter, and upon this rock I will build My church; and the gates of Hades will not overpower it.&#8221;
        <span>Matthew 16:18</span>
      </p>
    </div>
  </div>
</section>

<style>
  /* The section's own grey IS the canvas, so the temple sits on the page
     rather than inside a boxed image. */
  .ministry { position: relative; background: #E9EAE9; padding-top: clamp(72px, 9vw, 132px); }

  /* White-to-grey blend: the white band above eases into this section. A long,
     eased fade (not a short linear one) so it dissolves into the grey with no
     visible seam. The temple paints above this layer, so the title/cross stay
     crisp even where the fade still has some white in it. */
  .ministry::before {
    content: '';
    position: absolute; inset: 0 0 auto; height: clamp(240px, 30vw, 440px);
    background: linear-gradient(to bottom,
      rgba(255, 255, 255, 1) 0%,
      rgba(255, 255, 255, 0.94) 16%,
      rgba(255, 255, 255, 0.78) 34%,
      rgba(255, 255, 255, 0.55) 52%,
      rgba(255, 255, 255, 0.32) 68%,
      rgba(255, 255, 255, 0.14) 84%,
      rgba(255, 255, 255, 0) 100%);
    pointer-events: none;
  }

  .ministry__art { position: relative; max-width: 1140px; margin: 0 auto; padding: 0 var(--space-6); }
  .ministry__svg { display: block; width: 100%; height: auto; font-family: var(--font-sans); }

  /* Full-bleed green foundation — the floor the pillars rest on. */
  .ministry__foundation { background: #8A957C; }
  .ministry__found-inner {
    max-width: 1140px; margin: 0 auto; padding: clamp(26px, 3.4vw, 46px) var(--space-6);
    display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: clamp(18px, 3vw, 52px);
  }
  .ministry__word {
    margin: 0; text-align: center; color: #fff; font-weight: 800;
    font-size: clamp(2rem, 4.6vw, 3.1rem); letter-spacing: 0.14em; line-height: 1;
  }
  .ministry__verse {
    margin: 0; color: #fff; font-style: italic; font-weight: 500;
    font-size: var(--rd-fs-small); line-height: 1.55; max-width: 36ch;
  }
  .ministry__verse--l { text-align: left; }
  .ministry__verse--r { text-align: right; margin-left: auto; }
  .ministry__verse span { display: block; font-style: normal; font-weight: 800; margin-top: 6px; }

  @media (max-width: 760px) {
    .ministry__found-inner { grid-template-columns: 1fr; gap: var(--space-5); justify-items: center; }
    .ministry__verse, .ministry__verse--l, .ministry__verse--r { text-align: center; margin: 0 auto; }
  }

  /* On phones the whole temple would shrink until the labels are unreadable, so
     keep it at a legible width and let the reader swipe across it. */
  @media (max-width: 640px) {
    .ministry__art { overflow-x: auto; -webkit-overflow-scrolling: touch; padding-inline: 0; }
    .ministry__svg { min-width: 580px; }
  }

  /* text roles — sizes are in the 1200-wide user space, so they scale */
  .ms-title-txt { font-family: var(--font-display); font-weight: 600; font-size: 66px; fill: #231F20; letter-spacing: 0.5px; }
  .ms-prov { font-weight: 700; font-size: 22px; fill: #231F20; }
  .ms-prov-cite { font-weight: 800; font-size: 23px; }
  .ms-verse { font-style: italic; font-weight: 500; font-size: 20px; fill: #231F20; }
  .ms-cite { font-style: normal; font-weight: 800; font-size: 20px; }
  .ms-pillar { font-weight: 800; fill: #2B4D24; }
  .ms-band { font-weight: 800; font-size: 20px; fill: #231F20; letter-spacing: 0.4px; }
</style>
