---
// Impact numbers as a clean static stat grid (no scroll animation): each figure
// in its own card with the big green number, a label, and an optional source.
export interface Props {
  label?: string;
  heading: string;
  stats: { value: string; label: string; source?: string }[];
}
const { label, heading, stats } = Astro.props as Props;
---
<section class="band band--white">
  <div class="container">
    <header class="band__header">
      {label && <p class="label">{label}</p>}
      <h2>{heading}</h2>
    </header>
    <div class="rd-nums__grid">
      {stats.map((s) => (
        <div class="rd-nums__cell">
          <span class="rd-nums__num">{s.value}</span>
          <span class="rd-nums__cap">{s.label}</span>
          {s.source && <span class="rd-nums__src">{s.source}</span>}
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .rd-nums__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(20px, 2vw, 28px);
  }
  @media (max-width: 900px) { .rd-nums__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 460px) { .rd-nums__grid { grid-template-columns: 1fr; } }

  .rd-nums__cell {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    background: var(--color-white);
    border-radius: var(--rd-radius);
    box-shadow: var(--rd-shadow);
    padding: clamp(24px, 2.6vw, 40px);
  }
  .rd-nums__num {
    font-family: var(--font-sans);
    font-weight: 800;
    font-size: var(--rd-fs-title);
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--color-green);
  }
  .rd-nums__cap { color: var(--color-ink-soft); font-size: var(--rd-fs-body); line-height: 1.45; }
  .rd-nums__src { margin-top: var(--space-1); font-size: var(--rd-fs-small); color: var(--color-sage); }
</style>
