---
// Section header with a faint monstera-style leaf tucked behind the title.
// Per Daniel: only on white sections with green titles; semi-transparent,
// never asking for attention. Leaf style follows his flat-illustration ref
// (lobed shape with cutout holes).
import Leaf from './Leaf.astro';
export interface Props {
  label?: string;
  title: string;
  intro?: string;
  align?: 'center' | 'left';
  leaves?: boolean;
}
const { label, title, intro, align = 'center', leaves = true } = Astro.props as Props;
---
<header class={`band__header rd-lhead rd-lhead--${align}`}>
  {leaves && <Leaf class="rd-lhead__leaves" />}
  {label && <p class="label">{label}</p>}
  <h2>{title}</h2>
  {intro && <p>{intro}</p>}
  <slot />
</header>

<style>
  .rd-lhead { position: relative; }
  .rd-lhead--center { text-align: center; margin-left: auto; margin-right: auto; }
  .rd-lhead--left { text-align: left; margin-left: 0; }
  .rd-lhead--left > :global(p:not(.label)) { margin-left: 0 !important; }
  .rd-lhead > :global(.rd-lhead__leaves) {
    position: absolute;
    top: -64px;
    left: 50%;
    transform: translateX(-150%) rotate(-14deg);
    width: clamp(130px, 14vw, 180px);
    height: auto;
    color: #cfe0c6;
    opacity: 0.55;
    pointer-events: none;
    z-index: 0;
  }
  .rd-lhead--left > :global(.rd-lhead__leaves) { left: -30px; transform: rotate(-14deg); }
  .rd-lhead > :global(*:not(.rd-lhead__leaves)) { position: relative; z-index: 1; }
  @media (max-width: 760px) {
    .rd-lhead > :global(.rd-lhead__leaves) { top: -44px; width: 110px; }
  }
</style>
