---
// Image card with a dark gradient at the bottom and text over it. Modern, clean,
// reusable for link grids, info cards, and image CTAs. If `href` is set it renders
// as a link; otherwise a static figure. Use real photos; keep text short.
export interface Props {
  href?: string;
  image: string;
  imageAlt?: string;
  kicker?: string;
  title: string;
  desc?: string;
  cta?: string;
  ratio?: string;
  objectPosition?: string;
}
const { href, image, imageAlt = '', kicker, title, desc, cta, ratio = '4 / 3', objectPosition = 'center 30%' } = Astro.props as Props;
const Tag = href ? 'a' : 'div';
---
<Tag class="ocard" href={href} style={`--ocard-ratio:${ratio};`} aria-label={href ? `${title}` : undefined}>
  <span class="ocard__media">
    <span class="ocard__img" style={`background-image:url(${image}); background-position:${objectPosition};`} role="img" aria-label={imageAlt || title}></span>
    {kicker && <span class="ocard__kicker ocard__kicker--photo">{kicker}</span>}
  </span>
  <span class="ocard__body">
    <span class="ocard__title">{title}</span>
    {desc && <span class="ocard__desc">{desc}</span>}
    {cta && <span class="ocard__cta">{cta} <span aria-hidden="true">&rarr;</span></span>}
  </span>
</Tag>
<style>
  .ocard { display: flex; flex-direction: column; height: 100%; text-decoration: none; color: inherit; background: transparent; transition: transform 220ms ease; }
  a.ocard:hover { transform: translateY(-5px); }
  .ocard__media { position: relative; display: block; aspect-ratio: var(--ocard-ratio); overflow: hidden; border-radius:var(--rd-radius, 22px); background: var(--color-sage-light); }
  .ocard__img { position: absolute; inset: 0; background-size: cover; background-repeat: no-repeat; transition: transform 320ms ease; }
  a.ocard:hover .ocard__img { transform: scale(1.05); }
  .ocard__body { display: flex; flex: 1; flex-direction: column; align-items: flex-start; gap: var(--space-3); padding: var(--space-5) var(--space-1) 0; }
  .ocard__kicker { font-size: 0.72rem; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-gold-light); }
  .ocard__kicker--photo { position: absolute; left: var(--space-4); top: var(--space-4); padding: 7px 13px; border-radius: var(--radius-pill); background: rgba(31,58,26,.86); color: var(--color-white); backdrop-filter: blur(4px); }
  .ocard__title { font-family: var(--font-sans); font-weight: 800; font-size: 1.2rem; line-height: 1.25; color: var(--color-green); }
  .ocard__desc { font-size: 0.95rem; line-height: 1.6; color: var(--color-ink-soft); }
  .ocard__cta { margin-top: auto; padding-top: var(--space-2); font-weight: 800; font-size: 0.85rem; color: var(--color-gold-deep); }
  a.ocard:hover .ocard__cta { color: var(--color-green); }
</style>
