---
// Africa reach map for the home page — a TRUE vector map.
//
// Country shapes come from real geographic data (Natural Earth admin-0),
// projected into the coordinate space of Favor's own field artwork by
// matching the artwork's "reached" region to the real reached countries
// (see scripts/build-africa-geo.py). The ~2,700 Portable Bible School
// dots and the mission-station stars were extracted by colour from the
// artwork and live in the same space, so everything aligns. Because it
// is all vector, it stays crisp at any size and is fully recolourable.
//
// On first scroll into view the coverage ripples outward from the field.

import geo from '../../data/africa-geo.json';
import pbs from '../../data/africa-pbs.json';

const { countries, labels, view } = geo as {
  viewW: number; viewH: number;
  view: { x: number; y: number; w: number; h: number };
  countries: { name: string; reached: boolean; cx: number; cy: number; d: string }[];
  labels: { lines: string[]; x: number; y: number; fs: number; anchor: string; leader: [number, number] | null }[];
};
const { dots, orange, green } = pbs as {
  dots: [number, number, number][];
  orange: [number, number][];
  green: [number, number][];
};
const publicCountries = new Set(['Uganda', 'S. Sudan', 'Chad']);
const publicCountryName = (name: string) => name === 'S. Sudan' ? 'South Sudan' : name;
const publicLabels = labels.filter((label) => {
  const name = label.lines.join(' ').toLowerCase();
  return name === 'uganda' || name === 'south sudan' || name === 'chad';
});

// Mission-station markers are larger dots, distinct from the small PBS dots.
const STATION_R = 13;

// Reveal ripple spreads out from the densest part of the field.
const fx = dots.reduce((s, d) => s + d[0], 0) / dots.length;
const fy = dots.reduce((s, d) => s + d[1], 0) / dots.length;
const maxDist = Math.max(...dots.map((d) => Math.hypot(d[0] - fx, d[1] - fy)));
const delay = (x: number, y: number, span = 1100) =>
  Math.round((Math.hypot(x - fx, y - fy) / maxDist) * span);

// Optional props default to the home-page behaviour, so the home page is
// unchanged. About > Where We Work passes showStats={false} to hide the
// headline stat bar and a note to caption the map as a work in progress.
export interface Props {
  showStats?: boolean;
  note?: string;
}
const { showStats = true, note } = Astro.props as Props;

---

<section class="africa-map" aria-label="Favor’s public country fields in Africa">
  <div class="container africa-map__inner">
    <header class="africa-map__head">
      <p class="eyebrow eyebrow--gold">Your partnership puts you on the mission field</p>
      <h2 class="africa-map__h2">Three public country fields. One field-led mission.</h2>
      <p class="africa-map__lede">
        Favor publicly highlights its work in Uganda, South Sudan, and Chad.
        Local leaders carry prayer, discipleship, education, and community transformation forward.
      </p>
    </header>

    <figure class="africa-map__board">
      <ul class="africa-map__key" aria-label="Map key">
        <li><span class="africa-map__key-dot africa-map__key-dot--station"></span>Public country fields</li>
      </ul>
      <svg
        class="africa-map__svg"
        viewBox={`${view.x} ${view.y} ${view.w} ${view.h}`}
        xmlns="http://www.w3.org/2000/svg"
        role="img"
        aria-labelledby="africa-map-title"
      >
        <title id="africa-map-title">
          Map of Africa highlighting Favor International’s public country fields: Uganda, South Sudan, and Chad
        </title>

        <rect x={view.x} y={view.y} width={view.w} height={view.h} class="africa-map__sea" />

        <g class="africa-map__countries">
          {countries.map((c) => (
            <path d={c.d} class={publicCountries.has(c.name) ? 'country country--reached' : 'country'} data-name={publicCountries.has(c.name) ? publicCountryName(c.name) : undefined} />
          ))}
        </g>

        <g class="africa-map__leaders" aria-hidden="true">
          {publicLabels.filter((l) => l.leader).map((l) => (
            <>
              <line x1={l.leader![0]} y1={l.leader![1]} x2={l.x} y2={l.y} />
              <circle cx={l.leader![0]} cy={l.leader![1]} r="5" />
            </>
          ))}
        </g>
        <g class="africa-map__labels" aria-hidden="true">
          {publicLabels.map((l) => (
            <text x={l.x} y={l.y} font-size={l.fs} text-anchor={l.anchor}>
              {l.lines.map((ln, i) => <tspan x={l.x} dy={i === 0 ? 0 : l.fs * 1.02}>{ln}</tspan>)}
            </text>
          ))}
        </g>

      </svg>
      <figcaption class="africa-map__caption">
        Public-facing country view. Additional operational locations are intentionally not identified.
      </figcaption>
    </figure>

    {showStats && (
      <div class="africa-map__stats">
        <div class="africa-map__stat">
          <span class="africa-map__stat-num">524,673</span>
          <span class="africa-map__stat-label">Total salvations to date</span>
        </div>
        <span class="africa-map__stat-divider" aria-hidden="true"></span>
        <div class="africa-map__stat">
          <span class="africa-map__stat-num">3,635</span>
          <span class="africa-map__stat-label">PBS locations</span>
        </div>
        <span class="africa-map__stat-divider" aria-hidden="true"></span>
        <div class="africa-map__stat">
          <span class="africa-map__stat-num">3</span>
          <span class="africa-map__stat-label">Public country fields</span>
        </div>
      </div>
    )}
    {note && <p class="africa-map__note">{note}</p>}
  </div>
</section>

<script>
  // Ripple-in reveal on first scroll into view.
  document.querySelectorAll<HTMLElement>('.africa-map__svg').forEach((svg) => {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) { svg.classList.add('is-revealed'); return; }
    const io = new IntersectionObserver((entries) => {
      entries.forEach((en) => { if (en.isIntersecting) { svg.classList.add('is-revealed'); io.disconnect(); } });
    }, { threshold: 0.2 });
    io.observe(svg);
  });
</script>

<style>
  .africa-map {
    background: var(--color-cream);
    padding: clamp(var(--space-12), 9vw, var(--space-16)) 0;
    position: relative;
    overflow: hidden;
  }
  .africa-map__head {
    text-align: center;
    max-width: 720px;
    margin-inline: auto;
    margin-bottom: clamp(var(--space-12), 5vw, var(--space-16));
  }
  .africa-map__h2 {
    margin: 0 0 var(--space-4) 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.8rem, 3.8vw, 2.6rem);
    line-height: 1.12;
    color: var(--color-green-deep);
    letter-spacing: -0.01em;
  }
  .africa-map__lede { margin: 0; color: var(--color-ink-soft); font-size: 1rem; line-height: 1.6; }

  .africa-map__board { margin: 0; max-width: 1080px; margin-inline: auto; }
  .africa-map__svg {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 14px;
    box-shadow: 0 12px 40px rgba(11, 64, 36, 0.12);
    background: var(--color-cream);
  }

  .africa-map__sea { fill: var(--color-cream); }
  .country {
    fill: var(--color-sage-light);
    stroke: #ffffff;
    stroke-width: 2;
    stroke-linejoin: round;
  }
  .country--reached { fill: var(--color-gold); }

  .africa-map__labels text {
    font-family: var(--font-sans);
    font-weight: 800;
    letter-spacing: 0.5px;
    fill: #111111;
    stroke: rgba(255, 255, 255, 0.82);
    stroke-width: 3.5px;
    paint-order: stroke fill;
    pointer-events: none;
  }
  .africa-map__leaders line { stroke: #1a1a1a; stroke-width: 1.6; }
  .africa-map__leaders circle { fill: #1a1a1a; }

  .africa-map__dots circle { fill: #ed1c24; fill-opacity: 0.92; pointer-events: none; }
  .africa-map__stations circle { stroke: #ffffff; stroke-width: 2.5; paint-order: stroke; }
  .africa-map__stations--future circle { fill: #1f6fb8; }
  .africa-map__stations--station circle { fill: #179c47; }

  /* Ripple-in reveal: dots start collapsed + invisible, then scale/fade
     to full, staggered by their inline transition-delay. */
  .africa-map__dots circle,
  .africa-map__stations circle {
    opacity: 0;
    transform: scale(0.3);
    transform-box: fill-box;
    transform-origin: center;
    transition: opacity 0.45s ease, transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .africa-map__svg.is-revealed .africa-map__dots circle { opacity: 0.92; transform: scale(1); }
  .africa-map__svg.is-revealed .africa-map__stations circle { opacity: 1; transform: scale(1); }

  /* Map key */
  .africa-map__key {
    list-style: none;
    margin: 0 0 var(--space-5) 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-4) var(--space-6);
  }
  .africa-map__key li {
    display: flex;
    align-items: center;
    gap: 9px;
    font-size: 0.9rem;
    color: var(--color-ink-soft);
  }
  .africa-map__key-dot {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .africa-map__key-dot--pbs { background: #ed1c24; }
  .africa-map__key-dot--station { background: #179c47; }
  .africa-map__key-dot--future { background: #1f6fb8; }

  .africa-map__caption {
    margin: var(--space-4) 0 0 0;
    text-align: center;
    font-size: 0.8rem;
    color: var(--color-ink-soft);
    font-style: italic;
  }

  .africa-map__stats {
    margin-top: clamp(var(--space-8), 5vw, var(--space-12));
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(var(--space-6), 5vw, var(--space-12));
    flex-wrap: wrap;
  }
  .africa-map__stat { display: flex; flex-direction: column; align-items: center; gap: 4px; text-align: center; }
  .africa-map__stat-num {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2rem, 4.6vw, 3.4rem);
    color: var(--color-green-deep);
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .africa-map__stat-label {
    font-family: var(--font-brand);
    font-size: 0.75rem;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--color-gold);
    font-weight: 200;
  }
  .africa-map__stat-divider { width: 1px; height: 48px; background: var(--color-gold); opacity: 0.4; }
  @media (max-width: 700px) { .africa-map__stat-divider { display: none; } }

  @media (prefers-reduced-motion: reduce) {
    .africa-map__dots circle, .africa-map__stars polygon { transition: none; }
  }
</style>
