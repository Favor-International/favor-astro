---
import '../styles/global.css';
import { SITE } from '../lib/site';

export interface Props {
  title: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const { title, description, image, noindex } = Astro.props as Props;
const fullTitle = title === SITE.name ? title : `${title} | ${SITE.name}`;
const ogImage = image || '/images/og-default.jpg';
const canonical = new URL(Astro.url.pathname, SITE.url).toString();

// Every fact here comes from SITE (verified against Favor's own published
// material); do not add fields that aren't verifiable from those sources.
const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'NonprofitOrganization',
  '@id': `${SITE.url}/#organization`,
  name: 'Favor International, Inc.',
  alternateName: SITE.name,
  url: SITE.url,
  logo: new URL('/images/favor-logo-color.png', SITE.url).toString(),
  slogan: SITE.tagline,
  description: SITE.mission,
  nonprofitStatus: 'https://schema.org/Nonprofit501c3',
  taxID: SITE.ein,
  email: SITE.emailGeneral,
  telephone: SITE.phoneTel,
  address: {
    '@type': 'PostalAddress',
    streetAddress: '3433 Lithia Pinecrest Rd. #356',
    addressLocality: 'Valrico',
    addressRegion: 'FL',
    postalCode: '33596',
    addressCountry: 'US',
  },
  areaServed: ['Uganda', 'South Sudan', 'Chad'],
  sameAs: [
    SITE.social.facebook,
    SITE.social.instagram,
    SITE.social.youtube,
    SITE.social.twitter,
    SITE.social.linkedin,
    SITE.trust.ecfa,
    SITE.trust.candid,
    SITE.trust.charityNavigator,
  ],
};

const siteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${SITE.url}/#website`,
  name: SITE.name,
  url: SITE.url,
  publisher: { '@id': `${SITE.url}/#organization` },
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Consent Mode v2 defaults, ahead of every other tag: Google storage is
         denied until CookieYes reports a choice, and wait_for_update gives the
         CMP 500ms to send that update before tags decide. -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag('consent', 'default', {
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        analytics_storage: 'denied',
        wait_for_update: 500,
      });
    </script>
    <meta name="theme-color" content="#2b4d24" />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <link rel="preload" href="/fonts/montserrat-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/montserrat-700.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/montserrat-800.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/PlayfairDisplay-VariableFont.ttf" as="font" type="font/ttf" crossorigin />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;600;700&display=swap" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.name} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:image" content={new URL(ogImage, SITE.url).toString()} />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(siteSchema)} />
    <!-- CookieYes consent management (Daniel, 2026-08-07). Banner styling is
         configured in the CookieYes dashboard; it was themed for the old site
         and Daniel expects it to need touch-ups against this design. -->
    <script is:inline id="cookieyes" type="text/javascript" src="https://cdn-cookieyes.com/client_data/876f631cdfa13b3634a60ffb/script.js"></script>

    <!-- Google Tag Manager (GTM-MMMRL3S4). GA4 (G-VTJ3LN2BC8) and the rest of
         the tags are configured inside GTM, so no gtag.js snippet belongs
         here. Loaded after CookieYes on purpose: CMP first, then GTM. -->
    <script is:inline>
      (function (w, d, s, l, i) {
        w[l] = w[l] || []; w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
        var f = d.getElementsByTagName(s)[0], j = d.createElement(s), dl = l != 'dataLayer' ? '&l=' + l : '';
        j.async = true; j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
        f.parentNode.insertBefore(j, f);
      })(window, document, 'script', 'dataLayer', 'GTM-MMMRL3S4');
    </script>
    <!-- End Google Tag Manager -->
  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-MMMRL3S4"
      height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    <a href="#main" class="skip">Skip to main content</a>
    <slot />
  </body>
</html>
