---
import BaseLayout from './BaseLayout.astro';
import SiteHeader from '../components/global/SiteHeader.astro';
import SiteFooter from '../components/global/SiteFooter.astro';
import GalleryLightbox from '../components/global/GalleryLightbox.astro';

export interface Props {
  title: string;
  description?: string;
  image?: string;
  headerVariant?: 'transparent' | 'opaque';
  noindex?: boolean;
}
const { title, description, image, headerVariant = 'opaque', noindex } = Astro.props as Props;
---
<BaseLayout title={title} description={description} image={image} noindex={noindex}>
  <SiteHeader variant={headerVariant} />
  <main id="main">
    <slot />
  </main>
  <SiteFooter />
  <GalleryLightbox />
</BaseLayout>
